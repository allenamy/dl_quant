    "input_len": 600,
    "stride": 180,
    "horizons_sec": [
      600
    ],
    "include_ridge_features": true,
    "include_regime_prior": true,
    "quantize_features": true,
    "preload": false,
    "recent_y_stats_path": "data/v6b_daily_y_stats.json",
    "recent_y_features": [
      [30, "mean"],
      [30, "std"],
      [30, "vol_mean"],
      [30, "vol_std"],
      [7, "mean"],
      [7, "vol_mean"]
    ]
  },
  "model": {
    "d_model": 32,
    "d_raw": 16,
    "n_mask_blocks": 1,
    "n_cross_layers": 1,
    "patch_size": 5,
    "attn_nhead": 2,
    "attn_d_ff": 64,
    "d_prior": 12,
    "dropout": 0.2,
    "n_horizons": 1,
    "n_symbols": 1,
    "use_monotonic_quantile": true,
    "use_revin": true,
