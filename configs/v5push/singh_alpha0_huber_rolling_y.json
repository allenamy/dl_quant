{
  "_comment": "V5 singh α=0+Huber + rolling causal 30d y-normalize. Target = y_600 / σ_day where σ_day = rolling 30d MAD on past y (strictly causal). Model learns regime-invariant function. Eval denorms via σ_day lookup.",
  "data": {
    "csv_path": "",
    "npz_dir": "data/npz_v4",
    "y_rolling_sigma_path": "data/y_rolling_sigma_30d.json",
    "n_levels": 25,
    "horizon_sec": 600,
    "input_len": 600,
    "stride": 180,
    "horizons_sec": [600],
    "include_ridge_features": true,
    "include_regime_prior": true,
    "quantize_features": true,
    "preload": false
  },
  "model": {
    "d_model": 32,
    "d_raw": 16,
    "n_mask_blocks": 1,
    "n_cross_layers": 1,
    "patch_size": 5,
    "attn_nhead": 2,
    "attn_d_ff": 64,
    "d_prior": 6,
    "dropout": 0.2,
    "n_horizons": 1,
    "n_symbols": 1,
    "use_monotonic_quantile": true,
    "use_revin": true,
    "use_masknet": false,
    "use_gdcn": true,
    "use_raw_path": true,
    "use_attention": false,
    "use_conv": false,
    "use_channel_mix_conv": true,
    "use_level_attention_pool": true,
    "use_patch_attention_pool": false,
    "use_ppnet_gate": true,
    "backbone_kind": "conformer",
    "backbone_kwargs": {"n_blocks": 2, "n_heads": 2, "kernel_size": 15}
  },
  "training": {
    "epochs": 25,
    "batch_size": 1024,
    "lr": 0.0006,
    "weight_decay": 0.001,
    "patience": 4,
    "grad_clip": 1.0,
    "train_days": 700,
    "val_days": 60,
    "test_days": 90,
    "fold_stride": 60,
    "fold_test_starts": ["2025-02-09", "2025-04-10", "2025-06-11"],
    "num_workers": 4,
    "prefetch_factor": 2,
    "val_metric": "composite",
    "use_ema": true,
    "ema_decay": 0.999,
    "dul_config": {
      "lambda_quantile": 0.10,
      "lambda_utility_rank": 0.50,
      "lambda_calib": 0.0,
      "lambda_dir_huber": 0.50,
      "lambda_pearson": 0.0,
      "lambda_beta_calib": 0.0,
      "utility_alpha": 0.0,
      "dir_huber_delta": 2.0,
      "dir_huber_w_wrong": 0.0,
      "dir_huber_w_extreme": 0.0
    },
    "embargo_days": 1
  },
  "output_dir": "experiments/v5push/singh_rolling_y"
}
