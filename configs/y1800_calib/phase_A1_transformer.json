{
  "_comment": "Phase A1 (architecture): pure Transformer baseline. patch_size=8 (1200/8=150 fits max_patches), 2-head causal patch attention + token pool. Tests if global attention helps at 30-min horizon (V4 has attn=False — was tested on y_180 only). Backbone path bypassed (use_attention=true takes over).",
  "data": {
    "csv_path": "",
    "npz_dir": "data/npz_v4_y1800",
    "n_levels": 20,
    "horizon_sec": 1800,
    "input_len": 1200,
    "stride": 600,
    "horizons_sec": [1800],
    "include_ridge_features": false,
    "include_regime_prior": true,
    "quantize_features": true,
    "preload": false
  },
  "model": {
    "d_model": 32, "d_raw": 16, "n_mask_blocks": 1, "n_cross_layers": 1,
    "patch_size": 8, "attn_nhead": 2, "attn_d_ff": 64, "d_prior": 6,
    "dropout": 0.15, "n_horizons": 1, "n_symbols": 1,
    "use_monotonic_quantile": true, "use_revin": true,
    "use_masknet": false, "use_gdcn": true, "use_raw_path": true,
    "use_attention": true, "use_conv": true,
    "use_channel_mix_conv": true, "use_level_attention_pool": true,
    "use_patch_attention_pool": true, "use_ppnet_gate": true,
    "backbone_kind": "conv_lasts"
  },
  "training": {
    "epochs": 40, "batch_size": 512, "lr": 0.0006,
    "weight_decay": 0.001, "patience": 8, "grad_clip": 1.0,
    "train_days": 700, "val_days": 30, "test_days": 90,
    "fold_stride": 60,
    "num_workers": 4, "prefetch_factor": 2,
    "val_metric": "composite", "use_ema": true, "ema_decay": 0.999,
    "dul_config": {
      "lambda_quantile": 1.0, "lambda_utility_rank": 0.3,
      "lambda_calib": 0.0, "lambda_dir_huber": 0.2,
      "lambda_beta_calib": 0.05, "utility_alpha": 1.0,
      "dir_huber_delta": 2.0, "dir_huber_w_wrong": 2.0, "dir_huber_w_extreme": 3.0
    }
  },
  "output_dir": "experiments/y1800_calib/phase_A1_transformer"
}
