        "attn_d_ff": 64,
        "d_prior": 0,
        "dropout": 0.15,
        "n_horizons": 4,
        "n_symbols": 1,
        "use_monotonic_quantile": true,
        "use_revin": true
    },
    "training": {
        "epochs": 60,
        "batch_size": 256,
        "lr": 3e-4,
        "weight_decay": 1e-3,
        "patience": 10,
        "grad_clip": 1.0,
        "train_days": 500,
        "val_days": 30,
        "test_days": 30,
        "fold_stride": 60
    },
    "output_dir": "experiments/v3_multi_horizon"
