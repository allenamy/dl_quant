        "npz_dir": "data/npz_multi_horizon",
        "n_levels": 25,
        "horizons_sec": [60, 180, 300, 600],
        "input_len": 300,
        "stride": 60
    },
    "model": {
        "d_model": 32,
        "d_raw": 16,
        "n_mask_blocks": 1,
