    "val_days": 30,
    "test_days": 90,
    "fold_stride": 60,
    "num_workers": 4,
    "prefetch_factor": 2,
    "val_metric": "composite",
    "use_ema": true,
    "ema_decay": 0.999,
    "dul_config": {
      "lambda_quantile": 0.10,
      "lambda_utility_rank": 0.50,
      "lambda_calib": 0.0,
      "lambda_dir_huber": 0.50,
      "lambda_pearson": 0.0,
      "lambda_beta_calib": 0.0,
      "utility_alpha": 0.0,
      "dir_huber_delta": 2.0,
      "dir_huber_w_wrong": 0.0,
      "dir_huber_w_extreme": 0.0
    }
  },
  "output_dir": "experiments/y600_push/baseline_plus_alpha0_huber"
