{
  "_comment": "V4 baseline_plus + α=0+Huber loss (cross-arch validation of V5 dualh winner). Identical model/training to baseline_plus.json EXCEPT dul_config: utility_alpha 1.0->0.0 + lambda_dir_huber 0.50 (plain Huber, w_wrong=w_extreme=0). Hypothesis: train-time bias fix that worked on V5 dualh also works on V4 single-horizon.",
  "data": {
    "csv_path": "",
    "npz_dir": "data/npz_v4",
    "n_levels": 25,
    "horizon_sec": 600,
    "input_len": 600,
    "stride": 180,
    "horizons_sec": [600],
    "include_ridge_features": true,
    "include_regime_prior": true,
    "quantize_features": true,
    "preload": false
  },
  "model": {
    "d_model": 32,
    "d_raw": 16,
    "n_mask_blocks": 1,
    "n_cross_layers": 1,
    "patch_size": 5,
    "attn_nhead": 2,
    "attn_d_ff": 64,
    "d_prior": 6,
    "dropout": 0.15,
    "n_horizons": 1,
    "n_symbols": 1,
    "use_monotonic_quantile": true,
    "use_revin": true,
    "use_masknet": false,
    "use_gdcn": true,
    "use_raw_path": true,
    "use_attention": false,
    "use_conv": true,
    "use_channel_mix_conv": true,
    "use_level_attention_pool": true,
    "use_patch_attention_pool": false,
    "use_ppnet_gate": true
  },
  "training": {
    "epochs": 40,
    "batch_size": 1024,
    "lr": 0.0006,
    "weight_decay": 0.001,
    "patience": 8,
