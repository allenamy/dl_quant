{
  "_comment": "Train on augmented NPZ with 72 features (64 baseline + 8 long-horizon derived from X and X_raw). Features: lr_300s, lr_600s, rv_300s_win, mean_rev_z_300s, spread_z_300s, depth_asym_300s, obi_persistence, hurst_log_ratio. The extra 8 features explicitly expose long-horizon aggregates that the conv stack would otherwise need to learn implicitly.",
  "data": {
    "csv_path": "",
    "npz_dir": "data/npz_v4_plus",
    "n_levels": 25,
    "horizon_sec": 600,
    "input_len": 600,
    "stride": 180,
    "horizons_sec": [600],
    "include_ridge_features": true,
    "include_regime_prior": true,
    "quantize_features": true,
    "preload": false
  },
  "model": {
    "d_model": 32,
    "d_raw": 16,
    "n_mask_blocks": 1,
    "n_cross_layers": 1,
    "patch_size": 5,
    "attn_nhead": 2,
    "attn_d_ff": 64,
    "d_prior": 6,
    "dropout": 0.15,
    "n_horizons": 1,
    "n_symbols": 1,
    "use_monotonic_quantile": true,
    "use_revin": true,
    "use_masknet": false,
    "use_gdcn": true,
    "use_raw_path": true,
    "use_attention": false,
    "use_conv": true,
    "use_channel_mix_conv": true,
    "use_level_attention_pool": true,
    "use_patch_attention_pool": false,
    "use_ppnet_gate": true
  },
  "training": {
    "epochs": 40,
    "batch_size": 1024,
    "lr": 0.0006,
    "weight_decay": 0.001,
    "patience": 8,
    "grad_clip": 1.0,
    "train_days": 700,
    "val_days": 30,
    "test_days": 90,
    "fold_stride": 60,
    "num_workers": 4,
    "prefetch_factor": 2,
    "val_metric": "composite",
    "use_ema": true,
    "ema_decay": 0.999,
    "dul_config": {
      "lambda_quantile": 1.0,
      "lambda_utility_rank": 0.3,
      "lambda_calib": 0.0,
      "utility_alpha": 1.0
    }
  },
  "output_dir": "experiments/y600_push/augmented_v4"
}
