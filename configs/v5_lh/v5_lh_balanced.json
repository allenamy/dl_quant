{
  "_comment_1": "V5-LH Balanced config — focal DISABLED to prevent P/S divergence (ep 5 of default showed P=0.075 / S=0.020, tail-driven Pearson failure mode). Kept utility_rank=0.3 (same as V4 DUL) and decorr α=0.1 (mild). Primary goal: P AND S >= 0.10 on clean test.",
  "_comment_2": "If P/S remain divergent after 10 epochs with focal_weight=0, try bumping utility_rank to 0.5 next iteration.",

  "data": {
    "npz_dir": "data/npz_v5_lh",
    "input_len": 1800,
    "eval_subsample_stride": 10
  },
  "model": {
    "d_model": 24,
    "d_raw": 16,
    "d_prior": 6,
    "horizons": ["y_600"],
    "n_mamba_layers": 1,
    "mamba_d_state": 16,
    "mamba_expand": 1,
    "use_fallback": false
  },
  "loss": {
    "gamma_crps": 0.0,
    "eta_utility": 0.3,
    "alpha_decorr": 0.1,
    "focal_weight": 0.0,
    "focal_threshold_sigma": 2.0,
    "use_unit": true
  },
  "training": {
    "epochs": 40,
    "batch_size": 32,
    "lr": 6e-4,
    "weight_decay": 1e-3,
    "warmup_epochs": 0,
    "patience": 8,
    "grad_clip": 1.0,
    "train_days": 700,
    "val_days": 30,
    "test_days": 90,
    "fold_stride": 60,
    "num_workers": 2,
    "cache_size": 8,
    "chunk_size": 8
  },
  "early_exit": {
    "min_epoch5_pearson": 0.010,
    "max_grad_norm": 10.0,
    "grad_spike_window": 3
  },
  "output_dir": "experiments/v5_lh_balanced"
}
