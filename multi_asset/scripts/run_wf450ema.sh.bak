#!/bin/bash
# FAST beta-healthy trajectory: 450d + patience10 + epochs32, EMA checkpoint (the validated fast fix).
# Ablation 2025-11: 450d+pat10 EMA = beta1.47 sigma0.051 HEALTHY (BEST is sigma-gate-trapped at b2.33 = #24).
# 450d ~1.5h/month -> ~12-15h total, finishes by tomorrow. verify-before-advance (EMA preds), OOM-retry.
# Log: /tmp/wf450ema.log
cd /mnt/storage/private/work_hsy/quant_research_multi_asset
PY=/root/miniconda3/envs/hsy_v5push/bin/python; export PYTHONPATH=.
exec > /tmp/wf450ema.log 2>&1
echo "=== WF450EMA runner $(date) ==="
wait_clear () { while pgrep -f "train_v2arch.py|train_dual_lob.py" >/dev/null 2>&1 || [ "$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null|grep -c .)" != "0" ]; do sleep 30; done; }
MONTHS="2025-08 2025-09 2025-10 2025-11 2025-12 2026-01 2026-02 2026-03 2026-04 2026-05"
# seed 2025-11 from the ablation arm A (already 450d+pat10) to save a run
if [ -f experiments/abl11/A_450_pat10/fold_0/ema_test_preds.npz ] && [ ! -f experiments/wfEMA/wf_2025_11/fold_0/ema_test_preds.npz ]; then
  mkdir -p experiments/wfEMA/wf_2025_11/fold_0
  cp experiments/abl11/A_450_pat10/fold_0/ema_test_preds.npz experiments/wfEMA/wf_2025_11/fold_0/ema_test_preds.npz
  cp experiments/abl11/A_450_pat10/fold_0/test_preds.npz experiments/wfEMA/wf_2025_11/fold_0/test_preds.npz 2>/dev/null
fi
for M in $MONTHS; do
  Y=${M%-*}; MO=${M#*-}; out="experiments/wfEMA/wf_${Y}_${MO}"; base="configs/walkforward/wf_${Y}_${MO}.json"
  if [ "$M" \> "2025-09" ]; then trainer=train_dual_lob; else trainer=train_v2arch; fi
  if [ -f "$out/fold_0/ema_test_preds.npz" ]; then echo "=== SKIP $M (done) ==="; \
    $PY multi_asset/eval/eval_caliber.py --preds "$out/fold_0/test_preds.npz" --ema 2>&1; continue; fi
  ok=0
  for TD in 450 350 250; do
    wait_clear
    tcfg="/tmp/ema_${Y}_${MO}_td${TD}.json"
    $PY -c "import json;d=json.load(open('$base'));d['training']['train_days']=$TD;d['training']['patience']=10;d['training']['epochs']=32;d['output_dir']='$out';json.dump(d,open('$tcfg','w'))"
    echo "=== WF450EMA TRAIN $M ($trainer, td=$TD pat10) $(date) ==="
    $PY -u multi_asset/train/${trainer}.py --config "$tcfg" --start-fold 0 --max-folds 1 --seed 42 > /tmp/ema_${Y}_${MO}.log 2>&1 < /dev/null
    if [ -f "$out/fold_0/ema_test_preds.npz" ]; then
      echo "=== WF450EMA METRICS $M (td=$TD, BEST+EMA) $(date) ==="
      $PY multi_asset/eval/eval_caliber.py --preds "$out/fold_0/test_preds.npz" --ema 2>&1
      ok=1; break
    else echo "=== WF450EMA OOM/FAIL $M td=$TD -> retry smaller ==="; tail -4 /tmp/ema_${Y}_${MO}.log; fi
  done
  [ "$ok" = 0 ] && echo "=== WF450EMA GAVE-UP $M ==="
  echo "=== WF450EMA DONE $M $(date) ==="
done
echo "=== WF450EMA ALL COMPLETE -> PER-MONTH BEST/EMA-PICK AGGREGATE $(date) ==="
PYTHONPATH=. $PY multi_asset/eval/honest_aggregate_pick.py 2>&1
echo "=== WF450EMA CHAIN COMPLETE $(date) ==="
touch /tmp/wf450ema.DONE
