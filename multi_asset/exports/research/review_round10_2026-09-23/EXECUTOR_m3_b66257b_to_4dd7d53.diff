+@contextlib.contextmanager
+def frozen_clock(start=None):
+    """time.time() returns a deterministic sequence, reset per run, so two runs of equal call order are byte-comparable."""
+    t0 = float(start if start is not None else NOW)
+    c = [0]
+    real = time.time
+
+    def fake():
+        c[0] += 1
+        return t0 + c[0] * 1e-3
+    time.time = fake
+    try:
+        yield
+    finally:
+        time.time = real
