+
+def diag(beta_before: float, beta_after: Optional[float], intent: float, stage_name: str, tol: Optional[float] = None) -> Dict[str, Any]:
+    """The flat-book diagnostic (prereg R3 on the executor's own code): the move of the executed book's ex-ante beta against the
+    intent (-beta_before). ratio 1.0 = delivered exactly. `tol` absolute in USDT (None ⇒ relative TARGET_DIAG_REL_TOL)."""
+    if beta_after is None:
+        return {"stage": stage_name, "ok": None, "why": "beta after not computable"}
+    move = beta_after - beta_before
+    if intent == 0.0:
+        ok = (move == 0.0) if tol is None else abs(move) <= tol
+        return {"stage": stage_name, "beta_before_usdt": beta_before, "beta_after_usdt": beta_after, "move_usdt": move,
+                "intent_usdt": intent, "ratio": None, "ok": ok, "tol_usdt": tol}
+    ratio = move / intent
+    lim = (TARGET_DIAG_REL_TOL * abs(intent)) if tol is None else float(tol)
+    return {"stage": stage_name, "beta_before_usdt": beta_before, "beta_after_usdt": beta_after, "move_usdt": move,
+            "intent_usdt": intent, "ratio": ratio, "ok": abs(move - intent) <= lim, "tol_usdt": lim}
+
+
+def after_cap(rec: Dict[str, Any], target: Dict[str, float], capd: Dict[str, Any],
+              betas: Optional[Dict[str, float]] = None) -> List[tuple]:
+    """After clamp_venue_cap (a later, rare step the prereg's w_exec does not include): did the cap move the combined BTC target,
+    and what ex-ante beta does the FINAL target carry? Updates the record (`beta_final_usdt` = the residual beta after the leg and
+    every cap — 0 when nothing was capped); returns alarms. The hedge is NOT recomputed after the cap (prereg §2: w_exec is the
+    target after POP -> RESHAPE -> CLAMP); a non-BTC cap shows up here as a non-zero residual, stated, never absorbed."""
+    if not rec or rec.get("status") not in APPLIED:
+        return []
+    if betas:
+        fin = beta_exec(target, betas)
+        rec["beta_final_usdt"] = fin["beta_exec_usdt"] if fin["ok"] else None
+        rec["capped_names"] = sorted(c.get("symbol") for c in (capd or {}).get("capped") or [])
+    capped = [c for c in (capd or {}).get("capped") or [] if c.get("symbol") == BTC]
+    rec["venue_capped"] = bool(capped)
+    if not capped:
+        return []
+    delivered = float(target.get(BTC, 0.0) or 0.0) - float(rec.get("btc_book_target_usdt") or 0.0)
+    rec["hedge_after_cap_usdt"] = delivered
+    rec["hedge_gap_usdt"] = float(rec.get("hedge_target_usdt") or 0.0) - delivered
+    rec["hedge_gap_reason"] = "venue cap (maxNotionalValue x (1 - margin)) on the combined BTC target"
+    return [("HIGH", f"M3 对冲腿被场所上限截断: BTCUSDT {capped[0].get('target_before'):+,.0f}→{capped[0].get('target_after'):+,.0f}"
+                     f"(cap {capped[0].get('cap')}); 对冲意图 {rec.get('hedge_target_usdt'):+,.0f}U, 实际 {delivered:+,.0f}U, "
+                     f"对冲缺口 {rec['hedge_gap_usdt']:+,.0f}U 记账。")]
+
+
+def after_plan(rec: Dict[str, Any], plans: List[Dict[str, Any]], lot_step: Optional[float] = None,
+               min_notional: Optional[float] = None) -> None:
+    """Plan-level delivery (after lot rounding / min-notional): the BTC notional the plan will leave us holding, minus the book's
+    component, against the hedge intent. Tolerance = ONE lot of BTC at the plan's mid (binance_executor.round_qty floors the
+    quantity toward zero, so the planned order can fall short by up to a full step), or the venue's min_notional when the plan
+    SKIPPED the delta as below it — whichever is larger; None when the step / mid is unknown (then `ok` is None: not measured,
+    never "fine"). Record only (never a trading decision)."""
+    if not rec or rec.get("status") not in APPLIED:
+        return
+    row = next((p for p in plans or [] if p.get("symbol") == BTC), None)
+    if row is None:
+        rec["diag_plan"] = {"stage": "plan", "ok": None, "why": "no BTC plan row"}
+        return
+    cur = float(row.get("prev_notional") or 0.0)
+    mid = row.get("mid_at_anchor")
+    qty = row.get("qty")
+    if row.get("skip") is not None or qty is None:
+        planned = cur
+    elif mid:
+        planned = cur + float(qty) * float(mid)
+    else:
+        rec["diag_plan"] = {"stage": "plan", "ok": None, "why": "no mid"}
+        return
+    intent = float(rec.get("hedge_target_usdt") or 0.0)
+    delivered = planned - float(rec.get("btc_book_target_usdt") or 0.0)
+    tol = None
+    if lot_step and mid:
+        tol = float(lot_step) * float(mid)
+        if row.get("skip") == "skipped_min_notional" and min_notional:
+            tol = max(tol, float(min_notional))
+    rec["diag_plan"] = {"stage": "plan", "planned_btc_usdt": planned, "hedge_delivered_usdt": delivered, "intent_usdt": intent,
+                        "ratio": (delivered / intent) if intent else None, "skip": row.get("skip"),
+                        "tol_usdt": tol, "ok": (abs(delivered - intent) <= tol + 1e-9) if tol is not None else None,
+                        "note": "delivered = BTC notional after this plan's order minus the book's BTC component; lot rounding "
+                                "and min-notional skips are the only planned deviations (partial fills are phase B's)"}
+
+
+def neutrality_view(row: Dict[str, Any], rec: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    """The end-of-anchor neutrality readers (the HIGH page and the neutrality price) judge the book EX-OVERLAY when the leg was
+    placed: venue net minus the overlay's intended net. Adds `net_ex_overlay_*` to `row` (the raw `net_over_gross` stays the
+    venue's fact) and returns a view for the two readers. No overlay applied ⇒ returns `row` itself (identity)."""
+    if not rec or rec.get("status") not in APPLIED + ("refused",) or rec.get("mode") != "on":
+        return row
+    ov = rec.get("overlay_net_usdt")
+    if ov is None or row.get("venue_net_usdt") is None:
+        return row
+    net = float(row["venue_net_usdt"]) - float(ov)
+    grs = row.get("venue_gross_usdt")
+    eq_ratio = row.get("net_over_equity")
+    row["m3_overlay_net_usdt"] = float(ov)
+    row["net_ex_overlay_usdt"] = round(net, 6)
+    row["net_ex_overlay_over_gross"] = (round(net / float(grs), 6) if grs else None)
+    view = dict(row)
+    view["venue_net_usdt"] = row["net_ex_overlay_usdt"]
+    view["net_over_gross"] = row["net_ex_overlay_over_gross"]
+    if eq_ratio is not None and row.get("venue_net_usdt") not in (None, 0):
+        # net/equity rescaled by the same ratio (equity is not on the row)
+        try:
+            view["net_over_equity"] = round(float(eq_ratio) * net / float(row["venue_net_usdt"]), 6)
+        except (TypeError, ValueError, ZeroDivisionError):
+            view["net_over_equity"] = None
+    return view
+
+
+# ── the source-level identity used by tests and by the deploy receipt ────────────────────────────
+M3_BEGIN = "# ── M3-BEGIN"
+M3_END = "# ── M3-END"
+M3_LINE = "# M3-LINE"
+M3_ORIG = "# M3-ORIG:"
+
+
+def strip_m3(src: str) -> str:
+    """Remove every M3 insertion from a source file and restore every M3-modified line: the pre-M3 source, byte for byte
+    (asserted against the b66257b blobs in the deploy receipt; used by tests_beta_overlay [Z] to build the OFF reference)."""
+    out, skip = [], False
+    for line in src.splitlines(keepends=True):
+        s = line.strip()
+        if s.startswith(M3_BEGIN):
+            if skip:
+                raise ValueError("nested M3-BEGIN")
+            skip = True
+            continue
+        if s.startswith(M3_END):
+            if not skip:
+                raise ValueError("M3-END without M3-BEGIN")
+            skip = False
+            continue
+        if skip:
+            continue
+        if line.rstrip("\n").endswith(M3_LINE):
+            continue
+        i = line.find(M3_ORIG)
+        if i >= 0:
+            nl = "\n" if line.endswith("\n") else ""
+            out.append(line[i + len(M3_ORIG):].rstrip("\n")[1:] + nl)     # exactly one space after the marker
+            continue
+        out.append(line)
+    if skip:
+        raise ValueError("unterminated M3-BEGIN")
+    return "".join(out)
