index 0000000..3a2c262
--- /dev/null
+++ b/ops/producer_release/20260923_m3/tests_beta_overlay_producer.py
@@ -0,0 +1,217 @@
+"""tests_beta_overlay_producer — the producer's M3 beta field (beta_overlay_producer.compute). Pure numpy fixtures; optional
+read-only real-cache checks when M3_REAL_ROLLING (a rolling.npz path) and M3_REAL_SYMS (xfer_syms.npz) are set; the pair check
+against the executor's validator REQUIRES M3_EXECUTOR_ROOT (a dl_quant_live tree with live/beta_overlay.py) — absent ⇒ RED,
+never skipped (an unchecked pair is not a checked one).
+
+  T1  future-perturbation invariance: every row after the anchor rewritten (values, NaNs, a +-30% spike) ⇒ the field is
+      byte-identical; control: the row closing AT the anchor changed ⇒ the beta changes (the bar ending at A is used).
+  T2  a name built as exactly 2 x BTC (+ constant) ⇒ beta 2.0 (error < 1e-12); BTC's own beta is exactly 1.
+  T3  119 valid pairs ⇒ fallback 1.0 with n_obs 119; 120 ⇒ estimated (2.0).
+  T4  clip: a 5x name ⇒ 4.0; a -3x name ⇒ -1.0.
+  T5  the start-boundary rule: a missing row closing AT a boundary T invalidates BOTH bars sharing it — the one ending at T
+      (the row is inside it) and the one starting at T (its start price is stale: the next row's ret5 spans the gap), 178
+      pairs; a gap-spanning spike placed in the next row leaves the beta exactly 2. RED control: a mutant that ignores the
+      start row counts 179 pairs and the spike moves the beta.
+  T6  refusals: anchor not in the axis / off the 4h grid / non-contiguous axis / duplicate symbols / BTC column missing / zero
+      BTC variance ⇒ BetaOverlayError (never a default); a name with no cache column ⇒ fallback, n_obs 0.
+  T7  PAIR: the field (JSON round-trip) is accepted by the executor's validator; a changed parameter is refused.
+  T8  (optional, real cache) the latest anchor: finite, clipped, BTC 1, one entry per universe name, < 2 s; and causality on
+      REAL data — the full cache vs the cache truncated at an earlier anchor give byte-identical fields for that anchor.
+"""
+import importlib.util
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import beta_overlay_producer as B  # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'} {name}{(' — ' + str(detail)[:300]) if detail else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+A = 1790150400
+BARS = 180
+ROWS = BARS * 48 + 1
+EXTRA = 24                                   # rows AFTER the anchor (the future the formula must not read)
+
+
+def axis(extra=EXTRA, before=0):
+    return np.arange(A - (ROWS - 1 + before) * 300, A + 1 + extra * 300, 300, dtype=np.int64)
+
+
+def synth(seed=1, extra=EXTRA, before=0):
+    """BTC + four names. Each 4h bar carries its whole log return in ONE row (the last) so exact targets are constructible."""
+    rts = axis(extra, before)
+    n = len(rts)
+    rng = np.random.default_rng(seed)
+    ai = int(np.nonzero(rts == A)[0][0])
+    x = np.zeros(n)
+    x[ai - (BARS - 1) * 48 - 48 * before: ai + 1: 48] = rng.normal(0, 0.02, size=len(range(ai - (BARS - 1) * 48 - 48 * before, ai + 1, 48)))
+    cols = {"BTCUSDT": x.copy(), "TWOUSDT": np.where(x != 0, 2 * x + 0.001, 0.0), "FIVEUSDT": 5 * x, "NEGUSDT": -3 * x,
+            "NOISEUSDT": rng.normal(0, 0.001, size=n)}
+    syms = list(cols)
+    L = np.stack([cols[s] for s in syms], 1)
+    return rts, np.expm1(L), syms          # simple returns, float64 (the exact tests); float16 is covered by T7/T8
+
+
+# ── T1 future invariance ──────────────────────────────────────────────────────────────────────────
+print("[T1] future-perturbation invariance")
+rts, R, syms = synth()
+names = syms[1:]
+f0 = B.compute(rts, R, syms, names, A)
+ai = int(np.nonzero(rts == A)[0][0])
+R2 = R.copy()
+rng = np.random.default_rng(99)
+R2[ai + 1:] = rng.normal(0, 0.05, size=R2[ai + 1:].shape)
+R2[ai + 3, 1] = np.nan
+R2[ai + 5, 0] = 0.30
+f1 = B.compute(rts, R2, syms, names, A)
+check("T1a every row after the anchor rewritten ⇒ field byte-identical", json.dumps(f0, sort_keys=True) == json.dumps(f1, sort_keys=True))
+R3 = R.copy()
+R3[ai, 1] += 0.01                                       # the row closing AT the anchor
+f3 = B.compute(rts, R3, syms, names, A)
+check("T1b control: the row closing AT the anchor changed ⇒ the beta changes (the bar ending at A is in the sample)",
+      f3["betas"]["TWOUSDT"] != f0["betas"]["TWOUSDT"], (f0["betas"]["TWOUSDT"], f3["betas"]["TWOUSDT"]))
+
+# ── T2 exact beta ────────────────────────────────────────────────────────────────────────────────
+print("\n[T2] exact beta and BTC")
+check("T2a a 2x(+const) name ⇒ beta 2 (|err| < 1e-12), 180 pairs", abs(f0["betas"]["TWOUSDT"] - 2.0) < 1e-12 and f0["n_obs"]["TWOUSDT"] == 180,
+      f0["betas"]["TWOUSDT"])
+check("T2b BTC's own beta is exactly 1.0 and it is written first", f0["betas"]["BTCUSDT"] == 1.0 and list(f0["betas"])[0] == "BTCUSDT")
+check("T2c declared parameters are the prereg's", (f0["version"], f0["n_win"], f0["n_min"], f0["clip"], f0["fallback"], f0["data_cutoff_ts"])
+      == ("m3_beta_v1", 180, 120, [-1.0, 4.0], 1.0, A))
+
+# ── T3 the 120 line ──────────────────────────────────────────────────────────────────────────────
+print("\n[T3] 119 ⇒ fallback, 120 ⇒ estimated")
+
+
+def knock(Rm, k_bars, col):
+    """make the LAST k_bars bars of `col` invalid (one NaN row inside each)."""
+    Rm = Rm.copy()
+    for k in range(k_bars):
+        Rm[ai - 48 * k - 10, col] = np.nan
+    return Rm
+
+
+f120 = B.compute(rts, knock(R, 60, 1), syms, names, A)
+f119 = B.compute(rts, knock(R, 61, 1), syms, names, A)
+check("T3a 120 valid pairs ⇒ estimated beta 2.0", f120["n_obs"]["TWOUSDT"] == 120 and abs(f120["betas"]["TWOUSDT"] - 2.0) < 1e-12,
+      (f120["n_obs"]["TWOUSDT"], f120["betas"]["TWOUSDT"]))
+check("T3b 119 valid pairs ⇒ fallback exactly 1.0", f119["n_obs"]["TWOUSDT"] == 119 and f119["betas"]["TWOUSDT"] == 1.0,
+      (f119["n_obs"]["TWOUSDT"], f119["betas"]["TWOUSDT"]))
+fb = B.compute(rts, knock(R, 61, 0), syms, names, A)
+check("T3c pairs are PAIRWISE: 61 invalid BTC bars ⇒ every name falls back (n_obs 119)", all(fb["betas"][n] == 1.0 and fb["n_obs"][n] == 119 for n in names))
+
+# ── T4 clip ──────────────────────────────────────────────────────────────────────────────────────
+print("\n[T4] clip")
+check("T4 a 5x name ⇒ 4.0; a -3x name ⇒ -1.0", f0["betas"]["FIVEUSDT"] == 4.0 and f0["betas"]["NEGUSDT"] == -1.0,
+      (f0["betas"]["FIVEUSDT"], f0["betas"]["NEGUSDT"]))
+
+# ── T5 start-boundary rule ───────────────────────────────────────────────────────────────────────
+print("\n[T5] a missing row AT a bar's start invalidates the bar (stale start price)")
+Rs = R.copy()
+k0 = ai - 48 * 50                                        # the row closing at the start of bar ending ai - 48*49
+Rs[k0, 1] = np.nan
+Rs[k0 + 1, 1] = 0.25                                     # the gap-spanning return the producer would have stored there
+fs = B.compute(rts, Rs, syms, names, A)
+check("T5a both bars sharing the boundary are invalid (178 pairs) and the beta stays 2.0 exactly", fs["n_obs"]["TWOUSDT"] == 178 and abs(fs["betas"]["TWOUSDT"] - 2.0) < 1e-12,
+      (fs["n_obs"]["TWOUSDT"], fs["betas"]["TWOUSDT"]))
+src = open(os.path.join(HERE, "beta_overlay_producer.py")).read()
+old = "    V = body_ok & start_ok                                # (180, m)"
+assert src.count(old) == 1
+import tempfile  # noqa: E402
+_td = tempfile.mkdtemp(prefix="bop_mut_")
+mp = os.path.join(_td, "bop_mut.py")
+open(mp, "w").write(src.replace(old, "    V = body_ok", 1))
+spec = importlib.util.spec_from_file_location("bop_mut", mp)
+Bm = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(Bm)
+os.remove(mp)
+os.rmdir(_td)
+fm = Bm.compute(rts, Rs, syms, names, A)
+check("T5b RED control: a mutant without the start-row rule counts 179 pairs and the spike moves the beta",
+      fm["n_obs"]["TWOUSDT"] == 179 and abs(fm["betas"]["TWOUSDT"] - 2.0) > 1e-3, (fm["n_obs"]["TWOUSDT"], fm["betas"]["TWOUSDT"]))
+
+# ── T6 refusals ──────────────────────────────────────────────────────────────────────────────────
+print("\n[T6] refusals and the no-column fallback")
+
+
+def raises(label, fn):
+    try:
+        fn()
+        ok = False
+    except B.BetaOverlayError:
+        ok = True
+    check(f"T6 {label} ⇒ BetaOverlayError", ok)
+
+
+raises("anchor not in the axis", lambda: B.compute(rts, R, syms, names, A + 14400 * 10))
+raises("anchor off the 4h grid", lambda: B.compute(rts, R, syms, names, A + 300))
+_rb = rts.copy(); _rb[5] += 1
+raises("non-contiguous axis", lambda: B.compute(_rb, R, syms, names, A))
+raises("duplicate symbols", lambda: B.compute(rts, R, syms[:-1] + [syms[0]], names, A))
+raises("BTC column missing", lambda: B.compute(rts, R[:, 1:], syms[1:], names, A))
+_Rz = R.copy(); _Rz[:, 0] = 0.0
+raises("zero BTC variance", lambda: B.compute(rts, _Rz, syms, names, A))
+fnc = B.compute(rts, R, syms, names + ["NOCOLUSDT"], A)
+check("T6b a name with no cache column ⇒ fallback 1.0, n_obs 0, counted", fnc["betas"]["NOCOLUSDT"] == 1.0 and fnc["n_obs"]["NOCOLUSDT"] == 0
+      and fnc["n_no_cache_column"] == 1)
+fshort = B.compute(rts[200:], R[200:], syms, names, A)
+check("T6c bars before the cache's first row do not exist (invalid, never zero): a cache 200 rows short ⇒ 175 pairs",
+      fshort["n_obs"]["TWOUSDT"] == 175, fshort["n_obs"]["TWOUSDT"])
+
+# ── T7 pair with the executor's validator ────────────────────────────────────────────────────────
+print("\n[T7] pair: the executor's validator accepts this field")
+root = os.environ.get("M3_EXECUTOR_ROOT")
+if not root or not os.path.isfile(os.path.join(root, "live", "beta_overlay.py")):
+    check("T7 M3_EXECUTOR_ROOT names a dl_quant_live tree with live/beta_overlay.py (pair check is REQUIRED)", False, root)
+else:
+    spec = importlib.util.spec_from_file_location("beta_overlay_exec", os.path.join(root, "live", "beta_overlay.py"))
+    BX = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(BX)
+    f16 = B.compute(rts, R.astype(np.float16), syms, names, A)
+    v = BX.validate_field(json.loads(json.dumps(f16)), A)
+    check("T7a float16 cache field, JSON round-trip ⇒ ACCEPTED by the executor validator", v["ok"], (v.get("reason"), v.get("detail")))
+    v2 = BX.validate_field(json.loads(json.dumps(dict(f16, n_min=100))), A)
+    check("T7b a changed parameter ⇒ refused params_mismatch", (not v2["ok"]) and v2["reason"] == "params_mismatch", v2.get("reason"))
+
+# ── T8 real cache (optional, read-only) ──────────────────────────────────────────────────────────
+rp, sp = os.environ.get("M3_REAL_ROLLING"), os.environ.get("M3_REAL_SYMS")
+if rp and sp:
+    print("\n[T8] real cache (read-only)")
+    z = np.load(rp, allow_pickle=True)
+    rts_r, D = z["ts"].astype(np.int64), z["data"]
+    syms_r = [str(s) for s in np.load(sp, allow_pickle=True)["symbols"]]
+    Ar = int(rts_r[-1])
+    uni = json.load(open(os.environ["M3_REAL_UNIVERSE"]))["universe"] if os.environ.get("M3_REAL_UNIVERSE") else syms_r[:450]
+    t0 = time.time()
+    fr = B.compute(rts_r, D[:, :, 0], syms_r, uni, Ar)
+    el = time.time() - t0
+    bv = np.array(list(fr["betas"].values()))
+    check("T8a latest anchor: finite, inside the clip, BTC 1, one entry per universe name (+BTC), < 2 s",
+          np.isfinite(bv).all() and bv.min() >= -1 and bv.max() <= 4 and fr["betas"]["BTCUSDT"] == 1.0
+          and set(fr["betas"]) == set(uni) | {"BTCUSDT"} and el < 2.0, (round(el, 3), fr["n_estimated"], fr["n_fallback"]))
+    Ap = Ar - 6 * 14400
+    ip = int(np.nonzero(rts_r == Ap)[0][0])
+    fa = B.compute(rts_r, D[:, :, 0], syms_r, uni, Ap)
+    fb2 = B.compute(rts_r[:ip + 1], D[:ip + 1, :, 0], syms_r, uni, Ap)
+    check("T8b REAL causality: the field at A-24h from the full cache == from the cache truncated at A-24h (byte-identical)",
+          json.dumps(fa, sort_keys=True) == json.dumps(fb2, sort_keys=True))
+else:
+    print("\n[T8] real cache: not requested (M3_REAL_ROLLING / M3_REAL_SYMS unset) — the synthetic groups above are the suite")
+
+print(f"\nTESTS_BETA_OVERLAY_PRODUCER {'ALL PASS' if not FAILS else 'FAILURES'} checks={N[0]} failed={len(FAILS)}")
+for f in FAILS:
+    print("  FAILED:", f)
+sys.exit(0 if not FAILS else 1)
