+    b, ex, loop, al = make_loop(al_mod, ex_mod, symbol_config=symbol_config)
+    M = al_mod or AL
+    with BC._using(book_path), pns_stub(M), frozen_clock():
+        out = loop.run_anchor(now=NOW)
+    st = AL._load(os.environ["LIVE_LOOP_STATE"], {})
+    return types.SimpleNamespace(out=out, b=b, ex=ex, loop=loop, al=al, st=st,
+                                 ctx=copy.deepcopy(loop._anchor_ctx or {}),
+                                 plans=[dict(p) for p in (getattr(ex, "_last_plans", None) or [])],
+                                 target=dict((loop._anchor_ctx or {}).get("target") or {}))
