@@ -0,0 +1,217 @@
+"""tests_beta_overlay_producer — the producer's M3 beta field (beta_overlay_producer.compute). Pure numpy fixtures; optional
+read-only real-cache checks when M3_REAL_ROLLING (a rolling.npz path) and M3_REAL_SYMS (xfer_syms.npz) are set; the pair check
+against the executor's validator REQUIRES M3_EXECUTOR_ROOT (a dl_quant_live tree with live/beta_overlay.py) — absent ⇒ RED,
+never skipped (an unchecked pair is not a checked one).
+
+  T1  future-perturbation invariance: every row after the anchor rewritten (values, NaNs, a +-30% spike) ⇒ the field is
+      byte-identical; control: the row closing AT the anchor changed ⇒ the beta changes (the bar ending at A is used).
+  T2  a name built as exactly 2 x BTC (+ constant) ⇒ beta 2.0 (error < 1e-12); BTC's own beta is exactly 1.
+  T3  119 valid pairs ⇒ fallback 1.0 with n_obs 119; 120 ⇒ estimated (2.0).
+  T4  clip: a 5x name ⇒ 4.0; a -3x name ⇒ -1.0.
+  T5  the start-boundary rule: a missing row closing AT a boundary T invalidates BOTH bars sharing it — the one ending at T
+      (the row is inside it) and the one starting at T (its start price is stale: the next row's ret5 spans the gap), 178
+      pairs; a gap-spanning spike placed in the next row leaves the beta exactly 2. RED control: a mutant that ignores the
+      start row counts 179 pairs and the spike moves the beta.
+  T6  refusals: anchor not in the axis / off the 4h grid / non-contiguous axis / duplicate symbols / BTC column missing / zero
+      BTC variance ⇒ BetaOverlayError (never a default); a name with no cache column ⇒ fallback, n_obs 0.
+  T7  PAIR: the field (JSON round-trip) is accepted by the executor's validator; a changed parameter is refused.
+  T8  (optional, real cache) the latest anchor: finite, clipped, BTC 1, one entry per universe name, < 2 s; and causality on
+      REAL data — the full cache vs the cache truncated at an earlier anchor give byte-identical fields for that anchor.
+"""
+import importlib.util
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import beta_overlay_producer as B  # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'} {name}{(' — ' + str(detail)[:300]) if detail else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+A = 1790150400
+BARS = 180
+ROWS = BARS * 48 + 1
+EXTRA = 24                                   # rows AFTER the anchor (the future the formula must not read)
+
+
+def axis(extra=EXTRA, before=0):
+    return np.arange(A - (ROWS - 1 + before) * 300, A + 1 + extra * 300, 300, dtype=np.int64)
+
+
+def synth(seed=1, extra=EXTRA, before=0):
+    """BTC + four names. Each 4h bar carries its whole log return in ONE row (the last) so exact targets are constructible."""
+    rts = axis(extra, before)
+    n = len(rts)
+    rng = np.random.default_rng(seed)
+    ai = int(np.nonzero(rts == A)[0][0])
+    x = np.zeros(n)
+    x[ai - (BARS - 1) * 48 - 48 * before: ai + 1: 48] = rng.normal(0, 0.02, size=len(range(ai - (BARS - 1) * 48 - 48 * before, ai + 1, 48)))
+    cols = {"BTCUSDT": x.copy(), "TWOUSDT": np.where(x != 0, 2 * x + 0.001, 0.0), "FIVEUSDT": 5 * x, "NEGUSDT": -3 * x,
+            "NOISEUSDT": rng.normal(0, 0.001, size=n)}
+    syms = list(cols)
+    L = np.stack([cols[s] for s in syms], 1)
+    return rts, np.expm1(L), syms          # simple returns, float64 (the exact tests); float16 is covered by T7/T8
+
+
+# ── T1 future invariance ──────────────────────────────────────────────────────────────────────────
+print("[T1] future-perturbation invariance")
+rts, R, syms = synth()
+names = syms[1:]
+f0 = B.compute(rts, R, syms, names, A)
+ai = int(np.nonzero(rts == A)[0][0])
+R2 = R.copy()
+rng = np.random.default_rng(99)
+R2[ai + 1:] = rng.normal(0, 0.05, size=R2[ai + 1:].shape)
+R2[ai + 3, 1] = np.nan
+R2[ai + 5, 0] = 0.30
+f1 = B.compute(rts, R2, syms, names, A)
+check("T1a every row after the anchor rewritten ⇒ field byte-identical", json.dumps(f0, sort_keys=True) == json.dumps(f1, sort_keys=True))
+R3 = R.copy()
+R3[ai, 1] += 0.01                                       # the row closing AT the anchor
+f3 = B.compute(rts, R3, syms, names, A)
+check("T1b control: the row closing AT the anchor changed ⇒ the beta changes (the bar ending at A is in the sample)",
+      f3["betas"]["TWOUSDT"] != f0["betas"]["TWOUSDT"], (f0["betas"]["TWOUSDT"], f3["betas"]["TWOUSDT"]))
+
+# ── T2 exact beta ────────────────────────────────────────────────────────────────────────────────
+print("\n[T2] exact beta and BTC")
+check("T2a a 2x(+const) name ⇒ beta 2 (|err| < 1e-12), 180 pairs", abs(f0["betas"]["TWOUSDT"] - 2.0) < 1e-12 and f0["n_obs"]["TWOUSDT"] == 180,
+      f0["betas"]["TWOUSDT"])
+check("T2b BTC's own beta is exactly 1.0 and it is written first", f0["betas"]["BTCUSDT"] == 1.0 and list(f0["betas"])[0] == "BTCUSDT")
+check("T2c declared parameters are the prereg's", (f0["version"], f0["n_win"], f0["n_min"], f0["clip"], f0["fallback"], f0["data_cutoff_ts"])
+      == ("m3_beta_v1", 180, 120, [-1.0, 4.0], 1.0, A))
+
+# ── T3 the 120 line ──────────────────────────────────────────────────────────────────────────────
+print("\n[T3] 119 ⇒ fallback, 120 ⇒ estimated")
+
+
+def knock(Rm, k_bars, col):
+    """make the LAST k_bars bars of `col` invalid (one NaN row inside each)."""
+    Rm = Rm.copy()
+    for k in range(k_bars):
+        Rm[ai - 48 * k - 10, col] = np.nan
+    return Rm
+
+
+f120 = B.compute(rts, knock(R, 60, 1), syms, names, A)
+f119 = B.compute(rts, knock(R, 61, 1), syms, names, A)
+check("T3a 120 valid pairs ⇒ estimated beta 2.0", f120["n_obs"]["TWOUSDT"] == 120 and abs(f120["betas"]["TWOUSDT"] - 2.0) < 1e-12,
+      (f120["n_obs"]["TWOUSDT"], f120["betas"]["TWOUSDT"]))
+check("T3b 119 valid pairs ⇒ fallback exactly 1.0", f119["n_obs"]["TWOUSDT"] == 119 and f119["betas"]["TWOUSDT"] == 1.0,
+      (f119["n_obs"]["TWOUSDT"], f119["betas"]["TWOUSDT"]))
+fb = B.compute(rts, knock(R, 61, 0), syms, names, A)
+check("T3c pairs are PAIRWISE: 61 invalid BTC bars ⇒ every name falls back (n_obs 119)", all(fb["betas"][n] == 1.0 and fb["n_obs"][n] == 119 for n in names))
+
+# ── T4 clip ──────────────────────────────────────────────────────────────────────────────────────
+print("\n[T4] clip")
+check("T4 a 5x name ⇒ 4.0; a -3x name ⇒ -1.0", f0["betas"]["FIVEUSDT"] == 4.0 and f0["betas"]["NEGUSDT"] == -1.0,
+      (f0["betas"]["FIVEUSDT"], f0["betas"]["NEGUSDT"]))
+
+# ── T5 start-boundary rule ───────────────────────────────────────────────────────────────────────
+print("\n[T5] a missing row AT a bar's start invalidates the bar (stale start price)")
+Rs = R.copy()
