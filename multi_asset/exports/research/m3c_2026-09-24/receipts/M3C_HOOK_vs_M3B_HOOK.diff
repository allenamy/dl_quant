+def budget_scale(book_gross, btc_before, leg, limit):
+    """M3c: the largest s in [0, 1] with (book_gross − |btc_before|) + |btc_before + s·leg| ≤ limit, limit ≥ book_gross (asserted)"""
+    if not (np.isfinite(limit) and np.isfinite(book_gross) and limit >= book_gross): raise M3Error(f"budget limit {limit} < book gross {book_gross}")
+    others = book_gross - abs(btc_before)
+    if leg == 0.0 or others + abs(btc_before + leg) <= limit: return 1.0
+    return float(min(1.0, max(0.0, (limit - others - np.sign(leg) * btc_before) / abs(leg))))
