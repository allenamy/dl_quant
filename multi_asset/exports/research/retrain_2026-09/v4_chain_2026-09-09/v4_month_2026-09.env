# v4_month_2026-09.env — the MONTH CONFIGURATION CONTRACT of the v4 chain, September 2026 values = the paths the 09-09 v4 chain actually used
# (positive control: chain_v4_monthly.sh under this file reproduces the September locators; receipts written under $R/v4_gates).
# Read by chain_lib.sh load_month_env: KEY=value lines only (no ; & | ` $( ), later keys may reference earlier ones ($R/...); EVERY key of
# V4_MONTH_KEYS must be present and non-empty or the loader dies (rc 4). Schema: docs/DESIGN_v4_monthly_chain_2026-09-12.md §3.
# ── identity ──
V4_MONTH=2026-09
R=/workspace/review_scratch
PY=/workspace/venv/bin/python
# ── 5m cache + panels + patches (inputs of the data chain) ──
CACHE=/workspace/data/dlnative_5m_wide829_f16_holefix2.npz
PANEL_SPLICE=/workspace/data/wide_panel_4h_v3splice.npz
PANEL_KING=/workspace/data/wide_panel_4h_v2ext.npz
RAW_PATCH=$R/raw_patch.npz
HOLE_CELLS=$R/holefix2_cells.npz
# ── DL data dirs (targets / fea82 / fea89 / legs / mwf / models) and king features ──
DLW_RAW=/workspace/dlw_v4raw
DLW_CLIP=/workspace/dlw_hf3
F8=/workspace/f8_v4
KING_FEA=/workspace/data/wide_fea_v4.npy
KING_META=/workspace/data/wide_fea_v4_meta.npz
# ── fold months (complete calendar months on the targets axis; v4_months.py refuses a month the data cannot label), seeds, mwf tree ──
MONTHS_ALL=202501,202502,202503,202504,202505,202506,202507,202508,202509,202510,202511,202512,202601,202602,202603,202604,202605,202606,202607,202608
SEEDS=42,2027
MWF_ROOT=mwf_v4b
# ── king export (env verbatim RUNBOOK §0★ step 5) ──
BUNDLE_OUT=/workspace/shadow_bundle_v4
BUNDLE_TAR=/workspace/shadow_bundle_v4.tar.gz
# the label the September export WROTE (it was a source constant then: a v4 bundle labelled v3 — review R4); October must be v4_2026-10
BUNDLE_GENERATION=v3_2026-09
BUNDLE_BASE=/workspace/slow_scorer_v4base.json
EXPORT_PANEL=/workspace/data/wide_panel_4h_v3splice.npz
EMA_STATE_JSON=/workspace/fund_state_canoncont.json
LIVE_PINS=/workspace/live_pins.json
FUND_AUG=/workspace/fund_aug.json.gz
FUNDING_DIR=/workspace/wide_multisrc/funding
# ── legs (AMENDMENT 5 policy: in-service training legs rows verbatim + new anchors same formula) ──
LEGS_OLD=/workspace/f8_ext/data/f10v2_legs.npz
LEGS_PANEL=/workspace/data/wide_panel_4h_v3splice.npz
# ── in-service yearly generation (merge splice source pre-2025; A0 preds) ──
DLW_EXT=/workspace/dlw_ext
F8_EXT=/workspace/f8_ext
# ── book layer: dev tree (masks, calib, run_arm.sh, w10_health.py, A0 baseline books), king SLOW files, the arm judged/exported ──
HC=$R/health_check
KING_DIR=$R/king_v4
EXPORT_ARM=A1
SIGNAL_RECEIPT=/workspace/uplift_2026-09-11/infra2/GATE_signal_parity.json
# ── external builders / base trainer (outside the device dir; preflight pins their sha) ──
BUILDER_FEA82=/workspace/pod_dlw_features_ext.py
BUILDER_FEA89=/workspace/pod_f8_build_ext.py
BASE_TRAINER=/workspace/pod_f10_train_ext.py
# ── data gates (basenames in the device dir; their sha must be APPROVED in ELIGIBILITY_CONTRACT.json — the September gates encode September's comparison pairs) ──
GATE_STEP1=v4_gate_step1.py
GATE_STEP2=v4_gate_step2.py
# ── previous generation (build_dev_v4: SLOW_v3_on_v4axis; STEP2 reference meta) and the raw-accounting reference meta of the dev tree ──
PREV_BUNDLE=/workspace/shadow_bundle_v3
PREV_META=/workspace/data/wide_fea_v2ext_meta.npz
REF_META=$R/refute_C6_2/altrun/meta_newprod_raw.npz
# ── previous-month REFERENCE builds of the month-generic data gates (W7 2026-09-12, PREREG_v4_gates_monthly_2026-09-12 §2): September's reference is the holefix
#    generation the frozen gates compare against (hf2 / f8_hf2 / v2ext_clamp / v2ext) — exactly the values exported for the pod2 positive control (w7_gates/pod2_root/w7_commands.txt) ──
PREV_DLW_CLIP=/workspace/dlw_hf2
PREV_F8=/workspace/f8_hf2
PREV_KING_FEA=/workspace/data/wide_fea_v2ext_clamp.npy
PREV_KING_FEA_UNCLAMPED=/workspace/data/wide_fea_v2ext.npy
# builder identity the STEP2 gate binds a NONE (no unclamped reference) month to: sha256 of pod_fea_ext_clamp.py as verified on September data by the frozen
# STEP2 gate (receipts/monthly_chain_2026-09-12/pod2_root/preflight.json device_sha256; PREREG_v4_gates_monthly AMENDMENT 1 / researcher B-R4)
PREV_CLAMP_BUILDER_SHA256=b9f9c72816241715fc4b767950420e74f50adbbbcfc4ea77b362407ab5efa4ac
