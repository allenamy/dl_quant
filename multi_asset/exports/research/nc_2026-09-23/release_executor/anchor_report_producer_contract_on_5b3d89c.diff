+PRODUCER_DAEMONS = {"prod": "shadow_loop_v3.py run", "sidecar": "sidecar_daemon.sh", "combo": "combo_live_daemon.sh"}
+DAEMON_CONTRACTS = {"legacy": (("prod", "sidecar", "combo"), ()), "nc_v1": (("prod", "combo"), ("sidecar",))}
