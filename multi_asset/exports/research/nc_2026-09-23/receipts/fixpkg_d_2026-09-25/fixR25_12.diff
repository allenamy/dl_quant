@@ -0,0 +1,174 @@
+"""Drift gate between this repo's vendored live modules and their research-repo upstream.
+
+★ WHY A GATE AND NOT A RULE
+The migration is deliberately two-phase. The server's shadow (and its running 5-day acceptance
+clock) still executes the research-repo copies; killing those mid-clock to enforce "one copy"
+would trade a real, running verification for a tidiness principle. So for the transition window
+there ARE two copies — and two copies drift. That is the disease; this file is the containment:
+the duplication is allowed only while it is MACHINE-CHECKED. When the local loop takes over and
+the research-repo copies retire, this gate retires with them.
+
+Exit 0: vendored == upstream (or upstream absent: fine once retired).
+Exit 1: drift — someone edited one side. Re-vendor deliberately or revert; never ignore.
+"""
+import hashlib
+import os
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+MANIFEST = os.path.join(HERE, "UPSTREAM_MANIFEST.sha256")
+UPSTREAM = "/Users/haosiyu/Desktop/quant_research/multi_asset/engine/live"
+# ★ B-5 (lead ruling 2026-09-25; DESIGN_executor_durable_state_2026-09-25): UPSTREAM lives in the iCloud-synced research
+#   repo, whose files are routinely evicted to placeholders ("dataless"). Reading one blocks until iCloud delivers it —
+#   measured 2026-09-25: a baseline battery sat ~17 minutes in this guard on production_state_guard.py. A deploy or rollback
+#   battery must not hang on that, so an upstream file is (1) checked for the placeholder flag before any read, and (2) read
+#   in a child process with a timeout. Either case is a NAMED RED that prints the commands to materialise the file.
+SF_DATALESS = 0x40000000          # sys/stat.h: file is a placeholder whose data is not local
+READ_TIMEOUT_S = 10.0
+
+
+def _is_placeholder(p):
+    return bool(getattr(os.stat(p), "st_flags", 0) & SF_DATALESS)
+
+
+def _upstream_sha(p, timeout=None):
+    """(sha, None) or (None, reason). Never blocks longer than `timeout` seconds."""
+    if _is_placeholder(p):
+        return None, "iCloud placeholder (SF_DATALESS)"
+    try:
+        r = subprocess.run([sys.executable, "-c",
+                            "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())", p],
+                           capture_output=True, text=True, timeout=READ_TIMEOUT_S if timeout is None else timeout)
+    except subprocess.TimeoutExpired:
+        return None, f"read timed out after {READ_TIMEOUT_S if timeout is None else timeout:.0f} s"
+    if r.returncode != 0 or len(r.stdout.strip()) != 64:
+        return None, f"read failed (rc {r.returncode}): {r.stderr.strip()[:160]}"
+    return r.stdout.strip(), None
+
+
+def sha(p):
+    return hashlib.sha256(open(p, "rb").read()).hexdigest()
+
+
+# ★★ THE A-SET IS DECLARED HERE, AND THE MANIFEST MUST COVER IT.
+# The manifest alone cannot notice that it has been emptied — it IS the thing that was emptied.
+# A guard whose only input is the file that was deleted has no way to be surprised, which is why
+# `no drift across 0 vendored modules` printed exit 0 for two days. So the SET is declared in
+# code, the manifest supplies the fingerprints, and the guard compares the two.
+# `direction` is a FIELD because a mismatch means opposite things for the two groups:
+#   research->production : our vendored copy fell behind the research original
+#   production->research : the research side fell behind OUR file (this repo holds the frozen
+#                          implementation; "fixing" our copy would overwrite the signed bytes)
+A_SET = {
+    "regime_classifier.py":       "research->production",
+    "deliver_report.py":          "research->production",
+    "production_state_guard.py":  "research->production",
+    "factor_version_registry.py": "research->production",
+    "pilot_metrics.py":           "production->research",
+    # B-2 (2026-09-25): the durable writer the three research->production modules above now import; it originates HERE
+    # (live/durable_io.py) and is copied to the research repo beside them, so its direction is production->research.
+    "durable_io.py":              "production->research",
+}
+
+
+def main(manifest=None, upstream=None, read_timeout=None):
+    """`manifest` overrides the path — so the guard can be exercised WITHOUT the subject being the
+    production file.
+
+    ★★ WHY THIS IS A PARAMETER AND NOT A TEST-LOCAL SWAP. `tests_drift_gate` had to prove that an
+    EMPTY manifest exits non-zero, and with the path hardcoded the only way to do that was to
+    overwrite `ops/UPSTREAM_MANIFEST.sha256` in place and restore it in a `finally`. That is a
+    correct-looking pattern with one hole: `finally` does not run under SIGKILL, a power loss, or
+    a `kill -9` on a hung suite. So the test whose entire subject is "the fingerprint table was
+    emptied and nobody noticed" could, on an unlucky interruption, LEAVE THE FINGERPRINT TABLE
+    EMPTIED. The guard's own red condition was reachable by running its test.
+    ⇒ The root cause is not the missing exception-safety, it is that the subject was the
+      production artifact. A guard is exercised against a one-off copy; the production file is
+      what it PROTECTS, never what it is tried on.
+    """
+    manifest = manifest or MANIFEST
+    lines = [l for l in open(manifest).read().splitlines() if l.strip()
+             and not l.lstrip().startswith("#")]
+    # ★★ SELF-CHECK FIRST, BEFORE ANY COMPARISON. An empty or short manifest is not "nothing to
+    # check" — it is the guard reporting that it has been disarmed, and that must be LOUD.
+    if not lines:
+        print("MANIFEST IS EMPTY — the drift gate is disarmed. This is a RED, not a pass: an "
+              "empty table cannot detect anything, and emptying it is indistinguishable from "
+              "regenerating it in the observable that used to define success (measured "
+              "2026-07-25: 19 deletions, 0 insertions, two days of `across 0 modules` exit 0).")
+        return 1
+    covered = set()
+    for l in lines:
+        parts = l.split()
+        if len(parts) >= 2:
+            covered.add(parts[1])
+    missing = sorted(set(A_SET) - covered)
+    if missing:
+        print(f"MANIFEST DOES NOT COVER THE DECLARED A-SET — missing {missing}. A partially "
+              f"emptied table is the same failure as an empty one, one entry at a time.")
+        return 1
+    UP = UPSTREAM if upstream is None else upstream
+    if not os.path.isdir(UP):
+        print(f"upstream absent — research-repo copies retired; gate passes vacuously BY DESIGN "
+              f"(declared A-set: {len(A_SET)} files)")
+        return 0
+    drift = []
+    unreadable = []
+    for l in lines:
+        parts = l.split()
+        h, name = parts[0], parts[1]
+        local_p = os.path.join(REPO, "live", name)
+        up_p = os.path.join(UP, name)
+        if not os.path.exists(up_p):
+            continue                       # retired upstream file: local copy is now the source
+        if not os.path.exists(local_p):
+            drift.append((name, "LOCAL COPY MISSING"))
+            continue
+        uh, why = _upstream_sha(up_p, read_timeout)
+        if uh is None:
+            unreadable.append((up_p, why))
+            continue
+        lh = sha(local_p)
+        direction = A_SET.get(name, "research->production")
+        if lh != uh:
+            # ★ worded from the direction field, because the responsible side differs
+            drift.append((name, "our vendored copy fell behind the research original"
+                                if direction == "research->production" else
+                                "the RESEARCH side fell behind this repo's file — do NOT "
+                                "'fix' the local copy, it is the upstream for this file"))
+        if uh != h:
+            drift.append((name, "upstream moved since vendoring"))
+    if unreadable:
+        print(f"UPSTREAM_UNREADABLE (iCloud placeholder) — {len(unreadable)} upstream file(s) could not be read without blocking; "
+              f"this is a RED, not a pass (nothing was compared for them). Materialise, then re-run the battery:")
+        for p, why in unreadable:
+            print(f"  {p}: {why}")
+            print(f"    brctl download \"{p}\"")
+            print(f"    cat \"{p}\" > /dev/null")
+    if drift:
+        print("DRIFT DETECTED — the two copies have diverged. Re-vendor deliberately or revert:")
+        for name, why in sorted(set(drift)):
+            print(f"  {name} [{A_SET.get(name, '?')}]: {why}")
+        return 1
+    if unreadable:
+        return 1
+    print(f"no drift across {len(lines)} vendored modules "
+          f"(declared A-set {len(A_SET)}, all covered)")
+    return 0
+
+
+if __name__ == "__main__":
+    # ★ argv, not an env var: an override that changes what a SAFETY GUARD is judging must be
+    # visible in the process line of whoever ran it. An exported variable is inherited silently by
+    # every descendant, which is the shape that would let a whole acceptance run be graded against
+    # a fixture without anything saying so.
+    _m = _u = _t = None
+    _a = sys.argv[1:]
+    while _a:
+        if _a[0] == "--manifest" and len(_a) > 1: _m = _a[1]; _a = _a[2:]
+        elif _a[0] == "--upstream" and len(_a) > 1: _u = _a[1]; _a = _a[2:]            # B-5: fixtures only (visible in the process line)
+        elif _a[0] == "--read-timeout" and len(_a) > 1: _t = float(_a[1]); _a = _a[2:]  # B-5: fixtures only
+        else: print(f"unknown argument {_a[0]!r}"); sys.exit(2)
+    sys.exit(main(_m, _u, _t))
