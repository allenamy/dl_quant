+"""DUST POSITIONS COUNT AS FLAT IN THE WITHHOLD — pop before the reshape, not clamp after it (fix package D, lead-approved design
+quant_research docs/DESIGN_dust_pop_before_reshape_2026-09-25.md, 0875fbf24).
+
+*** MOCK ONLY: dicts and a stub planner. No venue, no credentials, no state written. ***
+
+★ THE DEFECT (measured on the live ledger 2026-09-16 .. 09-25): `withhold_pop` popped an untradable name only if its held notional was
+EXACTLY 0.0. A residual below the venue's min notional (PRLUSDT −1 contract = −0.12 USDT; ENAUSDT −1.8 USDT in stop cooldown) counted as
+"held", went to the clamp AFTER the reshape, and its reshape target was not re-absorbed — while the planner can never close it
+(binance_executor.plan: |delta| < min_notional ⇒ skipped_min_notional, exits included). With the producer still shorting the stop-cooldown
+trio BCH / ENA / ZAMA the book sat +2,464 USDT net long after the clamp at 2026-09-25 08Z (the executor's own net_shift_usdt), +1.06 % of NAV
+on average over 54 anchors. The research engine has the same mechanism with the opposite sign (cooldown names targeted long).
+★ THE RULE: an untradable name whose |held notional| is below ITS floor (`floors_usdt`, the executor's min_notional) is popped like an
+unheld one. At / above the floor ⇒ clamp as before. No floors ⇒ the exact-zero rule, unchanged.
+Checks (the RED CAPABILITY is shown by running this file on the unfixed tree: D1, D5, D6, D7 fail there; D0, D2, D3, D4 pass on both —
+D4 is a safety property of the planner, not the defect's detector):
+  D0 fixture fidelity: the unfixed rule applied to the recorded 08Z inputs reproduces the executor's own record (net_before, net_after,
+     clamped names, book_net_usdt) — only then do the fixed-rule numbers below mean anything
+  D1 a held residual below its floor is POPPED before the reshape; the clamp still gives it its flatten row at exactly 0.0 (no orphan)
+  D2 a held position at / above its floor is still CLAMPED (pinned at its position)
+  D3 floors absent ⇒ exact-zero rule (a sub-floor held name is clamped as before)
+  D4 the dust name's plan row is skipped_min_notional with no qty and no order-bearing row exists for it ⇒ no opening, no closing
+     attempt: the residual stays where it is — asserted on the plan rows and on the order-bearing rows (qty)
+  D5 the reshape of a book with dust names is neutral and the clamp net shift excludes them
+  D6 recorded 08Z inputs: net after the clamp +2,464 (unfixed) → |net| < 50 USDT (fixed); the popped set = the sub-floor held names
+  D7 the report names the dust-popped names separately (n_dust_popped / dust_popped_names), so the ledger shows why they left the book
+Exit 0 = all pass."""
+import copy, json, os, sys, types
+
+_HERE = os.path.dirname(os.path.abspath(__file__)); _REPO = os.path.dirname(_HERE)
+sys.path.insert(0, _HERE)
+for _d in ("scheduler", "signal", "ops"):
+    sys.path.insert(0, os.path.join(_REPO, _d))
+import anchor_loop as AL               # noqa: E402
+import binance_executor as EX          # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, extra=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(extra)[:400]) if extra != '' else ''}")
+    if not cond:
+        FAILS.append(name)
+
+
+G = 1000.0
+BOOK = {"A": 250.0, "B": 150.0, "C": 100.0, "D": -200.0, "E": -180.0, "Z": -120.0}      # neutral, gross G
+FLOORS = {s: 5.0 for s in BOOK}
+
+
+def seam(held, untradable=("Z",), floors=FLOORS):
+    t = dict(BOOK)
+    clamp, rs = AL.apply_withhold_and_reshape(t, held, list(untradable), G, floors_usdt=floors,
+                                              floors_source="test" if floors is not None else "not supplied")
+    return t, clamp, rs
+
+
+print("[D1] sub-floor held residual ⇒ popped")
+t, clamp, rs = seam({"Z": -0.12})
+check("★★★ D1 a held residual below its floor is POPPED before the reshape (listed as popped and dust-popped), so the reshape re-absorbs it",
+      "Z" in (clamp.get("popped") or []) and "Z" in ((rs or {}).get("dust_popped_names") or []),
+      {"popped": clamp.get("popped"), "dust_popped": (rs or {}).get("dust_popped_names")})
+check("★★★ D1 ...the clamp still gives the held residual its FLATTEN row at exactly 0.0 (flatten_only) — never an orphan (the 2026-08-01 "
+      "lesson in clamp_held_untradable) — and that row moves the net by 0: the book after it is neutral",
+      t.get("Z") == 0.0 and "Z" in (clamp.get("flatten_only") or []) and abs(sum(t.values())) < 1e-9
+      and abs(float(((rs or {}).get("clamped_after_reshape") or {}).get("net_shift_usdt") or 0.0)) < 1e-9,
+      {"Z": t.get("Z"), "flatten_only": clamp.get("flatten_only"), "net": sum(t.values()), "shift": ((rs or {}).get("clamped_after_reshape") or {}).get("net_shift_usdt")})
+
+print("[D2] held at / above the floor ⇒ clamped as before")
+t2, clamp2, rs2 = seam({"Z": -60.0})
+check("★★★ D2 a held position above its floor is still CLAMPED (not popped; pinned)",
+      "Z" in t2 and "Z" not in (clamp2.get("popped") or []) and "Z" in ((rs2 or {}).get("clamped_after_reshape") or {}).get("names", []),
+      {"popped": clamp2.get("popped"), "clamped": ((rs2 or {}).get("clamped_after_reshape") or {}).get("names"), "Z": t2.get("Z")})
+t2b, clamp2b, rs2b = seam({"Z": -5.0})
+check("★★ D2 exactly AT the floor counts as held (clamped) — the rule is strictly below", "Z" in t2b and "Z" not in (clamp2b.get("popped") or []),
+      {"popped": clamp2b.get("popped")})
+
+print("[D3] floors absent ⇒ exact-zero rule")
+t3, clamp3, rs3 = seam({"Z": -0.12}, floors=None)
+check("★★★ D3 without floors a sub-floor held name is CLAMPED (today's rule, no dust judgement without a floor)",
+      "Z" in t3 and "Z" not in (clamp3.get("popped") or []), {"popped": clamp3.get("popped"), "Z": t3.get("Z")})
+t3b, clamp3b, _ = seam({"Z": 0.0}, floors=None)
+check("★★ D3 an exactly-zero held name is popped with or without floors (unchanged)", "Z" not in t3b and "Z" in (clamp3b.get("popped") or []))
+
+print("[D4] a popped name gets no plan row and no order")
+F = types.SimpleNamespace(f={s: {"min_notional": 5.0} for s in list(BOOK) + ["ZZDUSTUSDT"]}, round_qty=lambda s, q: float(round(q)))
+STUB = types.SimpleNamespace(band_bps=0, filters=F)
+t4, clamp4, rs4 = seam({"Z": -0.12})
+mids = {s: 1.0 for s in list(BOOK)}
+cur = {"Z": -0.12}
+plans = EX.RebalanceExecutor.plan(STUB, t4, cur, mids, reduce_only_syms=set(clamp4.get("reduced") or []) | set(clamp4.get("flatten_only") or []),
+                                  held_qty={"Z": -0.12})
+_z = [p for p in plans if p["symbol"] == "Z"]
+check("★★★ D4 the dust name's plan row is a SKIP (skipped_min_notional, no qty): no opening and no closing attempt — the residual stays",
+      len(_z) == 1 and _z[0].get("skip") == "skipped_min_notional" and not _z[0].get("qty"), _z)
+check("★★★ D4 ...and NO order-bearing row (qty) for it anywhere in the plan; every order-bearing row is a non-dust name",
+      not any(p["symbol"] == "Z" and p.get("qty") for p in plans), [(p["symbol"], p.get("qty"), p.get("skip")) for p in plans])
+
+print("[D5] reshape neutral with dust names; clamp shift excludes them")
+t5, clamp5, rs5 = seam({"Z": -0.12, "E": -0.3}, untradable=("Z", "E"))
+ca5 = (rs5 or {}).get("clamped_after_reshape") or {}
+check("★★★ D5 two sub-floor held untradables: both dust-popped before the reshape, back at exactly 0.0, the book is neutral, the clamp net shift is 0",
+      sorted((rs5 or {}).get("dust_popped_names") or []) == ["E", "Z"] and t5.get("Z") == 0.0 and t5.get("E") == 0.0
+      and abs(sum(t5.values())) < 1e-9 and abs(float(ca5.get("net_shift_usdt") or 0.0)) < 1e-9,
+      {"net": sum(t5.values()), "shift": ca5.get("net_shift_usdt"), "popped": clamp5.get("popped")})
+
+print("[D0 / D6] the recorded 2026-09-25 08Z anchor")
+FX_ = json.load(open(os.path.join(_HERE, "tests_fixtures", "dust_pop", "reshape_A1790324640.json")))
+rec = FX_["recorded"]
+
+
+def replay(floors):
+    t = dict(FX_["target"])
+    return (t,) + AL.apply_withhold_and_reshape(t, dict(FX_["held_full"]), list(FX_["untradable"]), FX_["sizing_gross"], floors_usdt=floors,
+                                                floors_source="fixture", force_flat=list(FX_["force_flat"]))
+
+
+t0, c0, r0 = replay(None)          # floors absent ⇒ today's rule on every tree (D3) ⇒ must reproduce the executor's own record
+ca0 = r0.get("clamped_after_reshape") or {}
+check("★★★ D0 fixture fidelity: today's rule on the recorded inputs reproduces the executor's record (net_before, net_after, clamped names, "
+      "book_net_usdt)",
+      abs(r0["net_before"] - rec["net_before"]) < 1e-6 and abs(r0["net_after"] - rec["net_after"]) < 1e-6
+      and sorted(ca0.get("names") or []) == sorted(rec["clamped_names"]) and abs(float(ca0["book_net_usdt"]) - rec["book_net_usdt"]) < 0.01,
+      # 0.01 USDT: the fixture's held values are readback qty × mid_at_anchor; the executor pinned its own state notional (measured |Δ| 4.5e-5)
+      {"net_before": (r0["net_before"], rec["net_before"]), "book_net": (ca0.get("book_net_usdt"), rec["book_net_usdt"]), "clamped": ca0.get("names")})
+t6, c6, r6 = replay(FX_["floors"])
+ca6 = r6.get("clamped_after_reshape") or {}
+dust = sorted(s for s in rec["clamped_names"] if abs(FX_["held_full"].get(s, 0.0)) < FX_["floors"].get(s, 0.0))
+check("★★★ D6 with the floors the book after the clamp is within 50 USDT of neutral (recorded +2,464)", abs(float(ca6.get("book_net_usdt") or 0.0)) < 50.0,
+      {"book_net_fixed": ca6.get("book_net_usdt"), "recorded": rec["book_net_usdt"]})
+check("★★ D6 ...exactly the sub-floor held names were dust-popped, each is back at exactly 0.0 (flatten), and the names above their floor "
+      "keep today's clamp disposition",
+      sorted(r6.get("dust_popped_names") or []) == dust and all(t6.get(s) == 0.0 for s in dust)
+      and all(t6.get(s) == t0.get(s) for s in rec["clamped_names"] if s not in dust),
+      {"dust": dust, "dust_popped": r6.get("dust_popped_names"), "kept": {s: (t6.get(s), t0.get(s)) for s in rec["clamped_names"] if s not in dust}})
+
+print("[D7] the report names the dust-popped names")
+check("★★ D7 the reshape report lists the dust-popped names separately", sorted((r6 or {}).get("dust_popped_names") or []) == dust
+      and int((r6 or {}).get("n_dust_popped", -1)) == len(dust), {"dust_popped_names": (r6 or {}).get("dust_popped_names"), "expected": dust})
+
+print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed")
+print("ALL PASS" if not FAILS else f"FAILURES: {FAILS}")
+sys.exit(0 if not FAILS else 1)
