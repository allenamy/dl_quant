)\'"\'"\',\\012              \'"\'"\'out["king_itself"] = med_wcorr(np.nan_to_num(leg["KZ"][use], nan=0.0).astype(np.float64))\\n\'"\'"\'\\012              \'"\'"\'f10_live = np.load(f"{W}/work/f10_s42/F10_OOF.npz")["P"][use].astype(np.float64)\\n\'"\'"\'\\012              \'"\'"\'out["live_F10_s42"] = med_wcorr(f10_live)   # the book the recorded 0.43 (pre2026 MEAN) refers to\'"\'"\')\\012open(p,"w").write(s)\\012print("pre-2026 variant written; reports median AND mean, adds the live F10 book")\\012PY\\012L=$(md5 -q /tmp/null_wcorr_pre2026.py) && scp -q /tmp/null_wcorr_pre2026.py pod2:/workspace/dlarch_2026-09-24/null_wcorr_pre2026.py && R=$(ssh pod2 "md5sum /workspace/dlarch_2026-09-24/null_wcorr_pre2026.py | cut -d\'"\'"\' \'"\'"\' -f1") && [ "$L" = "$R" ] && echo "md5 MATCH" && ssh pod2 "cd /workspace/dlarch_2026-09-24 && setsid nohup env -i PATH=/usr/bin:/bin HOME=/root LC_CTYPE=C /workspace/venv/bin/python -B null_wcorr_pre2026.py out_pg2026/T2_RESIDUAL_PREDS.npz > logs_floor_pre2026.log 2>&1 < /dev/null & sleep 10; echo launched"\' && pwd -P >| /Users/haosiyu/cc_tmp/claude-52a0-cwd', '40109 /bin/zsh -c source /Users/haosiyu/.claude/shell-snapshots/snapshot-zsh-1790128091534-lmct5o.sh 2>/dev/null || true && export CODEX_COMPANION_SESSION_ID=\'b9646a9e-31a1-4eb3-a08b-e8ea13fdceb0\'\\012export CLAUDE_PLUGIN_DATA=\'/Users/haosiyu/.claude/plugins/data/codex-openai-codex\'\\012export CODEX_COMPANION_SESSION_ID=\'958cbe67-8307-4b0e-92af-d682af158161\'\\012export CLAUDE_PLUGIN_DATA=\'/Users/haosiyu/.claude/plugins/data/codex-openai-codex\'\\012export CODEX_COMPANION_SESSION_ID=\'b9646a9e-31a1-4eb3-a08b-e8ea13fdceb0\'\\012export CLAUDE_PLUGIN_DATA=\'/Users/haosiyu/.claude/plugins/data/codex-openai-codex\'\\012export CODEX_COMPANION_SESSION_ID=\'b9646a9e-31a1-4eb3-a08b-e8ea13fdceb0\'\\012export CLAUDE_PLUGIN_DATA=\'/Users/haosiyu/.claude/plugins/data/codex-openai-codex\'\\012export CODEX_COMPANION_SESSION_ID=\'b9646a9e-31a1-4eb3-a08b-e8ea13fdceb0\'\\012export CLAUDE_PL