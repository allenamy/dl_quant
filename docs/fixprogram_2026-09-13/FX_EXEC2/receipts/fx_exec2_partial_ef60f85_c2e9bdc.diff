@@ -192,3 +192,201 @@ def coverage_note(b: Dict[str, Any]) -> str:
     if b.get("bps_measured") is None:
         parts.append("bps UNMEASURED (not 0)")
     return "; ".join(parts)
+
+
+# ══ protective-flatten legs: priced against their OWN arrival mid, fee from the fills ledger ═════
+# ★★★ LED-02 (FX-EXEC2, 2026-09-13; AUDIT_EXEC 842bbffa; fact table
+#     docs/fixprogram_2026-09-13/FX_EXEC2/FACT_TABLE_EXEC2.md §LED-02 in the research repo).
+#     `partition` above prices a fill against `mid_at_anchor`, the DECISION anchor of a rebalance.
+#     A protective flatten has no decision anchor — the ladder writes `mid_at_anchor=None` on
+#     purpose (watchdog._write_flatten_rows) — so every flatten row lands in `unpriced`, and it stays
+#     there forever: the 09-12 12:47Z batch read 255/255 unpriced even after E1 wrote 3,656 fills rows
+#     carrying every commission. Measured on the live ledger copy (14:27Z): all 10 FLATTEN batches
+#     carry `avg_fill_px` AND `mid_at_submit` on every filled row (the mid of ONE batched bookTicker
+#     read that flatten_all takes before its submit loop — the exit's arrival price), and on 09-09 /
+#     09-12 the fills rows close EXACTLY to the order rows' notional (243/243, 255/255 legs).
+#     ⇒ The exit IS priceable, against its own arrival mid, and its fee IS recorded — on the fills
+#       rows, not on the order rows (orders stay append-only with fee_paid None).
+# ★★ A DIFFERENT CALIBER, SO A DIFFERENT FUNCTION AND DIFFERENT KEYS. Exit cost vs the exit's arrival
+#    mid is not rebalance cost vs the anchor mid (it omits the move between the trip evaluation and the
+#    bookTicker read, and it is a crisis cost). Nothing here is ever pooled with `bucket_fills`.
+# ★★ THE FEE JOIN IS (rebalance_id, symbol), NEVER attempt_idx. The fills rows written by the B26b
+#    backfill carry `attempt_idx 2` for every non-maker leg (venue_fills row builder) while the flatten's
+#    order rows carry the ladder attempt (1) — 255/255 pairs on 09-12. A leg whose symbol has more than
+#    one filled order row in the batch cannot be joined exactly and is fee-unknown, named.
+# ★ Fills rows are collapsed on (symbol, trade_id), last row wins by position (the table's supersede
+#   contract, pilot_log.SCHEMA["fills"]); a joined row without a trade_id makes the leg fee-unknown,
+#   because it cannot be de-duplicated. A commission in any asset other than USDT is unconverted ⇒
+#   fee-unknown (same rule as `known_fee`); Σ|fill_notional| must equal the order row's |filled_notional|
+#   within max(0.01 USDT, 1e-6 relative), otherwise the fills are not the whole leg ⇒ fee-unknown.
+FLATTEN_PRICE_REFERENCE = "mid_at_submit"
+FLATTEN_NOTIONAL_TOL_ABS = 0.01
+FLATTEN_NOTIONAL_TOL_REL = 1e-6
+FLATTEN_MEASURED_OVER = (
+    "MEASURED protective-flatten legs only — a leg with a usable fill price (finite positive "
+    "avg_fill_px) AND its own arrival mid (mid_at_submit: the batched bookTicker read taken before the "
+    "flatten's submit loop) AND a known fee (the order row's own known fee, else the leg's fills rows "
+    "joined on (rebalance_id, symbol), collapsed on (symbol, trade_id), every commission present and "
+    "in USDT, and Σ|fill_notional| equal to the order row's |filled_notional|). bps is over MEASURED "
+    "notional only and None when nothing was measured. This is an EXIT cost against the exit's own "
+    "arrival price — not the rebalance legs' anchor-mid caliber; never pool the two.")
+
+
+def _fin(x: Any) -> Optional[float]:
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and v not in _INF) else None
+
+
+def _flatten_leg_fills(fills_rows: List[Dict[str, Any]], rids) -> Dict[Tuple[Any, Any], Dict[str, Any]]:
+    """{(rebalance_id, symbol): {"rows": [...collapsed...], "n_no_trade_id": k}} for protective_flatten fills."""
+    last: Dict[Tuple[Any, Any, Any], int] = {}
+    kept = []
+    for f in fills_rows or []:
+        if f.get("order_type") != "protective_flatten" or f.get("rebalance_id") not in rids:
+            continue
+        kept.append(f)
+    for i, f in enumerate(kept):
+        if f.get("trade_id") is not None:
+            last[(f.get("rebalance_id"), f.get("symbol"), f.get("trade_id"))] = i
+    out: Dict[Tuple[Any, Any], Dict[str, Any]] = {}
+    for i, f in enumerate(kept):
+        k = (f.get("rebalance_id"), f.get("symbol"))
+        slot = out.setdefault(k, {"rows": [], "n_no_trade_id": 0})
+        if f.get("trade_id") is None:
+            slot["n_no_trade_id"] += 1
+        elif last.get((f.get("rebalance_id"), f.get("symbol"), f.get("trade_id"))) == i:
+            slot["rows"].append(f)
+    return out
+
+
+def _flatten_fee(o: Dict[str, Any], fa: float, legs, n_filled_rows_by_leg) -> Tuple[Optional[float], Optional[str], str]:
+    """(fee_usdt, reason_if_unknown, source) for one flatten leg with a known non-zero fill `fa`."""
+    own = known_fee(o)
+    if own is not None:
+        return own, None, "order_row"
+    if o.get("fee_paid") is not None:
+        return None, "order_row_fee_not_known_usdt (raw mixed-asset fee, no conversion)", "order_row"
+    k = (o.get("rebalance_id"), o.get("symbol"))
+    if n_filled_rows_by_leg.get(k, 0) > 1:
+        return None, "ambiguous_join (more than one filled order row for this symbol in the batch)", "fills_rows"
+    slot = legs.get(k)
+    if not slot or (not slot["rows"] and not slot["n_no_trade_id"]):
+        return None, "no_fills_rows (no execution of this leg in the fills ledger)", "fills_rows"
+    if slot["n_no_trade_id"]:
+        return None, "fills_row_without_trade_id (cannot be de-duplicated)", "fills_rows"
+    notl, fee = 0.0, 0.0
+    for f in slot["rows"]:
+        c, n = _fin(f.get("commission")), _fin(f.get("fill_notional"))
+        if c is None:
+            return None, "commission_missing (a joined fills row has no finite commission)", "fills_rows"
+        if str(f.get("commission_asset") or "") != "USDT":
+            return None, (f"commission_non_usdt_unconverted ({f.get('commission_asset')!r})"), "fills_rows"
+        if n is None:
+            return None, "fill_notional_missing (a joined fills row has no finite notional)", "fills_rows"
+        notl += abs(n)
+        fee += c
+    if abs(notl - fa) > max(FLATTEN_NOTIONAL_TOL_ABS, FLATTEN_NOTIONAL_TOL_REL * fa):
+        return None, (f"fills_do_not_close (Σ|fill_notional| {notl:.6f} vs order |filled_notional| "
+                      f"{fa:.6f})"), "fills_rows"
+    return fee, None, "fills_rows"
+
+
+def flatten_cost(order_rows: List[Dict[str, Any]], fills_rows: List[Dict[str, Any]]) -> Dict[str, Any]:
+    """Protective-flatten exit cost over `order_rows` (only `protective_flatten` rows are read), priced
+    against each leg's own `mid_at_submit`, fees from the order row or the fills ledger. Pure; JSON-safe.
+
+    Every leg that is not MEASURED is counted in exactly one bucket and its reason is counted by name;
+    None is never folded to 0. bps are over measured notional only, None when nothing was measured.
+    """
+    rows = [o for o in (order_rows or []) if o.get("order_type") == "protective_flatten"]
+    rids = {o.get("rebalance_id") for o in rows}
+    legs = _flatten_leg_fills(fills_rows, rids)
+    n_filled_rows_by_leg: Dict[Tuple[Any, Any], int] = {}
+    for o in rows:
+        fa = filled_abs(o)
+        if fa is not None and fa > 0:
+            k = (o.get("rebalance_id"), o.get("symbol"))
+            n_filled_rows_by_leg[k] = n_filled_rows_by_leg.get(k, 0) + 1
+    n_unknown = 0
+    measured, fee_unknown, unpriced = [], [], []
+    reasons: Dict[str, int] = {}
+    fee_source: Dict[str, int] = {}
+    fee_m = adverse = abs_slip = 0.0
+
+    def _why(r: str) -> None:
+        key = r.split(" (", 1)[0]
+        reasons[key] = reasons.get(key, 0) + 1
+
+    for o in rows:
+        fa = filled_abs(o)
+        if fa is None:
+            n_unknown += 1
+            _why("unknown_fill (filled_notional not a finite number)")
+            continue
+        if fa <= 0:
+            continue
+        px, mid = usable_px(o.get("avg_fill_px")), usable_px(o.get(FLATTEN_PRICE_REFERENCE))
+        if px is None or mid is None:
+            unpriced.append(fa)
+            _why("no_avg_fill_px" if px is None else "no_mid_at_submit")
+            continue
+        fee, why, src = _flatten_fee(o, fa, legs, n_filled_rows_by_leg)
+        if fee is None:
+            fee_unknown.append(fa)
+            _why(why)
+            continue
+        sgn = 1.0 if float(o["filled_notional"]) > 0 else -1.0
+        dev = (px - mid) / mid
+        measured.append(fa)
+        fee_source[src] = fee_source.get(src, 0) + 1
+        fee_m += fee
+        adverse += sgn * dev * fa
+        abs_slip += abs(dev) * fa
+    notl_m, notl_fu, notl_up = sum(measured), sum(fee_unknown), sum(unpriced)
+    notl = notl_m + notl_fu + notl_up
+    n_fills = len(measured) + len(fee_unknown) + len(unpriced)
+
+    def _bps(num: float) -> Optional[float]:
+        return (1e4 * num / notl_m) if notl_m else None
+
+    return {
+        "n_rows": len(rows),
+        "n_batches": len(rids),
+        "n_fills": n_fills,
+        "n_unknown_fill": n_unknown,
+        "n_measured": len(measured),
+        "n_fee_unknown": len(fee_unknown),
+        "n_unpriced": len(unpriced),
+        "notional_usdt": round(notl, 4),
+        "notional_measured_usdt": round(notl_m, 4),
+        "fee_unknown_notional_usdt": round(notl_fu, 4),
+        "unpriced_notional_usdt": round(notl_up, 4),
+        "fee_measured_usdt": round(fee_m, 8),
+        "adverse_measured_usdt": round(adverse, 8),
+        "abs_slip_measured_usdt": round(abs_slip, 8),
+        "bps_measured": _bps(fee_m + adverse),
+        "fee_bps_measured": _bps(fee_m),
+        "adverse_bps_measured": _bps(adverse),
+        "abs_bps_measured": _bps(fee_m + abs_slip),
+        "coverage_measured_notional": ((notl_m / notl) if notl else None),
+        "coverage_measured_count": ((len(measured) / n_fills) if n_fills else None),
+        "measurement_complete": (None if (n_fills == 0 and not n_unknown) else
+                                 (n_unknown == 0 and not unpriced and not fee_unknown)),
+        "reasons_not_measured": dict(sorted(reasons.items())),
+        "fee_source_counts": dict(sorted(fee_source.items())),
+        "price_reference": FLATTEN_PRICE_REFERENCE,
+        "measured_over": FLATTEN_MEASURED_OVER,
+    }
+
+
+def flatten_cost_by_batch(order_rows: List[Dict[str, Any]],
+                          fills_rows: List[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
+    """{rebalance_id: flatten_cost(rows of that batch)} for every protective_flatten batch in the rows."""
+    by: Dict[str, List[Dict[str, Any]]] = {}
+    for o in order_rows or []:
+        if o.get("order_type") == "protective_flatten":
+            by.setdefault(str(o.get("rebalance_id")), []).append(o)
+    return {rid: flatten_cost(rows, fills_rows) for rid, rows in sorted(by.items())}
