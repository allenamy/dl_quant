     return out
 
 
+ANCHOR_GRID_S = 14400
+REBUILD_FLAT_USDT = 1.0
+
+
+def anchor_series(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
+    """The LIVE `anchors` table as a clean per-anchor TRADED series — the canonical reader-side accessor.
+
+    ★★★ LED-07 (FX-EXEC2, 2026-09-13; AUDIT_EXEC 842bbffa). The table is one row per anchor RUN, and three
+        different things share it (measured on the ledger copy 08-01..09-13 12Z, 257 rows):
+          · two book ERAS — 127 rows of the internal composer (no `external_book.nominal_ts`) and 130 of the
+            external book (from 2026-08-22 08Z);
+          · HALTED runs — 19 rows with `opening_halted: true` that still carry `target_gross` (e.g. 09-12 16Z
+            target 235,335, realized 0): a target that was never traded;
+          · a TIME that is not the anchor — in the external era `anchor_ts` is the capture time, 1,381..1,547 s
+            after the nominal slot, and the nominal slot lives in `external_book.nominal_ts`.
+        A naive per-anchor statistic over the file counts untraded targets and mixes two books. There is no
+        per-row schema version, so the classification is done HERE, once, from the row's own fields.
+    ★★ WHAT COMES BACK. `series`: external-era rows, not halted, on the 4h grid, one per nominal slot (a
+       duplicate slot keeps the LAST row by position — the file is append-only, position is chronology — and
+       names the others), sorted by nominal slot. Beside it, every exclusion by reason, the nominal slots with
+       NO row at all between the first and last external slot (a crash or a skipped anchor is a gap, not a
+       zero), and the REBUILD slots: traded rows whose previous slot has a row with realized_gross below
+       REBUILD_FLAT_USDT (a flat-to-full rebuild — turnover > 100% — which dominates per-anchor cost and
+       execution averages and must be reported apart). A previous slot without a row is `prev_unknown`, never
+       read as flat.
+    ★ Rows are not modified; nominal slots are ints. Pure; no I/O.
+    """
+    ext, n_internal, off_grid, halted = [], 0, [], []
+    for i, r in enumerate(rows or []):
+        eb = r.get("external_book")
+        nts = eb.get("nominal_ts") if isinstance(eb, dict) else None
+        try:
+            nts = None if nts is None else int(nts)
+        except (TypeError, ValueError):
+            nts = None
+        if nts is None:
+            n_internal += 1
+            continue
+        if nts % ANCHOR_GRID_S:
+            off_grid.append(nts)
+            continue
+        ext.append((nts, i, r))
+    by_slot: Dict[int, Any] = {}
+    dup: List[int] = []
+    for nts, i, r in ext:
+        if nts in by_slot:
+            dup.append(nts)
+        by_slot[nts] = r                       # later row by position wins
+    traded, rebuild, prev_unknown = [], [], []
+    for nts in sorted(by_slot):
+        r = by_slot[nts]
+        if r.get("opening_halted"):
+            halted.append(nts)
+            continue
+        traded.append(nts)
+        prev = by_slot.get(nts - ANCHOR_GRID_S)
+        if prev is None:
+            prev_unknown.append(nts)
+        else:
+            try:
+                pg = float(prev.get("realized_gross"))
+            except (TypeError, ValueError):
+                pg = None
+            if pg is None or pg != pg:
+                prev_unknown.append(nts)
+            elif pg < REBUILD_FLAT_USDT:
+                rebuild.append(nts)
+    missing = []
+    if by_slot:
+        lo, hi = min(by_slot), max(by_slot)
+        missing = [t for t in range(lo, hi + ANCHOR_GRID_S, ANCHOR_GRID_S) if t not in by_slot]
+    return {
+        "series": [by_slot[t] for t in traded],
+        "nominal_ts": traded,
+        "rebuild_nominal_ts": rebuild,
+        "prev_unknown_nominal_ts": prev_unknown,
+        "missing_nominal_ts": missing,
+        "excluded": {"internal_era": n_internal, "off_grid_nominal": len(off_grid),
+                     "halted": len(halted), "duplicate_nominal_superseded": len(dup)},
+        "halted_nominal_ts": halted,
+        "duplicate_nominal_ts": sorted(set(dup)),
+        "off_grid_nominal_ts": off_grid,
+        "caliber": ("external-era anchors rows, one per 4h nominal slot (external_book.nominal_ts), "
+                    "opening_halted rows excluded; anchor_ts in these rows is the capture time, not the slot; "
+                    "rebuild = previous slot's row had realized_gross < %.1f USDT" % REBUILD_FLAT_USDT),
+    }
+
+
