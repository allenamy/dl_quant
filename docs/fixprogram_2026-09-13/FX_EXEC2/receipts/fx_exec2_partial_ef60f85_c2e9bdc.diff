+    b5 = PL.anchor_series([{"external_book": {"nominal_ts": str(T)}, "opening_halted": False, "realized_gross": 1.0}])
+    check("B5 nominal_ts as text is read as the slot", b5["nominal_ts"] == [T])
+    b6 = PL.anchor_series([{"external_book": None, "anchor_ts": T}, {"anchor_ts": T}])
+    check("B6 external_book None / absent ⇒ internal era", b6["excluded"]["internal_era"] == 2 and b6["series"] == [])
+    _src = [row(T - 14400, halted=True, rg=0.0), row(T)]
+    _cp = copy.deepcopy(_src)
+    b7 = PL.anchor_series(_src)
+    check("B7 input rows are not mutated; a flat previous slot makes a rebuild", _src == _cp and b7["rebuild_nominal_ts"] == [T])
+    check("B8 empty input ⇒ empty series, no missing slots", PL.anchor_series([])["series"] == [] and PL.anchor_series(None)["missing_nominal_ts"] == [])
+
+print("\n[C] ★ capture time vs slot on the real external series")
+if ANAME == "pilot_log.anchor_series":
+    lags = [float(r["anchor_ts"]) - float(r["external_book"]["nominal_ts"]) for r in S["series"]]
+    check("anchor_ts − nominal_ts within 1,380..1,548 s on every traded row", min(lags) >= 1380 and max(lags) <= 1548,
+          (min(lags), max(lags)))
+else:
+    check("capture-time check needs the series (absent in this tree)", False, "attribute absent")
+
+print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed")
+if FAILS:
+    print("FAILED:", *FAILS, sep="\n  ")
+    sys.exit(1)
+print("ALL PASS")
