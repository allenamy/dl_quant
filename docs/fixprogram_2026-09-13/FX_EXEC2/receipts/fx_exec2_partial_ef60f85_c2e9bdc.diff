+        _ts = [t for t in _ts if t is not None] or [t for t in (_finite(o.get("anchor_ts")) for o in rows)
+                                                    if t is not None]
+        if not _ts or max(_ts) < float(since):
+            continue
+        b = CB.flatten_cost(rows, fills_rows)
+        out.append({"rebalance_id": rid, "first_fill_ts": min(_ts), "cost": b})
+    return out
