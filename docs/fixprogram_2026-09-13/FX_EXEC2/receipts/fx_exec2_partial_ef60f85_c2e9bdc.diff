diff --git a/live/tests_flatten_exit_cost.py b/live/tests_flatten_exit_cost.py
new file mode 100644
index 0000000..cba960c
--- /dev/null
+++ b/live/tests_flatten_exit_cost.py
@@ -0,0 +1,275 @@
+"""LED-02 (FX-EXEC2, 2026-09-13; AUDIT_EXEC 842bbffa): the protective flatten is costed as an EXIT — each leg priced
+against its OWN arrival mid (`mid_at_submit`), its fee taken from the order row or the fills ledger — instead of
+being read "unpriced" for ever because it has no `mid_at_anchor`.
+
+*** PURE / READ-ONLY: verbatim ledger lines from tests_fixtures/led02_flatten_cost (gzip, sha-pinned in MANIFEST);
+    temp pilot_log trees for the reader wiring; no venue, no credentials, nothing written under state/. ***
+
+THE GAP: `cost_buckets.partition` requires `mid_at_anchor`; the ladder writes `mid_at_anchor=None` on every flatten
+row by design, so the 2026-09-12 12:47Z batch (255 legs, 235,382.55 USDT) read 255/255 unpriced even after the E1
+backfill wrote 3,656 fills rows with every commission. Every flatten row on the live ledger carries `avg_fill_px`
+and `mid_at_submit` (10/10 batches), and on 09-09 / 09-12 the fills rows close exactly to the order notional.
+
+ASSERTED HERE:
+  [0] fixture integrity: every extract's decompressed bytes hash to the MANIFEST sha; row counts are the ledger's.
+  [A] REAL 09-12 batch: 255/255 legs measured against mid_at_submit; fee = Σ commission of the 3,656 fills rows
+      (re-derived here from the raw rows, not from the reader); bps re-derived; complete; fee source fills rows.
+      ★ RED on ef60f85: the only reader the old tree has for these rows (`bucket_fills`) measures 0 of 255.
+  [B] REAL 09-09 batch: 6,190 fills rows = 3,095 trades × 2 (markout supersede) ⇒ the fee is the COLLAPSED sum
+      (a naive sum doubles it); 242 legs measured, BOMEUSDT fee-unknown (a BNB commission, unconverted).
+  [C] REAL 09-06 batch: 268 legs priced but no fills rows ⇒ 268 fee-unknown `no_fills_rows`, bps None (not 0).
+  [D] REAL 08-05 12:18Z batch: 4 rows with raw `fee_paid 0.0, fee_all_usdt False` ⇒ fee-unknown, never "free".
+  [E] neighbour cells on synthetic rows: fills do not close; ambiguous join (two filled rows, one symbol); a fills
+      row without trade_id; unknown fill; missing mid_at_submit; NaN commission; a foreign batch's fills are not
+      joined; non-flatten rows are ignored; attempt_idx is not a join key.
+  [F] the anchor-mid rule is untouched: `bucket_fills` on the same rows still reads them unpriced (W2 unchanged).
+  [G] wiring: score_post_fix E6 carries `protective_flatten_exit_cost` = flatten_cost over the same rows and the
+      day's fills; daily_summary.flatten_batches_facts lists the batch by FILL time (the rows' anchor_ts is the
+      row-write time) and a batch outside the window is not listed.
+
+NOT asserted: that `mid_at_submit` is the economically right benchmark for a crisis exit (it omits the move between
+the trip evaluation and the bookTicker read — a caliber stated in the output), nor anything about batches whose fees
+were never backfilled (LED-03 names them fee-unknown; their venue fees are a separate operator step).
+
+Exit 0 = all pass.
+"""
+import gzip
+import hashlib
+import json
+import math
+import os
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+for _d in ("ops", "scheduler", "signal"):
+    sys.path.insert(0, os.path.join(REPO, _d))
+import cost_buckets as CB   # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:400]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
