+class _Venue(BB.BinanceBroker):
+    """A broker whose venue is a list in memory. `_request` is replaced, so nothing leaves the process; the mode is
+    switched after construction so `income_since` / `nav_valuation` run their REAL venue branches over it."""
+    def __init__(self, ledger, state):
+        super().__init__()                     # DRY_RUN construction: no credentials exist or are read
+        self.mode = "TESTNET"
+        self.ledger, self.state, self.calls = ledger, state, []
+
+    def _request(self, method, path, params=None, signed=False, host=None):
+        st, p = self.state, dict(params or {})
+        self.calls.append((method, path, p, signed))
+        if path == "/fapi/v1/income":
+            s0 = int(p["startTime"])
+            e0 = min(int(p.get("endTime", MS(st["now"]))), MS(st["now"]))
+            rows = sorted((r for r in self.ledger if s0 <= r["time"] <= e0), key=lambda r: r["time"])
+            return [dict(r) for r in rows][: int(p.get("limit", 1000))]
+        if path == "/fapi/v1/multiAssetsMargin":
+            return {"multiAssetsMargin": True}
+        if path == "/fapi/v1/assetIndex":
+            tm = MS(st["now"] + 1)
+            return [{"symbol": "USDTUSD", "time": tm, "index": f"{U0:.8f}", "bidRate": f"{UB():.8f}"},
+                    {"symbol": "BNBUSD", "time": tm, "index": f"{BNBI:.8f}", "bidRate": f"{BB_():.8f}"},
+                    {"symbol": "BTCUSDT", "time": tm, "index": "1", "bidRate": "1"}]
+        raise AssertionError(f"unexpected venue call in the fake: {method} {path}")
+
+    def account_snapshot(self):
+        st = self.state
+        nav = st["W"] * UB()
+        return {"total_wallet_balance": nav, "total_unrealized_profit": 0.0, "total_margin_balance": nav,
+                "available_balance": nav, "equity": nav, "positions_notional": {}, "positions_contracts": {},
+                "positions_unrealized": {}, "read_ts": st["now"]}
+
