+    def nav_valuation(self) -> Optional[Dict[str, Any]]:
+        """The UNIT of `daily_nav.nav` and the venue's own collateral rates, read beside the equity snapshot
+        (user ruling #5, 2026-09-19; consumer: live/flow_window.py).
+
+        ★ WHY. With multiAssetsMargin on (the LIVE account, measured 2026-09-19), /fapi/v3/account's totals — and so
+          `nav` — are in USD: USDT counted at the USDTUSD index x (1 - bidBuffer 1e-4), BNB at BNBUSD x (1 - 0.05).
+          Without the margin mode and these rates a USDT de-peg reads as a loss and a BNB transfer cannot be valued
+          in the unit the NAV itself uses. Both come from the venue at the row's own moment: this is the SAME
+          valuation the NAV applies (`bidRate`), not a price we chose.
+        ★ NEVER RAISES, and each half fails on its own: the NAV row must still be written, and a missing rate must be
+          a NAMED absence (the reader then says UNKNOWN), never a default.
+        Returns None in DRY_RUN — there is no account to value."""
+        if self.mode == "DRY_RUN":
+            return None
+        out: Dict[str, Any] = {"read_ts": time.time(), "multi_assets_margin": None,
+                               "multi_assets_margin_error": None, "rates": {}, "rates_error": None}
+        try:
+            r = self._request("GET", "/fapi/v1/multiAssetsMargin", signed=True)
+            v = r.get("multiAssetsMargin") if isinstance(r, dict) else None
+            if isinstance(v, bool):
+                out["multi_assets_margin"] = v
+            else:
+                out["multi_assets_margin_error"] = f"unexpected body: {str(r)[:120]}"
+        except Exception as e:                                          # noqa: BLE001 — recorded, never swallowed
+            out["multi_assets_margin_error"] = f"{type(e).__name__}: {str(e)[:160]}"
+        try:
+            rows = self._request("GET", "/fapi/v1/assetIndex")
+            rows = [rows] if isinstance(rows, dict) else (rows if isinstance(rows, list) else [])
+            for x in rows:
+                sym = str((x or {}).get("symbol") or "")
+                if not sym.endswith("USD") or len(sym) <= 3:
+                    continue
+
+                def _f(k, _x=x):
+                    try:
+                        v = float(_x.get(k))
+                    except (TypeError, ValueError):
+                        return None
+                    return v if (v == v and abs(v) != float("inf")) else None
+                _t = _f("time")
+                out["rates"][sym[:-3]] = {"index": _f("index"), "bid_rate": _f("bidRate"),
+                                          "time_ms": (int(_t) if _t is not None else None)}
+            if not out["rates"]:
+                out["rates_error"] = f"no *USD rows in the assetIndex answer ({str(rows)[:120]})"
+        except Exception as e:                                          # noqa: BLE001
+            out["rates_error"] = f"{type(e).__name__}: {str(e)[:160]}"
+        return out
+
     def classify(self, err: "VenueError") -> str:
