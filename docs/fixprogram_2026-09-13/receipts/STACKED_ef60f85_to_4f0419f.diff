+"""COST-MIX DRIFT against a FROZEN reference window. Pure: no file, no network, no clock.
+
+★★★ WHY THIS EXISTS (LED-08 follow-up, FX-EXEC2 2026-09-16; lead sent LED-08 back, FIXPROGRAM §8).
+    ops/anchor_report.py judges taker share and |net/gross| against the book's OWN trailing distribution — the
+    previous ≤42 traded non-rebuild anchors. 42 anchors × 4h is exactly SEVEN DAYS, so the band re-centres on any
+    step shift within a week and then reports nothing. Measured on the live ledger copy (fact table D1): the
+    maker-share collapse X-COST decomposed, 93.1 % → 73.9 %, is already fully inside the band — the band's own taker
+    median is 21.58 % and it raises nothing, while the same book sat at 5.01 % in the reference window.
+    **A self-calibrating instrument cannot see a regime change. It can only see an outlier inside the regime.**
+⇒ So a SECOND, non-adaptive comparison is made against a window that is frozen in config and never moves.
+
+★★ CALIBER IS BOUND TO THE FUNCTION, NOT TO THE WORD "maker share". Two different numbers are in circulation:
+     · X-COST (RESULT_X_COST.md T1): M/(M+T) by the FILL-level `venue_maker_flag`, over fills de-duplicated on
+       (symbol, trade_id), pooled by notional over a period. Its S1a value is 93.1 % (⇒ taker 6.9 %).
+     · this report: Σ|filled_notional| of ORDER ROWS whose `order_type` is `topup_taker`, over Σ|filled_notional|
+       of the anchor, per anchor. Its S1a median is 5.010 %.
+   A maker order the venue filled as taker (from_reject MARKET, chase IOC) is TAKER to the first and MAKER to the
+   second. They agree to ~2 pp here by arithmetic accident. The pinned reference is the SECOND, because that is the
+   quantity the warning judges; `config/cost_drift_reference.json` declares this and names the other as NOT it.
+
+★★ THE THRESHOLD IS A PROPOSAL, AND THE ECONOMICS ARE REPORTED BUT NEVER GATED ON.
+   Trip: |median_now − median_ref| > k · 1.4826 · MAD_ref (k = 3), with at least `min_n` eligible anchors on BOTH
+   sides. This deliberately uses SINGLE-ANCHOR dispersion as the yardstick for a shift in a MEDIAN, i.e. it is
+   insensitive by construction, so a once-a-day page does not fire on ordinary variation. Beside the verdict the
+   fee-only translation of the drift is printed — Δ(taker share) × (taker_fee_bps − maker_fee_bps) × median turnover,
+   in bps per anchor per gross — so it can be read against the frozen K2 book-level δ of 0.05. That number is
+   REPORTED and is NOT part of the trip condition: this module is a DETECTION instrument reporting departure from
+   the characterised regime; whether the departure is worth acting on is the deep-check template's call (K5).
+   On the recorded data the fee-only cost of the 93 → 74 collapse is +0.023 bps/anchor/gross, i.e. BELOW δ — a real
+   level shift that is not, on fees alone, book-level material. Folding δ into the trip condition would silence it.
+
+★ THE PINNED NUMBERS ARE ALSO RE-DERIVED AT RUNTIME. `recompute_gate` compares the config's pinned levels with
+  `window_levels` recomputed from the ledger the reader is already holding. The PIN stays operative — that is what
+  "frozen" means — and a disagreement, or a window that is no longer in the ledger, is NAMED
+  (`mismatch` / `reference_window_unavailable`), never silently skipped and never silently re-fitted.
+"""
+from __future__ import annotations
+
+import math
+import statistics
+from typing import Any, Callable, Dict, List, Optional
+
+import pilot_log as PL
+
+K_MADS = 3.0
+MAD_TO_SIGMA = 1.4826
+MIN_N = 12
+SE_OF_MEDIAN_FACTOR = 1.2533          # SE(median) ≈ 1.2533 σ / √n, for the sensitivity note only
+RECOMPUTE_TOL = 1e-12                 # same code on the same bytes ⇒ bit-identical; a real ledger edit must SHOW
+
+MAKER_FEE_BPS = 2.00                  # measured schedule, unchanged across both windows (X-COST §1 / CHK-03)
+TAKER_FEE_BPS = 5.00
+DELTA_BPS_ANCHOR_GROSS = 0.05         # FIXPROGRAM §4.1, the frozen K2 book-level equivalence band
+
+KEYS = ("taker_share", "net_over_gross_abs")
+
+REQUIRED_CONFIG_KEYS = ("_basis", "window_name", "first_nominal_ts_inclusive", "last_nominal_ts_inclusive",
+                        "caliber", "levels", "threshold", "economic", "device", "receipt")
+
+
+class ReferenceConfigError(ValueError):
+    """The frozen reference config is absent or malformed. Never swallowed into a default."""
+
+
+def _fin(x) -> Optional[float]:
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and not math.isinf(v)) else None
+
+
+def band(values: List[Optional[float]], k: float = K_MADS, min_n: int = MIN_N) -> Dict[str, Any]:
+    """median / MAD / trailing threshold over the finite values. None is not a value; too few ⇒ no threshold."""
+    v = [x for x in values if x is not None]
+    if len(v) < min_n:
+        return {"n": len(v), "median": None, "mad": None, "threshold": None, "min": None, "max": None}
+    med = statistics.median(v)
+    mad = statistics.median([abs(x - med) for x in v])
+    return {"n": len(v), "median": med, "mad": mad, "threshold": med + k * MAD_TO_SIGMA * mad,
+            "min": min(v), "max": max(v)}
+
+
+def window_levels(anchor_rows, orders_by_rid, first_ts: int, last_ts: int, *,
+                  facts_fn: Callable[[List[Dict[str, Any]]], Dict[str, Any]],
+                  min_n: int = MIN_N) -> Dict[str, Any]:
+    """Levels over the traded, non-halted, non-rebuild anchors whose NOMINAL slot is in [first_ts, last_ts].
+
+    Same eligibility as the report's trailing band (`ops/anchor_report.history_facts`), applied to a FIXED window
+    instead of a trailing one, so the two sides of the comparison are the same population rule. `facts_fn` is the
+    report's own `order_facts`, passed in rather than re-implemented here: a second implementation of the taker-share
+    definition could drift from the reader that consumes the comparison and nothing would notice.
+    """
+    S = PL.anchor_series(anchor_rows)
+    rebuild = set(S["rebuild_nominal_ts"])
+    taker, ngabs, per_anchor = [], [], []
+    n_traded = n_rebuild = 0
+    # `anchor_series` has ALREADY removed halted slots from `series` into `halted_nominal_ts`, so halted rows are
+    # never seen in this loop and are counted from that list instead. `n_slots` is the whole window for the reader.
+    for t, r in zip(S["nominal_ts"], S["series"]):
+        if not (first_ts <= t <= last_ts):
+            continue
+        n_traded += 1
+        if t in rebuild:
+            n_rebuild += 1
+            continue
+        f = facts_fn(orders_by_rid.get(r.get("rebalance_id"), []) or [])
+        ng = _fin(r.get("net_over_gross"))
+        ts = f.get("taker_share")
+        na = None if ng is None else abs(ng)
+        taker.append(ts)
+        ngabs.append(na)
+        per_anchor.append({"nominal_ts": t, "taker_share": ts, "net_over_gross_abs": na})
+    n_halted = sum(1 for t in S["halted_nominal_ts"] if first_ts <= t <= last_ts)
+    n_slots = n_traded + n_halted
+    return {"first_nominal_ts_inclusive": first_ts, "last_nominal_ts_inclusive": last_ts,
+            "n_slots": n_slots, "n_halted": n_halted, "n_rebuild": n_rebuild, "n_eligible": len(taker),
+            "taker_share": band(taker, min_n=min_n), "net_over_gross_abs": band(ngabs, min_n=min_n),
+            "per_anchor": per_anchor}
+
+
+def band_to_levels(history: Dict[str, Any]) -> Dict[str, Any]:
+    """`ops/anchor_report.history_facts` output → the {key: {median, mad, n}} shape `drift_facts` takes."""
+    out = {}
+    for key, src in (("taker_share", "taker"), ("net_over_gross_abs", "net_over_gross_abs")):
+        b = history.get(src) or {}
+        out[key] = {"median": b.get("median"), "mad": b.get("mad"), "n": b.get("n", 0)}
+    return out
+
+
+def load_reference(path: str) -> Dict[str, Any]:
+    """Read and VALIDATE the frozen config. A missing key is an error, never a default."""
+    import json
+    import os
+    if not os.path.exists(path):
+        raise ReferenceConfigError(f"frozen reference config absent: {path}")
+    try:
+        cfg = json.load(open(path))
+    except Exception as e:
+        raise ReferenceConfigError(f"frozen reference config unreadable: {path}: {e!r}")
+    missing = [k for k in REQUIRED_CONFIG_KEYS if k not in cfg]
+    if missing:
+        raise ReferenceConfigError(f"frozen reference config missing keys {missing}: {path}")
+    lv = cfg.get("levels") or {}
+    for key in KEYS:
+        one = lv.get(key) or {}
+        for f in ("median", "mad", "n"):
+            if _fin(one.get(f)) is None:
+                raise ReferenceConfigError(f"frozen reference level {key}.{f} is not a finite number: {path}")
+    for k in ("first_nominal_ts_inclusive", "last_nominal_ts_inclusive"):
+        if not isinstance(cfg.get(k), int) or cfg[k] % PL.ANCHOR_GRID_S:
+            raise ReferenceConfigError(f"frozen reference {k} is not an int on the {PL.ANCHOR_GRID_S}s grid: {path}")
+    if cfg["first_nominal_ts_inclusive"] >= cfg["last_nominal_ts_inclusive"]:
+        raise ReferenceConfigError(f"frozen reference window is empty or reversed: {path}")
+    return cfg
+
+
+def pinned_levels(cfg: Dict[str, Any]) -> Dict[str, Any]:
+    return {key: {"median": float(cfg["levels"][key]["median"]), "mad": float(cfg["levels"][key]["mad"]),
+                  "n": int(cfg["levels"][key]["n"])} for key in KEYS}
+
+
+def recompute_gate(pinned: Dict[str, Any], recomputed: Dict[str, Any], tol: float = RECOMPUTE_TOL) -> Dict[str, Any]:
+    """Does the ledger still produce the pinned levels? The PIN stays operative either way; this only NAMES.
+
+    `reference_window_unavailable` (no eligible anchor in the window — the days have left the ledger, or the reader
+    holds a shorter history) is its own status, never folded into `match`.
+    """
+    n_elig = recomputed.get("n_eligible")
+    if not n_elig:
+        return {"status": "reference_window_unavailable", "n_eligible": n_elig or 0,
+                "first_nominal_ts_inclusive": recomputed.get("first_nominal_ts_inclusive"),
+                "last_nominal_ts_inclusive": recomputed.get("last_nominal_ts_inclusive"),
+                "pinned": pinned, "recomputed": None, "diffs": None}
+    diffs, ok = {}, True
+    rec_out = {}
+    for key in KEYS:
+        r = recomputed.get(key) or {}
+        p = pinned.get(key) or {}
+        rec_out[key] = {"median": r.get("median"), "mad": r.get("mad"), "n": r.get("n")}
+        for f in ("median", "mad"):
+            pv, rv = _fin(p.get(f)), _fin(r.get(f))
+            if pv is None or rv is None:
+                diffs[f"{key}.{f}"] = None
+                ok = False
+            else:
+                d = rv - pv
+                diffs[f"{key}.{f}"] = d
+                if abs(d) > tol:
+                    ok = False
+        if p.get("n") != r.get("n"):
+            diffs[f"{key}.n"] = (p.get("n"), r.get("n"))
+            ok = False
+    return {"status": "match" if ok else "mismatch", "n_eligible": n_elig, "tol": tol,
+            "first_nominal_ts_inclusive": recomputed.get("first_nominal_ts_inclusive"),
+            "last_nominal_ts_inclusive": recomputed.get("last_nominal_ts_inclusive"),
+            "pinned": pinned, "recomputed": rec_out, "diffs": diffs}
+
+
+def drift_facts(reference: Dict[str, Any], current: Dict[str, Any], *, k: float = K_MADS, min_n: int = MIN_N,
+                turnover: Optional[float] = None, delta_bps: float = DELTA_BPS_ANCHOR_GROSS,
+                maker_fee_bps: float = MAKER_FEE_BPS, taker_fee_bps: float = TAKER_FEE_BPS) -> Dict[str, Any]:
+    """Frozen reference vs the current trailing level, per key. Pure.
+
+    `warn` requires BOTH sides to carry at least `min_n` anchors; otherwise `warn` is False and
+    `undecidable_reason` says which side was thin. `delta_bps` and `turnover` enter ONLY the reported economic
+    translation — never the trip condition (the mutants in tests_cost_drift [P6] pin that).
+    """
+    out = {}
+    for key in KEYS:
+        ref, cur = reference.get(key) or {}, current.get(key) or {}
+        rmed, rmad, rn = _fin(ref.get("median")), _fin(ref.get("mad")), int(ref.get("n") or 0)
+        cmed, cn = _fin(cur.get("median")), int(cur.get("n") or 0)
+        thr = None if rmad is None else k * MAD_TO_SIGMA * rmad
+        d = None if (rmed is None or cmed is None) else cmed - rmed
+        why = None
+        if rmed is None or rmad is None:
+            why = "reference level missing"
+        elif cmed is None:
+            why = "current band has no median"
+        elif rn < min_n:
+            why = f"reference has {rn} anchors, needs {min_n}"
+        elif cn < min_n:
+            why = f"current band has {cn} anchors, needs {min_n}"
+        elif rmad == 0:
+            # ★ A DEGENERATE REFERENCE CANNOT CALIBRATE A THRESHOLD. MAD_ref = 0 makes the line 0, so ANY difference
+            #   — including a float wobble — would "warn". The existing trailing band declares the same blind spot
+            #   and lets the line equal the median; for a DRIFT check that behaviour is worse than useless, because
+            #   the verdict then carries no information. So no verdict is issued, and the reason is said out loud.
+            #   Nothing is hidden: both levels and Δ are printed either way, so the operator still sees the move.
+            why = "reference MAD is 0 (degenerate dispersion) — no scale for a threshold"
+        one = {"reference_median": rmed, "reference_mad": rmad, "reference_n": rn,
+               "current_median": cmed, "current_n": cn, "drift": d, "threshold": thr,
+               "k_mads": k, "min_n": min_n, "undecidable_reason": why,
+               "warn": bool(why is None and d is not None and thr is not None and abs(d) > thr),
+               "threshold_alternative_se_of_median": (
+                   None if (rmad is None or rn < 2) else k * SE_OF_MEDIAN_FACTOR * (MAD_TO_SIGMA * rmad) / (rn ** 0.5))}
+        if key == "taker_share":
+            tv = _fin(turnover)
+            one["economic_fee_only"] = {
+                "formula": "drift x (taker_fee_bps - maker_fee_bps) x median(filled_notional / realized_gross)",
+                "maker_fee_bps": maker_fee_bps, "taker_fee_bps": taker_fee_bps,
+                "turnover_median_filled_over_realized_gross": tv,
+                "bps_per_anchor_per_gross": (None if (d is None or tv is None)
+                                             else d * (taker_fee_bps - maker_fee_bps) * tv),
+                "delta_bps_per_anchor_per_gross": delta_bps,
+                "within_delta": (None if (d is None or tv is None)
+                                 else abs(d * (taker_fee_bps - maker_fee_bps) * tv) <= delta_bps),
+                "note": "REPORTED, never part of the trip condition",
+            }
+        out[key] = one
+    return out
+
+
+# ── rendering (both readers print BOTH levels; only the daily summary prints a verdict) ──────────
+_LABEL = {"taker_share": "taker 占比", "net_over_gross_abs": "|净/gross|"}
+
+
+def _pct(x, nd=2):
+    return "n/a" if x is None else f"{x * 100:.{nd}f}%"
+
+
+def reference_line(cfg: Dict[str, Any], facts: Dict[str, Any]) -> str:
+    """One compact line for the per-anchor report: BOTH levels and the delta, NO verdict."""
+    t = facts.get("taker_share") or {}
+    n = facts.get("net_over_gross_abs") or {}
+    return (f"参照({cfg.get('window_name')}): taker 中位 {_pct(t.get('reference_median'), 1)} "
+            f"→ 当前 {_pct(t.get('current_median'), 1)} (Δ{_pp(t.get('drift'))}) | "
+            f"|净/gross| 中位 {_pct(n.get('reference_median'))} → 当前 {_pct(n.get('current_median'))} "
+            f"(Δ{_pp(n.get('drift'))}) · 判词见日报")
+
+
+def _pp(x, nd=2):
+    return "n/a" if x is None else f"{x * 100:+.{nd}f}pp"
+
+
+def summary_lines(cfg: Dict[str, Any], facts: Dict[str, Any], gate: Dict[str, Any]) -> List[str]:
+    """The daily summary's block: both levels, the threshold, the verdict, the economics, and the gate."""
+    L = [f"【成本组合漂移】 —— 对冻结参照窗 {cfg.get('window_name')} "
+         f"({cfg.get('first_utc', cfg.get('first_nominal_ts_inclusive'))} .. "
+         f"{cfg.get('last_utc', cfg.get('last_nominal_ts_inclusive'))}), 非自校准",
+         f"   口径: {(cfg.get('caliber') or {}).get('name', 'n/a')} "
+         f"(不是 X-COST 的 venue_maker_flag 汇总口径 —— 两者不可互引)"]
+    for key in KEYS:
+        f = facts.get(key) or {}
+        head = (f"   {_LABEL[key]:<10} 参照 {_pct(f.get('reference_median'))} (n {f.get('reference_n')}) "
+                f"| 当前 {_pct(f.get('current_median'))} (n {f.get('current_n')}) "
+                f"| Δ {_pp(f.get('drift'))} | 线 {_pp(f.get('threshold'))}")
+        if f.get("undecidable_reason"):
+            L.append(head + f"  → 不可判: {f['undecidable_reason']}")
+        elif f.get("warn"):
+            L.append(head + "  → ⚠️ 漂移越线")
+        else:
+            L.append(head + "  → 带内")
+    e = ((facts.get("taker_share") or {}).get("economic_fee_only") or {})
+    bps = e.get("bps_per_anchor_per_gross")
+    if bps is None:
+        L.append("   仅手续费经济换算: n/a(未测到换手中位, 非 0)")
+    else:
+        L.append(f"   仅手续费经济换算: {bps:+.4f} bps/锚/gross "
+                 f"(费 {e.get('maker_fee_bps')}/{e.get('taker_fee_bps')} bps, 换手中位 "
+                 f"{e.get('turnover_median_filled_over_realized_gross'):.4f}) 对冻结 δ "
+                 f"{e.get('delta_bps_per_anchor_per_gross')} ⇒ "
+                 f"{'带内' if e.get('within_delta') else '出带'} —— 只报, 不入触发条件")
+    th = cfg.get("threshold") or {}
+    L.append(f"   门限: |中位差| > {th.get('k_mads', K_MADS)}×1.4826×MAD_参照, 两侧各需 ≥{th.get('min_n', MIN_N)} 锚 "
+             f"—— {th.get('status', 'PROPOSAL')}")
+    st = (gate or {}).get("status")
+    if st == "match":
+        L.append(f"   参照重算门: MATCH ({gate.get('n_eligible')} 锚, 容差 {gate.get('tol')})")
+    elif st == "mismatch":
+        L.append(f"   参照重算门: ⚠️ MISMATCH —— 钉住值仍为判据; 钉 {gate.get('pinned')} vs 重算 "
+                 f"{gate.get('recomputed')}; 差 {gate.get('diffs')}")
+    elif st == "reference_window_unavailable":
+        L.append("   参照重算门: reference_window_unavailable(账本中该窗无合格锚) —— 钉住值仍为判据, 未静默跳过")
+    else:
+        L.append(f"   参照重算门: {st}")
+    return L
+
+
+def summary_warnings(facts: Dict[str, Any], gate: Dict[str, Any]) -> List[str]:
+    """The warning strings the daily summary raises — at most one per quantity, plus the gate. Once a day by
+    construction: this is the daily summary's block, not the per-anchor report's."""
+    w = []
+    for key in KEYS:
+        f = facts.get(key) or {}
+        if f.get("warn"):
+            w.append(f"{_LABEL[key]} 漂移越线: 参照 {_pct(f.get('reference_median'))} → 当前 "
+                     f"{_pct(f.get('current_median'))} (Δ {_pp(f.get('drift'))} > 线 {_pp(f.get('threshold'))})")
+    st = (gate or {}).get("status")
+    if st == "mismatch":
+        w.append("冻结参照重算不符(reference_recompute_mismatch): 配置钉住值与账本重算不一致, 需重钉或查账本改动")
+    elif st == "reference_window_unavailable":
+        w.append("冻结参照窗不在账本中(reference_window_unavailable): 无法重算校验, 钉住值仍在用")
+    return w
