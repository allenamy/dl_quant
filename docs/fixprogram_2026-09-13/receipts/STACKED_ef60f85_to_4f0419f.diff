+"""BNB commission -> USDT, in ONE declared caliber. Pure: no file, no network, no clock.
+
+★★★ WHY THIS EXISTS (LED-03, FX-EXEC2 2026-09-16; lead ruling 2026-09-13 17:0xZ). Five of the eight older
+    protective-flatten batches paid their commission in BNB (08-05 12Z, both 08-21 batches, 08-26, and part of
+    09-06: 0.14011738 BNB in total). The three-bucket reader refuses to fold an unconverted non-USDT fee to 0 or to
+    a guessed price, so those legs read `commission_non_usdt_unconverted` and stay unmeasured even after the exact
+    fills backfill. Converting them needs a PRICE, and a price needs a caliber, or the number is just a number.
+
+★★ THE CALIBER, AS RULED: `bnb_spot_1m_close_at_fill` — the CLOSE of the BNBUSDT **spot** 1m kline whose minute
+   CONTAINS the fill, taken from the data.binance.vision static archive. Three things follow from that wording and
+   all three are properties of the ruling, not defects to be smoothed away:
+     · the close is the price at the END of that minute, i.e. up to 60 s AFTER the fill. It is a stated convention,
+       not an estimate of the fill-instant price; a caliber that were the fill-instant price would need trade data,
+       not klines.
+     · **spot**, not perp. The perp mark is carried as a SENSITIVITY column by the device that builds the table —
+       reported beside the number, never substituted for it.
+     · a minute with no kline stays **fee_unknown and NAMED**. It is never interpolated, never taken from the
+       nearest minute, never carried forward. An absent price is an absent price; the three-bucket rule exists
+       precisely so that "unmeasured" and "zero" cannot be confused, and a silent nearest-minute fill would put
+       them back together.
+
+★ PROVENANCE TRAVELS WITH THE NUMBER. Every converted row carries the rate, the caliber name, and the source the
+  rate came from (archive path, the publisher's own CHECKSUM, and our own sha256 of the bytes we read). A converted
+  fee whose price cannot be traced back to a specific archived file is not auditable, and an unauditable fee in a
+  cost table is worse than a named gap.
+"""
+from __future__ import annotations
+
+import math
+from typing import Any, Dict, Mapping, Optional
+
+CALIBER = "bnb_spot_1m_close_at_fill"
+
+# why each row could not be converted — one reason per row, never a silent None
+REASON_NO_KLINE = "bnb_spot_1m_kline_absent"
+REASON_BAD_RATE = "bnb_spot_1m_close_not_a_positive_number"
+REASON_BAD_TS = "fill_timestamp_not_a_finite_millisecond"
+REASON_BAD_AMOUNT = "commission_amount_not_a_finite_number"
+
+
+def minute_open_ms(ts_ms) -> Optional[int]:
+    """The open timestamp of the 1m kline CONTAINING ts_ms. None when ts_ms is not a usable millisecond."""
+    try:
+        v = float(ts_ms)
+    except (TypeError, ValueError):
+        return None
+    if v != v or math.isinf(v) or v <= 0:
+        return None
+    return int(v // 60000) * 60000
+
+
+def _fin(x) -> Optional[float]:
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and not math.isinf(v)) else None
+
+
+def convert(commission_bnb, fill_ts_ms, closes: Mapping[int, Any], *,
+            source: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+    """One BNB commission -> USDT at the ruled caliber.
+
+    `closes` maps a 1m kline's OPEN timestamp in ms to its close price. Returns a record that always states either
+    a usdt figure with its rate and provenance, or `usdt is None` with a named `reason`. It never returns 0 for a
+    missing price, and it never reaches for a neighbouring minute.
+    """
+    out: Dict[str, Any] = {"caliber": CALIBER, "commission_bnb": commission_bnb, "fill_ts_ms": fill_ts_ms,
+                           "minute_open_ms": None, "rate_usdt_per_bnb": None, "usdt": None,
+                           "reason": None, "source": source}
+    amt = _fin(commission_bnb)
+    if amt is None:
+        out["reason"] = REASON_BAD_AMOUNT
+        return out
+    m = minute_open_ms(fill_ts_ms)
+    if m is None:
+        out["reason"] = REASON_BAD_TS
+        return out
+    out["minute_open_ms"] = m
+    if m not in closes:
+        out["reason"] = REASON_NO_KLINE          # named, not interpolated
+        return out
+    rate = _fin(closes[m])
+    if rate is None or rate <= 0:
+        out["reason"] = REASON_BAD_RATE
+        return out
+    out["rate_usdt_per_bnb"] = rate
+    out["usdt"] = amt * rate                      # sign preserved: a commission is negative income
+    return out
+
+
+def convert_rows(rows, closes: Mapping[int, Any], *, source: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
+    """Convert an iterable of {commission_bnb, fill_ts_ms, ...} rows. Totals are over CONVERTED rows only.
+
+    ★ `usdt_total` is the sum over rows that converted. `n_unconverted` and `unconverted_bnb` are reported beside
+      it and are NOT folded in — a total that silently omits what it could not price is the same defect as a fee
+      of 0, one level up.
+    """
+    conv, n_ok, total, unconv, by_reason = [], 0, 0.0, 0.0, {}
+    for r in rows:
+        c = convert(r.get("commission_bnb"), r.get("fill_ts_ms"), closes, source=source)
+        c.update({k: v for k, v in r.items() if k not in ("commission_bnb", "fill_ts_ms")})
+        conv.append(c)
+        if c["usdt"] is None:
+            by_reason[c["reason"]] = by_reason.get(c["reason"], 0) + 1
+            a = _fin(c["commission_bnb"])
+            if a is not None:
+                unconv += a
+        else:
+            n_ok += 1
+            total += c["usdt"]
+    return {"caliber": CALIBER, "rows": conv, "n_rows": len(conv), "n_converted": n_ok,
+            "n_unconverted": len(conv) - n_ok, "usdt_total_converted_only": total,
+            "unconverted_bnb": unconv, "unconverted_by_reason": by_reason, "source": source}
