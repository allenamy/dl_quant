+
+print("\n[A] ★★★ REAL anchors rows 08-01..09-13 12Z")
+# independent re-derivation
+ext = {}
+n_int = 0
+for r in ROWS:
+    eb = r.get("external_book")
+    if isinstance(eb, dict) and eb.get("nominal_ts") is not None:
+        ext[int(eb["nominal_ts"])] = r
+    else:
+        n_int += 1
+hal = sorted(t for t, r in ext.items() if r.get("opening_halted"))
+trd = sorted(t for t, r in ext.items() if not r.get("opening_halted"))
+miss = [t for t in range(min(ext), max(ext) + 14400, 14400) if t not in ext]
+reb = [t for t in trd if (t - 14400) in ext and float(ext[t - 14400].get("realized_gross") or 0) < 1.0]
