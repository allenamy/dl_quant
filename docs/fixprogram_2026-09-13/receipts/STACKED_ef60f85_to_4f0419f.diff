+check("★★ C2 the render prints the unreliable line", any("不可靠" in l for l in DS.render_account(fac)),
+      [l for l in DS.render_account(fac) if "已实现" in l or "不可靠" in l][:2])
+
+print("\n[D] a post-fix row ignores a record")
+r12 = [r for r in NAV["20260912"] if "realised_by_type_asset" in r][-1]
