+    if f is not None:
+        return "pilot_log.anchor_series", f
+    # the old tree has no accessor: a reader gets the raw table as its series
+    return "raw table (no accessor in this tree)", (lambda rows: {"series": list(rows), "nominal_ts": [
+        (r.get("external_book") or {}).get("nominal_ts") if isinstance(r.get("external_book"), dict) else None
+        for r in rows]})
+
+
+ANAME, AS = accessor()
+print(f"accessor under test: {ANAME}")
+
+print("[0] fixture integrity")
+check("projection bytes hash to MANIFEST and carry 257 rows",
