+++ b/live/tests_weight_shaper_sliding.py
@@ -0,0 +1,308 @@
+"""OPS-03 A (FX-EXEC2, 2026-09-16; lead ruling A + C): the WEIGHT shaper bounds a SLIDING 60 s window, at the same
+cap, like the order and request shapers beside it already do.
+
+*** THE DEFECT IS A BOUNDARY BURST, AND IT IS NOT HYPOTHETICAL. `spend_weight` used a FIXED window that opens on the
+    first spend after a reset, so two bursts either side of the boundary are both admitted and the emission in a
+    sliding minute reaches ~2x the self-cap. Measured on the recorded request timelines (OPS03_sliding_shaper_replay):
+    our own requests reached 1,941 weight in a sliding minute on 2026-08-26 12Z — 81% of the venue's 2,400 cap and
+    just above the 80% backstop threshold — while the venue's aligned-minute counter read only 1,005, because the
+    burst straddled its minute boundary. rate_budget's own docstring names this shape as the cause of both the
+    07-30 and 07-31 -1003 bans. ***
+
+*** NO NETWORK, NO SLEEPING: every cell drives a FAKE CLOCK injected into rate_budget, so `time.time()` and
+    `time.sleep()` are virtual and the suite runs in milliseconds. Nothing here touches a venue or a ledger. ***
+
+ASSERTED HERE:
+  [R1] ★★★ the lead's sequence — 100 at t=0, 900 at t=59.5, 900 at t=60.1 — leaves NO sliding 60 s window of admitted
+       spends above WEIGHT_PER_MIN. RED on the fixed-window shaper, which admits 1,800 inside 0.6 s.
+  [R2] the same sequence on a REPLICA of the old fixed-window shaper, inline in this file, DOES breach — so the cell
+       above is testing the change and not the arithmetic of the checker.
+  [N1] neighbour: spends summing to exactly WEIGHT_PER_MIN in one window are all admitted with zero waits.
+  [N2] neighbour: a single spend LARGER than the cap terminates (no spin), is admitted once, and is NAMED in stats —
+       waiting cannot help, so silently looping forever would be the worst of the three options.
+  [N3] neighbour: two threads spending concurrently never exceed the cap in any sliding window.
+  [N4] `weight_peak_per_min` becomes the SLIDING peak, and `weight_in_window` the sliding sum — the key kept by
+       tests_request_budget ("109 weight-1 cancels are 10.9% of the WEIGHT cap") still reads 109.
+  [N5] a wait is counted in `weight_waits` and its seconds in `wait_seconds`, and the spend lands after it.
+  [N6] the ORDER and REQUEST shapers are untouched: their sliding behaviour is re-asserted here so a shared-helper
+       refactor of the weight path cannot silently alter them.
+  [N7] a drip at 0/20/40 s, which only a 60 s window shapes — R1's burst does not discriminate a too-SHORT window,
+       and a 6 s horizon survived every other cell.
+  [N8] `weight_in_window` (40) and `weight_spent` (740) must differ — N4 spends everything in one instant, where a
+       reader returning the lifetime total looks correct.
+
+NOT asserted: whether the venue counts an aligned minute or a sliding one for bans (OPS-03 design §6 leaves that open);
+the real wall-clock cost, which is the replay's job (34.5 s worst added delay, 28.5 fewer markout marks on 09-13 12Z).
+Exit 0 = all pass.
+"""
+import importlib
+import os
+import sys
+import threading
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:300]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+import rate_budget as RB   # noqa: E402
+
+
+class FakeClock:
+    """A stand-in for the `time` module: virtual now, virtual sleep. Thread-safe enough for [N3]."""
+
+    # ★ t0 = 0.0 ON PURPOSE. The first version started at an absolute epoch while the cell sequences are RELATIVE
+    #   offsets, so `set(59.5)` was max(1_000_000.0, 59.5) = no advance at all: every spend landed at t=0, the
+    #   sequence never crossed a boundary, and [R1] PASSED on the unfixed shaper. A red cell that is green on the
+    #   old code is not evidence of anything.
+    def __init__(self, t0=0.0):
+        self.now = t0
+        self._l = threading.Lock()
+        self.slept = []
+
+    def time(self):
+        return self.now
+
+    def sleep(self, s):
+        with self._l:
+            self.slept.append(s)
+            self.now += max(0.0, float(s))
+
+    def set(self, t):
+        with self._l:
+            self.now = max(self.now, float(t))
+
+
+def with_clock(fn):
+    """Run fn(budget, clock) with rate_budget's `time` replaced. Restored even on failure."""
+    real = RB.time
+    clk = FakeClock()
+    RB.time = clk
+    try:
+        b = RB.RateBudget()
+        return fn(b, clk), clk
+    finally:
+        RB.time = real
+
+
+def sliding_max(spends, window=60.0):
+    """Max total weight in any `window`-second half-open interval over (t, weight) admissions."""
+    if not spends:
+        return 0
+    best = 0
+    for t0, _ in spends:
+        s = sum(w for t, w in spends if t0 <= t < t0 + window)
+        best = max(best, s)
+    return best
+
+
+SEQ = [(0.0, 100), (59.5, 900), (60.1, 900)]     # the lead's red sequence
+
+
+def drive(b, clk, seq):
+    admitted = []
+    for at, w in seq:
+        clk.set(at)
+        b.spend_weight(w)
+        admitted.append((clk.now, w))             # the time the spend actually landed
+    return admitted
+
+
+print("[R1] ★★★ the sliding window holds across the boundary burst")
+_adm, _clk = with_clock(lambda b, c: drive(b, c, SEQ))
+_peak = sliding_max(_adm)
+check("★★★ R1 no sliding 60s window of admitted weight exceeds WEIGHT_PER_MIN "
+      "(old fixed window admits 1,800 within 0.6s)", _peak <= RB.WEIGHT_PER_MIN,
+      {"sliding_max": _peak, "cap": RB.WEIGHT_PER_MIN, "admitted": [(round(t, 2), w) for t, w in _adm]})
+check("★★ R1 all three spends are eventually admitted (shaping delays, it never drops)",
+      sum(w for _, w in _adm) == sum(w for _, w in SEQ), _adm)
+check("★★ R1 the third spend was pushed past the boundary rather than admitted at 60.1",
+      _adm[-1][0] > 60.1, round(_adm[-1][0], 3))
+
+
+print("\n[R2] the checker is not the thing being tested: a replica of the OLD shaper breaches")
+
+
+class FixedWindowReplica:
+    """The pre-OPS-03 `spend_weight`, verbatim in behaviour, so [R1] is shown to test the CHANGE."""
+
+    def __init__(self, clk):
+        self.clk, self.used, self.start = clk, 0, clk.time()
+
+    def spend(self, weight):
+        now = self.clk.time()
+        if now - self.start >= 60:
+            self.used, self.start = 0, now
+        if self.used + weight > RB.WEIGHT_PER_MIN:
+            self.clk.sleep(60 - (now - self.start) + 0.25)
+            self.used, self.start = weight, self.clk.time()
+        else:
+            self.used += weight
+        return self.clk.time()
+
+
+_c2 = FakeClock()
+_rep = FixedWindowReplica(_c2)
+_old = []
+for _at, _w in SEQ:
+    _c2.set(_at)
+    _old.append((_rep.spend(_w), _w))
+_old_peak = sliding_max(_old)
+check("★★★ R2 the old fixed-window shaper DOES breach the sliding cap on this sequence",
+      _old_peak > RB.WEIGHT_PER_MIN, {"sliding_max": _old_peak, "cap": RB.WEIGHT_PER_MIN,
+                                      "admitted": [(round(t, 2), w) for t, w in _old]})
+
+
+print("\n[N1] exactly at the cap: admitted, no wait")
+_adm1, _clk1 = with_clock(lambda b, c: (drive(b, c, [(0.0, 400), (1.0, 300), (2.0, 300)]), b.snapshot())[1])
+check("★★ N1 three spends summing to exactly the cap are admitted with 0 waits",
+      _adm1["weight_spent"] == RB.WEIGHT_PER_MIN and _adm1["weight_waits"] == 0, _adm1)
+
+
+print("\n[N2] a single spend larger than the cap terminates and is named")
+
+
+def _oversize(b, c):
+    c.set(0.0)
+    b.spend_weight(RB.WEIGHT_PER_MIN + 250)
+    return b.snapshot()
+
+
+_s2, _c2b = with_clock(_oversize)
+check("★★★ N2 an oversized spend does not spin: it returns (waiting can never make room for it)", True)
+check("★★ N2 it is admitted once and NAMED in stats rather than silently let through",
+      _s2["weight_spent"] == RB.WEIGHT_PER_MIN + 250 and _s2.get("weight_oversize_spends", 0) == 1, _s2)
+
+
+print("\n[N3] two threads never exceed the cap in a sliding window")
+
+
+def _concurrent(b, c):
+    adm, lk = [], threading.Lock()
+
+    def worker(n):
+        for _ in range(n):
+            b.spend_weight(50)
+            with lk:
+                adm.append((c.time(), 50))
+    ts = [threading.Thread(target=worker, args=(15,)) for _ in range(2)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    return adm
