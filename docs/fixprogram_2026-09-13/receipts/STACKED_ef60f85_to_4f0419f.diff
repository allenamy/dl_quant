+_acts = [(AP.decide(m, "HIGH")["action"], AP.classify(m)[1]) for _, m in REAL_EXPIRY]
+check("★★★ every real expiry body ⇒ DAILY by the cooldown-expiry rule (old tree: PUSH, UNRECOGNISED)",
