+      and abs(f06["by_type_usdt"]["COMMISSION"] + 16.92422909) < 1e-8, f06.get("by_type_usdt"))
+
+print("\n[B] account_facts + render")
+if "amendments" in inspect.signature(DS.account_facts).parameters:
