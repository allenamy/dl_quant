+"""LED-03 (FX-EXEC2, 2026-09-16; lead ruling 2026-09-13 17:0xZ): BNB commissions convert to USDT in ONE declared
+caliber, `bnb_spot_1m_close_at_fill`, or they stay fee_unknown and NAMED.
+
+*** PURE AND OFFLINE: this suite never opens the archive, never reaches a network, and never reads a ledger. The
+    price map is a literal. Fetching and hashing the archive is the offline device's job
+    (docs/fixprogram_2026-09-13/FX_EXEC2/devices/led03_bnb_conversion.py), and its output carries the provenance. ***
+
+ASSERTED HERE:
+  [C1] the rate is the close of the kline whose minute CONTAINS the fill — the containing minute, not the nearest
+       one, and not the one that opens after it. Cells sit at the first millisecond of a minute, mid-minute, and the
+       last millisecond, and a fill one millisecond into the next minute must take the NEXT kline.
+  [C2] ★★★ a missing minute yields usdt None with the reason named, and the neighbouring minutes are NOT used even
+       though both exist and either would look plausible. This is the whole point of the ruling.
+  [C3] a non-positive or unreadable close is named separately from an absent one — "the price was there and was
+       unusable" and "there was no price" are different facts.
+  [C4] an unreadable amount or timestamp is named, and never silently dropped.
+  [C5] the sign is preserved: a commission is negative income and stays negative after conversion.
+  [C6] ★★★ convert_rows totals over CONVERTED rows only, and reports the unconverted BNB and the reason counts
+       beside the total rather than folding them in — a total that quietly omits what it could not price is a fee
+       of 0 one level up, which is the defect the three-bucket rule exists to prevent.
+  [C7] provenance travels with every row, converted or not.
+  [C8] the caliber NAME is the ruled string, and the module says in its own text that the perp mark is a
+       sensitivity column only and that a missing minute is never interpolated.
+
+NOT asserted: that the archive's closes are correct (they are the publisher's, verified against the publisher's own
+CHECKSUM by the device); that a 1m close is a good estimate of the fill-instant price — it is a stated convention,
+up to 60 s after the fill, and the device carries a perp-mark sensitivity column beside it.
+Exit 0 = all pass.
+"""
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:300]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+import bnb_conversion as BC   # noqa: E402
+
+M0 = 1787746980000 // 60000 * 60000          # a minute open, on the grid
+CLOSES = {M0 - 60000: 610.0, M0: 600.0, M0 + 60000: 590.0, M0 + 180000: 580.0}
+SRC = {"archive": "spot/monthly/klines/BNBUSDT/1m/BNBUSDT-1m-2026-08.zip", "sha256": "deadbeef",
+       "published_checksum": "cafebabe"}
+
+print("[C1] the rate is the close of the CONTAINING minute")
+for off, want, label in ((0, 600.0, "first ms of the minute"), (30_000, 600.0, "mid-minute"),
+                         (59_999, 600.0, "last ms of the minute"), (60_000, 590.0, "1 ms into the next minute")):
+    r = BC.convert(-1.0, M0 + off, CLOSES, source=SRC)
+    check(f"★★ C1 {label} -> {want}", r["rate_usdt_per_bnb"] == want and r["minute_open_ms"] == M0 + (off // 60000) * 60000,
+          (r["minute_open_ms"], r["rate_usdt_per_bnb"]))
+
+print("\n[C2] ★★★ a missing minute is NAMED, and the neighbours are not used")
+_gap = M0 + 120000                           # deliberately absent; M0+60000 and M0+180000 both exist
+check("★★★ C2 the gap minute really is absent while both neighbours exist",
+      _gap not in CLOSES and (_gap - 60000) in CLOSES and (_gap + 60000) in CLOSES)
+r2 = BC.convert(-0.5, _gap + 100, CLOSES, source=SRC)
+check("★★★ C2 usdt is None (never 0) and the reason is named",
+      r2["usdt"] is None and r2["reason"] == BC.REASON_NO_KLINE, r2)
+check("★★★ C2 no neighbouring minute's close leaked in as the rate",
+      r2["rate_usdt_per_bnb"] is None, r2["rate_usdt_per_bnb"])
+
+print("\n[C3] an unusable price is named SEPARATELY from an absent one")
+for bad, label in ((0.0, "zero"), (-1.0, "negative"), (float("nan"), "nan"), (float("inf"), "inf"), ("x", "text")):
+    rb = BC.convert(-1.0, M0 + 1000, {M0: bad}, source=SRC)
+    check(f"★★ C3 a {label} close -> reason {BC.REASON_BAD_RATE}, not {BC.REASON_NO_KLINE}",
+          rb["usdt"] is None and rb["reason"] == BC.REASON_BAD_RATE, rb["reason"])
+
+print("\n[C4] an unreadable amount or timestamp is named, never dropped")
+check("★★ C4 a None amount is named", BC.convert(None, M0, CLOSES)["reason"] == BC.REASON_BAD_AMOUNT)
+check("★★ C4 a nan amount is named", BC.convert(float("nan"), M0, CLOSES)["reason"] == BC.REASON_BAD_AMOUNT)
+for bad_ts, label in ((None, "None"), (0, "zero"), (-1, "negative"), (float("nan"), "nan"), ("x", "text")):
+    check(f"★★ C4 a {label} timestamp is named", BC.convert(-1.0, bad_ts, CLOSES)["reason"] == BC.REASON_BAD_TS,
+          BC.convert(-1.0, bad_ts, CLOSES)["reason"])
+
+print("\n[C5] the sign survives")
+r5 = BC.convert(-0.00320538, M0 + 5, CLOSES, source=SRC)
+check("★★ C5 a negative commission stays negative after conversion",
+      r5["usdt"] is not None and r5["usdt"] < 0 and abs(r5["usdt"] - (-0.00320538 * 600.0)) < 1e-12, r5["usdt"])
+
+print("\n[C6] ★★★ totals are over CONVERTED rows only, with the rest reported beside them")
+rows = [{"commission_bnb": -0.10, "fill_ts_ms": M0 + 1, "symbol": "AAAUSDT"},
