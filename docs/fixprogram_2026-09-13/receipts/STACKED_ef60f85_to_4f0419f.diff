+    check("B2 an off-grid nominal slot is excluded and named", b2["series"] == [] and b2["off_grid_nominal_ts"] == [T + 60])
+    b3 = PL.anchor_series([row(T - 14400), row(T, halted=True, rg=5000.0), row(T + 14400)])
+    check("B3 halted-but-holding is excluded from the traded series; the next slot is not a rebuild (prev held)",
+          b3["nominal_ts"] == [T - 14400, T + 14400] and b3["halted_nominal_ts"] == [T] and b3["rebuild_nominal_ts"] == [])
+    b4 = PL.anchor_series([row(T - 14400, rg=None), row(T)])
