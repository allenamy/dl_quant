@@ -0,0 +1,337 @@
+"""LED-04 ruling (a): §4-4 prices a pre-fix TRANSFER day from the amendment record, and names the
+days it could not.
+
+*** MOCK ONLY: pilot_log trees built in tmp, watchdog.evaluate only (no broker, no state written,
+    no venue, no network). ***
+
+THE DEFECT (FIXPROGRAM_2026-09-13 §9, lead's ruling (a); FX-EXEC2's measurement receipt
+quant_research docs/fixprogram_2026-09-13/FX_EXEC2/receipts/LED04_cond4_transfer_day_effect.json):
+§4-4's cumulative equity return prices an ORDINARY day by the nav ratio but a TRANSFER day by
+`(realised_pnl + unrealised − unrealised_prev) / nav_prev` — the flow amount deliberately never
+enters, so the realised figure carries the whole day. Every `daily_nav` row written before the
+E-0909-H carrier fix (b681ca5, 2026-09-12 06:05Z) carries a realised figure from a carrier that
+de-duplicated income on `tranId` alone — dropping one of each COMMISSION/REALIZED_PNL twin — and
+summed BNB commissions into the USDT total. On the 14:27Z ledger copy the condition therefore read
+**−1.3136%** (bit-identical to the live `last_eval`) where the amended income ledger gives
+**−1.5749%**: the judged drawdown understated by **0.2613 pp**, mostly 2026-08-02 and 2026-08-05.
+
+THE RULING: use the amendment record's USDT total when a VALID record exists; when it is missing,
+fails its sha check or does not parse, use the RECORDED value and name that day
+`unamended_prefix_day` in `last_eval` — never blind, never silent. A bookkeeping correction must
+never become a new way to stop the book.
+
+WHAT THIS SUITE PROVES, on this tree:
+  [A] a pre-fix transfer day with a valid record is priced from the record, and the day is named as
+      amended; the arithmetic is checked against the chain's own formula.
+  [B] the four ways a record fails to cover a row — absent, sha mismatch, unparsable line, and a
+      duplicate key with different content — each leave the RECORDED value in place and name the day
+      `unamended_prefix_day` with a reason. None of them is blind, none breaks the chain.
+  [C] nothing else moves: a post-fix row is priced exactly as before (its USDT-only slice is
+      reported and NOT used — that would be a second change to a trigger and is outside the ruling),
+      an ordinary day is untouched, and cond4's blind/coverage behaviour is unchanged.
+  [D] one reader: the module's path matches FX-EXEC2's relative path, and the tree holds exactly one
+      definition of the loader (this cell goes RED when their branch is stacked without deduping).
+WHAT IT DOES NOT PROVE: that the amendment records themselves are right (FX-EXEC2 owns the builder
+and its positive control: the 8 post-fix rows' own split equals the recomputation 8/8); that the
+live tree HAS the records (it does not yet — the apply step is deferred, so every pre-fix transfer
+day will name itself until it runs, which is the ruling's own prescription); anything about the
+venue. The real-data reproduction of −1.3136 / −1.5749 is the offline device
+devices/led04_cond4_watchdog_reproduction.py, not this suite.
+
+Old-code proof: this file on ef60f85 must REACH its summary line and fail [A]/[B]/[D] for the right
+reason — that tree prices every transfer day from the recorded value and reports nothing about it.
+
+Exit 0 = all pass.
+"""
+import hashlib
+import json
+import os
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+for _d in ("scheduler", "ops", "signal"):
+    sys.path.insert(0, os.path.join(REPO, _d))
+
+import pilot_log as PL                 # noqa: E402
+import watchdog as WD                  # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    ok = bool(cond)
+    print(("  ok   " if ok else "  FAIL ") + name + ("" if ok else f"   [{detail}]"), flush=True)
+    if not ok:
+        FAILS.append(name)
+
+
+tmp = tempfile.mkdtemp(prefix="led04_")
+
+# ── the three days, in the shape the live rows have ──────────────────────────────────────────
+# D1 starting equity · D2 an ORDINARY day · D3 a pre-fix TRANSFER day (the one under test)
+NAV = {"20260801": 2000.0, "20260802": 2100.0, "20260803": 2204.71279148}
+UNREAL = {"20260801": 10.0, "20260802": 15.0, "20260803": 22.52763078}
+RECORDED_REALISED = 6.13972215          # the live 2026-08-02 row's own figure
+AMENDED_REALISED = 3.13512435           # its amendment record's USDT total (same receipt)
+FLOW = 36.82261
+
+
+def nav_row(day, nav_ts, realised, flow=0.0, by_type_asset=None):
+    r = {"day": day, "target_gross": 4401.87, "nav": NAV[day], "realised_pnl": realised,
+         "realised_pnl_source": "/fapi/v1/income since 00:00Z",
+         "realised_by_type": {"COMMISSION": -2.98925093, "REALIZED_PNL": 9.00546225,
+                              "FUNDING_FEE": 0.12351083, "TRANSFER": flow},
+         "realised_truncated": False, "unrealised_pnl": UNREAL[day],
+         "sizing_policy": "constant_leverage_2.00", "nav_ts": nav_ts,
+         "external_flow_usdt": flow,
+         "external_flow_source": "/fapi/v1/income incomeType=TRANSFER since 00:00Z", "mode": "LIVE"}
+    if by_type_asset is not None:
+        r["realised_by_type_asset"] = by_type_asset
+    return r
+
+
+NAV_TS = {"20260801": 1785600000.0, "20260802": 1785700000.0, "20260803": 1785800000.0}
+
+
+def tree(tag, realised=RECORDED_REALISED, by_type_asset=None, flow_on_last=True):
+    """A three-day pilot_log whose LAST day is the transfer day under test."""
+    # each case gets its OWN mode root, because the record file lives beside pilot_log and a shared
+    # parent would let one case's records answer another's (it did, on the first run of this suite)
+    root = os.path.join(tmp, tag, "pilot_log")
+    for day in sorted(NAV):
+        lg = PL.PilotLogger(root, day)
+        ats = NAV_TS[day] - 100.0
+        lg.anchor(anchor_ts=ats, target_vector_hash="h", realized_gross=4401.87,
+                  target_gross=4401.87, n_names_skipped=0, regime_at_anchor="calm",
+                  mid_at_anchor_vector={"AAAUSDT": 1.0}, factor_version="f", panel_hash="p")
+        lg.order(anchor_ts=ats, symbol="AAAUSDT", side="buy", target_w=1.0, prev_w=1.0,
+                 intended_notional=0.0, order_type="maker", submit_ts=ats, price_submit=1.0,
+                 mid_at_submit=1.0, mid_at_anchor=1.0, filled_notional=0.0, avg_fill_px=None,
+                 first_fill_ts=None, last_fill_ts=None, cancel_ts=ats + 5, fee_paid=0.0,
+                 rebalance_id=f"A{int(ats)}", attempt_idx=1, terminal_reason="partial_expired",
+                 notional_currency="USDT")
+        lg.position_readback(anchor_ts=ats, symbol="AAAUSDT", venue_position_notional=4401.87,
+                             venue_position_qty=4401.87, source="mock", read_ts=ats + 10)
+        last = (day == "20260803")
+        lg.daily_nav(**nav_row(day, NAV_TS[day],
+                               realised if last else 0.0,
+                               FLOW if (last and flow_on_last) else 0.0,
+                               by_type_asset if last else None))
+        lg.close()
+    return root
+
+
+def record_for(root, day, line, amended_usdt, sha=None):
+    """An amendment record in the real builder's shape, its row_sha256 taken from the file."""
+    p = os.path.join(root, day, "daily_nav.jsonl")
+    raw = open(p, "rb").read().splitlines(keepends=True)
+    return {"kind": "daily_nav_realised_split_amendment", "day": day, "line": line,
+            "row_sha256": sha if sha is not None else hashlib.sha256(raw[line - 1]).hexdigest(),
+            "nav_ts": NAV_TS[day], "window_ms": [0, 1], "n_income_rows": 42,
+            "reason": "written before the E-0909-H carrier fix (b681ca5, 2026-09-12 06:05Z)",
+            "recorded": {"realised_pnl": RECORDED_REALISED, "realised_by_type": {},
+                         "realised_truncated": False},
+            "amended": {"realised_by_type_asset": {}, "realised_usdt_by_type": {},
+                        "realised_pnl_usdt": amended_usdt, "non_usdt_unconverted": {}},
+            "source": {"income_ledger": "guard_twin state/income.jsonl",
+                       "income_sha256": "ffbb1102" + "0" * 56, "income_rows": 109545,
+                       "key": "(tranId, incomeType, symbol, time, income)"}}
+
+
+def write_amendments(root, records, extra_lines=()):
+    """The records where the apply step puts them: <mode root>/ledger_amendments/…"""
+    d = os.path.join(os.path.dirname(os.path.normpath(root)), "ledger_amendments")
+    os.makedirs(d, exist_ok=True)
+    p = os.path.join(d, "daily_nav_realised_split.jsonl")
+    with open(p, "w") as f:
+        for r in records:
+            f.write(json.dumps(r, sort_keys=True) + "\n")
+        for l in extra_lines:
+            f.write(l + "\n")
+    return p
+
+
+def cond4(root):
+    ev = WD.evaluate(root, venue_events=[], ops_stats=[])
+    return ev, (ev.get("conditions", {}).get("cond4_drawdown") or {})
+
+
+def amend_block(c4):
+    return c4.get("realised_amendments") or {}
+
+
+def expected_cum(realised):
+    """The chain's own formula, by hand: D1 is the starting equity, D2 an ordinary day (nav ratio),
+    D3 a transfer day ((realised + unrealised − unrealised_prev) / nav_prev)."""
+    r2 = NAV["20260802"] / NAV["20260801"] - 1.0
+    r3 = (realised + UNREAL["20260803"] - UNREAL["20260802"]) / NAV["20260802"]
+    return round(((1 + r2) * (1 + r3) - 1.0) * 100, 4)
+
+
+# ══════════════════════════════════════════════════════════════════════════════════════════
+print("\n[A] a valid record prices the day")
+# ══════════════════════════════════════════════════════════════════════════════════════════
+_rootA = tree("amended")
+write_amendments(_rootA, [record_for(_rootA, "20260803", 1, AMENDED_REALISED)])
+_evA, _c4A = cond4(_rootA)
+_bA = amend_block(_c4A)
+check("★★★ A1 a pre-fix transfer day with a valid record is priced from the RECORD, not from the "
+      "row: the cumulative equity return is the amended one and differs from the recorded one by "
+      "exactly the chain's own arithmetic (ef60f85 prices it from the row)",
