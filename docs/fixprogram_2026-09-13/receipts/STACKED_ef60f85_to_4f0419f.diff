+      and q[0]["row"]["trade_id"] == orig["trade_id"] and len(getattr(lg, "fill_quarantined", [])) == 1,
+      (r_dup, len(day_rows(root)), [x.get("kind") for x in q]))
+bad_sup = dict(orig, supersedes_trade_id=orig["trade_id"], mid_at_fill_plus_60s=1.0, fill_notional=123456.0)
+check("G3 a supersede that changes a fact column ⇒ False, kind supersede_changes_fact_columns",
+      lg.fill(**bad_sup) is False and day_rows(root, "fills_quarantine.jsonl")[-1]["kind"] == "supersede_changes_fact_columns")
+fl = [r for r in R12 if r["order_type"] == "protective_flatten"][0]
+good_sup = dict(fl, mid_at_fill_plus_60s=2500.0, mark_source="aggTrades", mark_ts_actual=1.0, mark_lag_s=0.2,
