+                         for t in (_exp[0], "⚠️ HIGH\n" + _exp[0])), _exp)
+st2, ev2 = PNS.evaluate({"positions_notional": {"YYYUSDT": 100.0}, "positions_unrealized": {"YYYUSDT": -40.0}},
