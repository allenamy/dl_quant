+"""EXE-01: a book-level response only for book-level evidence — the watchdog's PROPORTIONALITY GATE (R-14 read as A, ON).
+
+*** MOCK ONLY: MockBroker, temp state dirs, pilot_log trees built in tmp. No venue, no credentials, no network, nothing
+    written under state/. ***
+
+THE DEFECT (quant_research docs/fixprogram_2026-09-13/FX_W6C/FACT_TABLE_W6C.md): every trip ran the same ladder — halt,
+cancel, flatten EVERY position — whatever fired. On the live record 5 of 10 whole-book flattens came from triggers whose
+evidence was a handful of named symbols; 4 of those were two-name events at 0.42–1.84% of gross (08-01 and 09-12 our own
+instruments, 08-21 and 08-26 real two-name venue changes). The user's rules (2026-09-12: instrument doubt must never
+trigger a book-level response, a book-level response must pass a proportionality gate; 2026-09-13: fix known issues
+without waiting) settle the ruling R-14 as option A, switch ON, with the frozen 2% / 5-name thresholds.
+
+WHAT THIS SUITE PROVES, on this tree:
+  [A]  the headline and its neighbours, through `watchdog.run` on a held MockBroker book — a single-name §4-5b/§4-5e/§4-7
+       set flattens THAT name only (the base ef60f85 flattens all 100 names — red for the right reason); 4/5/6 names;
+       1.999 / 2.000 / 2.001% of gross; the union across classes; book-level triggers beside a named set; unknown doubt
+       and unknown gross; the real 2026-09-12 12Z rows re-shaped so (a)(b) keeps the contradiction; the config switch off.
+  [N]  negative controls: §4-2 day loss, §4-4b leverage, §4-5a outage and §4-5c account-side anomaly on the same held
+       book still flatten EVERY name and set reduce-only (green on both trees by design).
+  [B]  the local action itself (cancel-before-flatten on the named names only, re-read + retry, unreadable positions,
+       refused flatten, a standing trip not overwritten), the EMA reset exemption, the page composition and its tier,
+       reconcile's order-independent doubt (review C9), the kind-agnostic source pins, the unreadable-book equality probe,
+       the 09-09 receipt's name sets.
+WHAT IT DOES NOT PROVE: the venue's behaviour for reduce-only market exits during -4400 / price protection (MockBroker);
+that the off-box page is DELIVERED (run_anchor's wiring is pinned statically here, delivery is the anchor's receipt);
+`ops/resume_from_trip.sh` / `ops/unseed_rehearsal_halt.py` end to end (both run a public network probe — their refusal
+branches are pinned statically, the EMA keep/remove snippet is executed verbatim); that 2% / 5 are the right numbers
+(policy, set after the incident, frozen).
+
+Old-code proof: this file on ef60f85 (`/Users/haosiyu/cc_tmp/fx_w6c_base`) must reach its summary line — every new name
+is looked up with getattr — and fail the [A]/[B] cells for the right reason (the whole book flattened / no local response).
+
+Exit 0 = all pass.
+"""
+import copy
+import json
+import math
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+for _d in ("scheduler", "ops", "signal"):
+    sys.path.insert(0, os.path.join(REPO, _d))
+
+import book_config as BC               # noqa: E402
+import pilot_log as PL                 # noqa: E402
+import reconcile as RC                 # noqa: E402
+import watchdog as WD                  # noqa: E402
+import watchdog_inputs as WI           # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:500]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+def _safe(fn, default=None):
+    try:
+        return fn()
+    except Exception as e:                                   # noqa: BLE001 — a missing API on the old tree is a FAIL, not a crash
+        return {"_raised": f"{type(e).__name__}: {str(e)[:160]}"} if default is None else default
+
+
+T1, T2 = 1789000000.0, 1789014400.0
+NAMES = [f"S{i:03d}USDT" for i in range(100)]
+EACH = 1000.0
+
+
+def build(resid=None, n=100, target_gross=None, nav_change_pct=0.0, readback_nan=(), anchors=True, nav_override=None,
+          extra_orders_t2=()):
+    """A 100-name held book, two anchors (T1 baseline, T2 compared). `resid` {symbol: contracts added at T2} makes the
+    T2 readback differ from what the orders explain (mark 1.0, so USDT == contracts). Every order is submitted and fills
+    nothing, so both anchors are REBALANCE anchors (§4-5e tracks a real intent: target_w × target_gross = the held 1000)."""
+    resid = dict(resid or {})
+    root = tempfile.mkdtemp(prefix="exe01_fx_")
+    names = NAMES[:n]
+    tg = float(target_gross if target_gross is not None else n * EACH)
+    for day, ts, second in (("20260910", T1, False), ("20260911", T2, True)):
+        lg = PL.PilotLogger(root, day)
+        if anchors:
+            lg.anchor(anchor_ts=ts, target_vector_hash="h", realized_gross=n * EACH, target_gross=tg, n_names_skipped=0,
+                      regime_at_anchor="calm", mid_at_anchor_vector={s: 1.0 for s in names}, factor_version="f",
+                      panel_hash="p")
+        for s in names:
+            lg.order(anchor_ts=ts, symbol=s, side="buy", target_w=EACH / tg, prev_w=EACH / tg, intended_notional=0.0,
+                     order_type="maker", submit_ts=ts + 1, price_submit=1.0, mid_at_submit=1.0, mid_at_anchor=1.0,
+                     filled_notional=0.0, avg_fill_px=None, first_fill_ts=None, last_fill_ts=None, cancel_ts=ts + 5,
+                     fee_paid=0.0, rebalance_id=f"A{int(ts)}", attempt_idx=1, terminal_reason="partial_expired",
+                     notional_currency="USDT")
+            q = EACH + (resid.get(s, 0.0) if second else 0.0)
+            lg.position_readback(anchor_ts=ts, symbol=s, venue_position_notional=q, venue_position_qty=q, source="mock",
+                                 read_ts=ts + 10)
+        nav0 = tg / 2.0
+        lg.daily_nav(day=int(day), target_gross=tg, nav=(nav_override if (second and nav_override) else
+                                                          (nav0 * (1 + nav_change_pct / 100.0) if second else nav0)),
+                     sizing_policy="constant_leverage_2.00", realised_pnl=0.0, unrealised_pnl=0.0)
+        lg.close()
+    d2 = os.path.join(root, "20260911")
+    if readback_nan:
+        p = os.path.join(d2, "position_readback.jsonl")
+        rows = [json.loads(l) for l in open(p) if l.strip()]
+        for r in rows:
+            if r["symbol"] in readback_nan:
+                r["venue_position_notional"] = float("nan")
+        open(p, "w").write("".join(json.dumps(r) + "\n" for r in rows))
+    if extra_orders_t2:
+        with open(os.path.join(d2, "orders.jsonl"), "a") as f:
+            for r in extra_orders_t2:
+                f.write(json.dumps(r) + "\n")
+    return root
+
+
+def unknown_leg(sym, intended, t):
+    """A submitted T2 leg whose amount was never read: `execution_of_unknown_size` in reconcile (raw row; the logger's
+    not-null rule would refuse a NaN intended, which is exactly the unreadable case this must represent)."""
+    return {"anchor_ts": T2, "symbol": sym, "side": "buy", "target_w": 0.01, "prev_w": 0.01, "intended_notional": intended,
+            "order_type": "topup_taker", "submit_ts": t, "price_submit": None, "mid_at_submit": 1.0, "mid_at_anchor": 1.0,
+            "filled_notional": None, "avg_fill_px": None, "first_fill_ts": t, "last_fill_ts": t, "cancel_ts": None,
+            "fee_paid": None, "rebalance_id": f"A{int(T2)}", "attempt_idx": 2, "terminal_reason": "filled_amount_unknown",
+            "notional_currency": "USDT"}
+
+
+def held_broker(resid=None, n=100, fail_submit=False, resting=None):
+    pos = {s: EACH + float((resid or {}).get(s, 0.0)) for s in NAMES[:n]}
+    b = WD.MockBroker(positions=dict(pos), fail_submit=fail_submit, resting=resting)
+    b._notional = dict(pos)
+    return b
+
+
+def run(root, broker, venue_events=(), switch=None, state_seed=None):
+    ops = WI.derive_ops_stats(root)
+    sdir = tempfile.mkdtemp(prefix="exe01_state_")
+    if state_seed is not None:
+        json.dump(state_seed, open(os.path.join(sdir, "state.json"), "w"))
+    if switch is None:
+        ev, brk, st = WD.run(root, broker=broker, venue_events=list(venue_events), ops_stats=ops, verbose=False,
+                             state_dir=sdir)
+    else:
+        cfg = json.load(open(BC.path()))
+        cfg["watchdog_proportional_response"] = {"enabled": bool(switch)}
+        tmpb = os.path.join(tempfile.mkdtemp(prefix="exe01_book_"), "book.json")
+        json.dump(cfg, open(tmpb, "w"))
+        with BC._using(tmpb):
+            ev, brk, st = WD.run(root, broker=broker, venue_events=list(venue_events), ops_stats=ops, verbose=False,
+                                 state_dir=sdir)
+    return ev, brk, st, sdir, ops
+
+
+def acts(brk, kind):
+    return [a for a in brk.actions if a.get("action") == kind]
+
+
+def flattened_symbols(brk):
+    return sorted({o["symbol"] for a in acts(brk, "flatten_all") for o in (a.get("orders") or [])})
+
+
+def ladder_whole_book(ev, brk, st, n=100):
+    """The full response: tripped, reduce-only set, a degradation record, and EVERY held name in a flatten order."""
+    return (ev.get("tripped") is True and brk.reduce_only is True and isinstance(st.get("degradation"), dict)
+            and flattened_symbols(brk) == sorted(NAMES[:n]))
+
+
+def local_only(ev, brk, st, names):
+    """The proportional response: NOT tripped, one local response naming exactly `names`, opening halted, the reduce-only
+    key NOT set, no degradation, and every flattened symbol is one of `names`."""
+    lrs = ev.get("local_responses") or []
+    return (ev.get("tripped") is False and len(lrs) == 1 and sorted(lrs[0].get("names") or []) == sorted(names)
+            and brk.open_orders_halted is True and brk.reduce_only is False and "degradation" not in st
+            and set(flattened_symbols(brk)) <= set(names) and st.get("kind") == "proportional_local")
+
+
+def rm(*paths):
+    for p in paths:
+        shutil.rmtree(p, ignore_errors=True)
+
+
+# ════════════════════════════ [A] the headline and its neighbours ════════════════════════════════════════════════════
+print("[A0] control: the clean held book does not trip and asks for no local response")
+r = build()
+ev, brk, st, sd, ops = run(r, held_broker())
+check("★ A0 no anomaly ⇒ not tripped, no local response, nothing flattened",
+      ev["tripped"] is False and not ev.get("local_responses") and acts(brk, "flatten_all") == [], ev["triggers"])
+rm(r, sd)
