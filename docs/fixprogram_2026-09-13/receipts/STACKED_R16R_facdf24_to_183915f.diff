+#!/usr/bin/env python3
+"""R16R-E1 (independent review, second round, 2026-09-16): a position quantity that is not a finite number is UNKNOWN.
+
+WHY THIS FILE EXISTS. The first-round E1 fix taught `watchdog._local_response` to treat a non-finite quantity as
+unknown. But the BROKER's `positions()` filtered on `abs(float(x)) > 0`, which is False for NaN — so a NaN
+`positionAmt` never reached the watchdog: the account looked flat, stage 1 of the degradation ladder reported
+`stage1_ok=True, flat_on_reread=True`, and `flatten_all` given a non-finite quantity built and SENT an order.
+"存在但不是有限数 = 仓位未知, 不是仓位为零" has to hold at the first place the number is parsed.
+
+Three behaviours, each pre/post:
+  [1] BinanceBroker.positions()  — REAL method, only `_request` stubbed — keeps NaN and ±inf, drops exact 0
+  [2] BinanceBroker.flatten_all() — REAL method — given only non-finite quantities builds NO order, records
+      `flatten_skip_nonfinite` per symbol, never reaches submission (so no submit stub is needed)
+  [3] watchdog._degradation_ladder stage 1 — fed what THIS tree's broker returns for a NaN account:
+      ok is False and the name is listed as unknown; finite and empty books unchanged
+  [C] control: pre-fix broker+watchdog from git (defect shape: positions() has no non-finite branch) → the
+      NaN account becomes an empty book and stage 1 passes; flatten_all attempts submission — RED
+The control is reported UNAVAILABLE (exit 3) if no ancestor carries the pre-fix shape; never faked.
+DRY_RUN is not used: `positions()` returns {} in DRY_RUN and the parse under test would never run.
+"""
+import importlib.util, os, subprocess, sys, tempfile
+HERE = os.path.dirname(os.path.abspath(__file__)); REPO = os.path.dirname(HERE)
+for d in ("live", "ops", "scheduler", "signal"): sys.path.insert(0, os.path.join(REPO, d))
+FAILS, N = [], [0]
+def check(name, ok, detail=None):
+    N[0] += 1
+    if not ok: FAILS.append(name)
+    print(("  OK   " if ok else "  FAIL ") + name + (("  — " + str(detail)[:240]) if detail is not None else ""), flush=True)
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path); m = importlib.util.module_from_spec(spec)
+    sys.modules[name] = m; spec.loader.exec_module(m); return m
+NAN_ACCT = {"positions": [{"symbol": "NANUSDT", "positionAmt": "nan"}, {"symbol": "ZEROUSDT", "positionAmt": "0"}]}
+FULL_ACCT = {"positions": [{"symbol": "NANUSDT", "positionAmt": "nan"}, {"symbol": "INFUSDT", "positionAmt": "1e9999"},
+                           {"symbol": "TENUSDT", "positionAmt": "10"}, {"symbol": "ZEROUSDT", "positionAmt": "0"}]}
+class FakeForLadder:
+    def __init__(self, pos): self._pos = pos; self.actions = []; self.flattened = []
+    def halt_opening_orders(self, r): pass
+    def open_orders(self): return []
+    def cancel_all_open_orders(self, s, r): pass
+    def set_reduce_only(self, *a, **k): return True
+    def positions(self): return dict(self._pos)
+    def flatten_all(self, held, reason):
+        self.flattened.append(dict(held)); self._pos = {k: 0.0 for k in self._pos}
+        self.actions.append({"action": "flatten_all", "orders": []}); return []
+
+def arms(bb_path, wd_path, tag):
+    BB = load(bb_path, "bb_" + tag); WD = load(wd_path, "wd_" + tag)
+    class Probe(BB.BinanceBroker):                      # real positions()/flatten_all(); only the wire is replaced
+        def __init__(self, acct): self.mode = "LIVE"; self.actions = []; self._acct = acct
+        def _request(self, *a, **k): return self._acct
+    r = {}
+    pos = Probe(FULL_ACCT).positions()
+    r["pos_keys"] = sorted(pos); r["nan_kept"] = "NANUSDT" in pos; r["inf_kept"] = "INFUSDT" in pos
+    r["ten_kept"] = "TENUSDT" in pos; r["zero_dropped"] = "ZEROUSDT" not in pos
+    b = Probe(FULL_ACCT)
+    try:
+        orders = b.flatten_all({"NANUSDT": float("nan"), "INFUSDT": float("inf")}, "test")
+        r["flat_orders"] = len(orders); r["flat_submitted"] = False
+        r["flat_skips"] = sorted(a["symbol"] for a in b.actions if a.get("action") == "flatten_skip_nonfinite")
+    except Exception as e:                                # noqa: BLE001 — pre-fix reaches submission and fails there
+        r["flat_orders"] = None; r["flat_submitted"] = True; r["flat_skips"] = []; r["flat_exc"] = f"{type(e).__name__}: {e}"
+    chain = Probe(NAN_ACCT).positions()                   # what the ladder is handed for a NaN account in THIS tree
+    r["chain_input"] = {k: repr(v) for k, v in chain.items()}
+    for lab, p in (("chain", chain), ("finite", {"TENUSDT": 10.0}), ("empty", {})):
+        f = FakeForLadder(p); d = tempfile.mkdtemp()
+        o = WD._degradation_ladder(f, dict(p), "test", os.path.join(d, "ALARM.log"), verbose=False, max_retries=2)
+        r[lab] = {"ok": o.get("stage1_ok"), "unknown": o.get("stage1_position_unknown_names"),
+                  "flat_on_reread": o.get("stage1_flat_on_reread"), "flatten_calls": len(f.flattened)}
+    return r
+
+print("[A] current tree")
+a = arms(os.path.join(HERE, "binance_broker.py"), os.path.join(HERE, "watchdog.py"), "cur")
+check("★★★ A1 positions(): NaN and ±inf are KEPT (unknown), 10 kept, exact 0 dropped",
+      a["nan_kept"] and a["inf_kept"] and a["ten_kept"] and a["zero_dropped"], a["pos_keys"])
+check("★★★ A2 flatten_all(non-finite only): 0 orders, never reaches submission, one flatten_skip_nonfinite per symbol",
+      a["flat_orders"] == 0 and not a["flat_submitted"] and a["flat_skips"] == ["INFUSDT", "NANUSDT"], (a["flat_orders"], a["flat_submitted"], a["flat_skips"]))
+check("★★★ A3 stage 1 fed a NaN account through THIS broker: ok False, NANUSDT listed unknown, no flatten call",
+      a["chain"]["ok"] is False and a["chain"]["unknown"] == ["NANUSDT"] and a["chain"]["flatten_calls"] == 0, (a["chain_input"], a["chain"]))
+check("★★ A4 finite book still flattens (ok True, one call) and empty book still reads flat (ok True, flat_on_reread True)",
+      a["finite"]["ok"] is True and a["finite"]["flatten_calls"] == 1 and a["empty"]["ok"] is True and a["empty"]["flat_on_reread"] is True, (a["finite"], a["empty"]))
+
+print("\n[C] red capability: pre-fix broker + watchdog from git (defect shape: no non-finite branch in positions())")
+pre = None
+for ref in ("HEAD", "HEAD~1", "HEAD~2", "HEAD~3"):
+    cb = subprocess.run(["git", "-C", REPO, "show", f"{ref}:live/binance_broker.py"], capture_output=True, text=True)
+    cw = subprocess.run(["git", "-C", REPO, "show", f"{ref}:live/watchdog.py"], capture_output=True, text=True)
+    if cb.returncode == 0 and cw.returncode == 0 and "flatten_skip_nonfinite" not in cb.stdout and "_unk1" not in cw.stdout:
+        pre = (ref, cb.stdout, cw.stdout); break
+if pre is None:
+    print("  UNAVAIL C  no ancestor within HEAD..HEAD~3 carries the pre-fix shape — control not run, not faked")
+    print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed; control UNAVAILABLE"); sys.exit(3 if not FAILS else 1)
+print(f"  (control source: {pre[0]})")
+td = tempfile.mkdtemp(); pb = os.path.join(td, "bb_pre.py"); pw = os.path.join(td, "wd_pre.py")
+open(pb, "w").write(pre[1]); open(pw, "w").write(pre[2])
+c = arms(pb, pw, "pre")
+check("★★★ C1 (PRE-FIX: RED) positions() DROPS NaN (abs(nan)>0 is False) — the account looks flat",
+      not c["nan_kept"], c["pos_keys"])
+check("★★★ C2 (PRE-FIX: RED) flatten_all(non-finite) builds orders and reaches submission",
+      c["flat_submitted"] and c["flat_skips"] == [], c.get("flat_exc"))
+check("★★★ C3 (PRE-FIX: RED) NaN account → empty book → stage 1 passes silently (ok True, flat_on_reread True) — the reviewer's counterexample",
+      c["chain_input"] == {} and c["chain"]["ok"] is True and c["chain"]["flat_on_reread"] is True, (c["chain_input"], c["chain"]))
+check("★★ C4 baseline [A] green and control [C] red on the SAME inputs — the pair is the evidence",
+      a["nan_kept"] and not c["nan_kept"] and a["chain"]["ok"] is False and c["chain"]["ok"] is True)
+print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed")
+if FAILS: print("FAILED:", *FAILS, sep="\n  "); sys.exit(1)
+print("ALL PASS")
