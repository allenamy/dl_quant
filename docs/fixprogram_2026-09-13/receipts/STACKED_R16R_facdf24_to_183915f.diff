@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""R16R-E3 (independent review, second round, 2026-09-16): the daily summary's REAL entry point on a REAL state layout.
+
+WHY THIS FILE EXISTS. The first-round fix made `realised_facts` consume the shared amendment verifier — and
+`tests_daily_summary` stayed green twice — while `main()` handed the verifier `root` where it needs
+`plog = root/pilot_log`. One directory level wrong, and a VALID amendment (101) was silently reported as
+the recorded value (11) with the row marked unreliable. The suite never noticed because it calls the
+functions, not the entry. This file drives `main()` itself: same argv parsing, same `state_root.paths_for`
+call (patched to a temp root of the real shape), same three call sites. It asserts on the rendered account
+because that is what the operator reads.
+
+Two arms, pre-registered:
+  [A] current tree       → the amended 101 reaches the account section (rendered `当日已实现 +101.0000 USDT [口径: …修订记录…]`)
+  [B] pre-fix ops/daily_summary.py from git (the root-instead-of-plog version), if reachable → the recorded 12.0000
+Arm [B] is the red-capability control WITH an asserted-green baseline ([A]); if no pre-fix source can be read the
+control is reported UNAVAILABLE (exit 3), never faked.
+
+Fixture details that are NOT incidental (each one was a way this test silently drove the wrong thing on first run):
+  * nav_ts values are real 2026-09-01 epochs — `--since Nh` means "the last N hours", so a 1970 timestamp is outside
+    every window and the account section is simply not rendered;
+  * the temp root carries an EMPTY notify_audit.jsonl — main() falls back to <repo>/state/notify_audit.jsonl when the
+    root has none, which pulled the real alarm log (670 lines) into the "rendered" text;
+  * paths_for is patched by re-rooting the REAL dict, so every key main() may read points into the temp root.
+"""
+import hashlib, importlib.util, io, json, os, subprocess, sys, tempfile, contextlib
+
+HERE = os.path.dirname(os.path.abspath(__file__)); REPO = os.path.dirname(HERE)
+sys.path.insert(0, HERE); sys.path.insert(0, os.path.join(REPO, "ops"))
+KIND = "daily_nav_realised_split_amendment"
+FAILS, N = [], [0]
+
+def check(name, ok, detail=None):
+    N[0] += 1
+    if not ok: FAILS.append(name)
+    print(("  OK   " if ok else "  FAIL ") + name + (("  — " + str(detail)[:220]) if detail is not None else ""), flush=True)
+
+def build_root():
+    """<root>/pilot_log/<day>/daily_nav.jsonl (2 rows) + <root>/ledger_amendments/… (1 VALID record for row 1)."""
+    root = tempfile.mkdtemp(prefix="ds_entry_"); day = "20260901"; T0 = 1788220800.0      # 2026-09-01T00:00:00Z
+    plog = os.path.join(root, "pilot_log", day); os.makedirs(plog)
+    open(os.path.join(root, "notify_audit.jsonl"), "w").close()      # present and empty: no fallback to the repo's real one
+    rows = [{"day": day, "nav_ts": T0 + 60.0, "nav": 1000.0, "prev_nav": 990.0, "wallet_balance": 1000.0, "unrealised_pnl": 0.0,
+             "realised_pnl": 11.0, "realised_by_type": {"COMMISSION": 11.0}, "external_flow_usdt": 0.0, "mode": "LIVE",
+             "realised_pnl_source": "test", "realised_truncated": False},
+            {"day": day, "nav_ts": T0 + 3600.0, "nav": 1001.0, "prev_nav": 990.0, "wallet_balance": 1001.0, "unrealised_pnl": 0.0,
+             "realised_pnl": 12.0, "realised_by_type": {"COMMISSION": 12.0}, "external_flow_usdt": 0.0, "mode": "LIVE",
+             "realised_pnl_source": "test", "realised_truncated": False}]
+    raw = b"".join((json.dumps(r, separators=(",", ":")) + "\n").encode() for r in rows)
+    open(os.path.join(plog, "daily_nav.jsonl"), "wb").write(raw)
+    line1 = raw.splitlines(keepends=True)[1]                       # the LAST row (the one the account reads); recorded 12.0
+    rec = {"kind": KIND, "day": day, "nav_ts": T0 + 3600.0, "line": 2, "row_sha256": hashlib.sha256(line1).hexdigest(),
+           "amended": {"realised_pnl_usdt": 101.0, "realised_usdt_by_type": {"COMMISSION": 101.0}},
+           "source": {"income_sha256": "t"}, "reason": "entry test"}
+    os.makedirs(os.path.join(root, "ledger_amendments"))
+    open(os.path.join(root, "ledger_amendments", "daily_nav_realised_split.jsonl"), "w").write(json.dumps(rec) + "\n")
+    return root
+
+def drive(module_path, root):
+    """Run the module's real main() with state_root.paths_for patched to `root`. Returns captured stdout."""
+    spec = importlib.util.spec_from_file_location("ds_under_test_%d" % abs(hash(module_path)), module_path)
+    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
+    import state_root as SR
+    real = SR.paths_for
+    def _rerooted(mode):                                           # the REAL dict with every path moved under `root`
+        d = dict(real(mode)); rr = d["root"]
+        return {k: (root + v[len(rr):] if isinstance(v, str) and v.startswith(rr) else v) for k, v in d.items()}
+    SR.paths_for = _rerooted
+    buf = io.StringIO(); argv = sys.argv
+    try:
+        sys.argv = ["daily_summary.py", "--since", "100000h", "--mode", "LIVE"]
+        with contextlib.redirect_stdout(buf):
+            try: m.main()
+            except SystemExit: pass
+    finally:
+        SR.paths_for = real; sys.argv = argv
+    return buf.getvalue()
+
+print("[A] current tree, real main(), real state layout")
+root = build_root()
+out_a = drive(os.path.join(REPO, "ops", "daily_summary.py"), root)
+_acct_a = [l for l in out_a.splitlines() if "当日已实现" in l]
+check("★★★ A1 the account section prices the last nav row from its VALID amendment: `当日已实现 +101.0000 USDT [口径: …修订记录…]`, not the recorded 12.0000",
+      any("+101.0000 USDT" in l and "修订记录" in l for l in _acct_a) and not any("+12.0000 USDT" in l for l in _acct_a), _acct_a[:2])
+check("★★ A2 …and the row is not called unreliable (that label was the symptom of the wrong directory), and the rendered text is the FIXTURE's "
+      "(no 2026-07/08 alarm lines: the audit fallback did not fire)",
+      "不可靠" not in out_a and "07-27" not in out_a and "08-01 00:01Z" not in out_a and "20260901" in out_a,
+      [l for l in out_a.splitlines() if "不可靠" in l][:2])
+check("★ A3 the same-day increment line reads the two rows through the SAME verifier: 已实现 +11.0000 → +101.0000 with the mixed-caliber note",
+      any("+11.0000 → +101.0000" in l for l in out_a.splitlines()), [l for l in out_a.splitlines() if "已实现 +" in l][:2])
+
+print("\n[B] red capability: the pre-fix entry (root instead of plog) on the SAME layout")
+# The pre-fix source is identified by its DEFECT SHAPE (it passes `root` where `plog` belongs), not by a fixed
+# ancestor: before the fix is committed that is HEAD, after it is HEAD~1, and a commit in between may not carry
+# the amendment root parameter at all. Probing the shape keeps the control pointed at the right bytes either way.
+old, old_ref = None, None
+for ref in ("HEAD", "HEAD~1", "HEAD~2", "HEAD~3"):
+    try:
+        cand = subprocess.run(["git", "-C", REPO, "show", f"{ref}:ops/daily_summary.py"], capture_output=True, text=True, check=True).stdout
+    except Exception:                                              # noqa: BLE001
+        continue
+    if "pilot_log_root=root)" in cand and "pilot_log_root=plog" not in cand:
+        old, old_ref = cand, ref; break
+if old is None:
+    print("  UNAVAIL B  no ancestor within HEAD..HEAD~3 carries the root-instead-of-plog shape — control not run, not faked")
+    print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed; control UNAVAILABLE")
+    sys.exit(3 if not FAILS else 1)
+print(f"  (control source: {old_ref}:ops/daily_summary.py)")
+tmp_old = os.path.join(tempfile.mkdtemp(), "daily_summary_prefix.py"); open(tmp_old, "w").write(old)
+out_b = drive(tmp_old, build_root())
+_acct_b = [l for l in out_b.splitlines() if "当日已实现" in l]
+check("★★★ B1 (PRE-FIX: RED) the same layout through the pre-fix main() shows the recorded +12.0000, NOT the amended +101.0000 — "
+      "the reviewer's counterexample, reproduced from the real entry expression",
+      any("+12.0000 USDT" in l for l in _acct_b) and not any("+101.0000 USDT" in l for l in _acct_b), _acct_b[:2])
+check("★★ B2 the two arms differ ONLY in that value — baseline [A] green, control [B] red: the pair is the evidence",
+      any("+101.0000 USDT" in l for l in _acct_a) and not any("+101.0000 USDT" in l for l in _acct_b))
+print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed")
+if FAILS:
+    print("FAILED:", *FAILS, sep="\n  "); sys.exit(1)
+print("ALL PASS")
