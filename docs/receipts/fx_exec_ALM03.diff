+"""Step 9 — is the position-rank monitor (#55, ops/ic_monitor.py) RUNNING and REPORTING? Read from its own evals ledger.
+
+ALM-03 = W5 (docs/DESIGN_factor_health_repoint_2026-09-12.md §2 with every §5 correction), FX-EXEC 2026-09-13.
+
+★★★ WHAT THIS REPLACES, AND WHY (fact table, read-only on the live tree and ef60f85):
+  · Step 9 called `check_factor_health.run()`, which ssh-reads a report on the research box (jpline) whose producer was RETIRED by
+    user ruling on 2026-08-06. Every anchor since: `factor_health_last.json = {reason: report_unreachable, decay_judged: false}`,
+    one INFO line, and one open episode (68f039b2, since 2026-09-04T12:45Z).
+  · Artefact assertion #9 ("decay monitored on the deployable caliber") passed whenever that report was ABSENT — i.e. on every anchor
+    since 08-06. A per-anchor gate reported PASS for a monitor that had watched nothing.
+  · The instrument that does measure the traded book already runs on THIS box: #55 `ops/ic_monitor.py` (launchd 01:30Z daily) judges
+    the rolling rank-IC of venue positions vs next-anchor returns and, since W1 (ef60f85, committed 2026-09-13T12:04:14Z), appends one
+    row per evaluation to `state/live/ic_monitor_evals.jsonl` (level / judged / r24 / r48 / trigger / judged_windows /
+    incomplete_windows / census{frontier_ts, newest_row_anchor_ts, r24, r48} / contract / eval_at). The live ledger did not exist yet
+    when this was written; its first row is due 2026-09-14T01:30Z.
+
+★★ WHAT THIS IS — AND IS NOT (§5-3). It checks the INPUT of a position-rank diagnostic: that #55 evaluated recently, that its row has
+   the contract shape, and that "not judged" comes with the census that explains it. It is NOT a model-score IC, NOT a carry/cost or
+   net-alpha monitor, and it issues NO decay verdict: #55's thresholds were stamped on a different α/band book (its own
+   CALIB_IDENTITY line says so), and #55 pages its own ALERT/DECIDE/INCOMPLETE. Re-paging those here would be a second stream with a
+   different body that hash de-duplication cannot join (§5-5) — so this file pages ONLY when the source is missing, stale, unreadable,
+   unstamped, or contradicts itself.
+
+★ STATES (one per evaluation; `ok` is True only for the first two):
+    JUDGED                  a judged row (OK / ALERT / DECIDE), fresh, whose observed newest anchor keeps up with the expected frontier
+    NOT_JUDGED              level INCOMPLETE with its census and incomplete windows — the freshness gate WORKING; not_judged_reason
+                            names the missing anchors
+    LEDGER_ABSENT_IN_GRACE  no ledger yet, and the check runs before GRACE_UNTIL — a fixed instant (W1 live + 30 h), never reset by a
+                            run or by the file being missing (§5-4); INFO, not paged
+    LEDGER_ABSENT           no ledger after GRACE_UNTIL — #55 has not written a single evaluation; HIGH
+    LEDGER_UNREADABLE       the file or its last row cannot be read as an object; HIGH
+    SHAPE                   the last row lacks a contract field; HIGH
+    EVAL_STALE              the last evaluation is older than MAX_EVAL_AGE_H — #55 stopped running; HIGH
+    UNSTAMPED               #55 reports its thresholds unstamped; HIGH
+    DATA_LAG_CONTRADICTION  judged, yet its observed newest anchor lags its own expected frontier by more than MAX_LAG_ANCHORS; HIGH
+    NOT_JUDGED_WITHOUT_CENSUS  not judged without the census/incomplete windows that would explain it; HIGH
+  The two clocks are separate (§5-2): `eval_at` says the monitor RAN; `census.newest_row_anchor_ts` against `census.frontier_ts` says
+  its DATA moved. Both are recorded on every state.
+"""
+from __future__ import annotations
+
+import calendar
+import json
+import os
+import time
+from typing import Any, Dict, Optional, Tuple
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+EVALS = os.path.join(REPO, "state", "live", "ic_monitor_evals.jsonl")     # = ic_monitor.EVALS (pinned equal by the suite)
+LAST = os.path.join(REPO, "state", "rank_monitor_input_last.json")
+SUBJECT = "rank_monitor_input"
+NAME = "持仓排序监控输入(#55 书级实现 rank-IC 的评估账本)"
+W1_EVALS_LIVE_UTC = "2026-09-13T12:04:14Z"      # ef60f85 commit time — the first deployed code that appends to the evals ledger
+LEDGER_GRACE_H = 30.0
+GRACE_UNTIL_TS = calendar.timegm(time.strptime(W1_EVALS_LIVE_UTC, "%Y-%m-%dT%H:%M:%SZ")) + LEDGER_GRACE_H * 3600
+# #55 runs once a day (launchd 01:30Z): one cycle plus two hours for a late run — the same arithmetic as check_factor_health's 26 h
+MAX_EVAL_AGE_H = 26.0
+GRID_S = 14400                                   # = ic_monitor.GRID_S
+MAX_LAG_ANCHORS = 2                              # = ic_monitor.MAX_MISSING["r24"]: a judged r24 window tolerates at most this many
+REQUIRED = ("eval_at", "level", "judged", "contract")
+HIGH_STATES = ("LEDGER_ABSENT", "LEDGER_UNREADABLE", "SHAPE", "EVAL_STALE", "UNSTAMPED", "DATA_LAG_CONTRADICTION",
+               "NOT_JUDGED_WITHOUT_CENSUS")
+
+
+def iso(t: Optional[float]) -> Optional[str]:
+    return None if t is None else time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(float(t)))
+
+
+def read_last_eval(path: str = EVALS) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
+    """(last row, None) or (None, why). 'absent' is its own why — the only one that can be inside the grace."""
+    if not os.path.exists(path):
+        return None, "absent"
+    try:
+        lines = [l for l in open(path, encoding="utf-8").read().splitlines() if l.strip()]
+    except (OSError, UnicodeDecodeError) as e:
+        return None, f"the ledger could not be read ({type(e).__name__}: {e})"
+    if not lines:
+        return None, "the ledger exists and holds no row"
+    try:
+        rec = json.loads(lines[-1])
+    except ValueError as e:
+        return None, f"its last row is not JSON ({e})"
+    if not isinstance(rec, dict):
+        return None, f"its last row is a {type(rec).__name__}, not an object"
+    return rec, None
+
+
+def evaluate_ledger(rec: Optional[Dict[str, Any]], err: Optional[str], now: Optional[float] = None,
+                    path: str = EVALS) -> Dict[str, Any]:
+    now = time.time() if now is None else float(now)
+    out: Dict[str, Any] = {"source": "ic_monitor_evals", "subject": NAME, "evals_path": path, "checked_at": now,
+                           "checked_at_iso": iso(now), "grace_until": iso(GRACE_UNTIL_TS), "w1_evals_live": W1_EVALS_LIVE_UTC,
+                           "eval_at": None, "eval_at_iso": None, "eval_age_h": None, "max_eval_age_h": MAX_EVAL_AGE_H,
+                           "level": None, "judged": None, "judged_windows": None, "incomplete_windows": None,
+                           "trigger": None, "r24": None, "r48": None, "not_judged_reason": None,
+                           "expected_frontier": None, "observed_newest_anchor": None, "data_lag_anchors": None,
+                           "object": None, "decay_verdict": "none issued here — #55 pages its own levels (§5-5)"}
+    findings = []
+
+    def done(state, page=None):
+        """`page` is the STABLE sentence the episode is keyed on: it names the condition and the evaluation it concerns, never an age
+        or a clock reading — alarm_episode fingerprints the exact text, so a number that moves every anchor would page every anchor."""
+        high = state in HIGH_STATES
+        out.update(state=state, ok=state in ("JUDGED", "NOT_JUDGED"), severity="HIGH" if high else "INFO",
+                   findings=findings, page_findings=[page] if high else [],
+                   known_gap=state == "LEDGER_ABSENT_IN_GRACE")
+        return out
+
+    if err == "absent":
+        if now <= GRACE_UNTIL_TS:
+            findings.append(f"LEDGER_ABSENT_IN_GRACE: {path} does not exist yet; #55 first appends to it at its first 01:30Z run after "
+                            f"W1 went live ({W1_EVALS_LIVE_UTC}). Grace ends at the fixed instant {iso(GRACE_UNTIL_TS)}.")
+            return done("LEDGER_ABSENT_IN_GRACE")
+        findings.append(f"LEDGER_ABSENT: {path} still does not exist at {iso(now)}, "
+                        f"{(now - GRACE_UNTIL_TS) / 3600 + LEDGER_GRACE_H:.1f} h after W1 went live — #55 has not recorded one "
+                        f"evaluation, so nothing is watching the traded book's position ranking.")
+        return done("LEDGER_ABSENT", f"LEDGER_ABSENT: {path} does not exist after the fixed grace {iso(GRACE_UNTIL_TS)} — #55 has "
+                                     f"recorded no evaluation of the traded book's position ranking")
+    if err:
+        findings.append(f"LEDGER_UNREADABLE: {path}: {err}.")
+        return done("LEDGER_UNREADABLE", f"LEDGER_UNREADABLE: {path}: {err}")
+    missing = [k for k in REQUIRED if k not in rec]
+    if missing:
+        findings.append(f"SHAPE: the last evaluation row lacks {missing} — not the row #55's append_eval writes.")
+        return done("SHAPE", findings[-1])
+    try:
+        eval_at = float(rec["eval_at"])
+    except (TypeError, ValueError):
+        findings.append(f"SHAPE: eval_at {rec.get('eval_at')!r} is not a timestamp.")
+        return done("SHAPE", findings[-1])
+    cz = rec.get("census") if isinstance(rec.get("census"), dict) else {}
+    fr, newest = cz.get("frontier_ts"), cz.get("newest_row_anchor_ts")
+    out.update(eval_at=eval_at, eval_at_iso=iso(eval_at), eval_age_h=round((now - eval_at) / 3600.0, 2), level=rec.get("level"),
+               judged=rec.get("judged"), judged_windows=rec.get("judged_windows"), incomplete_windows=rec.get("incomplete_windows"),
+               trigger=rec.get("trigger"), r24=rec.get("r24"), r48=rec.get("r48"),
+               expected_frontier=iso(fr) if fr is not None else None,
+               observed_newest_anchor=iso(newest) if newest is not None else None,
+               data_lag_anchors=(None if fr is None or newest is None else round((float(fr) - float(newest)) / GRID_S, 2)),
+               object=(rec.get("contract") or {}).get("object") if isinstance(rec.get("contract"), dict) else None)
+    if (now - eval_at) / 3600.0 > MAX_EVAL_AGE_H:
+        findings.append(f"EVAL_STALE: #55's last evaluation is {(now - eval_at) / 3600.0:.1f} h old (limit {MAX_EVAL_AGE_H} h; it runs "
+                        f"daily at 01:30Z) — the monitor stopped running; its last level {rec.get('level')} describes {iso(eval_at)}, "
+                        f"not now.")
+        return done("EVAL_STALE", f"EVAL_STALE: #55's last evaluation is {iso(eval_at)}, older than {MAX_EVAL_AGE_H} h — the "
+                                  f"monitor stopped running")
+    level, judged = rec.get("level"), rec.get("judged")
+    if level == "UNSTAMPED":
+        findings.append(f"UNSTAMPED: #55 reports its thresholds unstamped ({rec.get('note')}).")
+        return done("UNSTAMPED", f"UNSTAMPED: #55's evaluation of {iso(eval_at)} reports its thresholds unstamped")
+    if judged is True and level in ("OK", "ALERT", "DECIDE"):
+        lag = out["data_lag_anchors"]
+        if lag is None or lag > MAX_LAG_ANCHORS:
+            findings.append(f"DATA_LAG_CONTRADICTION: #55 judged ({level}) while its observed newest anchor "
+                            f"{out['observed_newest_anchor']} lags its own expected frontier {out['expected_frontier']} by "
+                            f"{lag} anchors (a judged r24 window allows {MAX_LAG_ANCHORS}).")
+            return done("DATA_LAG_CONTRADICTION", findings[-1] + f" [evaluation {iso(eval_at)}]")
+        return done("JUDGED")
+    inc = rec.get("incomplete_windows")
+    if judged is False and level == "INCOMPLETE" and cz and isinstance(inc, list) and inc \
+            and all(isinstance(cz.get(k), dict) for k in inc):
+        out["not_judged_reason"] = "; ".join(
+            f"{k}: {cz[k].get('missing')} expected anchors missing > {cz[k].get('max_missing')} "
+            f"({', '.join((cz[k].get('missing_anchors') or [])[:6])}{' …' if len(cz[k].get('missing_anchors') or []) > 6 else ''})"
+            for k in inc)
+        findings.append(f"NOT_JUDGED: #55 evaluated at {iso(eval_at)} and honestly did not judge — {out['not_judged_reason']}. "
+                        f"#55 pages this itself; recorded here, not re-paged.")
+        return done("NOT_JUDGED")
+    findings.append(f"NOT_JUDGED_WITHOUT_CENSUS: level {level!r}, judged {judged!r}, incomplete_windows {inc!r} — a row that is not "
+                    f"judged must carry the census windows that explain it.")
+    return done("NOT_JUDGED_WITHOUT_CENSUS", findings[-1] + f" [evaluation {iso(eval_at)}]")
+
+
+def run(notifier=None, log=print, path: str = EVALS, now: Optional[float] = None) -> Dict[str, Any]:
+    res = evaluate_ledger(*read_last_eval(path), now=now, path=path)
+    try:
+        os.makedirs(os.path.dirname(LAST), exist_ok=True)
+        json.dump(res, open(LAST, "w"), indent=1, default=str, ensure_ascii=False)
+    except Exception as e:                                  # noqa: BLE001 — named in the log; the verdict below still runs
+        log(f"rank_monitor_input: could not persist {LAST}: {type(e).__name__}: {e}")
+    log(f"rank_monitor_input: state={res['state']} ok={res['ok']} level={res['level']} judged={res['judged']} "
+        f"eval_at={res['eval_at_iso']} age_h={res['eval_age_h']} frontier={res['expected_frontier']} "
+        f"newest={res['observed_newest_anchor']} lag={res['data_lag_anchors']}")
+    import alarm_episode as _AE
+    if not res["page_findings"]:
+        _AE.decide(SUBJECT, [], scope="global")             # closes any open episode
+        return res
+    _d = _AE.decide(SUBJECT, res["page_findings"], scope="global")
+    if not _d["alarm"]:
+        log(f"rank_monitor_input: {_d['reason']}")
+        res["alarm_suppressed_same_episode"] = True
+        return res
+    if notifier is not None:
+        rcpt = notifier.alarm("HIGH", "持仓排序监控输入: " + " | ".join(res["page_findings"])[:600])
+        res["alarm_receipt"] = rcpt
+        if rcpt.get("delivered_offbox") or rcpt.get("status") == "SUPPRESSED":
+            _AE.record(SUBJECT, _d["episode"], res["page_findings"], scope="global")
+    else:
+        log("rank_monitor_input: no notifier attached; episode NOT recorded")
+    return res
+
+
+if __name__ == "__main__":
+    print(json.dumps(evaluate_ledger(*read_last_eval()), indent=1, default=str, ensure_ascii=False))
