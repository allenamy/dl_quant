+            out["children_equal_confirmed"] = False
+            out["why"] = f"request {r.get('client_id')}: child fills {s} do not determine the confirmed quantity {c}"; return out
+        cap = _fin(r.get("qty_venue")) if r.get("qty_venue") is not None else _fin(r.get("qty"))
+        if cap is None or abs(c) > abs(cap) + 1e-9:
+            out["confirmed_equal_capacity"] = False
+            out["why"] = f"request {r.get('client_id')}: confirmed {c} exceeds the request capacity {cap}"; return out
