+_bad = [RC.Request("x", +1, 1.0, birth=0.0, terminal=0.5, exact=0.0, lower=1.0)]
+_rb = RC.feasible_exact(_bad, T, [0.0, 0.0, 0.0])
+check("★★★ G5a a request whose credible TOTAL is 0 while its evidence FLOOR is 1 is a hard "
+      "contradiction: status unmeasurable, distance None. No fact is dropped to make it "
+      "computable and no zero is invented (PREREG §1d.4)",
+      _rb["status"] == "unmeasurable" and _rb["distance"] is None,
+      {"status": _rb["status"], "distance": _rb["distance"]})
