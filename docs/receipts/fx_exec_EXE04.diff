+      "replayed under a different rule without the difference being visible",
+      json.dumps(_s1, sort_keys=True) == json.dumps(_s2, sort_keys=True)
+      and "chronological_admission" in _s1["policy"] and "rev4" in _s1["policy"],
+      _s1["policy"])
