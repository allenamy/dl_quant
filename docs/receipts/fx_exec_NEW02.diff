+def attempt_from_client_id(client_id, rebalance_id, symbol) -> Optional[int]:
+    """The attempt index ENCODED IN OUR OWN rebalance client id, or None — never a guess.
+
+    ★★ NEW-02. `binance_executor` mints `f"{rebalance_id}-{symbol}-{int(pl.get('attempt_idx') or 1)}"[:36]`, so for a
+    REBALANCE id the suffix IS the attempt: `-1` the first maker, `-2` a requote or a top-up leg. That is the only
+    place an attempt is recoverable from an id, and it is recoverable only because WE put it there.
+
+    ★★★ AND IT IS NOT TRUE OF A FLATTEN, WHICH IS WHY THIS CHECKS THE SHAPE INSTEAD OF SPLITTING ON THE LAST DASH.
+    `binance_broker.flatten_all` mints `F<yyyymmddHHMMSS>-SYM-<seq>` where `seq` is `next(_FLATTEN_SEQ)` — a
+    PROCESS-WIDE counter, deliberately not a per-symbol or per-attempt index (round 4, review E2: a retry inside the
+    same UTC second used to mint the same id). On the real 2026-09-12 12:47Z ladder those suffixes ran 1..255 across
+    255 orders that were EVERY ONE OF THEM attempt 1. So reading the suffix would not merely be unfounded, it would
+    be wronger than the leg-type proxy it replaces. A flatten id does not start with `{rebalance_id}-{symbol}-`
+    (the rebalance id there is `FLATTEN-<trip>`), so the shape test refuses it by construction.
+
+    ★ A 36-CHARACTER ID IS REFUSED. The mint truncates with `[:36]`, and a cut that lands inside the suffix leaves a
+    shorter number that still parses — `-12` becomes `-1`. No live id is anywhere near the limit (a rebalance id and
+    a symbol come to ~25 characters), so refusing at the boundary costs nothing real and removes the one way this
+    function could return a number that is wrong rather than absent.
+    """
+    cid = str(client_id or "")
+    if not cid or len(cid) >= 36:
+        return None
+    pre = f"{rebalance_id}-{symbol}-"
+    if not cid.startswith(pre):
+        return None
+    tail = cid[len(pre):]
+    if not tail.isdigit():
+        return None
+    try:
+        return int(tail)
+    except ValueError:                                  # pragma: no cover — isdigit already guarantees it
+        return None
+
+
