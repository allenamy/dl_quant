+++ b/fx/p9_rule_eval.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""p9_rule_eval.py — FIXPROGRAM 2026-09-13 P9: settlement-interval labelling rules scored against the exchange-declared zip column
+(data.binance.vision `funding_interval_hours`) over full history, with the exact v1-EMA and FTRIM impact of every mislabel.
+Input: ledger_full.npz (zip U API rows; zip_iv = declared interval, NaN for API-only rows). READ-ONLY. CPU only.
+Producer timing model: anchors on the 4h UTC grid; the producer reads funding at A + 16 min and appends every settlement in (A-4h, A];
+the latest row of a batch is the last settlement <= A. fundingInfo model (validated separately on the executor's pull-time records):
+fundingInfo read at time P reports the declared interval of the first settlement strictly after P.
+Rules (label of each row as finally recorded; 'at_anchor' = the label in force when that row is the latest row at its anchor):
+  R1  back        snap(backward gap)  [today: shadow_loop_v3.py L341-342; tie 3h -> 2h]
+  R1u back_tieup  snap with ties rounded up
+  R2  maxbf       max(snap back, snap fwd), retroactive exact correction (at_anchor = R1 for the latest row)
+  R3  fi_last     latest row of the batch <- fundingInfo(A+16m); other rows <- snap(back)
+  R3a fi_all      every row of the batch <- fundingInfo(A+16m)   [executor pilot_log semantics]
+  R4  max_fi      latest row <- max(snap back, fundingInfo(A+16m)); other rows <- snap(back)
+  R5  exec_med3   dl_quant_live signal/funding_panel.py derive_interval_h (k=3 median of rounded backward diffs; retroactive; at_anchor = the
+                  same function on rows <= A with interval_now = fundingInfo(A+16m))
+  H   hybrid (lead ruling 15:1xZ, direction (a)): at append the latest row of a batch gets snap(back); every row that has a forward neighbour (earlier batch rows at once, the latest row at the next
+      anchor) is re-resolved with the exact rules (steady / cap 4h|8h->1h at |rate| 0.02 / last 1h before a 2-3h gap / interest signature over
+      {snap back, snap fwd}; first row of a series: steady-forward) and corrected exactly; unresolved rows keep their append label
+  Hfi hybrid with the append label of the latest row = fundingInfo(A+16m), unless the interest signature picks snap(back) over it
+  H2  H, and an unresolved row whose label is not an adjacent schedule (e.g. snap(3h)=2 between 1h and 4h) takes the forward regime
+  ZIP truth: zip_iv.
+Metrics per rule and year: rows scored, final mislabels, at-anchor mislabels; EMA error D(A) over fresh (<=12h) anchor x symbol cells
+(D = exact linear effect of the label errors on acc, v1 recursion rn = rate*8/iv, HL 3d); FTRIM flips = cells where the latest row is fresh,
+rate < 0 and (rate*8/iv_at_anchor <= -1e-3) != (rate*8/iv_zip <= -1e-3)."""
+import os, sys, json, time, hashlib
+import numpy as np
+
+HL = 3 * 86400.0
+ALLOWED = np.array([1.0, 2.0, 4.0, 6.0, 8.0])
+INP = sys.argv[1]; OUTP = sys.argv[2]
+
+
+def snap_down(g):
+    g = np.where((g > 0) & (g <= 24), g, 8.0)
+    return ALLOWED[np.argmin(np.abs(g[:, None] - ALLOWED[None, :]), axis=1)]      # argmin -> first minimum = lower tie
+
+
+def snap_up(g):
+    g = np.where((g > 0) & (g <= 24), g, 8.0)
+    d = np.abs(g[:, None] - ALLOWED[None, :])
+    return ALLOWED[(d.shape[1] - 1) - np.argmin(d[:, ::-1], axis=1)]               # last minimum = upper tie
+
+
+def exec_med3(ft_s, interval_now=None):
+    """verbatim port of dl_quant_live signal/funding_panel.py derive_interval_h (d91303e7) with ms->s."""
+    f = np.asarray(ft_s, np.float64) * 1000.0; n = len(f)
+    if n == 0: return np.zeros(0)
+    if n == 1: return np.array([interval_now if interval_now else 8.0])
+    dt = np.round(np.diff(f) / 3_600_000.0)
+    b = np.empty(n); b[0] = dt[0]; b[1:] = dt
+    b = np.where((b > 0) & (b <= 24), b, 8.0)
+    bp = np.pad(b, (1, 1), mode="edge")
+    win = np.lib.stride_tricks.sliding_window_view(bp, 3)
+    med = np.median(win, axis=1)
+    med = ALLOWED[np.argmin(np.abs(med[:, None] - ALLOWED[None, :]), axis=1)]
+    if interval_now:
+        j = n - 1
+        while j > 0 and med[j - 1] == med[-1]:
+            j -= 1
+        med[j:] = float(interval_now)
+    return med
+
+
+def main():
+    t0 = time.time()
+    h = hashlib.sha256(open(INP, "rb").read()).hexdigest()
+    z = np.load(INP); syms = [str(s) for s in z["symbols"]]; off = z["off"]; FT = z["ft"]; RT = z["rate"]; ZIV = z["zip_iv"]
+    RULES = ["R1_back", "R1u_back_tieup", "R2_maxbf", "R3_fi_last", "R3a_fi_all", "R4_max_fi", "R5_exec_med3", "H_hybrid", "Hfi_hybrid", "H2_hybrid"]
+    acc = {}      # (rule, year) -> metrics
+    ex = {r: [] for r in RULES}
+    amb = {}      # class stats of transition rows vs zip
+    def M(rule, yr):
+        return acc.setdefault((rule, yr), dict(rows=0, mis_final=0, mis_at_anchor=0, cells=0, ema_gt_1e9=0, ema_gt_1e7=0, ema_rel_gt_1pct=0, ema_max=0.0, ftrim_flip=0, ftrim_false_trim=0, ftrim_missed_trim=0))
+    for j, s in enumerate(syms):
+        a, b = int(off[j]), int(off[j + 1])
+        ft = FT[a:b].astype(np.int64); rt = RT[a:b].astype(np.float64); zi = ZIV[a:b].astype(np.float64)
+        n = len(ft)
+        if n < 3: continue
+        gb = np.empty(n); gb[0] = np.nan; gb[1:] = np.diff(ft) / 3600.0
+        gf = np.empty(n); gf[-1] = np.nan; gf[:-1] = np.diff(ft) / 3600.0
+        back = snap_down(np.nan_to_num(gb, nan=8.0)); back[0] = 8.0
+        backu = snap_up(np.nan_to_num(gb, nan=8.0)); backu[0] = 8.0
+        fwd = snap_down(np.nan_to_num(gf, nan=-1.0)); fwd[-1] = back[-1]
+        # batches: anchor of each row = ceil to 4h grid (row exactly on the grid belongs to that anchor)
+        anc = ((ft + 14399) // 14400) * 14400
+        latest = np.ones(n, bool); latest[:-1] = anc[:-1] != anc[1:]
+        P = anc + 960
+        nxt = np.searchsorted(ft, P, side="right")                                 # first settlement strictly after the pull
+        fi = np.where(nxt < n, zi[np.minimum(nxt, n - 1)], np.nan)                 # fundingInfo model
+        fi_ok = np.isfinite(fi)
+        lab = {}; lab_anchor = {}
+        lab["R1_back"] = back; lab_anchor["R1_back"] = back
+        lab["R1u_back_tieup"] = backu; lab_anchor["R1u_back_tieup"] = backu
+        mx = np.maximum(back, fwd); lab["R2_maxbf"] = mx; lab_anchor["R2_maxbf"] = np.where(latest, back, mx)
+        r3 = np.where(latest & fi_ok, fi, back); lab["R3_fi_last"] = r3; lab_anchor["R3_fi_last"] = r3
+        # R3a: every row of the batch takes the fundingInfo value read for its batch
+        r3a = np.where(fi_ok, fi, back); lab["R3a_fi_all"] = r3a; lab_anchor["R3a_fi_all"] = r3a
+        r4 = np.where(latest & fi_ok, np.maximum(back, np.nan_to_num(fi, nan=0.0)), back); lab["R4_max_fi"] = r4; lab_anchor["R4_max_fi"] = r4
+        med = exec_med3(ft); lab["R5_exec_med3"] = med
+        # at-anchor label for R5: derive on rows <= A with interval_now = fundingInfo(A+16m), evaluated only for latest rows (cost: one call per latest row)
+        # closed form (the trailing run always contains the last row, so interval_now labels it; without interval_now the edge-padded
+        # window (b[k-1], b[k], b[k]) has median b[k]); verified against the function itself on sampled rows below
+        rb = snap_down(np.where(np.isfinite(gb), np.round(gb), 8.0)); rb[0] = 8.0
+        r5a = np.where(latest, np.where(fi_ok, fi, rb), med)
+        rng = np.random.default_rng(j)
+        for k in rng.choice(np.where(latest)[0], size=min(20, int(latest.sum())), replace=False):
+            lo = max(0, k - 400)
+            v = exec_med3(ft[lo:k + 1], fi[k] if np.isfinite(fi[k]) else None)
+            assert v[-1] == r5a[k], (s, int(ft[k]), v[-1], r5a[k])
+        lab_anchor["R5_exec_med3"] = r5a
+        # ---- hybrid rules
+        gbr = np.round(np.nan_to_num(gb, nan=-1.0), 6); gfr = np.round(np.nan_to_num(gf, nan=-1.0), 6)
+        fwd_ok = np.isfinite(gf); back_ok = np.isfinite(gb)
+        steady = back_ok & fwd_ok & (back == fwd)
+        exact = np.full(n, np.nan)
+        exact[steady] = back[steady]
+        tr = back_ok & fwd_ok & ~steady
+        cap = tr & np.isin(gbr, (4.0, 8.0)) & (gfr == 1.0) & (np.abs(np.abs(rt) - 0.02) < 1e-12)
+        l1 = tr & (gbr == 1.0) & np.isin(gfr, (2.0, 3.0))
+        sig_b = tr & (np.abs(rt - 1.25e-5 * back) < 1e-12); sig_f = tr & (np.abs(rt - 1.25e-5 * fwd) < 1e-12)
+        sig_u = (sig_b ^ sig_f)
+        sig_val = np.where(sig_b, back, fwd)
+        cand = [(cap, back), (l1, np.ones(n)), (sig_u, sig_val)]
+        vals = np.full((3, n), np.nan)
+        for i_, (msk, v_) in enumerate(cand): vals[i_, msk] = v_[msk]
+        vmin = np.nanmin(np.where(np.isnan(vals), np.inf, vals), axis=0); vmax = np.nanmax(np.where(np.isnan(vals), -np.inf, vals), axis=0)
+        one = tr & np.isfinite(vmin) & (vmin == vmax)
+        exact[one] = vmin[one]
+        if n > 2 and np.isfinite(gf[0]) and np.isfinite(gf[1]):
+            if snap_down(np.array([gf[0]]))[0] == snap_down(np.array([gf[1]]))[0]: exact[0] = snap_down(np.array([gf[0]]))[0]
+        sig_any = np.full(n, np.nan)
+        for c in (1.0, 2.0, 4.0, 8.0):
+            hit = np.abs(rt - 1.25e-5 * c) < 1e-12
+            sig_any = np.where(hit & np.isnan(sig_any), c, np.where(hit & np.isfinite(sig_any), -1.0, sig_any))
+        sig_any = np.where(sig_any == -1.0, np.nan, sig_any)
+        # append labels: the any-interval signature is NOT exact (v2 run: 543 of 1,473,912 latest rows wrong, e.g. a 4h row at 1e-4 = 8h
+        # interest), so the append label uses the signature only to choose between the live candidates {snap back, fundingInfo}
+        prov = back.copy()
+        fi_c = np.where(fi_ok, fi, back)
+        sb_ = np.abs(rt - 1.25e-5 * back) < 1e-12; sf_ = np.abs(rt - 1.25e-5 * fi_c) < 1e-12
+        prov_fi = np.where(sb_ & ~sf_, back, fi_c)
+        for nm_, pv_ in (("H_hybrid", prov), ("Hfi_hybrid", prov_fi)):
+            fin_ = np.where(np.isfinite(exact), exact, np.where(latest, pv_, back))
+            lab[nm_] = fin_
+            lab_anchor[nm_] = np.where(latest, pv_, fin_)
+        # H2: H, but an unresolved row whose append label is not an adjacent schedule (neither the previous row's back regime nor the
+        # forward regime, e.g. snap(3h) = 2 between a 1h and a 4h schedule) takes the forward regime at re-resolution
+        prev_back = np.empty(n); prev_back[0] = np.nan; prev_back[1:] = back[:-1]
+        impossible = ~np.isfinite(exact) & fwd_ok & (back != fwd) & (back != prev_back)
+        fin2 = np.where(np.isfinite(exact), exact, np.where(impossible, fwd, back))
+        lab["H2_hybrid"] = fin2; lab_anchor["H2_hybrid"] = np.where(latest, back, fin2)
+        if not hasattr(main, "_sig_any_stats"): main._sig_any_stats = [0, 0]
+        m_ = latest & np.isfinite(sig_any) & np.isfinite(zi); main._sig_any_stats[0] += int(m_.sum()); main._sig_any_stats[1] += int((sig_any[m_] == zi[m_]).sum())
+        yrs = (1970 + (ft // 86400 + 0.5) / 365.2425).astype(int)
+        scored = np.isfinite(zi)
+        truth = np.where(scored, zi, np.nan)
+        # transition-row census against zip
+        for k in np.where(scored & np.isfinite(gb) & np.isfinite(gf))[0]:
+            if back[k] != fwd[k]:
+                key = f"back{back[k]:g}_fwd{fwd[k]:g}_gapback{round(gb[k], 2):g}_zip{zi[k]:g}"
+                amb[key] = amb.get(key, 0) + 1
+        # anchors where this symbol's latest row is fresh: evaluate on each latest row (the row is the one in force for its anchor ... next anchor)
+        a_k = np.empty(n); a_k[0] = 1.0; a_k[1:] = 1 - 0.5 ** (np.maximum(np.diff(ft), 1) / HL)
+        rn_true = np.where(scored, rt * 8.0 / np.where(scored, zi, 1.0), np.nan)
+        # true acc along rows (loop; needed for relative error); rows before the first scored row are skipped from metrics
+        acc_true = np.empty(n); cur = None
+        for k in range(n):
+            rnk = rn_true[k] if np.isfinite(rn_true[k]) else rt[k] * 8.0 / back[k]
+            cur = rnk if cur is None else cur + a_k[k] * (rnk - cur); acc_true[k] = cur
+        for rule in RULES:
+            L = lab[rule]; LA = lab_anchor[rule]
+            dfinal = np.where(scored, L != truth, False)
+            drn_final = np.where(scored, rt * 8.0 * (1.0 / L - 1.0 / np.where(scored, zi, 1.0)), 0.0)
+            # D at each row index k (final labels): D_k = (1-a_k) D_{k-1} + a_k drn_k
+            D = np.empty(n); cur = 0.0
+            for k in range(n):
+                cur = (1 - a_k[k]) * cur + a_k[k] * drn_final[k] if k else a_k[0] * drn_final[0]; D[k] = cur
+            # at-anchor: the latest row may carry a provisional label -> extra error a_k * (drn_anchor - drn_final) on that row only
+            drn_anchor = np.where(scored, rt * 8.0 * (1.0 / LA - 1.0 / np.where(scored, zi, 1.0)), 0.0)
+            D_anchor = D + np.where(latest, a_k * (drn_anchor - drn_final), 0.0)
+            for yr in np.unique(yrs[scored]):
+                sel = scored & (yrs == yr)
+                m = M(rule, int(yr))
+                m["rows"] += int(sel.sum()); m["mis_final"] += int((dfinal & sel).sum())
+                m["mis_at_anchor"] += int(((LA != truth) & sel & latest).sum())
+                cs = sel & latest
+                m["cells"] += int(cs.sum())
+                dd = np.abs(D_anchor[cs])
+                m["ema_gt_1e9"] += int((dd > 1e-9).sum()); m["ema_gt_1e7"] += int((dd > 1e-7).sum())
+                m["ema_rel_gt_1pct"] += int((dd > 0.01 * np.maximum(np.abs(acc_true[cs]), 1e-12)).sum())
+                if dd.size: m["ema_max"] = max(m["ema_max"], float(dd.max()))
+                neg = cs & (rt < 0)
