+def full_rows(include_pod2=True):
+    """{sym: [(ft, rate)]} = pod2 ledger_full (zip ∪ API, <= 09-01 02:00Z) ∪ every frozen Mac ledger source; rates must agree exactly."""
+    src, shas = H.frozen_ledger_sources()
+    if include_pod2:
+        p = H.WORK + "/pod2_inputs/ledger_full.npz"; shas["pod2_ledger_full"] = H.gsha(p)
+        assert shas["pod2_ledger_full"] == "bea6f5752772d54e659a4da5571ca41945a27d1b2316ec0ae52f387074f795ad"
+        z = np.load(p); syms = [str(s) for s in z["symbols"]]; off = z["off"]; ft = z["ft"]; rate = z["rate"]
+        led = {s: [[int(t), float(r), 0.0] for t, r in zip(ft[off[j]:off[j + 1]], rate[off[j]:off[j + 1]])] for j, s in enumerate(syms)}
