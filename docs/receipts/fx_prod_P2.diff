+# ---------------------------------------------------------------- combo stage (fea171/combo_stage.py) replay from frozen inputs
+FEA_MODEL_FILES = ("f10_live_s42_np.npz", "xfer_ref.npz", "xfer_syms.npz")
+
+
+def combo_home(home, A, aux_obj, lr_path, rolling_path, prev_weights_path, king_target_path, fea_state_dir, code_dir, keep_mini=False):
+    """Replay home for one combo-stage run at anchor A (Phase-1 run_combo_stage semantics with frozen inputs). Model/reference files are
+    read-only copies from ~/wide_shadow/fea171; the 171 feature builders come from the code under test; state files are copies."""
+    import shutil
+    fe = home + "/fea171"; st = home + "/state"
+    if not keep_mini:
+        shutil.rmtree(home, ignore_errors=True)
+    for d in (fe, st + "/weights", st + "/target_live", st + "/target_live_combo"):
+        os.makedirs(d, exist_ok=True)
+    for f in FEA_MODEL_FILES:
+        if not os.path.exists(fe + "/" + f): shutil.copy2(H.WS + "/fea171/" + f, fe + "/" + f)
+    for f in ("dlw_features.py", "f8_higher_order_features.py"):
+        shutil.copy2(os.path.join(code_dir, "fea171", f), fe + "/" + f)
+    for tag in ("f10", "kc", "fc"):
+        src = f"{fea_state_dir}/state_H_{tag}_{A - 14400}.npz"
+        if os.path.exists(src): shutil.copy2(src, f"{fe}/state_H_{tag}_{A - 14400}.npz")
+    shutil.copy2(prev_weights_path, f"{st}/weights/{A - 14400}.npz")
+    shutil.copy2(king_target_path, f"{st}/target_live/{A}.json"); shutil.copy2(king_target_path + ".sha256", f"{st}/target_live/{A}.json.sha256")
+    json.dump(aux_obj, open(st + "/aux.json", "w"))
+    shutil.copy2(lr_path, st + "/leg_returns_live.json")
+    for link, target in ((st + "/rolling.npz", rolling_path), (home + "/shadow_bundle", H.WS + "/shadow_bundle"), (home + "/venv", H.WS + "/venv")):
+        if os.path.islink(link) or os.path.exists(link): os.remove(link)
+        os.symlink(target, link)
+    return home
+
+
+def run_combo(device_path, home, timeout=900):
+    import subprocess
+    env = {"PATH": "/usr/bin:/bin", "HOME": H.HOME, "WIDE_SHADOW_HOME": home, "COMBO_LIVE": "1", "COMBO_LIVE_DIR": home + "/state/target_live_combo",
+           "REPLAY_TRUNCATE_CACHE": "1", "PYTHONDONTWRITEBYTECODE": "1"}
+    t0 = time.time()
+    p = subprocess.run([H.WS + "/venv/bin/python", "-B", device_path], cwd=home + "/fea171", env=env, capture_output=True, text=True, timeout=timeout)
+    return dict(rc=p.returncode, runtime_s=round(time.time() - t0, 1), stdout=p.stdout, stderr=p.stderr[-2000:])
+
+
+def weights_json(p):
+    return json.load(open(p))["weights"]
+
+
+def linf(w1, w2):
+    keys = set(w1) | set(w2)
+    return max(abs(w1.get(k, 0.0) - w2.get(k, 0.0)) for k in keys) if keys else 0.0
+
+
+_V1_CACHE = {}
+
+
+def v1_state_after(sym, t_cut, bundle_names=None):
+    """Producer v1 EMA state after all settlements <= t_cut, rebuilt from full history with the producer's stored labels (every frozen
+    producer ledger), zip labels for older rows, and the producer's cold start for names outside the 08-16 bundle. The same rebuild
+    reproduces the frozen live v1 EMA bitwise for 525/525 names (migrations/fund_label_ema_correction.py --classes NONE --control)."""
+    if not _V1_CACHE:
+        rows, _, _ = full_rows()
+        src, _ = H.frozen_ledger_sources(include=("pre_m1", "snap_1789200000", "snap_1789214400", "snap_1789228800", "snap_1789243200", "t4snap_1789272000", "live_1789300800"))
+        stored = {}
+        for tag, L in src:
+            for s, rr in L.items():
+                d = stored.setdefault(s, {})
+                for r in rr: d.setdefault(int(r[0]), float(r[2]))
+        z = np.load(H.WORK + "/pod2_inputs/ledger_full.npz"); zs = [str(x) for x in z["symbols"]]; off = z["off"]
+        zipiv = {s: {int(t): float(v) for t, v in zip(z["ft"][int(off[j]):int(off[j + 1])].tolist(), z["zip_iv"][int(off[j]):int(off[j + 1])].tolist()) if v == v} for j, s in enumerate(zs)}
+        seed8 = json.load(open(H.WS + "/shadow_bundle.aug20260816_backup/funding_ledger_seed.json"))
+        _V1_CACHE.update(rows=rows, stored=stored, zipiv=zipiv, bundle=set(seed8))
+    C = _V1_CACHE; st = C["stored"].get(sym, {}); start = None if sym in C["bundle"] else (min(st) if st else None)
+    acc = None; prev = None
+    for ft, rate in C["rows"].get(sym, []):
+        if ft > t_cut: break
+        if start is not None and ft < start: continue
+        if ft in st: iv = st[ft]
+        elif ft in C["zipiv"].get(sym, {}): iv = C["zipiv"][sym][ft]
+        else: iv = float(min([1.0, 2.0, 4.0, 6.0, 8.0], key=lambda a_: abs(a_ - ((((ft - prev) / 3600.0) if prev is not None and 0 < (ft - prev) / 3600.0 <= 24 else 8.0)))))
+        rn = rate * (8.0 / iv)
+        acc = rn if acc is None else acc + (1 - 0.5 ** (max(ft - prev, 1) / (3 * 86400.0))) * (rn - acc)
+        prev = ft
+    return None if acc is None else {"acc": acc, "last_ts": prev}
