 # ── structural coupling: the statement must keep up with the gate ───────────────────────────────
+def duplicate_literal_keys(path=None):
+    """Every repeated constant key in every dict literal of a source file, as {key: [line, ...]}.
+
+    ★★ WHY THIS IS READ FROM THE SOURCE AND NOT FROM THE DICT. A duplicate key in a dict LITERAL is
+    resolved by the parser: `{"a": 1, "a": 2}` is a one-entry dict and the FIRST statement is gone
+    before any code runs. So no runtime check on `SUITE_SCOPE` can ever see it — `len()` is right,
+    the key is present, `verify()`'s "every suite has a boundary statement" passes, and the entry
+    somebody wrote and reviewed is simply not there. The loss has NO runtime signature at all,
+    which is why it survived: the only witness is the text.
+
+    ★ MEASURED, 2026-09-16 (NEW-02 sibling): `SUITE_SCOPE` carried "tests_external_book" twice, at
+    lines 266 and 267. The surviving 267 is the current statement (in-universe normalisation, the
+    universe-list defects, shadow_loop_v3, seven blind spots); the discarded 266 was its
+    pre-universe predecessor. Here the loss was benign — the newer text won — but nothing made it
+    so, and the same shape with the order reversed silently reinstates a stale boundary statement
+    for a suite whose scope has changed. This file's whole job is to be the true statement of what
+    the battery does and does not establish, so a line of it going missing without a sound is
+    exactly the failure it exists to prevent.
+
+    ★ It scans EVERY dict literal in the file, not just `SUITE_SCOPE`: `GATE_STEPS` has the same
+    shape and the same silence, and a check aimed at one dict would not have found the other.
+    """
+    path = path or os.path.abspath(__file__)
+    out = {}
+    tree = ast.parse(open(path, encoding="utf-8").read())
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Dict):
+            continue
+        seen = {}
+        for k in node.keys:
+            if not isinstance(k, ast.Constant):      # **spread or a computed key: not a literal key
+                continue
+            seen.setdefault(k.value, []).append(k.lineno)
+        for val, lines in seen.items():
+            if len(lines) > 1:
+                out.setdefault(val, []).extend(lines)
+    return {k: sorted(v) for k, v in out.items()}
+
+
