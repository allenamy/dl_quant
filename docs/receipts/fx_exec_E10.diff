diff --git a/live/tests_fixtures/e10_notary/build_fixture.py b/live/tests_fixtures/e10_notary/build_fixture.py
new file mode 100644
index 0000000..cd87075
--- /dev/null
+++ b/live/tests_fixtures/e10_notary/build_fixture.py
@@ -0,0 +1,37 @@
+"""E10 fixture builder (FX-EXEC 2026-09-13) — READ-ONLY on its two sources, run once by hand; the suite never runs it.
+
+Sources:
+  LIVE      ~/dl_quant_live/state/live/pilot_log/20260912/   (the seven files of the 2026-09-12 ledger day, as they stand after E1)
+  RESEARCH  ~/Desktop/quant_research/ledger_notary/manifest_*.json   (all 43 manifests, verbatim; 08-31..09-12 are untracked there)
+            ~/Desktop/quant_research/docs/fixprogram_2026-09-13/receipts/E1_ledger_amendment_20260912.json   (verbatim)
+Output (this directory):
+  manifests/manifest_YYYYMMDD.json      byte copies
+  E1_ledger_amendment_20260912.json     byte copy
+  pilot_20260912/<file>.gz              gzip (mtime 0) of each ledger file; MANIFEST.json records the sha256 and size of the
+                                        UNCOMPRESSED bytes, which is what the suite checks after decompressing
+  MANIFEST.json                         source paths, copy time, sha256/bytes of every copied object
+Every sha256 is computed from the bytes read in memory, and the bytes written are those same bytes."""
+import gzip, hashlib, json, os, shutil, sys, time
+HERE = os.path.dirname(os.path.abspath(__file__))
+LIVE_DAY = os.path.expanduser("~/dl_quant_live/state/live/pilot_log/20260912")
+NOTARY = os.path.expanduser("~/Desktop/quant_research/ledger_notary")
+E1 = os.path.expanduser("~/Desktop/quant_research/docs/fixprogram_2026-09-13/receipts/E1_ledger_amendment_20260912.json")
+def sha(b): return hashlib.sha256(b).hexdigest()
+out = {"built_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "device": "build_fixture.py",
+       "sources": {"live_day": LIVE_DAY, "notary": NOTARY, "e1_receipt": E1}, "manifests": {}, "pilot_20260912": {}}
+os.makedirs(os.path.join(HERE, "manifests"), exist_ok=True); os.makedirs(os.path.join(HERE, "pilot_20260912"), exist_ok=True)
+for fn in sorted(os.listdir(NOTARY)):
+    if fn.startswith("manifest_") and fn.endswith(".json"):
+        b = open(os.path.join(NOTARY, fn), "rb").read()
+        open(os.path.join(HERE, "manifests", fn), "wb").write(b)
+        out["manifests"][fn] = {"sha256": sha(b), "bytes": len(b)}
+b = open(E1, "rb").read(); open(os.path.join(HERE, "E1_ledger_amendment_20260912.json"), "wb").write(b)
+out["e1_receipt"] = {"sha256": sha(b), "bytes": len(b)}
+for fn in sorted(os.listdir(LIVE_DAY)):
+    b = open(os.path.join(LIVE_DAY, fn), "rb").read()
+    with open(os.path.join(HERE, "pilot_20260912", fn + ".gz"), "wb") as f:
+        with gzip.GzipFile(fileobj=f, mode="wb", mtime=0, filename="") as g:
+            g.write(b)
+    out["pilot_20260912"][fn] = {"sha256": sha(b), "bytes": len(b)}
+json.dump(out, open(os.path.join(HERE, "MANIFEST.json"), "w"), indent=1, sort_keys=True)
+print(json.dumps({"manifests": len(out["manifests"]), "pilot": out["pilot_20260912"], "e1": out["e1_receipt"]}, indent=1))
