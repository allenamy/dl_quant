+def _amendment_segments(rec):
+    """[(from_cp, to_cp, reason)] from either record shape. Legacy E1 receipts: notarized → pre_e1 → post_e1."""
+    if rec.get("kind") == AMENDMENT_KIND:
+        return rec["day"], rec["table"], [(rec["before"], rec["after"], rec.get("reason") or "")], None
+    cps = [(k, v) for k, v in rec.items() if isinstance(v, dict) and "bytes" in v and "sha256" in v]
