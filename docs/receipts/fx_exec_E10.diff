+"""ops/notarize_ledgers.py — the ledger notary: what it writes, what it refuses, and how a notarized day is verified (E10 = LED-06,
+FX-EXEC 2026-09-13).
+
+*** SANDBOX ONLY: temp ledger trees, a temp git repo with a local bare remote, a fake `git` for failure injection, alarms with
+    LIVE_ALARM_SUPPRESS=1 into a temp audit file. Nothing live is read or written except the committed fixture below. ***
+
+★★★ THE MEASUREMENTS THAT PRODUCED THIS SUITE (2026-09-13, read-only on ~/dl_quant_live/state and the research repo)
+  (a) APPENDS READ AS TAMPERING. The notary recorded one whole-file sha256 per ledger file and its docstring promised "altering
+      any historical ledger breaks the chain". The ledger is append-only BY DESIGN: the markout backfill, ops/backfill_fills.py and
+      the 09-09 repair append rows to past days. Census of the live tree against all 43 manifests: 301 files, 259 unchanged,
+      42 grown — every one a pure append at a line boundary, zero bytes changed inside what was notarized. Under the whole-file
+      contract 42 of 43 days read "altered", so the notary could not tell a markout row from a forged fill.
+  (b) THE CHAIN BROKE, SILENTLY, 13 TIMES. Under launchd, `glob` on the research repo returned [] (it swallows the listing error)
+      and the manifest was written with prev = GENESIS; `git add` then died with "fatal: Unable to read current working directory:
+      Operation not permitted", a traceback nobody reads. Manifests 08-31..09-12 all carry GENESIS and none is committed. The same
+      observable is reproduced here with a directory of mode 0300 (create allowed, listing refused).
+  (c) HARDCODED BRANCH. The commit went to whatever branch was checked out and the push named `origin multi-asset-v2`; the research
+      repo is on another branch, so a commit that succeeded would never have reached the pushed branch — and the push's return code
+      was ignored while "committed+pushed" was printed.
+  (d) EVERY FILE IN THE DAY DIRECTORY was notarized (glob "*"), and `git add ledger_notary` + a pathspec-less `git commit` swept any
+      unrelated staged research file into a "notary:" commit.
+
+Each writer cell runs the tool as a subprocess: the new code with sandbox paths as arguments; the OLD code as a byte copy with only
+its two path constants rewritten to the sandbox (the logic under test is untouched, and the harness refuses if the rewrite does not
+match exactly once). Verifier cells call `verify_tree`; on the old module, which has no verifier, they read what the old module does
+offer — its whole-file-sha contract, through its own `sha()` — so an old-code failure is an assertion about that contract, not an
+AttributeError.
+"""
+import gzip
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+for _d in ("live", "ops"):
+    sys.path.insert(0, os.path.join(REPO, _d))
+import importlib.util                                                          # noqa: E402
+_spec = importlib.util.spec_from_file_location("notarize_ledgers_under_test", os.path.join(REPO, "ops", "notarize_ledgers.py"))
+NL = importlib.util.module_from_spec(_spec)
+_argv0 = sys.argv[:]
+sys.argv = [sys.argv[0], "verify"]          # a read-only invocation: the module must not load .env for this import
+try:
+    _spec.loader.exec_module(NL)
+finally:
+    sys.argv = _argv0
+import alarm_policy as AP                                                      # noqa: E402
+
+SRC = open(os.path.join(REPO, "ops", "notarize_ledgers.py"), encoding="utf-8").read()
+NEW = hasattr(NL, "verify_tree")
+PY = "/usr/bin/python3"
+GIT = shutil.which("git") or "/usr/bin/git"
+FAILS = []
+TMPS = []
+
+
+def check(name, cond, detail=""):
+    print(("  OK    " if cond else "  FAIL  ") + name + (f"  — {detail}" if detail != "" else ""), flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+def sha_bytes(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+# ══ sandbox ═════════════════════════════════════════════════════════════════════════════════════
+FAKE_GIT = """#!/bin/bash
+for a in "$@"; do
+  if [ -n "$NOTARY_FAKE_FAIL" ] && [[ " $NOTARY_FAKE_FAIL " == *" $a "* ]]; then
+    echo "${NOTARY_FAKE_MSG:-fatal: Unable to read current working directory: Operation not permitted}" >&2
+    exit 128
+  fi
+done
+exec %s "$@"
+""" % GIT
+
+FILL = {"anchor_ts": 1_000_000.0, "symbol": "AUSDT", "side": "buy", "order_type": "maker", "attempt_idx": 1, "fill_ts": 1_000_000.0,
+        "fill_px": 1.0, "fill_notional": 10.0, "mid_at_fill_plus_60s": None, "rebalance_id": "A1000000", "trade_id": 1}
+TABLES = ["anchors", "daily_nav", "fills", "funding", "orders", "position_readback"]
+
+
+def git(repo, *args, env=None):
+    return subprocess.run([GIT, "-C", repo] + list(args), capture_output=True, text=True, env=env)
+
+
+class Sandbox:
+    def __init__(self, branch="multi-asset-v2", remote=True):
+        self.root = tempfile.mkdtemp(prefix="notary_")
+        TMPS.append(self.root)
+        self.pilot = os.path.join(self.root, "live", "state", "live", "pilot_log")
+        self.repo = os.path.join(self.root, "research")
+        self.notary = os.path.join(self.repo, "ledger_notary")
+        self.audit = os.path.join(self.root, "audit.jsonl")
+        self.remote = os.path.join(self.root, "remote.git")
+        os.makedirs(self.pilot)
+        os.makedirs(self.notary)
+        fake = os.path.join(self.root, "fakebin")
+        os.makedirs(fake)
+        open(os.path.join(fake, "git"), "w").write(FAKE_GIT)
+        os.chmod(os.path.join(fake, "git"), 0o755)
+        self.env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+        self.env.update(HOME=self.root, GIT_CONFIG_NOSYSTEM="1", GIT_TERMINAL_PROMPT="0", LIVE_ALARM_SUPPRESS="1",
+                        LIVE_NOTIFY_AUDIT=self.audit, PYTHONDONTWRITEBYTECODE="1", PATH=fake + os.pathsep + os.environ.get("PATH", ""))
+        self.env.pop("NOTARY_FAKE_FAIL", None)
+        e = dict(self.env)
+        subprocess.run([GIT, "init", "-q", "-b", "multi-asset-v2", self.repo], capture_output=True, env=e, check=True)
+        for k, v in (("user.name", "notary-test"), ("user.email", "notary@test"), ("commit.gpgsign", "false")):
+            git(self.repo, "config", k, v, env=e)
+        open(os.path.join(self.repo, "README"), "w").write("sandbox\n")
+        git(self.repo, "add", "README", env=e)
+        git(self.repo, "commit", "-q", "-m", "init", env=e)
+        if remote:
+            subprocess.run([GIT, "init", "-q", "--bare", self.remote], capture_output=True, env=e, check=True)
+            git(self.repo, "remote", "add", "origin", self.remote, env=e)
+            git(self.repo, "push", "-q", "origin", "multi-asset-v2", env=e)
+        if branch != "multi-asset-v2":
+            git(self.repo, "checkout", "-q", "-b", branch, env=e)
+
+    def day(self, day, tables=TABLES, extra=(), n=3, partial_tail=None):
+        d = os.path.join(self.pilot, day)
+        os.makedirs(d, exist_ok=True)
+        open(os.path.join(d, "_schema.json"), "w").write(json.dumps({"schema_version": 2, "day": day}))
+        for t in tables:
+            with open(os.path.join(d, t + ".jsonl"), "w") as f:
+                for i in range(n):
+                    f.write(json.dumps(dict(FILL, trade_id=i + 1, table=t, day=day)) + "\n")
+                if partial_tail and t == "fills":
+                    f.write(partial_tail)
+        for fn in extra:
+            open(os.path.join(d, fn), "w").write("scratch\n")
+        return d
+
+    def legacy_manifest(self, day, prev="GENESIS", commit=True):
+        """What the OLD notary wrote, computed independently: every file in the day dir, whole-file sha + size."""
+        d = os.path.join(self.pilot, day)
+        files = {fn: {"sha256": sha_bytes(open(os.path.join(d, fn), "rb").read()), "bytes": os.path.getsize(os.path.join(d, fn))}
+                 for fn in sorted(os.listdir(d))}
+        man = {"day": day, "created_utc": "2026-09-10T00:12:00Z", "prev_manifest_sha256": prev, "n_files": len(files),
+               "files": files, "note": "legacy"}
+        p = os.path.join(self.notary, f"manifest_{day}.json")
+        json.dump(man, open(p, "w"), indent=1, sort_keys=True)
+        if commit:
+            git(self.repo, "add", "--", p, env=self.env)
+            git(self.repo, "commit", "-q", "-m", "legacy manifest", "--", p, env=self.env)
+            git(self.repo, "push", "-q", "origin", "multi-asset-v2", env=self.env)
+        return p
+
+    def old_copy(self):
+        live_line = next(l for l in SRC.splitlines() if l.startswith("LIVE = "))
+        res_line = next(l for l in SRC.splitlines() if l.startswith("RESEARCH = "))
+        src = SRC.replace(live_line, f"LIVE = {os.path.join(self.root, 'live')!r}", 1).replace(res_line, f"RESEARCH = {self.repo!r}", 1)
+        ok = SRC.count(live_line) == 1 and SRC.count(res_line) == 1
+        p = os.path.join(self.root, "old_notarize_ledgers.py")
+        open(p, "w").write(src)
+        return p, ok
+
+    def run(self, days, genesis=False, branch="multi-asset-v2", push="origin", fail=None, fail_msg=None):
+        env = dict(self.env)
+        if fail:
+            env["NOTARY_FAKE_FAIL"] = fail
+        if fail_msg:
+            env["NOTARY_FAKE_MSG"] = fail_msg
+        if NEW:
+            cmd = [PY, os.path.join(REPO, "ops", "notarize_ledgers.py")] + list(days) + [
+                "--pilot-root", self.pilot, "--research-repo", self.repo, "--notary-subdir", "ledger_notary",
+                "--branch", branch, "--push-remote", push] + (["--genesis"] if genesis else [])
+        else:
+            p, ok = self.old_copy()
+            if not ok:
+                return 99, "HARNESS: old path constants did not match exactly once"
+            cmd = [PY, p] + list(days) + (["--genesis"] if genesis else [])
+        r = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=120)
+        return r.returncode, (r.stdout or "") + (r.stderr or "")
+
+    def alarms(self):
+        if not os.path.exists(self.audit):
+            return []
+        return [json.loads(l) for l in open(self.audit) if l.strip()]
+
+    def head(self):
+        return git(self.repo, "rev-parse", "HEAD", env=self.env).stdout.strip()
+
+    def head_names(self):
+        return sorted(x for x in git(self.repo, "show", "--name-only", "--format=", "HEAD", env=self.env).stdout.split("\n") if x)
+
+    def manifest(self, day):
+        p = os.path.join(self.notary, f"manifest_{day}.json")
