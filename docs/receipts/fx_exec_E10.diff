+def amendment_record(pilot_root, day, table, before, reason, device):
+    """An append-amendment: the device that appends to a notarized day takes `checkpoint()` BEFORE its append and hands it here
+    afterwards. The record names the segment [before.bytes, after.bytes), why it was appended, and which device (path + sha256)."""
+    p = os.path.join(pilot_root, day, table)
+    data = open(p, "rb").read()
+    v, why = judge_prefix(data, int(before["bytes"]), before["sha256"])
+    if v not in ("EXACT", "APPENDED"):
+        raise NotaryError("amend", f"{day}/{table}: the before-checkpoint does not describe this file ({v}: {why})")
+    after = checkpoint(p)
+    return {"kind": AMENDMENT_KIND, "day": day, "table": table, "created_utc": _utc(),
+            "before": {"bytes": int(before["bytes"]), "sha256": before["sha256"]},
+            "after": {"bytes": after["bytes"], "sha256": after["sha256"]}, "reason": str(reason),
+            "device": {"path": os.path.abspath(device), "sha256": sha(device)}}
