+def commit_and_push(repo, paths, branch, push_remote, message, run=subprocess.run):
+    steps = []
+
+    def git(step, *args):
+        r = run(["git", "-C", repo] + list(args), capture_output=True, text=True)
+        steps.append({"step": step, "rc": r.returncode})
+        if r.returncode != 0:
+            tail = ((r.stderr or "") + (r.stdout or "")).strip().splitlines()[-2:]
+            raise NotaryError(step, f"git {' '.join(args[:2])} rc={r.returncode}: {' | '.join(tail)}")
+        return r.stdout
+    if not branch:
+        raise NotaryError("branch", "no branch is configured — refusing to commit to whatever happens to be checked out")
+    rel = []
+    for p in paths:
+        rp = os.path.relpath(os.path.abspath(p), os.path.abspath(repo))
+        if rp.startswith(".."):
+            raise NotaryError("config", f"{p} is not inside the research repo {repo}")
+        rel.append(rp)
+    cur = git("branch", "rev-parse", "--abbrev-ref", "HEAD").strip()
+    if cur != branch:
+        raise NotaryError("branch", f"checked-out branch {cur!r} is not the configured branch {branch!r} — not committed "
+                                    f"(a commit on {cur!r} would never reach {branch!r})")
+    git("add", "add", "--", *rel)
+    git("commit", "commit", "-q", "-m", message, "--", *rel)
+    names = sorted(x for x in git("verify-commit", "show", "--name-only", "--format=", "HEAD").split("\n") if x)
+    if names != sorted(rel):
+        raise NotaryError("verify-commit", f"HEAD names {names}, expected exactly {sorted(rel)}")
+    if push_remote:
+        git("push", "push", "-q", push_remote, branch)
+        steps.append({"step": "pushed", "remote": push_remote, "branch": branch})
+    else:
+        steps.append({"step": "push not configured"})
+    return steps
