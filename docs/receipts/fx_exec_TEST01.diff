+# ═══ TEST-01: A TEST MUST NOT BE ABLE TO BAN PRODUCTION ═══════════════════════════════════════
+# ★★★ THIS SUITE FEEDS A REAL 429 / -1003 "Too many requests" INTO `submit()` (see the [E-0909-D]
+#     cells below), and `rate_budget` PERSISTS the ban it observes — `ban_path()` falls back to
+#     `state_root.paths_for(mode)["root"]/venue_ban.json` unless `LIVE_VENUE_BAN_STATE` redirects
+#     it. This file set no redirect, so every run wrote a venue ban into the SHARED state tree.
+#     `live/tests_cancel_ban_resilience.py` already redirects it and states the rule in as many
+#     words ("A test must not be able to ban or unban production"); `rate_budget.ban_path`'s own
+#     docstring calls the redirect "not a convenience, a firebreak". Neither reached this file.
+#
+# ★★ AND IT IS NOT ONE SUITE. This file is EXEC'd as a fixture by `tests_reduce_only_clamp`,
+#    `tests_request_identity_unknown` and `tests_flatten_fee_backfill`, so the redirect belongs
+#    HERE rather than in any one of them — measured 2026-09-16, all four wrote the ban before this
+#    line existed, all four stopped after it (receipts TEST01_probe_RED / _GREEN). A bisect over
+#    suites finds one of the four; the cause is the shared fixture.
+#
+# ★ MEASURED IN PRODUCTION, which is why this is a P1 and not tidiness: `~/dl_quant_live/state/
+#   venue_ban.json` carries `testnet.binancefuture.com` / "Too many requests" / `until_epoch: null`
+#   stamped 2026-09-13T11:58:21Z — inside the acceptance battery run on the RUNNING tree at
+#   deployment. It is inert (no deadline ⇒ not banned; and every reader takes the MAX of disk and
+#   memory, so a stale copy can only be more cautious), and the file is KEPT because the
+#   `fapi.binance.com` row beside it is a genuine 2026-08-27 ban record. The mechanism is the bug.
+os.environ["LIVE_VENUE_BAN_STATE"] = os.path.join(
+    __import__("tempfile").mkdtemp(prefix="t01_ban_"), "venue_ban.json")
+
+
+def _real_ban_state_path():
+    """The path the ban WOULD go to without the redirect above — what this suite must not touch."""
+    import state_root as _SR
+    return os.path.join(_SR.paths_for(os.environ.get("LIVE_MODE", "DRY_RUN"))["root"],
+                        "venue_ban.json")
+
+
+def _ban_fingerprint():
+    """(exists, mtime_ns, sha256) of the real file — None-safe, so 'absent' is a state, not a crash."""
+    import hashlib
+    p = _real_ban_state_path()
+    if not os.path.exists(p):
+        return (False, None, None)
+    with open(p, "rb") as fh:
+        return (True, os.stat(p).st_mtime_ns, hashlib.sha256(fh.read()).hexdigest())
+
+
+_BAN_FINGERPRINT_AT_IMPORT = _ban_fingerprint()
+
