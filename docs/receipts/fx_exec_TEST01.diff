+      (_RB_T01.ban_path(), os.environ.get("LIVE_VENUE_BAN_STATE")))
+check("★★★ …and the ban this suite DID observe was actually recorded somewhere — the redirect "
+      "silences the write into production WITHOUT silencing the ban itself, which would make the "
+      "429 cells vacuous",
+      os.path.exists(os.environ["LIVE_VENUE_BAN_STATE"]),
+      os.environ.get("LIVE_VENUE_BAN_STATE"))
+
 print(f"\n{'ALL PASS' if not FAILS else 'FAILURES: ' + str(FAILS)}  ({N[0]} checks)")
