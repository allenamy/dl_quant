@@ -830,5 +874,36 @@ _be_src = open(os.path.join(REPO, "live", "binance_executor.py"), encoding="utf-
 check("★★ all three submit sites (maker / requote / top-up) catch VenueTransportError before VenueError",
       _be_src.count("except VenueTransportError as e:") == 3)
 
+# ═══ [T01] CAPABILITY: this suite cannot ban production ═══════════════════════════════════════
+# ★★★ LAST, SO IT COVERS EVERY CELL ABOVE. The redirect at the top of this file is a claim about
+#     where the ban goes; this is the measurement of where it did NOT go. A test that exercises
+#     rate-limit handling and a test that can WRITE a rate-limit ban into the shared tree are one
+#     line apart, and the difference has no other signature: the ban file is not an output anybody
+#     reads after a suite, so it went unnoticed from 2026-09-13 until FX-W6C bisected for it.
+# ★ It compares (exists, mtime_ns, sha256) — mtime alone would miss a rewrite inside the same
