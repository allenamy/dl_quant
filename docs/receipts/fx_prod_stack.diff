+    add("fea171/xfer_syms.npz", combo_last, "last combo_live.log run")
+
+    # bundle: MANIFEST.json vs the files on disk now.
+    # A missing or unparsable manifest is a HARD FAILURE, not a quiet None: "the field was absent so
+    # the check was skipped" is the defect family this device exists to catch, and an earlier version
+    # of this file reported bundle_mismatch=None simply because it looked for "MANIFEST" and the file
+    # is "MANIFEST.json".
+    bundle = {}
