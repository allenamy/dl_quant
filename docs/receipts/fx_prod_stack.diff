+#!/usr/bin/env python3
+"""fx_harness.py — offline harness for FIXPROGRAM 2026-09-13 FX-PROD (P1 P2 P5 P6). READ-ONLY on ~/wide_shadow and ~/dl_quant_live.
+(1) Replay devices are generated from the producer code under test (a file path, normally this repo's working tree or a git blob) by
+    EXECUTING the Phase-1 generators themselves (parity_replay_2026-09-12/devices/mk_replay_device.py 5b0f1e45…,
+    mk_combo_replay_device.py e29a2a89…) with only their input path and timestamp substituted; self-test: fed the live production files and
+    the Phase-1 timestamps they must reproduce the Phase-1 devices byte-for-byte (4d3bc157… / f5ba9a82…).
+(2) Training-definition v0 oracle = pod_panel_ext.py (db7f0474…) L124-133 recursion on the raw rate, value at anchor = state after the last
+    row with ft <= anchor, stale (anchor - last ft > 12h) => no value (panel L160-162).
+(3) Funding-row union across frozen sources with exact conflict accounting."""
+import os, sys, io, json, time, hashlib, stat, subprocess
+import numpy as np
+
+HOME = os.path.expanduser("~")
+WS = HOME + "/wide_shadow"
+FX = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))          # repo root (/Users/haosiyu/cc_tmp/fx_prod)
+WORK = FX + "/work"
+FROZEN = WORK + "/frozen"
+RES = "/Users/haosiyu/Desktop/quant_research/multi_asset/exports/research"
+PH1 = RES + "/parity_replay_2026-09-12/devices"
+PH1_KING_GEN_SHA = "5b0f1e4592f890e560c03e4cc54d1ee570c31f158748ad4d72549279fc6c9f74"
+PH1_COMBO_GEN_SHA = "e29a2a8970efbaa2689bdaed9012f5ae724472c64696661315b5cfc46eba2e37"
+PH1_KING_DEV_SHA = "4d3bc157f03e3462a69e64f817b3fd4cd51be4c03d72650304b7d0c1a0089d42"
+PH1_COMBO_DEV_SHA = "f5ba9a8234ef0c01ee1aa5bdb0ebd87e8e7093c10b164e37f4fc10f97bc7f77b"
+PH1_KING_TS = "2026-09-12T09:23:24Z"; PH1_COMBO_TS = "2026-09-12T09:39:08Z"
+HL = 3 * 86400.0
+SF_DATALESS = 0x40000000
+
+
+def gsha(p):
+    """sha256 that refuses APFS dataless files and short reads (T6 guard rule)."""
+    st = os.stat(p)
+    if st.st_flags & SF_DATALESS:
+        raise SystemExit("REFUSE %s: dataless" % p)
+    h = hashlib.sha256(); n = 0
+    with open(p, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b); n += len(b)
+    if n != st.st_size:
+        raise SystemExit("REFUSE %s: short read" % p)
+    return h.hexdigest()
+
+
+def _exec_generator(gen_path, gen_sha, live_src_literal, src_path, out_path, ts):
+    code = open(gen_path, encoding="utf-8").read()
+    assert hashlib.sha256(code.encode()).hexdigest() == gen_sha, ("Phase-1 generator changed", gen_path)
+    assert code.count(live_src_literal) == 1, (gen_path, live_src_literal)
+    code = code.replace(live_src_literal, repr(src_path))
+    tsx = 'time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())'
+    assert code.count(tsx) == 1, gen_path
+    code = code.replace(tsx, repr(ts))
+    g = {"__name__": "__fx_gen__", "__file__": gen_path}
+    old_argv = sys.argv; old_out = sys.stdout
+    sys.argv = [gen_path, out_path]; sys.stdout = io.StringIO()
+    try:
+        exec(compile(code, gen_path, "exec"), g)
+        printed = sys.stdout.getvalue()
+    finally:
+        sys.argv = old_argv; sys.stdout = old_out
+    return json.loads(printed.strip().splitlines()[-1])
+
+
+def gen_king_device(src_path, out_path, ts=PH1_KING_TS, extra_repl=()):
+    """Phase-1 king device from src_path; extra_repl = ((old, new), ...) once-only replacements applied AFTER the generator (arm flags)."""
+    rc = _exec_generator(PH1 + "/mk_replay_device.py", PH1_KING_GEN_SHA, 'os.path.expanduser("~/wide_shadow/shadow_loop_v3.py")', src_path, out_path, ts)
+    return _apply_extra(out_path, rc, extra_repl)
+
+
+def gen_combo_device(src_path, out_path, ts=PH1_COMBO_TS, extra_repl=()):
+    rc = _exec_generator(PH1 + "/mk_combo_replay_device.py", PH1_COMBO_GEN_SHA, 'os.path.expanduser("~/wide_shadow/fea171/combo_stage.py")', src_path, out_path, ts)
+    return _apply_extra(out_path, rc, extra_repl)
+
+
+def _apply_extra(out_path, rc, extra_repl):
+    txt = open(out_path, encoding="utf-8").read()
+    for old, new in extra_repl:
+        assert txt.count(old) == 1, ("extra replacement not unique", old, txt.count(old))
+        txt = txt.replace(old, new)
+    if extra_repl:
+        open(out_path, "w", encoding="utf-8").write(txt)
+    rc = dict(rc); rc["device_sha256"] = hashlib.sha256(txt.encode()).hexdigest(); rc["extra_replacements"] = [list(x) for x in extra_repl]
+    return rc
+
+
+def selftest_generators(tmpdir):
+    """Fed the LIVE production files with the Phase-1 timestamps, the generators must reproduce the Phase-1 devices byte-for-byte."""
+    os.makedirs(tmpdir, exist_ok=True)
+    k = gen_king_device(WS + "/shadow_loop_v3.py", tmpdir + "/k.py")
+    c = gen_combo_device(WS + "/fea171/combo_stage.py", tmpdir + "/c.py")
+    return dict(king_ok=k["device_sha256"] == PH1_KING_DEV_SHA == gsha(PH1 + "/shadow_loop_v3_replay.py"),
+                combo_ok=c["device_sha256"] == PH1_COMBO_DEV_SHA == gsha(PH1 + "/combo_stage_replay.py"), king=k, combo=c)
+
+
+# ---------------------------------------------------------------- funding rows / v0 oracle
+def rows_union(sources):
+    """sources: list of (tag, {sym: [[ft, rate, iv], ...]}). Returns ({sym: [(ft, rate)] strictly increasing}, audit).
+    A second that appears in several sources must carry the same rate in all of them (conflicts are counted and listed)."""
+    out = {}; conflicts = []; nrows = 0
+    for tag, led in sources:
+        for s, rows in led.items():
+            d = out.setdefault(s, {})
+            for r in rows:
+                ft = int(r[0]); rate = float(r[1]); nrows += 1
+                if ft in d and d[ft][0] != rate:
+                    conflicts.append((s, ft, d[ft][0], rate, d[ft][1], tag))
+                    continue
+                if ft not in d:
+                    d[ft] = (rate, tag)
+    res = {s: [(t, d[t][0]) for t in sorted(d)] for s, d in out.items()}
+    return res, dict(n_input_rows=nrows, n_names=len(res), conflicts=conflicts[:50], n_conflicts=len(conflicts))
+
+
+def v0_state_after(rows, t_cut):
+    """Training v0 (pod_panel_ext.py L124-133) after all rows with ft <= t_cut: acc = first rate; acc += a*(rate-acc), a = 1-0.5**(max(dt,1)/3d)."""
+    acc = None; prev = None
+    for ft, rate in rows:
+        if ft > t_cut:
+            break
+        if acc is None:
+            acc = rate
+        else:
+            a = 1 - 0.5 ** (max(ft - prev, 1) / HL)
+            acc = acc + a * (rate - acc)
+        prev = ft
+    return (None if acc is None else {"acc": acc, "last_ts": prev})
+
+
+def frozen_ledger_sources(include=("seed_aug", "seed_v3", "pre_m1", "snap_1789200000", "snap_1789214400", "snap_1789228800", "snap_1789243200", "t4snap_1789272000", "live_1789300800")):
+    paths = {"seed_aug": WS + "/shadow_bundle.aug20260816_backup/funding_ledger_seed.json",
+             "seed_v3": WS + "/shadow_bundle/funding_ledger_seed.json",
+             "pre_m1": FROZEN + "/live_1789300800/state/aux_pre_m1_20260904.json",
+             "snap_1789200000": FROZEN + "/snap_1789200000/aux.json", "snap_1789214400": FROZEN + "/snap_1789214400/aux.json",
