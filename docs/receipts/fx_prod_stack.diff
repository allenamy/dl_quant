+    need(r1["input_aux_sha256"] == sha["p5_aux"] and r1["output_sha256"] == sha["p1_aux"], "p1 input = p5 output")
+    need(rc_["inputs"]["aux"]["sha256"] == sha["p1_aux"] and rc_["output_sha256"] == sha["corr_aux"], "correction input = p1 output")
+    need(r1["code_sha256"] == sha["code"] and rc_["inputs"]["code"]["sha256"] == sha["code"] and r5["inputs"]["code_shadow_loop_v3"]["sha256"] == sha["code"], "same code under test")
+    need(sorted(rc_["classes"]) == ["D17", "P9"] and any(k.startswith("zip_dir_") for k in rc_["inputs"]), "correction classes D17,P9 with monthly zips")
