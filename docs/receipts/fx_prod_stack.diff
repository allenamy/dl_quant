+#!/usr/bin/env python3
+"""PROD-27 fact table, part F-C/F-D/F-E: per-anchor census of the combo rewrite.
+
+READ-ONLY against the live producer tree. The device opens every path under
+--ws with mode 'r'/'rb' only; a guard refuses if --out resolves under --ws.
+
+It reconstructs, for every 4h anchor that has a producer target_live file:
+
+  producer_write_s   seconds after the anchor at which the PRODUCER's king file
+                     was written.  For anchors where combo ran this is the mtime
+                     of state/target_live_king/<A>.json, which combo_stage.py
+                     L340 creates with shutil.copy2 (mtime preserved from the
+                     producer's own file).  For anchors where combo never ran it
+                     is the mtime of state/target_live/<A>.json itself, because
+                     nothing rewrote it.
+  combo_write_s      seconds after the anchor at which the combo rewrite landed
+                     (mtime of state/target_live/<A>.json when a king backup
+                     exists, i.e. when combo_stage got past its backup step).
+  stage_done_s       seconds after the anchor of the daemon's own `date -u`
+                     stamp on the `=== combo_live anchor=... rc=...` line.
+  form_on_disk       combo | king | king_no_combo_run, decided by CONTENT:
+                     target_live/<A>.json byte-equal to target_live_king/<A>.json
+                     => the rollback path restored the king file => king form.
+
+Three different margins are reported, because the three gates are different
+quantities measured at different instants:
+
+  m_gate = 1355 - producer_write_s
+      combo_live_daemon.sh L27.  Governs the SILENT skip.  Evaluated when the
+      daemon first sees the producer file, on a 5 s polling grid.
+  m_bail = 1360 - stage_deadline_check_s
+      combo_stage.py L321-323 (A + 22*60 + 40), evaluated at _now0, the start of
+      the COMBO_LIVE block, i.e. after the 171-feature pipeline has finished.
+      Approximated as stage_done_s - status_elapsed_s; status_elapsed_s is
+      ~0 because the block itself is sub-second (see --status).
+  m_read = 1440 - combo_write_s
+      the executor's FIRST read.  config/book.json external_book.anchor_offset_min
+      = 24 since 2026-08-27 05:2xZ (raised 23 -> 24 precisely because the combo
+      writer's measured landing left only 34 s); poll_grace_min = 5 retries every
+      ~15 s to N+29:00 but only on a RETRYABLE outcome, so a king file that is
+      already valid at N+24:00 is read and the anchor proceeds.  A combo rewrite
+      landing after N+24:00 is on disk but was NOT the book that traded, which is
+      why form_on_disk is only a valid trade record while m_read > 0; the device
+      flags any anchor where it is not.
+      NOTE: CLAUDE.md still says the executor reads at N+23; that was true before
+      2026-08-27 and is stale.  The constant here is read from the executor's own
+      config, and every row is cross-checked against the executor's ledger.
+
+Second instrument (--exec-log): the executor writes, in each anchor's phase_A
+line, `external_book.producer` — "combo_stage_v1(...)" or "shadow_loop_v3" — plus
+attempts, age_s, written_utc, json_sha and the resulting action.  That is an
+independent determination of which form actually traded, taken by a different
+process from different bytes.  The device reports both and names every anchor
+where they disagree rather than preferring one.
+
+Usage:
+  python3 fx/prod27_census.py --ws ~/wide_shadow --out work/prod27/PROD27_CENSUS.json
+"""
+import argparse
+import datetime as dt
+import hashlib
+import json
+import os
+import re
+import sys
+import time
+
+ANCHOR_S = 14400
+DAEMON_SKIP_S = 1355      # combo_live_daemon.sh L27
+STAGE_BAIL_S = 22 * 60 + 40   # combo_stage.py L321
+EXEC_READ_S = 24 * 60     # config/book.json external_book.anchor_offset_min = 24
+EXEC_RETRY_END_S = EXEC_READ_S + 5 * 60   # + poll_grace_min = 5
+
+LOG_RESULT_RE = re.compile(r"^=== combo_live anchor=(\d+) rc=(\d+) (.+)$")
+LOG_SKIP_RE = re.compile(r"^skip aux-not-settled anchor=(\d+) (.+)$")
+LOG_STAMP_RE = re.compile(r"^\[\s*([0-9.]+)s\]\s*(.*)$")
+PHASE_A_RE = re.compile(r"^(\S+) phase_A: (\{.*\})\s*$")
+MODE_RE = re.compile(r"anchor start mode=([A-Z_]+)")
+
+
+def read_exec_log(path, want_mode="LIVE"):
+    """Second instrument: the executor's own per-anchor record of what it read.
+
+    `anchor_runs.log` interleaves LIVE, DRY_RUN and TESTNET runs (the acceptance
+    battery's `tests_entrypoint_wiring` appends DRY_RUN rows), and a dry run at an
+    arbitrary wall time reads whatever target_live file is newest, so it reports
+    `stale` for anchors that traded perfectly well in LIVE.  Keying only on the
+    anchor and letting later rows overwrite earlier ones therefore mixes the two
+    populations and silently reports battery artefacts as live events.  Mode is
+    carried from the preceding `anchor start mode=` line and rows are kept as a
+    list per anchor, so duplicates are reported rather than collapsed.
+
+    Returns ({nominal_anchor_ts: [row, ...]}, counts_by_mode).
+    """
+    out = {}
+    counts = {}
+    mode = None
+    with open(path, "r", errors="replace") as f:
+        for raw in f:
+            ms = MODE_RE.search(raw)
+            if ms:
+                mode = ms.group(1)
+                continue
+            if " phase_A: {" not in raw:
+                continue
+            m = PHASE_A_RE.match(raw.rstrip("\n"))
+            if not m:
+                continue
+            try:
+                d = json.loads(m.group(2))
+            except Exception:
+                continue
+            counts[mode] = counts.get(mode, 0) + 1
+            if want_mode and mode != want_mode:
+                continue
+            eb = d.get("external_book") or {}
+            nom = eb.get("nominal_ts")
+            if nom is None:
+                nom = (d.get("external_wait") or {}).get("nominal_anchor_ts")
+            if nom is None:
+                continue
+            prod = eb.get("producer")
+            if prod is None:
+                form = None
+            elif prod.startswith("combo_stage_v1"):
+                form = "combo"
+            elif prod.startswith("shadow_loop_v3"):
+                form = "king"
+            else:
+                form = "other:" + prod[:40]
+            out.setdefault(int(nom), []).append({
+                "exec_mode": mode,
+                "exec_line_utc": m.group(1),
+                "exec_eb_ok": eb.get("ok"),
+                "exec_eb_reason": eb.get("reason"),
+                "exec_attempts": eb.get("attempts"),
+                "exec_age_s": eb.get("age_s"),
+                "exec_written_utc": eb.get("written_utc"),
+                "exec_json_sha": eb.get("json_sha"),
+                "exec_producer": prod,
+                "exec_form": form,
+                "exec_action": d.get("action"),
+                "exec_n_names": eb.get("n_names"),
+            })
+    return out, counts
+
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    d = h.hexdigest()
+    if os.path.getsize(path) > 0 and d.startswith("e3b0c44298fc1c14"):
+        raise SystemExit(f"FATAL empty-file sha on non-empty {path} (T6 guard)")
+    return d
+
+
+def self_sha():
+    return sha256_file(os.path.abspath(__file__))
+
+
+def utc(ts):
+    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def parse_daemon_date(s):
+    """`date -u` on macOS: 'Wed Sep 16 00:21:08 UTC 2026'."""
+    return int(dt.datetime.strptime(s.strip(), "%a %b %d %H:%M:%S UTC %Y")
+               .replace(tzinfo=dt.timezone.utc).timestamp())
+
+
+def read_log(path):
+    """Return {anchor: {...}} from combo_live.log, plus the unattributable lines.
+
+    Blocks are delimited by the `=== combo_live anchor=` result line, so the
+    `[ Xs]` stamps preceding a result line belong to that anchor's run.
+    """
+    per = {}
+    skips = []
+    block = []
+    orphan_tail = []
+    with open(path, "r", errors="replace") as f:
+        for raw in f:
+            line = raw.rstrip("\n")
+            m = LOG_RESULT_RE.match(line)
+            if m:
+                a, rc, when = int(m.group(1)), int(m.group(2)), m.group(3)
+                stamps = {}
+                for bl in block:
+                    ms = LOG_STAMP_RE.match(bl)
+                    if ms:
+                        stamps.setdefault(ms.group(2)[:2], float(ms.group(1)))
+                final = None
+                for bl in block:
+                    ms = LOG_STAMP_RE.match(bl)
+                    if ms and ms.group(2).startswith("⑤"):
+                        final = float(ms.group(1))
+                per[a] = {
+                    "log_rc": rc,
+                    "log_wall_ts": parse_daemon_date(when),
+                    "log_stage_final_s": final,
+                    "log_abort": any("COMBO_LIVE ABORT" in b for b in block),
+                    "log_rollback": any("已回滚为 king 文件" in b for b in block),
+                    "log_page_lines": [b for b in block if b.startswith("PAGE")],
+                    "log_block_lines": len(block),
+                }
+                block = []
+                continue
+            ms = LOG_SKIP_RE.match(line)
+            if ms:
+                skips.append({"anchor": int(ms.group(1)), "when": ms.group(2)})
+                block = []
+                continue
+            block.append(line)
+    orphan_tail = block
+    return per, skips, orphan_tail
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--ws", default=os.path.expanduser("~/wide_shadow"))
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--combo-live-from", type=int, default=1787716800,
+                    help="first anchor the combo daemon ran (2026-08-26 04:00Z; 00Z was the "
+                         "rehearsal, whose output went to state/target_live_REHEARSAL)")
+    ap.add_argument("--exec-log", default=os.path.expanduser(
+        "~/dl_quant_live/state/anchor_runs.log"),
+        help="second instrument: the executor's ledger; '' to skip")
+    ap.add_argument("--exec-mode", default="LIVE",
+                    help="only count executor runs in this mode (LIVE/DRY_RUN/TESTNET)")
+    args = ap.parse_args()
+
+    ws = os.path.realpath(os.path.expanduser(args.ws))
+    out = os.path.realpath(os.path.expanduser(args.out))
+    if out.startswith(ws + os.sep) or out == ws:
+        raise SystemExit(f"FATAL --out {out} resolves under --ws {ws}; this device is read-only there")
+
+    tl_dir = os.path.join(ws, "state", "target_live")
+    king_dir = os.path.join(ws, "state", "target_live_king")
+    log_path = os.path.join(ws, "fea171", "combo_live.log")
+    last_path = os.path.join(ws, "fea171", "combo_live_last_anchor")
+    status_path = os.path.join(ws, "state", "combo_live_status.json")
+
+    per_log, skips, orphan_tail = read_log(log_path)
+    if args.exec_log:
+        per_exec_all, exec_mode_counts = read_exec_log(args.exec_log, args.exec_mode)
+    else:
+        per_exec_all, exec_mode_counts = {}, {}
+    per_exec = {a: v[-1] for a, v in per_exec_all.items()}
+    exec_dupes = {utc(a): len(v) for a, v in per_exec_all.items() if len(v) > 1}
+
+    anchors = sorted(int(n[:-5]) for n in os.listdir(tl_dir)
+                     if n.endswith(".json") and n[:-5].isdigit())
+    kings = {int(n[:-5]) for n in os.listdir(king_dir)
+             if n.endswith(".json") and n[:-5].isdigit()}
+
+    rows = []
+    for a in anchors:
+        tlp = os.path.join(tl_dir, f"{a}.json")
+        kp = os.path.join(king_dir, f"{a}.json")
+        tl_mt = os.path.getmtime(tlp)
+        tl_sha = sha256_file(tlp)
+        try:
+            doc = json.load(open(tlp))
+        except Exception as e:
+            doc = {"_parse_error": f"{type(e).__name__}: {e}"}
+        has_king = a in kings
+        r = {
+            "anchor": a,
+            "anchor_utc": utc(a),
+            "pre_combo": a < args.combo_live_from,
+            "tl_mtime_s": round(tl_mt - a, 1),
+            "tl_sha256": tl_sha,
+            "tl_size": os.path.getsize(tlp),
+            "tl_written_utc": doc.get("written_utc"),
+            "tl_producer": doc.get("producer"),
+            "tl_n_names": doc.get("n_names"),
+            "king_backup_present": has_king,
+        }
+        if has_king:
+            k_mt = os.path.getmtime(kp)
+            k_sha = sha256_file(kp)
+            r["king_mtime_s"] = round(k_mt - a, 1)
+            r["king_sha256"] = k_sha
+            r["producer_write_s"] = round(k_mt - a, 1)
+            r["combo_write_s"] = round(tl_mt - a, 1)
+            r["form_on_disk"] = "king" if k_sha == tl_sha else "combo"
+        else:
+            r["king_mtime_s"] = None
+            r["king_sha256"] = None
+            r["producer_write_s"] = round(tl_mt - a, 1)
+            r["combo_write_s"] = None
+            r["form_on_disk"] = "pre_combo" if r["pre_combo"] else "king_no_combo_run"
+
+        lg = per_log.get(a)
+        if lg:
+            r.update({k: v for k, v in lg.items() if k != "log_wall_ts"})
+            r["stage_done_s"] = round(lg["log_wall_ts"] - a, 1)
+        else:
+            r["log_rc"] = None
+            r["stage_done_s"] = None
+            r["log_stage_final_s"] = None
+
+        r["m_gate_s"] = round(DAEMON_SKIP_S - r["producer_write_s"], 1)
+        r["m_bail_s"] = (None if r["stage_done_s"] is None
+                         else round(STAGE_BAIL_S - r["stage_done_s"], 1))
+        r["m_read_s"] = (None if r["combo_write_s"] is None
+                         else round(EXEC_READ_S - r["combo_write_s"], 1))
+        r["form_record_valid"] = (r["m_read_s"] is None or r["m_read_s"] > 0)
+
+        ex = per_exec.get(a)
+        if ex:
+            r.update(ex)
+            r["form_agrees"] = (
+                None if (ex["exec_form"] is None or r["pre_combo"])
+                else (ex["exec_form"] == ("king" if r["form_on_disk"] in
+                                          ("king", "king_no_combo_run")
+                                          else r["form_on_disk"])))
+        else:
+            r["exec_form"] = None
+            r["form_agrees"] = None
+        rows.append(r)
+
+    # anchor-grid gaps: anchors with no producer file at all
+    gaps = []
+    if anchors:
+        for a in range(anchors[0], anchors[-1] + ANCHOR_S, ANCHOR_S):
+            if a not in set(anchors):
+                gaps.append({"anchor": a, "anchor_utc": utc(a)})
+
+    # log-only anchors: a result line with no target_live file
+    log_only = [a for a in per_log if a not in set(anchors)]
+
+    combo_rows = [r for r in rows if not r["pre_combo"]]
+    traded_combo = [r for r in combo_rows if r["form_on_disk"] == "combo"]
+    traded_king = [r for r in combo_rows if r["form_on_disk"] in ("king", "king_no_combo_run")]
+    silent = [r for r in combo_rows
+              if r["log_rc"] is None and r["form_on_disk"] == "king_no_combo_run"]
+
+    def q(vals, p):
+        vals = sorted(v for v in vals if v is not None)
+        if not vals:
+            return None
+        i = min(len(vals) - 1, max(0, int(round(p * (len(vals) - 1)))))
+        return vals[i]
+
+    pw = [r["producer_write_s"] for r in combo_rows]
+    cw = [r["combo_write_s"] for r in combo_rows if r["combo_write_s"] is not None]
+    mg = [r["m_gate_s"] for r in combo_rows]
+
+    status = None
+    try:
+        status = json.load(open(status_path))
+    except Exception as e:
+        status = {"_read_error": f"{type(e).__name__}: {e}"}
+    try:
+        last_anchor = int(open(last_path).read().strip())
+    except Exception as e:
+        last_anchor = None
+
+    result = {
+        "device": os.path.basename(__file__),
+        "device_sha256": self_sha(),
+        "generated_utc": utc(int(time.time())),
+        "config": {
+            "ws": ws,
+            "out": out,
+            "combo_live_from": args.combo_live_from,
+            "combo_live_from_utc": utc(args.combo_live_from),
+            "DAEMON_SKIP_S": DAEMON_SKIP_S,
+            "STAGE_BAIL_S": STAGE_BAIL_S,
+            "EXEC_READ_S": EXEC_READ_S,
+            "EXEC_RETRY_END_S": EXEC_RETRY_END_S,
+            "exec_log": args.exec_log,
+            "exec_mode": args.exec_mode,
+        },
+        "inputs_sha256": {
+            "combo_live_daemon.sh": sha256_file(os.path.join(ws, "fea171", "combo_live_daemon.sh")),
+            "combo_stage.py": sha256_file(os.path.join(ws, "fea171", "combo_stage.py")),
+            "sidecar_daemon.sh": sha256_file(os.path.join(ws, "fea171", "sidecar_daemon.sh")),
+            "combo_live.log": sha256_file(log_path),
+        },
+        "live_state": {
+            "combo_live_last_anchor": last_anchor,
+            "combo_live_last_anchor_utc": utc(last_anchor) if last_anchor else None,
+            "combo_live_status": status,
+            "status_is_for_latest_anchor": (
+                status.get("anchor") == (anchors[-1] if anchors else None)
+                if isinstance(status, dict) else None),
+        },
+        "summary": {
+            "n_target_live_files": len(anchors),
+            "n_king_backups": len(kings),
+            "n_log_result_lines": len(per_log),
+            "n_log_skip_aux_lines": len(skips),
+            "n_anchors_pre_combo": len(rows) - len(combo_rows),
+            "n_anchors_combo_era": len(combo_rows),
+            "n_traded_combo": len(traded_combo),
+            "n_traded_king": len(traded_king),
+            "king_anchors": [r["anchor_utc"] for r in traded_king],
+            "n_silent_skip": len(silent),
+            "silent_skip_anchors": [r["anchor_utc"] for r in silent],
+            "n_form_record_invalid": sum(1 for r in combo_rows if not r["form_record_valid"]),
+            "producer_write_s": {"min": min(pw) if pw else None, "median": q(pw, 0.5),
+                                 "p99": q(pw, 0.99), "max": max(pw) if pw else None},
+            "combo_write_s": {"min": min(cw) if cw else None, "median": q(cw, 0.5),
+                              "p99": q(cw, 0.99), "max": max(cw) if cw else None},
+            "m_gate_s": {"min": min(mg) if mg else None, "median": q(mg, 0.5),
+                         "p01": q(mg, 0.01)},
+            "m_bail_s_min": min((r["m_bail_s"] for r in combo_rows
+                                 if r["m_bail_s"] is not None), default=None),
+            "m_read_s_min": min((r["m_read_s"] for r in combo_rows
+                                 if r["m_read_s"] is not None), default=None),
+            "anchor_grid_gaps": gaps,
+            "log_only_anchors": sorted(log_only),
+            "log_orphan_tail_lines": len(orphan_tail),
+            "log_skips": skips,
+            "exec_cross_check": {
+                "phaseA_rows_by_mode": exec_mode_counts,
+                "exec_mode_counted": args.exec_mode,
+                "n_anchors_with_multiple_runs": exec_dupes,
+                "n_exec_phaseA_rows": len(per_exec),
+                "n_combo_era_with_exec_row": sum(1 for r in combo_rows if r["exec_form"]),
+                "combo_era_without_exec_form": [
+                    r["anchor_utc"] for r in combo_rows if not r.get("exec_form")],
+                "n_form_disagree": sum(1 for r in combo_rows if r["form_agrees"] is False),
+                "form_disagree_anchors": [
+                    r["anchor_utc"] for r in combo_rows if r["form_agrees"] is False],
+                "exec_form_counts": {
+                    f: sum(1 for r in combo_rows if r.get("exec_form") == f)
+                    for f in sorted({r.get("exec_form") for r in combo_rows
+                                     if r.get("exec_form")})},
+                "exec_king_anchors": [
+                    {"anchor_utc": r["anchor_utc"], "attempts": r.get("exec_attempts"),
+                     "age_s": r.get("exec_age_s"), "action": r.get("exec_action"),
+                     "producer": r.get("exec_producer")}
+                    for r in combo_rows if r.get("exec_form") == "king"],
+                "exec_no_book_anchors": [
+                    {"anchor_utc": utc(a), "reason": e.get("exec_eb_reason"),
+                     "attempts": e.get("exec_attempts"), "action": e.get("exec_action")}
+                    for a, e in sorted(per_exec.items())
+                    if e.get("exec_eb_ok") is False and a >= args.combo_live_from],
+            },
+        },
+        "rows": rows,
+    }
+
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    with open(out, "w") as f:
+        json.dump(result, f, indent=1)
+    s = result["summary"]
+    print(f"[prod27_census] device_sha={result['device_sha256'][:8]} out={out}")
+    print(f"  target_live files {s['n_target_live_files']} | king backups {s['n_king_backups']} "
+          f"| log result lines {s['n_log_result_lines']} | aux-skip lines {s['n_log_skip_aux_lines']}")
+    print(f"  combo-era anchors {s['n_anchors_combo_era']}: combo {s['n_traded_combo']} "
+          f"/ king {s['n_traded_king']} {s['king_anchors']}")
+    print(f"  SILENT skips (no log line, king form on disk) {s['n_silent_skip']}: {s['silent_skip_anchors']}")
+    print(f"  producer_write_s  min/med/p99/max = {s['producer_write_s']}")
+    print(f"  combo_write_s     min/med/p99/max = {s['combo_write_s']}")
+    print(f"  m_gate_s (1355-producer) min/med/p01 = {s['m_gate_s']}")
+    print(f"  m_bail_s min = {s['m_bail_s_min']} | m_read_s min = {s['m_read_s_min']}")
+    print(f"  anchor grid gaps {len(s['anchor_grid_gaps'])} | log-only anchors {s['log_only_anchors']}")
+    x = s["exec_cross_check"]
+    print(f"  EXEC instrument ({x['exec_mode_counted']} only): phase_A rows by mode {x['phaseA_rows_by_mode']}")
+    print(f"  EXEC anchors {x['n_exec_phaseA_rows']} | combo-era covered "
+          f"{x['n_combo_era_with_exec_row']} | forms {x['exec_form_counts']} | multi-run anchors {x['n_anchors_with_multiple_runs']}")
+    print(f"  EXEC king-form anchors: {x['exec_king_anchors']}")
+    print(f"  EXEC anchors with NO usable book: {x['exec_no_book_anchors']}")
+    print(f"  form disagreements between instruments: {x['n_form_disagree']} {x['form_disagree_anchors']}")
+    print(f"  combo-era anchors with no {x['exec_mode_counted']} form: {x['combo_era_without_exec_form']}")
+    print(f"  status slot anchor={result['live_state']['combo_live_status'].get('anchor') if isinstance(result['live_state']['combo_live_status'], dict) else None} "
+          f"is_latest={result['live_state']['status_is_for_latest_anchor']}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
