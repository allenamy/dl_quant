+#!/usr/bin/env python3
+"""p9_declared_interval_table.py — FIXPROGRAM 2026-09-13 P9 shared evidence: the declared settlement interval of every funding settlement.
+READ-ONLY inputs (sha-pinned in the receipt): pod2 ledger_full.npz (data.binance.vision zip U fund_aug API rows, zip `funding_interval_hours`,
+2020-01 -> 2026-09-01 02:00Z); every frozen producer ledger (aux ledger_tail) and both bundle seeds; the executor's own settlement records
+~/dl_quant_live/state/live/pilot_log/<day>/funding.jsonl (`funding_interval_h` = /fapi/v1/fundingInfo read at PULL time, applied to every
+settlement of that pull; positive control only).
+One row per (symbol, settlement second) in [LO, HI]:
+  iv_producer   stored iv in the producer ledger (union of frozen producer ledgers; rows only in a seed carry the seed's stored iv, flagged)
+  iv_zip        exchange-declared funding_interval_hours from the monthly zip (rows <= 2026-07-31 only; August/September zips absent)
+  iv_exec       executor fundingInfo label for that settlement (held names only); several differing labels are joined with '|'
+  gap_back_h / gap_fwd_h  raw hours to the previous / next settlement of the same symbol (union of all row sources)
+  iv_gap_back / iv_gap_fwd  the producer's snap rule (shadow_loop_v3.py L341-342) applied to those gaps
+  regime        steady (snap back == snap fwd) | transition (snap back != snap fwd) | edge (no back or no fwd neighbour)
+  iv_best, iv_best_source  zip if present; else only rules that equal the zip on EVERY scored row of the full history (receipt V1):
+                structure_steady (2,521,513/2,521,515), interest_signature (rate == 1.25e-5*iv for exactly one candidate; 1,111/1,111),
+                cap_signature_{4,8}h_to_1h (|rate| == 0.02, back 4h/8h, fwd 1h; 194/194), structure_last_1h_before_gap{2,3} (92/92);
+                otherwise NULL with 'unresolved_<regime>' (the declared interval of a transition row is the schedule in force AT the settlement,
+                which neither the backward gap nor a fundingInfo read after the settlement determines; see p9_rule_eval.py)
+  iv_likely, iv_likely_support  below-100% rules for unresolved rows: gap3_into_longer 40/41, gap2_into_longer 52/62
+  iv_candidates  for transition rows: 'back|fwd' candidate ivs
+  producer_vs_best  match | mismatch | unresolved | not_in_producer_ledger
+Validation written to the receipt: (V1) the structural iv_best rule against the zip column on every zip row in [ZLO, 2026-07-31] of the same
+symbols (rule accuracy where truth exists); (V2) executor labels at switch_up rows (fundingInfo read after the switch must equal iv_best)."""
+import os, sys, json, glob, gzip, time, hashlib, csv, io
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import fx_harness as H
+
+LO = 1782864000   # 2026-07-01 00:00Z
+HI = 1789300800   # 2026-09-13 12:00Z (close of the frozen live state)
+ZLO = 1577836800  # 2020-01-01 00:00Z: V1 scores every resolution rule over the full zip history
+OUT = H.WORK + "/p9"
+ALLOWED = [1.0, 2.0, 4.0, 6.0, 8.0]
+
+
+def snap(g):
+    return float(min(ALLOWED, key=lambda a: abs(a - (g if 0 < g <= 24 else 8.0))))
+
+
+def T(t): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(int(t)))
+
+
+ZIP_DIRS = [a.split("=", 1)[1] for a in sys.argv[1:] if a.startswith("--zip-dir=")]   # extra monthly zips pulled by p9_pull_monthly_funding_zips.py
+
+
+def main():
+    t0 = time.time(); shas = {}
+    p = H.WORK + "/pod2_inputs/ledger_full.npz"; shas["pod2_ledger_full"] = H.gsha(p)
+    assert shas["pod2_ledger_full"] == "bea6f5752772d54e659a4da5571ca41945a27d1b2316ec0ae52f387074f795ad"
+    z = np.load(p); syms = [str(s) for s in z["symbols"]]; off = z["off"]; FT = z["ft"]; RT = z["rate"]; SRC = z["src"]; ZIV = z["zip_iv"]
+    rows = {}   # sym -> {ft: dict}
+    for j, s in enumerate(syms):
+        a, b = int(off[j]), int(off[j + 1])
