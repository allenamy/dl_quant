+    sl_start = procs["com.hsy.shadowloop"]["start_ts"]
+    add("shadow_loop_v3.py", sl_start, "producer process start",
+        "executed inside the long-lived producer process")
+    add("fea171/combo_stage.py", combo_last, "last combo_live.log run",
+        "relaunched by com.hsy.combolive every anchor")
+    add("fea171/sidecar_blend.py", side_last, "last sidecar_daemon.log run",
+        "relaunched by com.hsy.sidecar every anchor")
+    add("fea171/combo_live_daemon.sh", procs["com.hsy.combolive"]["start_ts"], "combolive daemon start")
