+++ b/fx/prod27_sandbox.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""PROD-27 sandbox: drive combo_live_daemon.sh through a fake clock without editing it.
+
+The daemon is copied BYTE-IDENTICALLY from the code under test and its sha is
+asserted against the source, so a red result cannot come from a doctored script.
+Everything it touches is redirected by environment alone:
+
+  HOME=<sbx>/home        -> the daemon's `cd "$HOME/wide_shadow/fea171"` and WS
+  PATH=<sbx>/bin:...     -> `date` and `sleep` shims (the daemon calls both bare)
+  <WS>/venv/bin/python   -> a stub that records the three call shapes the daemon
+                            makes and never reaches the venue or Telegram:
+                              `-c ...`          the aux.json settle poll  -> real python3
+                              `- SEV MSG`       page()                    -> recorded
+                              `-u combo_stage`  the rewrite               -> recorded, rc from env
+
+Nothing in this module reads or writes `~/wide_shadow` or `~/dl_quant_live`, and
+the stub means a page can never be sent even if a branch fires unexpectedly.
+"""
+import json
+import os
+import shutil
+import subprocess
+import time
+
+ANCHOR_S = 14400
+
+DATE_SHIM = r'''#!/bin/sh
+# Fake clock. FAKE_NOW holds the epoch the daemon should see.
+now=$(cat "$FAKE_NOW_FILE")
+if [ "$1" = "-u" ] && [ "$2" = "+%s" ]; then echo "$now"; exit 0; fi
+if [ "$1" = "-u" ] && [ -z "$2" ]; then exec /bin/date -u -r "$now"; fi
+exec /bin/date "$@"
+'''
+
+SLEEP_SHIM = r'''#!/bin/sh
+# Keep the poll loops from being a hot spin without spending their real seconds.
+exec /bin/sleep 0.02
+'''
+
+PY_STUB = r'''#!/bin/sh
+echo "CALL $*" >> "$P27_OUT/python_calls.txt"
+case "$1" in
+  -c) shift; exec /usr/bin/python3 -c "$@" ;;
+  -)  { echo "=== PAGE sev=$2"; echo "--- msg: $3"; cat >/dev/null; } >> "$P27_OUT/page_calls.txt"
+      exit 0 ;;
+  -u) echo "STAGE_RUN cwd=$(pwd) arg=$2 now=$(cat "$FAKE_NOW_FILE")" >> "$P27_OUT/stage_calls.txt"
+      if [ -n "$P27_STAGE_STDOUT" ]; then printf '%s\n' "$P27_STAGE_STDOUT"; fi
+      exit "${P27_STAGE_RC:-0}" ;;
+esac
+echo "UNEXPECTED $*" >> "$P27_OUT/python_calls.txt"
+exit 99
+'''
+
+
+def _w(path, text, mode=0o644):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w") as f:
+        f.write(text)
+    os.chmod(path, mode)
+
+
+def build(sbx, daemon_src, anchor, now_offset_s, *, king_file=True,
+          aux_anchor="match", rolling_newer=True, last_anchor="0"):
+    """Lay out one scenario.  Returns a dict of the paths the assertions need.
+
+    king_file      write a producer target_live/<A>.json (False = branch (b))
+    aux_anchor     "match" | "stale" — what aux.json prev_rec.anchor_ts says
+    rolling_newer  rolling.npz mtime newer than the target file (the L34 test)
+    """
+    shutil.rmtree(sbx, ignore_errors=True)
+    home = os.path.join(sbx, "home")
+    ws = os.path.join(home, "wide_shadow")
+    fea = os.path.join(ws, "fea171")
+    state = os.path.join(ws, "state")
+    out = os.path.join(sbx, "out")
+    for d in (fea, os.path.join(state, "target_live"), out, os.path.join(sbx, "bin"),
+              os.path.join(ws, "venv", "bin")):
+        os.makedirs(d, exist_ok=True)
+
+    shutil.copyfile(daemon_src, os.path.join(fea, "combo_live_daemon.sh"))
+    os.chmod(os.path.join(fea, "combo_live_daemon.sh"), 0o755)
+    _w(os.path.join(sbx, "bin", "date"), DATE_SHIM, 0o755)
+    _w(os.path.join(sbx, "bin", "sleep"), SLEEP_SHIM, 0o755)
+    _w(os.path.join(ws, "venv", "bin", "python"), PY_STUB, 0o755)
+
+    now = anchor + now_offset_s
+    _w(os.path.join(sbx, "fake_now"), str(int(now)) + "\n")
+    _w(os.path.join(fea, "combo_live_last_anchor"), str(last_anchor) + "\n")
+
+    tl = os.path.join(state, "target_live", f"{anchor}.json")
+    if king_file:
+        doc = {"schema": "wide_target_v1", "anchor_ts": anchor,
+               "weights": {"BTCUSDT": 0.1, "ETHUSDT": -0.1}, "gross_norm": 0.2,
+               "n_names": 2, "universe": ["BTCUSDT", "ETHUSDT"], "universe_sha": "x" * 64,
+               "n_universe": 2, "booster_sha": "y" * 64, "weights_sha": "z" * 64,
+               "written_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now - 60)),
+               "producer": "shadow_loop_v3"}
+        _w(tl, json.dumps(doc))
+        _w(tl + ".sha256", "0" * 64 + f"  {anchor}.json\n")
+
+    _w(os.path.join(state, "aux.json"), json.dumps(
+        {"prev_rec": {"anchor_ts": anchor if aux_anchor == "match" else anchor - ANCHOR_S}}))
+    roll = os.path.join(state, "rolling.npz")
+    _w(roll, "not-a-real-npz\n")
+    if king_file:
+        t_tl = os.path.getmtime(tl)
+        os.utime(roll, (t_tl + 10, t_tl + 10) if rolling_newer else (t_tl - 10, t_tl - 10))
+
+    return {"sbx": sbx, "home": home, "ws": ws, "fea": fea, "state": state, "out": out,
+            "target_live": tl, "last_file": os.path.join(fea, "combo_live_last_anchor"),
+            "log": os.path.join(fea, "combo_live.log"), "anchor": anchor, "now": int(now),
+            "page_calls": os.path.join(out, "page_calls.txt"),
+            "stage_calls": os.path.join(out, "stage_calls.txt"),
+            "python_calls": os.path.join(out, "python_calls.txt")}
+
+
+def run(paths, seconds=3.0, stage_rc="0", stage_stdout=""):
+    """Run the daemon for `seconds` of wall time, then stop it and its children."""
+    env = {
+        "PATH": os.path.join(paths["sbx"], "bin") + ":/usr/bin:/bin",
+        "HOME": paths["home"],
+        "FAKE_NOW_FILE": os.path.join(paths["sbx"], "fake_now"),
+        "P27_OUT": paths["out"],
+        "P27_STAGE_RC": str(stage_rc),
+        "P27_STAGE_STDOUT": stage_stdout,
+        "SHELL": "/bin/bash",
+    }
+    p = subprocess.Popen(["/bin/bash", os.path.join(paths["fea"], "combo_live_daemon.sh")],
+                         env=env, cwd=paths["fea"],
+                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
+    deadline = time.time() + seconds
+    while time.time() < deadline and p.poll() is None:
+        time.sleep(0.05)
+    if p.poll() is None:
+        os.killpg(os.getpgid(p.pid), 15)
+        try:
+            p.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            os.killpg(os.getpgid(p.pid), 9)
+            p.wait(timeout=5)
+    stdout = p.stdout.read().decode(errors="replace") if p.stdout else ""
+    return {
+        "stdout": stdout,
+        "last": _read(paths["last_file"]).strip(),
+        "log": _read(paths["log"]),
+        "pages": _read(paths["page_calls"]),
+        "stage": _read(paths["stage_calls"]),
+        "python": _read(paths["python_calls"]),
+        "target_live": _read(paths["target_live"]),
+    }
+
+
+def _read(p):
+    try:
+        with open(p, "r", errors="replace") as f:
+            return f.read()
+    except FileNotFoundError:
+        return ""
