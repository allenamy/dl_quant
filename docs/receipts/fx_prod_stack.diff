+    need(pr_f == pr_o, "prev_rec unchanged outside legz.king"); need(kf == json.load(open(p5_aux))["prev_rec"]["legz"]["king"], "prev_rec.legz.king = p5 v0 arm")
+    n_king_changed = sum(1 for a, b in zip(kf, ko) if a != b)
