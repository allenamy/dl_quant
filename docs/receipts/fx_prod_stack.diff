+                              re.compile(r"^=== combo_live anchor=\d+ rc=\d+ (.+)$"))
+    side_last = last_log_run(f"{WS}/fea171/sidecar_daemon.log",
+                             re.compile(r"^=== ran for \d+\.json rc=\d+ (.+)$"))
+
+    files = []
+
+    def add(rel, ref, ref_name, note=""):
