+
+def sh(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for c in iter(lambda: f.read(1 << 20), b""):
+            h.update(c)
+    d = h.hexdigest()
+    if os.path.getsize(path) > 0 and d.startswith("e3b0c44298fc1c14"):
+        raise SystemExit(f"FATAL empty-file sha on non-empty {path}")
+    return d
+
+
+def utc(ts):
+    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def run(cmd):
+    p = subprocess.run(cmd, capture_output=True, text=True)
+    return p.stdout, p.returncode
+
+
+def boottime():
+    out, _ = run(["sysctl", "-n", "kern.boottime"])
+    m = re.search(r"sec\s*=\s*(\d+)", out)
+    return int(m.group(1)) if m else None
+
+
+def proc_start(pid):
+    out, rc = run(["ps", "-p", str(pid), "-o", "lstart="])
+    if rc != 0 or not out.strip():
+        return None
+    return int(dt.datetime.strptime(out.strip(), "%a %b %d %H:%M:%S %Y").timestamp())
+
+
+def proc_cmd(pid):
+    out, _ = run(["ps", "-p", str(pid), "-o", "command="])
+    return out.strip()
+
+
+def lsof_files(pid, under):
+    out, _ = run(["lsof", "-p", str(pid), "-Fn"])
+    names = sorted({ln[1:] for ln in out.splitlines()
+                    if ln.startswith("n/") and ln[1:].startswith(under) and os.path.isfile(ln[1:])})
+    return names
+
+
+def launchd_pid(label):
+    out, rc = run(["launchctl", "list", label])
+    if rc != 0:
+        return None
+    m = re.search(r'"PID"\s*=\s*(\d+)', out)
+    return int(m.group(1)) if m else None
+
+
+def last_log_run(path, pattern):
+    """Latest wall-clock instant this daemon actually ran, from its own log."""
+    last = None
+    try:
+        for ln in open(path, errors="replace"):
+            m = pattern.match(ln.strip())
+            if m:
+                last = m.group(1)
+    except FileNotFoundError:
+        return None
+    if last is None:
+        return None
+    return int(dt.datetime.strptime(last.strip(), "%a %b %d %H:%M:%S UTC %Y")
+               .replace(tzinfo=dt.timezone.utc).timestamp())
+
+
+def verdict(mtime, ref, ref_name):
+    if ref is None:
+        return "REF_UNKNOWN", None
