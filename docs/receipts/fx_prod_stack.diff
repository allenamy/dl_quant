+    sys.modules[modname] = mod; spec.loader.exec_module(mod)
+    assert mod.STATE_DIR == home + "/state" and mod.BUNDLE == bundle, (mod.STATE_DIR, mod.BUNDLE)
+    mod.ShadowState.save = lambda self: None
+    return mod
