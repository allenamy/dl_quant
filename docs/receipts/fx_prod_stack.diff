+#!/bin/bash
+# FX-PROD swap dry run on the frozen live state 09-13 12Z (read-only inputs).
+# Start window: >= HH+1:05 after an anchor and outside HH:15-HH:50 of 00/04/08/12/16/20Z (refuses otherwise).
+# Backstop: pauses its own children throughout ANY anchor window, not just 20Z (corrected 2026-09-16; the
+# original only covered 19:55-20:50Z, so a run that overran into the next anchor was unguarded).
+set -u
+cd /Users/haosiyu/cc_tmp/fx_prod
+PY="env -i PATH=/usr/bin:/bin HOME=/Users/haosiyu PYTHONDONTWRITEBYTECODE=1 /Users/haosiyu/wide_shadow/venv/bin/python -B"
+CODE=work/code_b90f1b8; ST=work/frozen/live_1789300800/state; M=work/swapdry
+# lead 09-13: heavy local work only from 17:05Z (16Z executor anchor finishes ~N+58); never inside HH:15-HH:50 of 00/04/08/12/16/20Z
+hm=$(date -u +%H%M); h=$((10#${hm:0:2})); m=$((10#${hm:2:2}))
+if [ $((h % 4)) -eq 0 ] && [ $m -ge 15 ] && [ $m -lt 50 ]; then echo "REFUSE: anchor window"; exit 3; fi
+if [ $((h % 4)) -eq 0 ] && [ $m -lt 15 ] || { [ $((h % 4)) -eq 0 ] && [ $m -ge 50 ]; } || { [ $((h % 4)) -eq 1 ] && [ $m -lt 5 ]; }; then echo "REFUSE: executor settlement tail (start >= HH+1:05)"; exit 3; fi
+# sandbox: outputs only under work/swapdry; ~/wide_shadow is read (bundle, aug backup, venv) and must be unchanged -> before/after listing
+LIVE_RO="/Users/haosiyu/wide_shadow/shadow_bundle /Users/haosiyu/wide_shadow/shadow_bundle.aug20260816_backup"
+find $LIVE_RO -type f -exec stat -f "%m %z %N" {} \; | sort > $M/live_ro_before.txt
+guard() {   # pause this driver's direct children inside ANY anchor window (bash 3.2: no BASHPID, so read the subshell pid via PPID)
+  SELF=$(exec /bin/sh -c 'echo $PPID')
+  echo "guard self $SELF; covers every anchor hour (h%4==0) minutes 13..51" >> $M/guard.log
+  while kill -0 $$ 2>/dev/null; do
+    gh=$((10#$(date -u +%H))); gm=$((10#$(date -u +%M)))
+    if [ $((gh % 4)) -eq 0 ] && [ $gm -ge 13 ] && [ $gm -lt 52 ]; then want=STOP; else want=CONT; fi
+    n=0
+    for p in $(pgrep -P $$); do
+      [ "$p" = "$SELF" ] && continue
+      n=$((n+1))
+      if [ "$want" = STOP ]; then kill -STOP $p && echo "STOP $p $(date -u +%T)" >> $M/guard.log
+      else kill -CONT $p 2>/dev/null; fi
+    done
+    echo "guard tick $(date -u +%T) want=$want targets=$n" >> $M/guard.log
+    sleep 10
+  done
+}
+guard & GP=$!
+echo "armed guard pid $GP (children now: $(pgrep -P $$ | tr '\n' ' ')); driver $$ at $(date -u +%T); fx_prod HEAD $(git log -1 --format=%h)" >> $M/guard.log
+step() { echo "=== $1 start $(date -u +%T)"; shift; "$@"; rc=$?; echo "=== rc=$rc end $(date -u +%T)"; return $rc; }
+{
+step P5 $PY migrations/p5_rescore_seat_king.py --code $CODE --state $ST --out $M/p5 || exit 2
+mkdir -p $M/in_p1 && ln -sf ../p5/aux.p5.json $M/in_p1/aux.json
+step P1 $PY migrations/p1_build_ema_v0.py --state $M/in_p1 --code $CODE --out $M/p1 || exit 2
+mkdir -p $M/in_corr && ln -sf ../p1/aux.with_ema_v0.json $M/in_corr/aux.json
+step CORR $PY migrations/fund_label_ema_correction.py --state $M/in_corr --code $CODE --out $M/corr --classes D17,P9 --zip-dir /Users/haosiyu/cc_tmp/fx_prod/work/pod2_inputs/zips_2026-08 --control --allow-out-of-tail || exit 2
+step COMPOSE $PY migrations/swap_state_compose_check.py --orig $ST --p5 $M/p5 --p1 $M/p1 --corr $M/corr --code $CODE --out $M/compose || exit 2
+S=$M/compose/STAGED
+step LOAD_new_staged $PY migrations/swap_load_test.py --code $CODE --aux $S/aux.json --lr $S/leg_returns_live.json --rolling $ST/rolling.npz --home $M/load_new_staged --expect load
+step LOAD_old_staged $PY migrations/swap_load_test.py --code work/code_live_b8917484 --aux $S/aux.json --lr $S/leg_returns_live.json --rolling $ST/rolling.npz --home $M/load_old_staged --expect load
+step LOAD_new_original $PY migrations/swap_load_test.py --code $CODE --aux $ST/aux.json --lr $ST/leg_returns_live.json --rolling $ST/rolling.npz --home $M/load_new_original --expect refuse
+step LOAD_old_original $PY migrations/swap_load_test.py --code work/code_live_b8917484 --aux $ST/aux.json --lr $ST/leg_returns_live.json --rolling $ST/rolling.npz --home $M/load_old_original --expect load
+find $LIVE_RO -type f -exec stat -f "%m %z %N" {} \; | sort > $M/live_ro_after.txt
+cmp -s $M/live_ro_before.txt $M/live_ro_after.txt && echo "LIVE_RO unchanged" || echo "LIVE_RO CHANGED"
+echo "=== DONE $(date -u +%T)"
+} > $M/run_dry.log 2>&1
+kill $GP 2>/dev/null
