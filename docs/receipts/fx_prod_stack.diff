+#!/usr/bin/env python3
+"""P12: establish which process last writes fea171/state_H_f10_<A>.npz, per anchor.
+
+READ-ONLY.  Two candidate writers exist in code, both with the same path and both
+with a bare `np.savez` (no tmp + os.replace):
+
+  fea171/combo_stage.py   L180-194   run by com.hsy.combolive once per anchor
+  fea171/sidecar_blend.py L177-194   run by com.hsy.sidecar, which sleeps 120 s
+                                     after a new target_live appears
+  fea171/combo_stage_t3c_candidate.py L180-194  (candidate; checked for runners)
+
+The file is read at the NEXT anchor as `hf_prev` by whichever of them runs first,
+so whoever writes last decides the combo book's F-10 warm start.
+
+Attribution is by interval, not by guessing: each writer's run window is taken from
+its own daemon log (`combo_live.log` gives the finish stamp and the stage's elapsed
+seconds; `sidecar_daemon.log` gives the finish stamp and its elapsed seconds), and
+the file's mtime is placed in one window, the other, both, or neither.  An mtime that
+lands in neither window is reported as UNATTRIBUTED rather than assigned.
+
+Usage:
+  python3 fx/p12_state_h_census.py --ws ~/wide_shadow --out work/p12/P12_CENSUS.json
+"""
+import argparse
+import datetime as dt
+import hashlib
+import json
+import os
+import re
+import sys
+import time
+
+ANCHOR_S = 14400
+RESULT_RE = re.compile(r"^=== combo_live anchor=(\d+) rc=(\d+) (.+)$")
+SIDECAR_RE = re.compile(r"^=== ran for (\d+)\.json rc=(\d+) (.+)$")
+STAMP_RE = re.compile(r"^\[\s*([0-9.]+)s\]")
+
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    d = h.hexdigest()
+    if os.path.getsize(path) > 0 and d.startswith("e3b0c44298fc1c14"):
+        raise SystemExit(f"FATAL empty-file sha on non-empty {path} (T6 guard)")
+    return d
+
+
+def utc(ts):
+    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def pdate(s):
+    return int(dt.datetime.strptime(s.strip(), "%a %b %d %H:%M:%S UTC %Y")
+               .replace(tzinfo=dt.timezone.utc).timestamp())
+
+
+def read_runs(path, result_re, key_is_anchor):
+    """{anchor: {"end": ts, "elapsed": s, "rc": n}} — one run window per anchor."""
+    out = {}
+    block = []
+    with open(path, "r", errors="replace") as f:
+        for raw in f:
+            line = raw.rstrip("\n")
+            m = result_re.match(line)
+            if m:
+                a = int(m.group(1))
+                if not key_is_anchor:
+                    a = a  # sidecar keys by the target_live basename, which IS the anchor
+                last = None
+                for b in block:
+                    ms = STAMP_RE.match(b)
+                    if ms:
+                        last = float(ms.group(1))
+                out[a] = {"end": pdate(m.group(3)), "rc": int(m.group(2)),
+                          "elapsed": last, "lines": len(block)}
+                block = []
+                continue
+            block.append(line)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--ws", default=os.path.expanduser("~/wide_shadow"))
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--slack", type=float, default=2.0,
+                    help="seconds of slack on each side of a run window (log stamps are "
+                         "whole seconds and the savez precedes the final log line)")
+    args = ap.parse_args()
+
+    ws = os.path.realpath(os.path.expanduser(args.ws))
+    out = os.path.realpath(os.path.expanduser(args.out))
+    if out.startswith(ws + os.sep) or out == ws:
+        raise SystemExit(f"FATAL --out {out} resolves under --ws {ws}; read-only there")
+
+    fea = os.path.join(ws, "fea171")
+    combo_runs = read_runs(os.path.join(fea, "combo_live.log"), RESULT_RE, True)
+    side_runs = read_runs(os.path.join(fea, "sidecar_daemon.log"), SIDECAR_RE, False)
+
+    files = {}
+    for n in os.listdir(fea):
+        m = re.match(r"^state_H_f10_(\d+)\.npz$", n)
+        if m:
+            files[int(m.group(1))] = os.path.join(fea, n)
+
+    rows = []
+    for a in sorted(files):
+        p = files[a]
+        mt = os.path.getmtime(p)
+        c = combo_runs.get(a)
+        s = side_runs.get(a)
+
+        def inwin(run):
+            if not run or run["elapsed"] is None:
+                return None
+            start = run["end"] - run["elapsed"] - args.slack
+            return start <= mt <= run["end"] + args.slack
+
+        in_c, in_s = inwin(c), inwin(s)
+        if in_c and not in_s:
+            who = "combo_stage"
+        elif in_s and not in_c:
+            who = "sidecar_blend"
+        elif in_c and in_s:
+            who = "AMBIGUOUS_both_windows"
+        elif in_c is None and in_s is None:
+            who = "NO_RUN_RECORD"
+        else:
+            who = "UNATTRIBUTED"
+        rows.append({
+            "anchor": a, "anchor_utc": utc(a),
+            "mtime_s_after_anchor": round(mt - a, 1),
+            "size": os.path.getsize(p), "sha256": sha256_file(p),
+            "combo_end_s": None if not c else round(c["end"] - a, 1),
+            "combo_elapsed": None if not c else c["elapsed"],
+            "sidecar_end_s": None if not s else round(s["end"] - a, 1),
+            "sidecar_elapsed": None if not s else s["elapsed"],
+            "mtime_minus_combo_end": None if not c else round(mt - c["end"], 1),
+            "mtime_minus_sidecar_end": None if not s else round(mt - s["end"], 1),
+            "in_combo_window": in_c, "in_sidecar_window": in_s,
+            "last_writer": who,
+        })
+
+    counts = {}
+    for r in rows:
+        counts[r["last_writer"]] = counts.get(r["last_writer"], 0) + 1
+
+    # does the sidecar ever finish after the executor's first read (N+24:00)?
+    late = [{"anchor_utc": r["anchor_utc"], "sidecar_end_s": r["sidecar_end_s"]}
+            for r in rows if r["sidecar_end_s"] is not None and r["sidecar_end_s"] > 1440]
+
+    result = {
+        "device": os.path.basename(__file__),
+        "device_sha256": sha256_file(os.path.abspath(__file__)),
+        "generated_utc": utc(int(time.time())),
+        "config": {"ws": ws, "out": out, "slack_s": args.slack},
+        "inputs_sha256": {
+            "combo_stage.py": sha256_file(os.path.join(fea, "combo_stage.py")),
+            "sidecar_blend.py": sha256_file(os.path.join(fea, "sidecar_blend.py")),
+            "sidecar_daemon.sh": sha256_file(os.path.join(fea, "sidecar_daemon.sh")),
+            "combo_live.log": sha256_file(os.path.join(fea, "combo_live.log")),
+            "sidecar_daemon.log": sha256_file(os.path.join(fea, "sidecar_daemon.log")),
+        },
+        "summary": {
+            "n_state_H_files": len(rows),
+            "last_writer_counts": counts,
+            "n_combo_runs_logged": len(combo_runs),
+            "n_sidecar_runs_logged": len(side_runs),
+            "anchors_with_combo_but_no_sidecar": [utc(a) for a in sorted(combo_runs)
+                                                  if a not in side_runs],
+            "anchors_with_sidecar_but_no_combo": [utc(a) for a in sorted(side_runs)
+                                                  if a not in combo_runs],
+            "sidecar_finishes_after_exec_read_N24": {
+                "n": len(late), "anchors": late[:20],
+            },
+            "sidecar_end_minus_combo_end_s": sorted(
+                round(r["sidecar_end_s"] - r["combo_end_s"], 1) for r in rows
+                if r["sidecar_end_s"] is not None and r["combo_end_s"] is not None)[:1] +
+            sorted(round(r["sidecar_end_s"] - r["combo_end_s"], 1) for r in rows
+                   if r["sidecar_end_s"] is not None and r["combo_end_s"] is not None)[-1:],
+        },
+        "rows": rows,
+    }
+    os.makedirs(os.path.dirname(out), exist_ok=True)
+    with open(out, "w") as f:
+        json.dump(result, f, indent=1)
+    s = result["summary"]
+    print(f"[p12_census] device_sha={result['device_sha256'][:8]} out={out}")
+    print(f"  state_H_f10 files {s['n_state_H_files']} | combo runs {s['n_combo_runs_logged']} "
+          f"| sidecar runs {s['n_sidecar_runs_logged']}")
+    print(f"  LAST WRITER: {s['last_writer_counts']}")
+    print(f"  sidecar finishing AFTER the executor read (N+24:00): {s['sidecar_finishes_after_exec_read_N24']['n']}")
+    print(f"  sidecar_end - combo_end (min, max) = {s['sidecar_end_minus_combo_end_s']}")
+    print(f"  combo-only anchors: {s['anchors_with_combo_but_no_sidecar']}")
+    print(f"  sidecar-only anchors: {s['anchors_with_sidecar_but_no_combo']}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
