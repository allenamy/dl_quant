+                  "n": len(rows), "n_match": sum(1 for r in rows if r.get("match")),
+                  "n_mismatch": sum(1 for r in rows if r.get("match") is False),
+                  "rows": rows}
+
+    n_unknown = sum(1 for f in files if f.get("verdict") == "RUNNING_CODE_UNKNOWN")
+    res = {
+        "device": os.path.basename(__file__), "device_sha256": sh(os.path.abspath(__file__)),
+        "generated_utc": utc(int(time.time())),
+        "method": ("mtime < process start (or < the last logged run, for per-anchor children) proves the "
+                   "bytes on disk now are the bytes that were loaded; anything else is RUNNING_CODE_UNKNOWN. "
+                   "lsof is corroboration only: a long-lived Python has closed its .py sources, so absence "
+                   "from lsof is not evidence. git HEAD is deliberately not used."),
+        "supersedes": ("AUDIT_PROD PROD-28, verified against shadowloop PID 10900 / sidecar 30943 / "
+                       "combolive 30944, which no longer exist"),
+        "kern_boottime_utc": utc(bt) if bt else None,
+        "processes": procs,
+        "last_runs": {"combo_live.log": utc(combo_last) if combo_last else None,
+                      "sidecar_daemon.log": utc(side_last) if side_last else None},
+        "files": files, "bundle": bundle,
+        "summary": {"n_files": len(files), "n_running_code_unknown": n_unknown,
