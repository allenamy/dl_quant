+FX = "/Users/haosiyu/cc_tmp/fx_prod"; sys.path.insert(0, FX + "/fx")
+import fx_harness as FH
+ap = argparse.ArgumentParser()
+for a in ("--orig", "--p5", "--p1", "--corr", "--code", "--out"): ap.add_argument(a, required=True)
+args = ap.parse_args()
+assert os.path.abspath(args.out) not in {os.path.abspath(x) for x in (args.orig, args.p5, args.p1, args.corr)}
+
+
+def main():
+    t0 = time.time(); fails = []
+    def need(ok, what):
+        if not ok: fails.append(what)
+    o_aux_p = args.orig + "/aux.json"; o_lr_p = args.orig + "/leg_returns_live.json"
+    r5 = json.load(open(args.p5 + "/RECEIPT_p5_rescore_seat_king.json")); r1 = json.load(open(args.p1 + "/RECEIPT_p1_build_ema_v0.json"))
+    rc_ = json.load(open(args.corr + "/RECEIPT_fund_label_ema_correction.json"))
+    p5_aux = args.p5 + "/aux.p5.json"; p5_lr = args.p5 + "/leg_returns_live.rescored.json"; p1_aux = args.p1 + "/aux.with_ema_v0.json"; c_aux = args.corr + "/aux.corrected.json"
+    sha = {k: FH.gsha(p) for k, p in (("orig_aux", o_aux_p), ("orig_lr", o_lr_p), ("p5_aux", p5_aux), ("p5_lr", p5_lr), ("p1_aux", p1_aux), ("corr_aux", c_aux), ("code", args.code + "/shadow_loop_v3.py"))}
+    # receipt chain
+    need(r5.get("PASS") is True, "p5 PASS"); need(r1.get("PASS") is True, "p1 PASS")
+    need(r5["inputs"]["aux"]["sha256"] == sha["orig_aux"] and r5["inputs"]["leg_returns_live"]["sha256"] == sha["orig_lr"], "p5 inputs = original state")
