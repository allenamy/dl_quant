+#!/usr/bin/env python3
+"""swap_load_test.py — OFFLINE: does ShadowState(cfg) of a given shadow_loop_v3.py load a given state without REFUSE_TO_START?
+Runs the real module (not a replay device) with WIDE_SHADOW_HOME pointing at a scratch home whose state/ holds symlinks to the files under
+test; the bundle is read in place (read-only). One process per case so module constants and sys.exit stay isolated.
+Usage: python3 -B swap_load_test.py --code DIR --aux FILE --lr FILE --rolling FILE --home SCRATCH_DIR --expect load|refuse"""
+import os, sys, json, argparse, importlib.util, hashlib, io, contextlib
+ap = argparse.ArgumentParser()
+for a in ("--code", "--aux", "--lr", "--rolling", "--home", "--expect"): ap.add_argument(a, required=True)
+A = ap.parse_args()
+assert A.expect in ("load", "refuse") and not os.path.exists(A.home), "home must be a new scratch directory"
+os.makedirs(A.home + "/state")
+for src, dst in ((A.aux, "aux.json"), (A.lr, "leg_returns_live.json"), (A.rolling, "rolling.npz")):
+    os.symlink(os.path.abspath(src), A.home + "/state/" + dst)
+os.environ["WIDE_SHADOW_HOME"] = A.home
+sha = lambda p: hashlib.sha256(open(p, "rb").read()).hexdigest()
+spec = importlib.util.spec_from_file_location("slp_load", A.code + "/shadow_loop_v3.py"); SL = importlib.util.module_from_spec(spec); spec.loader.exec_module(SL)
+assert SL.STATE_DIR == A.home + "/state"
+cfg = json.load(open(SL.BUNDLE + "/config.json"))
+buf = io.StringIO(); out = dict(code_sha256=sha(A.code + "/shadow_loop_v3.py"), aux_sha256=sha(A.aux), lr_sha256=sha(A.lr), expect=A.expect,
+                                flags={k: getattr(SL, k, None) for k in ("FUND_COL80_V0", "FUND_IV_RERESOLVE")})
+try:
+    with contextlib.redirect_stdout(buf):
+        st = SL.ShadowState(cfg)
+    out.update(result="load", n_ema=len(st.ema), n_ema_v0=None if getattr(st, "ema_v0", None) is None else len(st.ema_v0), last_anchor=st.last_anchor,
+               prev_rec_anchor=(st.prev_rec or {}).get("anchor_ts"), lr_len=len(st.LR["king"]))
+except SystemExit as e:
+    out.update(result="refuse", exit_code=e.code)
+out["stdout"] = buf.getvalue()[-400:]
+out["PASS"] = out["result"] == A.expect
+print(json.dumps(out))
+sys.exit(0 if out["PASS"] else 2)
