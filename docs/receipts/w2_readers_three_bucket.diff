+def _finite(x):
+    """float(x) if it is a finite number, else None. NaN / inf / text are not numbers we report."""
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and v not in (float("inf"), float("-inf"))) else None
