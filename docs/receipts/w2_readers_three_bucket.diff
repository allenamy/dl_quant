+"""Three-bucket classification of filled order rows for the READ-ONLY cost readers. Pure; no I/O.
+
+★★★ WHY THIS MODULE EXISTS (W2, 2026-09-12; POSTMORTEM_b0a573a1 §5 "下游成本读者未继承三桶").
+    The in-production cost diagnostics (`anchor_loop.neutrality_price`, `chase_readout.collect`,
+    `verify_reshape_anchor.neutrality_lines`) were migrated in review rounds 13/14/14b/15 to ONE
+    rule: a fill is MEASURED only when its price is usable AND its fee is known; everything else
+    is named by its bucket, and a bps over zero measured fills is None, never 0. Three operator
+    readers still read `fee_paid or 0` and filtered unpriced rows away silently:
+      · `ops/daily_summary.py`       per-anchor cost column
+      · `ops/first_anchor_review.py` §3c realised cost
+      · `ops/score_post_fix.py`      E6 (through pilot_metrics.m1, whose denominator keeps
+                                     fee-unknown rows at fee 0 — a documented lower bound)
+    Measured on the LIVE ledger (read-only copy, 2026-09-12): anchor 2026-08-05 12:00Z had
+    103/103 fills with `fee_paid=0.0, fee_all_usdt=False, fee_conversion=None` — every fee was a
+    BNB commission nobody converted — and the daily summary printed **-3.70 bps** for it, a cost
+    figure computed over ZERO measured fills. This module makes that read `None` with the
+    bucket counts beside it.
+
+★★ THE RULE IS COPIED, NOT IMPORTED, AND THE COPY IS PINNED BY AN EQUALITY ASSERTION.
+   `anchor_loop.neutrality_price` owns the rule on the production path; importing anchor_loop into
+   an operator tool would drag the whole loop (torch, venue clients) into a read-only screen. So
+   the two predicates below are the same code as `anchor_loop.py` `_pos` / `_fee`, and the suite
+   `tests_readers_three_bucket` asserts bucket_fills() and neutrality_price() agree key by key on
+   the same rows. Drift between them goes red there before it reaches a screen.
+
+★ SIGN CONVENTION: the adverse-slippage sign is taken from the SIGN OF `filled_notional` (buy > 0),
+  as the two production diagnostics do — not from the `side` string. The review tool used `side`;
+  the two agree on every row the executor writes (side="buy" <=> filled_notional > 0) and the
+  equality assertion is what makes that a checked fact rather than a belief.
+
+None is never coerced to 0 anywhere in this file. A quantity that could not be read is absent
+from BOTH the numerator and the denominator, and the record says how much was absent.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional, Tuple
+
+_INF = (float("inf"), float("-inf"))
+
+MEASURED_OVER = ("MEASURED fills only — a fill with a usable price (finite positive avg_fill_px "
+                 "AND mid_at_anchor) AND a known fee (fee_paid not None and finite; a raw "
+                 "mixed-asset fee with fee_all_usdt=False and no fee_conversion is NOT known). "
+                 "An unpriced or fee-unknown fill is excluded from numerator AND denominator; "
+                 "it is not a zero-cost fill. bps is None when nothing was measured.")
+
+
+def usable_px(x: Any) -> Optional[float]:
+    """Finite, strictly positive price — or None. Same as anchor_loop.neutrality_price `_pos`."""
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and v not in _INF and v > 0) else None
+
+
+def known_fee(o: Dict[str, Any]) -> Optional[float]:
+    """The row's fee as a KNOWN USDT number — or None. Same as anchor_loop `_fee`.
+
+    ★ `fee_all_usdt is False` without `fee_conversion` means the writer stored the raw USDT slice
+      (often 0.0) of a fee that was partly charged in another asset. That is not a known fee.
+    """
+    f = o.get("fee_paid")
+    if f is None:
+        return None
+    if o.get("fee_all_usdt") is False and not o.get("fee_conversion"):
+        return None
+    try:
+        v = float(f)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and v not in _INF) else None
+
+
+def filled_abs(o: Dict[str, Any]) -> Optional[float]:
+    """|filled_notional| when it is a finite number, else None (unknown fill — NOT zero)."""
+    f = o.get("filled_notional")
+    if f is None:
+        return None
+    try:
+        v = float(f)
+    except (TypeError, ValueError):
+        return None
+    return abs(v) if (v == v and v not in _INF) else None
+
+
+def partition(rows: List[Dict[str, Any]]) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]],
+                                                    List[Dict[str, Any]], List[Dict[str, Any]]]:
+    """(measured, fee_unknown, unpriced, unknown_fill). Rows with a known zero fill are in none."""
+    measured, fee_unknown, unpriced, unknown = [], [], [], []
+    for o in rows:
+        fa = filled_abs(o)
+        if fa is None:
+            unknown.append(o)
+            continue
+        if fa <= 0:
+            continue
+        if usable_px(o.get("avg_fill_px")) is None or usable_px(o.get("mid_at_anchor")) is None:
+            unpriced.append(o)
+        elif known_fee(o) is None:
+            fee_unknown.append(o)
+        else:
+            measured.append(o)
+    return measured, fee_unknown, unpriced, unknown
+
+
+def bucket_fills(rows: List[Dict[str, Any]]) -> Dict[str, Any]:
+    """Three buckets + coverage + bps over the measured set. JSON-safe (no row objects)."""
+    measured, fee_unknown, unpriced, unknown = partition(rows)
+    n_fills = len(measured) + len(fee_unknown) + len(unpriced)
+    notl_m = sum(filled_abs(o) for o in measured)
+    notl_fu = sum(filled_abs(o) for o in fee_unknown)
+    notl_up = sum(filled_abs(o) for o in unpriced)
+    notl = notl_m + notl_fu + notl_up
+    fee_m = sum(known_fee(o) for o in measured)
+    adverse = 0.0            # signed: + = paid through the mid, - = price improvement
+    abs_slip = 0.0           # dispersion: |deviation| x notional
+    for o in measured:
+        px, mid = usable_px(o.get("avg_fill_px")), usable_px(o.get("mid_at_anchor"))
+        fa = filled_abs(o)
+        sgn = 1.0 if float(o["filled_notional"]) > 0 else -1.0
+        dev = (px - mid) / mid
+        adverse += sgn * dev * fa
+        abs_slip += abs(dev) * fa
+
+    def _bps(num: float) -> Optional[float]:
+        return (1e4 * num / notl_m) if notl_m else None
+
+    return {
+        "n_rows": len(rows),
+        "n_fills": n_fills,                       # known, non-zero fills (any bucket)
+        "n_unknown_fill": len(unknown),           # filled_notional None: NOT a zero fill
+        "n_measured": len(measured),
+        "n_fee_unknown": len(fee_unknown),
+        "n_unpriced": len(unpriced),
+        "notional_usdt": round(notl, 4),
+        "notional_measured_usdt": round(notl_m, 4),
+        "fee_unknown_notional_usdt": round(notl_fu, 4),
+        "unpriced_notional_usdt": round(notl_up, 4),
+        "fee_measured_usdt": round(fee_m, 8),
+        "adverse_measured_usdt": round(adverse, 8),
+        "abs_slip_measured_usdt": round(abs_slip, 8),
+        # bps over the MEASURED set only; None when nothing was measured
+        "bps_measured": _bps(fee_m + adverse),          # fee + signed adverse (money)
+        "fee_bps_measured": _bps(fee_m),
+        "adverse_bps_measured": _bps(adverse),
+        "abs_slip_bps_measured": _bps(abs_slip),
+        "abs_bps_measured": _bps(fee_m + abs_slip),     # fee + |slip| (m1's `c_bps_overall` caliber)
+        # ★ EXACT, not rounded (review W2-R2, 2026-09-12): a rounded coverage read 1.0 for 9999.6
+        #   measured beside 0.4 fee-unknown, so `< 1.0` was false and a screen printed 100%. Round
+        #   for DISPLAY only (`pct_floor`); compare on the exact ratio or on the counts.
+        "coverage_measured_notional": ((notl_m / notl) if notl else None),
+        "coverage_measured_count": ((len(measured) / n_fills) if n_fills else None),
+        # ★ THREE STATES, derived from the buckets and from nothing else: None = nothing to
+        #   measure (no known fill and no unknown fill); True = every fill known, priced and
+        #   fee-known; False otherwise. A non-finite fee or a raw mixed-asset fee is fee-unknown
+        #   here, so this bit is False where pilot_metrics.m1's `measurement_complete` can still
+        #   read True (review W2-R1; m1 is frozen — consumers derive completeness from THIS key).
+        "measurement_complete": (None if (n_fills == 0 and not unknown) else
+                                 (len(unknown) == 0 and len(unpriced) == 0
+                                  and len(fee_unknown) == 0)),
+        "measured_over": MEASURED_OVER,
+    }
+
+
+def pct_floor(cov: Optional[float]) -> Optional[int]:
+    """Coverage as an integer percent, FLOORED — 0.99996 prints 99, never 100."""
+    if cov is None:
+        return None
+    try:
+        v = float(cov)
+    except (TypeError, ValueError):
+        return None
+    if v != v:
+        return None
+    return int(v * 100.0 + 1e-9) if v < 1.0 else 100
+
+
+def coverage_note(b: Dict[str, Any]) -> str:
+    """One line a screen can print beside a bps: what was measured and what was not."""
+    if not b.get("n_fills"):
+        return ("no known non-zero fill" + (f"; {b['n_unknown_fill']} row(s) with UNKNOWN fill"
+                                            if b.get("n_unknown_fill") else ""))
+    parts = [f"measured {b['n_measured']}/{b['n_fills']} fills"]
+    cov = pct_floor(b.get("coverage_measured_notional"))
+    parts.append(f"notional coverage {cov}%" if cov is not None else "notional coverage n/a")
+    if b.get("n_fee_unknown"):
+        parts.append(f"fee-unknown {b['n_fee_unknown']} / ${b['fee_unknown_notional_usdt']:,.2f}")
+    if b.get("n_unpriced"):
+        parts.append(f"unpriced {b['n_unpriced']} / ${b['unpriced_notional_usdt']:,.2f}")
+    if b.get("n_unknown_fill"):
+        parts.append(f"unknown-fill rows {b['n_unknown_fill']}")
+    if b.get("bps_measured") is None:
+        parts.append("bps UNMEASURED (not 0)")
+    return "; ".join(parts)
