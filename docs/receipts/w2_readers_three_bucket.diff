+    lg = PL.PilotLogger(root, DAY)
+    rid = f"A{int(T0)}"
+    lg.anchor(anchor_ts=T0, target_vector_hash="h", realized_gross=0,
+              target_gross=sum(abs(l[1] or 0) for l in legs), n_names_skipped=0,
+              regime_at_anchor="calm", mid_at_anchor_vector={l[0]: l[3] for l in legs},
+              factor_version="{}", panel_hash="p", rebalance_id=rid, opening_halted=False,
+              weights={"king": 0.5, "s2": 0.17, "funding": 0.17, "size": 0.16})
