+def realised_facts(row) -> dict:
+    """The row's realised P&L as a RECORD with its own observability, USDT caliber and completeness.
+
+    ★★★ W2 2026-09-12 — two VERIFIED counterexamples from the independent reviewer
+        (codex_system_status_review_2026-09-12/deployment/RESULT.md §5):
+        (1) the income carrier sums every asset's raw amount into `realised_pnl`; on a row with
+            USDT -0.30 and BNB -0.01 the old reader printed **-0.31** and called it USDT. The carrier
+            writes `realised_by_type_asset` / `realised_non_usdt_assets` beside the sum since
+            2026-09-12 06:05Z (E-0909-H round 4) precisely so a reader can SEE the foreign-unit row;
+            this reader now sums the USDT slice only and lists every other asset UNCONVERTED, with
+            its raw amount and asset — never added into a USDT figure.
+        (2) `realised_pnl=None` (the income endpoint failed; the loop refuses to write 0 there)
+            read as `realised_today=0.0` under `or 0.0`, and the same-day residual was then computed
+            with that fabricated zero. Now: `observable=False`, `usdt=None`, and the residual refuses.
+    ★ A row written before the per-asset split existed cannot be split. The carrier's sum is passed
+      through with `caliber="legacy_carrier_sum_usdt_assumed"` — an assumption STATED, not a number
+      invented. `realised_truncated=True` (income paging hit its cap) makes the figure a PARTIAL
+      READ: kept, labelled `complete=False`, never presented as the day's total — and NOT called a
+      bound of any kind: the missing rows are signed (P&L, commission, funding), so the partial sum
+      is neither a lower nor an upper bound (review W2-R2). `complete=None` = the flag is absent.
+    """
+    r = row or {}
+    src = r.get("realised_pnl_source")
+
+    def _unobs(why):
+        return {"observable": False, "usdt": None, "by_type_usdt": {}, "unconverted": [],
+                "caliber": None, "complete": None, "carrier_sum": None,
+                "carrier_sum_mixes_assets": None, "why": why}
