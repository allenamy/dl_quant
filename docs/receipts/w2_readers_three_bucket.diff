+                "by_type_usdt": {t: float(by_type[t]) for t in types if t in by_type},
+                "unconverted": [], "caliber": "legacy_carrier_sum_usdt_assumed",
+                "complete": complete, "carrier_sum": carrier, "carrier_sum_mixes_assets": None,
+                "why": None}
+    by_type_usdt, unconverted = {}, []
