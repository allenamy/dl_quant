+                                  f"monitor stopped running")
+    level, judged = rec.get("level"), rec.get("judged")
+    if level == "UNSTAMPED":
+        findings.append(f"UNSTAMPED: #55 reports its thresholds unstamped ({rec.get('note')}).")
+        return done("UNSTAMPED", f"UNSTAMPED: #55's evaluation of {iso(eval_at)} reports its thresholds unstamped")
+    if judged is True and level in ("OK", "ALERT", "DECIDE"):
+        lag = out["data_lag_anchors"]
+        if lag is None or lag > MAX_LAG_ANCHORS:
+            findings.append(f"DATA_LAG_CONTRADICTION: #55 judged ({level}) while its observed newest anchor "
+                            f"{out['observed_newest_anchor']} lags its own expected frontier {out['expected_frontier']} by "
+                            f"{lag} anchors (a judged r24 window allows {MAX_LAG_ANCHORS}).")
+            return done("DATA_LAG_CONTRADICTION", findings[-1] + f" [evaluation {iso(eval_at)}]")
+        return done("JUDGED")
+    inc = rec.get("incomplete_windows")
+    if judged is False and level == "INCOMPLETE" and cz and isinstance(inc, list) and inc \
+            and all(isinstance(cz.get(k), dict) for k in inc):
