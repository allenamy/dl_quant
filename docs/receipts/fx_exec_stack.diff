+        for a in rep["amendments"]:
+            print(f"AMENDMENT {a['verdict']} {a['record']} {a.get('why') or ''}")
+        print(json.dumps({"rc": rep["rc"], **rep["summary"]}))
+    return rep["rc"]
+
+
+def main(argv=None, notifier=None):
