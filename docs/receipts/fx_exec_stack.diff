+        except NotaryError as e:
+            rc = 2
+            _alarm(notifier, f"台账公证失败 [{day}] {e.step}: {e.detail} — 清单未写入")
+            continue
+        except OSError as e:
+            rc = 2
+            _alarm(notifier, f"台账公证失败 [{day}] write: {type(e).__name__}: {e} — 清单未写入")
+            continue
+        written.append(p)
+        print(f"[{_utc()}] {day}: {man['n_files']} tables notarized; prev={man['prev_manifest']}; appends={len(man['appends'])}; "
+              f"not_notarized={man['not_notarized']}; absent_tables={man['absent_tables']}", flush=True)
+        if man["integrity_findings"]:
+            rc = 2
+            fs = "; ".join(f"{f['day']}/{f['file']} {f['verdict']}" for f in man["integrity_findings"][:8])
+            _alarm(notifier, f"台账公证 [{day}]: 已公证台账被改动 {len(man['integrity_findings'])} 处 — {fs}"
+                             f"{' …' if len(man['integrity_findings']) > 8 else ''}(已记入 manifest_{day}.json)")
+    if not written:
+        print(f"[{_utc()}] NOTARY rc={rc} written=0", flush=True)
