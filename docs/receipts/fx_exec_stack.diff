+"""ALM-03 fixture builder (FX-EXEC 2026-09-13) — READ-ONLY on ~/dl_quant_live/state, run once by hand; the suite never runs it.
+Copies, byte for byte:
+  state/live/ic_monitor.jsonl            #55's per-anchor rank-IC ledger (the rows W1's check() judges)
+  state/factor_health_last.json          what step 9 (check_factor_health.run) persisted at the last live anchor
+  state/alarm_episodes/factor_health.json its open episode
+and records sha256/bytes of each, the copy time, and the facts the suite re-derives: the ef60f85 commit time (W1's append_eval
+went live there) and that state/live/ic_monitor_evals.jsonl did NOT exist at copy time."""
+import hashlib, json, os, subprocess, time
+HERE = os.path.dirname(os.path.abspath(__file__))
+LIVE = os.path.expanduser("~/dl_quant_live")
+SRC = {"ic_monitor.jsonl": "state/live/ic_monitor.jsonl", "factor_health_last.json": "state/factor_health_last.json",
+       "alarm_episode_factor_health.json": "state/alarm_episodes/factor_health.json"}
+out = {"built_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "source_repo": LIVE, "files": {}}
+for dst, rel in SRC.items():
+    b = open(os.path.join(LIVE, rel), "rb").read()
+    open(os.path.join(HERE, dst), "wb").write(b)
+    out["files"][dst] = {"source": rel, "sha256": hashlib.sha256(b).hexdigest(), "bytes": len(b)}
+out["evals_ledger_existed_at_copy"] = os.path.exists(os.path.join(LIVE, "state/live/ic_monitor_evals.jsonl"))
+out["live_head"] = subprocess.run(["git", "-C", LIVE, "log", "-1", "--format=%H %cI"], capture_output=True, text=True).stdout.strip()
+json.dump(out, open(os.path.join(HERE, "MANIFEST.json"), "w"), indent=1, sort_keys=True)
+print(json.dumps(out, indent=1))
