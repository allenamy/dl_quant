+        ap.add_argument("--day", action="append", default=[])
+        ap.add_argument("--json", action="store_true")
+        return verify_main(ap.parse_args(argv[1:]))
+    ap = argparse.ArgumentParser(prog="notarize_ledgers.py", allow_abbrev=False)
