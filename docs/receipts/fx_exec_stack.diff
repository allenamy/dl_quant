+            extra.setdefault((a["day"], a["file"]), []).append((a["before"], a["after"], f"notary append checkpoint in {n}"))
+    paths = [os.path.join(notary_dir, n) for n in _listdir(notary_dir, "notary directory") if AMENDMENT_RE.match(n)]
+    paths += [p for p in (amendments or []) if p not in paths]
+    amend_out = []
+    for p in paths:
+        try:
+            rec = json.load(open(p))
+            day, table, segs, notarized = _amendment_segments(rec)
+        except (OSError, ValueError, KeyError, TypeError) as e:
+            amend_out.append({"record": p, "verdict": "UNREADABLE", "why": f"{type(e).__name__}: {e}"})
+            continue
+        man = by_day.get(day)
+        if not man or table not in man.get("files", {}) or not segs:
+            amend_out.append({"record": p, "day": day, "file": table, "verdict": "ORPHAN",
+                              "why": "no manifest notarized this day/table" if segs else "the record names no checkpoints"})
+            continue
+        entry = man["files"][table]
+        fp = os.path.join(pilot_root, day, table)
+        data = open(fp, "rb").read() if os.path.exists(fp) else None
+        whys = []
+        if notarized is not None and (int(notarized["bytes"]) != int(entry["bytes"]) or notarized["sha256"] != entry["sha256"]):
+            whys.append(f"its notarized checkpoint differs from manifest_{day}.json")
+        for c0, c1, _ in segs:
+            for c in (c0, c1):
+                if data is None:
+                    whys.append("the ledger file is absent")
+                elif len(data) < int(c["bytes"]) or hashlib.sha256(data[:int(c["bytes"])]).hexdigest() != c["sha256"]:
+                    whys.append(f"checkpoint at {c['bytes']} bytes does not hash to {c['sha256'][:12]}…")
+                elif int(c["bytes"]) > 0 and data[int(c["bytes"]) - 1:int(c["bytes"])] != b"\n":
+                    whys.append(f"checkpoint at {c['bytes']} bytes is not at a line boundary")
+            if int(c0["bytes"]) < int(entry["bytes"]):
+                whys.append(f"segment starts at {c0['bytes']}, inside the notarized {entry['bytes']} bytes")
+        if whys:
+            amend_out.append({"record": p, "day": day, "file": table, "verdict": "MISMATCH", "why": "; ".join(sorted(set(whys)))})
+            continue
+        amend_out.append({"record": p, "day": day, "file": table, "verdict": "VERIFIED"})
+        for c0, c1, reason in segs:
+            extra.setdefault((day, table), []).append((c0, c1, f"amendment {os.path.basename(p)}: {reason}"))
+    # files
+    files = []
+    for d, n in manifests:
+        if days and d not in days:
+            continue
+        for fn, entry in sorted(by_day[d].get("files", {}).items()):
+            fp = os.path.join(pilot_root, d, fn)
+            out = {"day": d, "file": fn, "notarized": {"bytes": int(entry["bytes"]), "sha256": entry["sha256"]}, "segments": []}
+            if not os.path.exists(fp):
+                out.update(verdict="MISSING", why=f"notarized by {n}, now absent")
+                files.append(out)
+                continue
+            data = open(fp, "rb").read()
+            out["size"] = len(data)
+            v, why = judge_prefix(data, int(entry["bytes"]), entry["sha256"])
+            if v == "APPENDED":
+                pairs = extra.get((d, fn), [])
+                bounds = {int(entry["bytes"]), len(data)}
+                for c0, c1, src in pairs:
+                    for c in (c0, c1):
+                        b = int(c["bytes"])
+                        if b > len(data):
