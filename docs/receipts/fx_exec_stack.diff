@@ -0,0 +1,34 @@
+"""E6 fixture builder (FX-EXEC 2026-09-13) — READ-ONLY on ~/dl_quant_live/state; run once by hand, never by the suite.
+Takes, verbatim, for the 2026-09-13 16Z anchor A1789316640:
+  · from pilot_log/20260913/anchors.jsonl: that row's external_book.held_exit / below_min_notional / meta_excluded and its
+    reshape.popped_names / forced_flat_names / clamped_after_reshape.names;
+  · from per_name_stop.json: the cooldown map and stopped map as they stand at copy time (the cooldowns expire 09-16..09-19, so they
+    held at 16Z) — recorded with the copy time, not asserted as the 16Z state beyond that;
+  · from notify_audit.jsonl: the alarm row the clamp channel wrote at that anchor ("N held name(s) are withheld by the venue …");
+  · from pilot_log/20260913/orders.jsonl: that anchor's rows for the seven withheld names (order_type, terminal_reason, intended).
+and records sha256 of every source file read."""
+import hashlib, json, os, time
+HERE = os.path.dirname(os.path.abspath(__file__))
+ST = os.path.expanduser("~/dl_quant_live/state")
+RID, ATS = "A1789316640", 1789316640
+def sha(p): return hashlib.sha256(open(p, "rb").read()).hexdigest()
+src = {"anchors": os.path.join(ST, "live/pilot_log/20260913/anchors.jsonl"), "orders": os.path.join(ST, "live/pilot_log/20260913/orders.jsonl"),
+       "per_name_stop": os.path.join(ST, "live/per_name_stop.json"), "notify_audit": os.path.join(ST, "notify_audit.jsonl")}
+row = next(json.loads(l) for l in open(src["anchors"]) if l.strip() and json.loads(l).get("rebalance_id") == RID)
+ext, rs = row.get("external_book") or {}, row.get("reshape") or {}
+names = sorted((rs.get("clamped_after_reshape") or {}).get("names") or [])
+alarm = [json.loads(l) for l in open(src["notify_audit"]) if "are withheld by the venue" in l]
+alarm = [a for a in alarm if abs(float(a["ts"]) - ATS) < 3600]
+pns = json.load(open(src["per_name_stop"]))
+orders = [json.loads(l) for l in open(src["orders"]) if l.strip()]
+orders = [{k: o.get(k) for k in ("symbol", "order_type", "terminal_reason", "intended_notional", "reduce_only")}
+          for o in orders if o.get("rebalance_id") == RID and o.get("symbol") in names]
+out = {"built_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "rebalance_id": RID,
+       "sources_sha256": {k: sha(v) for k, v in src.items()},
+       "external_book": {"held_exit": ext.get("held_exit"), "below_min_notional": ext.get("below_min_notional"), "meta_excluded": ext.get("meta_excluded")},
+       "reshape": {"popped_names": rs.get("popped_names"), "forced_flat_names": rs.get("forced_flat_names"), "clamped_names": names},
+       "per_name_stop_at_copy": {"stopped": pns.get("stopped"), "cooldown": pns.get("cooldown")},
+       "alarm_rows": alarm, "orders_of_clamped_names": orders}
+json.dump(out, open(os.path.join(HERE, "anchor_A1789316640_withheld.json"), "w"), ensure_ascii=False, indent=1, sort_keys=True)
+print(json.dumps({"clamped": names, "held_exit": ext.get("held_exit"), "dust": (ext.get("below_min_notional") or {}).get("names") if isinstance(ext.get("below_min_notional"), dict) else ext.get("below_min_notional"),
+                  "n_alarm_rows": len(alarm), "alarm": [a["message"] for a in alarm]}, ensure_ascii=False, indent=1))
