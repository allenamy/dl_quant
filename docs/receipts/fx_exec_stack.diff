@@ -0,0 +1,285 @@
+"""[EXE-04 / Q6] The joint feasible set is the reviewer's SOLUTION SET, not a count that matches it.
+
+*** MOCK ONLY: pure functions, no venue, no credentials, no ledger, no I/O beyond one JSON read. ***
+
+WHAT THIS PINS. `docs/PREREG_reconcile_carry_forward_unexplained_2026-09-10.md` revision 4 is
+accepted mathematics that was never coded (repo-wide grep for `carry_by_symbol` /
+`pending_requests.jsonl` is empty). Its acceptance criteria are SOLUTION SETS, and the PREREG says
+why in as many words: for the single-BUY100 case the correct contract and a wrong one both admit
+exactly 5,151 pairs, so "验收必须核解集而非计数" — checking the count would pass the wrong contract.
+Every cell below therefore compares SETS, element by element.
+
+THE GRID (PREREG §1c "验收判据", reviewer artefact `design/attempt01/GRID_SOLUTION_SETS.json`):
+1xBUY1 3 pairs / 2xBUY1 6 / 3xBUY1 10 / 2xBUY2 15, against the withdrawn marginal method's
+3 / 7 / 13 / 19. The differences are the reviewer's named false accepts — (1,0) at 2xBUY1, and so
+on — every one of them a readback path that DECREASES while only BUY requests exist, which no
+monotone trajectory can produce. The file is vendored here rather than read from the reviewer's
+worktree so this suite has no dependency on a branch it does not own; [G0] pins its sha256.
+
+BLIND SPOTS, stated because this file will be read as "EXE-04 is done" otherwise:
+ (a) it tests the CORE only. Nothing here is wired into `reconcile()`, `position_break` or the
+     watchdog, so §4-5b/5e still read the per-window residual and the live defect still stands.
+ (b) no ledger: the 41-day replay (PREREG §2, §3.5) has not been run, and until it is, nobody
+     knows which historical names would have carried a non-zero E_s.
+ (c) `pending_requests.jsonl`, the next-anchor terminal lookup and the `reconstructed` supersedes
+     rows (PREREG §2) do not exist.
+ (d) enumeration is exponential in requests x anchors; `feasible_exact` refuses above its bound
+     rather than falling back, but the bound itself is not calibrated against real per-symbol
+     request counts.
+
+Exit 0 = all pass.
+"""
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import reconcile_carry as RC          # noqa: E402
+
+# ★ THE DENOMINATOR IS PRINTED, AND A ZERO DENOMINATOR IS A RED (battery convention, 2026-07-27).
+FAILS = []
+N_CHECKS = [0]
+
+
+def check(name, cond, extra=""):
+    N_CHECKS[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(extra)[:300]) if extra != '' else ''}")
+    if not cond:
+        FAILS.append(name)
+
+
+GRID = os.path.join(HERE, "tests_fixtures", "exe04_q6", "GRID_SOLUTION_SETS.json")
+
+print("[G0] the reviewer's grid is the one we were given")
+import hashlib                        # noqa: E402
+_raw = open(GRID, "rb").read()
+check("★★ G0 GRID_SOLUTION_SETS.json sha256 is the reviewer's artefact (round 7, 38808cbd lineage)",
+      hashlib.sha256(_raw).hexdigest()
+      == "8a2b7c9b7e309c381f7115d91d0695c37af1a1098f5e6dbd489a56b34f128926",
+      hashlib.sha256(_raw).hexdigest())
+_grid = json.loads(_raw.decode())
+check("★ G0b it carries the four cases the PREREG names (1xBUY1 / 2xBUY1 / 3xBUY1 / 2xBUY2)",
+      [(c["requests"], c["cap"]) for c in _grid] == [(1, 1), (2, 1), (3, 1), (2, 2)],
+      [(c["requests"], c["cap"]) for c in _grid])
+check("★★ G0c …and the counts it declares are the PREREG's (exact 3/6/10/15, marginal 3/7/13/19)",
+      [(c["exact_count"], c["marginal_count"]) for c in _grid]
+      == [(3, 3), (6, 7), (10, 13), (15, 19)],
+      [(c["exact_count"], c["marginal_count"]) for c in _grid])
+
+print("\n[G1] the exact solver reproduces the reviewer's solution SET, pair by pair")
+# ★★ t_0 IS AN EXPLICIT ROW. Equation (e) is `sum sigma_i [x_i(t_k) - x_i(t_0)] = Q(t_k) - Q(t_0)`,
+# so the grid's `positions` — which are position LEVELS at two readbacks, from a flat book — are the
+# right-hand sides at t_1 and t_2 against a baseline at t_0 where every x_i is 0. Passing the first
+# level as the equation at t_0 would be asserting `level = 0`, which is a different claim entirely
+# (and was this suite's first red).
+T0 = 0.0
+T = [T0, 1.0, 2.0]
+for case in _grid:
+    n, cap = case["requests"], case["cap"]
+    reqs = [RC.Request(f"r{i}", +1, float(cap), birth=0.0) for i in range(n)]
+    exact_set, marginal_set = set(), set()
+    for cell in case["cases"]:
+        first, second = cell["positions"]
+        obs = [0.0, float(first), float(second)]
+        ok_e = RC.feasible_exact(reqs, T, obs)
+        ok_m = RC.feasible_marginal_UNSOUND(reqs, T, obs)
+        # a pair is EXACT-feasible iff no observation had to be excluded
+        if ok_e["status"] == "ok" and not ok_e["excluded"]:
+            exact_set.add((first, second))
+        if ok_m:
+            marginal_set.add((first, second))
+    want_exact = {tuple(c["positions"]) for c in case["cases"] if c["exact"]}
+    want_marg = {tuple(c["positions"]) for c in case["cases"] if c["marginal"]}
+    tag = f"{n}xBUY{cap}"
+    check(f"★★★ G1 {tag}: the exact SET equals the reviewer's, element by element "
+          f"({len(want_exact)} pairs) — not merely the same count",
+          exact_set == want_exact,
+          {"missing": sorted(want_exact - exact_set), "extra": sorted(exact_set - want_exact)})
+    check(f"★★ G1m {tag}: the withdrawn marginal method reproduces ITS set too "
+          f"({len(want_marg)} pairs), so the contrast below is measured and not assumed",
+          marginal_set == want_marg,
+          {"missing": sorted(want_marg - marginal_set), "extra": sorted(marginal_set - want_marg)})
+    check(f"★★★ G1d {tag}: exact is STRICTLY tighter, and the difference is exactly the reviewer's "
+          f"named false accepts {case['false_accepts']} — the proof this is not secretly the loose "
+          f"object revision 3 withdrew",
+          marginal_set - exact_set == {tuple(x) for x in case["false_accepts"]},
+          sorted(marginal_set - exact_set))
+
+# ★ AND THE SETS DO NOT DEPEND ON THE BASELINE BEING FREE. Above, the requests are born AT t_0, so
+#   x_i(t_0) is unconstrained and only the DIFFERENCES matter. Re-running with the requests born
+#   after t_0 — where constraint (a) pins x_i(t_0) = 0 — must give the same sets, or the agreement
+#   with the reviewer's grid would be an artefact of how the baseline happened to be modelled.
+for case in _grid:
+    n, cap = case["requests"], case["cap"]
+    reqs_b = [RC.Request(f"r{i}", +1, float(cap), birth=0.25) for i in range(n)]
+    got = set()
+    for cell in case["cases"]:
+        first, second = cell["positions"]
+        r = RC.feasible_exact(reqs_b, T, [0.0, float(first), float(second)])
+        if r["status"] == "ok" and not r["excluded"]:
+            got.add((first, second))
+    want = {tuple(c["positions"]) for c in case["cases"] if c["exact"]}
+    check(f"★★ G1b {n}xBUY{cap}: the same set with the requests born AFTER t_0 (baseline pinned to "
+          f"0 by constraint (a)) — the agreement is not an artefact of a free baseline",
+          got == want, {"missing": sorted(want - got), "extra": sorted(got - want)})
+
+print("\n[G2] the hard constraints, each on its own named PREREG example")
+# §1c.4 / D8-2: two TERMINAL BUY1 sharing a checkpoint. Post-terminal constant ⇒ only 1 is legal.
+# terminal at 0.5: both requests are already closed when the FIRST reading is taken, so that
+# reading is the last free one and everything after it is constant.
+_term = [RC.Request("a", +1, 1.0, birth=0.0, terminal=0.5),
+         RC.Request("b", +1, 1.0, birth=0.0, terminal=0.5)]
+_res_term = {v: RC.feasible_exact(_term, T, [0.0, 1.0, float(v)]) for v in (1, 2, 3)}
+check("★★★ G2a two TERMINAL BUY1, baseline 1: only a later reading of 1 is admissible; 2 and 3 are "
+      "refused (post-terminal constant — an unknown PAST is not remaining FUTURE capacity). The "
+      "revision-3 text said 2 was legal and D8-2 corrected it; both examples are kept",
+      not _res_term[1]["excluded"] and _res_term[2]["excluded"] and _res_term[3]["excluded"],
+      {v: bool(r["excluded"]) for v, r in _res_term.items()})
+# §1c.4: the same two requests still OPEN ⇒ 1 and 2 legal, 3 refused (capacity)
