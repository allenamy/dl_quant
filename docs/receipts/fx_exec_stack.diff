+#!/usr/bin/python3
+"""E9 fixture builder (FX-EXEC 2026-09-13). READ-ONLY over copies of the executor's LIVE pilot_log; writes only this directory.
+
+    /usr/bin/python3 live/tests_fixtures/e9_constant_columns/build_fixture.py <orders_20260913.jsonl> <orders_20260912.jsonl> <anchor_runs.log> <out_dir>
+
+Writes, from the REAL rows (every row verbatim; nothing recomputed):
+  orders_20260913_00Z_halted.jsonl   every row of the 00Z anchor A1789259039 — the day as the 00:39Z artefact check saw it
+  orders_20260913_to_12Z_subset.jsonl a SUBSET of the day's rows through the 12Z anchor A1789302239, chosen greedily so that it keeps the
+                                      day's first row first and gives EVERY column that varies over the full day at least two distinct
+                                      values — so the set of constant columns, their values, "any fill", "any submitted leg" and every
+                                      executor-reader ledger trigger are those of the full day (recorded below and re-checked by the suite)
+  history_20260912_subset.jsonl       rows of 09-12 giving attempt_idx / order_type / cancel_ts / terminal_reason two or more values each
+                                      (the event history the 00Z check read from the whole tree)
+  live_alarm_lines.txt                the anchor_runs.log lines of the 00:39:51Z and 12:46:59Z artefact findings, verbatim
+  MANIFEST.json                       source sha256, output sha256, and the full-day profile the subset must reproduce"""
+import hashlib, json, os, sys
+
+SRC13, SRC12, LOG, OUT = sys.argv[1:5]
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(HERE))))           # live/
+import binance_executor as BE  # noqa: E402
+
+LEDGER_COLS = ("filled_known_notional", "filled_known_qty", "filled_unknown_qty", "filled_unknown_residual", "filled_qty")
+
+
+def sha(p):
+    return hashlib.sha256(open(p, "rb").read()).hexdigest()
+
+
+def rows(p):
+    return [json.loads(l) for l in open(p, encoding="utf-8") if l.strip()]
+
+
+def J(v):
+    return json.dumps(v, default=str, sort_keys=True)
+
+
+def profile(rs):
+    keys = sorted(rs[0].keys())
+    const = {c: J(rs[0].get(c)) for c in keys if len({J(r.get(c)) for r in rs}) == 1}
+    trig = {c: any(isinstance(r.get("request_ledger"), list) and r["request_ledger"]
+                   and BE.ledger_row_columns(r["request_ledger"]).get(c) is not None for r in rs) for c in LEDGER_COLS}
+    return {"keys": keys, "constant": const, "any_filled": any(float(r.get("filled_notional") or 0) != 0 for r in rs),
+            "any_submitted": any(r.get("submit_ts") is not None for r in rs), "ledger_triggers": trig,
+            "any_submitted_topup": any(r.get("submit_ts") is not None and r.get("order_type") == "topup_taker" for r in rs),
+            "any_benign_reject": any(r.get("topup_source") == "from_reject" or (r.get("terminal_reason") == "venue_reject"
+                                                                                and "-5022" in str(r.get("note") or "")) for r in rs)}
+
+
+def dump(name, rs):
+    with open(os.path.join(OUT, name), "w", encoding="utf-8") as f:
+        f.write("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rs))
+
+
+day = rows(SRC13)
+r00 = [r for r in day if r.get("rebalance_id") == "A1789259039"]
+to12 = [r for r in day if float(r["anchor_ts"]) <= 1789302240.8704782]
+full = profile(to12)
+sub = [to12[0]]
+for c in full["keys"]:
+    if c in full["constant"]:
+        continue
+    have = {J(r.get(c)) for r in sub}
+    for r in to12:
+        if len(have) >= 2:
+            break
+        if J(r.get(c)) not in have:
+            sub.append(r); have.add(J(r.get(c)))
+# the ledger-trigger / benign-reject / top-up facts must also survive (add the first row that carries each, if missing)
+for key, pred in (("any_submitted_topup", lambda r: r.get("submit_ts") is not None and r.get("order_type") == "topup_taker"),
+                  ("any_benign_reject", lambda r: r.get("topup_source") == "from_reject" or (r.get("terminal_reason") == "venue_reject" and "-5022" in str(r.get("note") or "")))):
+    if full[key] and not any(pred(r) for r in sub):
+        sub.append(next(r for r in to12 if pred(r)))
+for c in LEDGER_COLS:
+    if full["ledger_triggers"][c] and not profile(sub)["ledger_triggers"][c]:
+        sub.append(next(r for r in to12 if isinstance(r.get("request_ledger"), list) and r["request_ledger"]
+                        and BE.ledger_row_columns(r["request_ledger"]).get(c) is not None))
+order = {id(r): i for i, r in enumerate(to12)}
+sub = sorted({id(r): r for r in sub}.values(), key=lambda r: order[id(r)])
+assert profile(sub) == full, "subset does not reproduce the full-day profile"
+h12 = rows(SRC12)
+hist, seen = [], {c: set() for c in ("attempt_idx", "order_type", "cancel_ts", "terminal_reason")}
+for c in seen:
+    for r in h12:
+        if len(seen[c]) >= 2:
+            break
+        v = J(r.get(c) is None) if c == "cancel_ts" else J(r.get(c))
+        if v not in seen[c]:
+            hist.append(r); seen[c].add(v)
+hist = list({id(r): r for r in hist}.values())
+lines = [l for l in open(LOG, encoding="utf-8", errors="replace")
+         if l.startswith("2026-09-13T00:39:51Z artifacts: REGRESSION") or l.startswith("2026-09-13T12:46:59Z artifacts: REGRESSION")]
+os.makedirs(OUT, exist_ok=True)
+dump("orders_20260913_00Z_halted.jsonl", r00)
+dump("orders_20260913_to_12Z_subset.jsonl", sub)
+dump("history_20260912_subset.jsonl", hist)
+open(os.path.join(OUT, "live_alarm_lines.txt"), "w", encoding="utf-8").write("".join(lines))
+man = {"built_by": "live/tests_fixtures/e9_constant_columns/build_fixture.py",
+       "sources": {"orders_20260913.jsonl": sha(SRC13), "orders_20260912.jsonl": sha(SRC12), "anchor_runs.log": sha(LOG)},
+       "n_rows": {"to_12Z_full": len(to12), "to_12Z_subset": len(sub), "00Z_halted": len(r00), "history_20260912_subset": len(hist)},
+       "full_day_profile_to_12Z": full,
+       "files": {n: sha(os.path.join(OUT, n)) for n in ("orders_20260913_00Z_halted.jsonl", "orders_20260913_to_12Z_subset.jsonl",
+                                                          "history_20260912_subset.jsonl", "live_alarm_lines.txt")}}
+json.dump(man, open(os.path.join(OUT, "MANIFEST.json"), "w"), indent=1, sort_keys=True)
+print(json.dumps(man["n_rows"]), len(lines), "log lines")
