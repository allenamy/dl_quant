+                        elif hashlib.sha256(data[:b]).hexdigest() != c["sha256"]:
+                            v, why = "TAMPERED", f"bytes [0,{b}) no longer hash to what {src} recorded"
+                        elif b >= int(entry["bytes"]):
+                            bounds.add(b)
+                if v == "APPENDED":
+                    bl = sorted(bounds)
+                    for a, b in zip(bl, bl[1:]):
+                        nl, bad = _lines(data[a:b])
+                        att = [src for c0, c1, src in pairs if int(c0["bytes"]) <= a and int(c1["bytes"]) >= b]
+                        out["segments"].append({"from": a, "to": b, "n_lines": nl, "n_unparseable": bad, "attested_by": att})
