+        print(f"[{_utc()}] ALARM {rec.get('status')}: {msg}", flush=True)
+    except Exception as e:                                           # noqa: BLE001 — the failure is printed and rc stays non-zero
+        print(f"[{_utc()}] ALARM COULD NOT BE SENT ({type(e).__name__}: {e}): {msg}", flush=True)
+
+
+def load_config(path=CONFIG_PATH):
+    if not os.path.exists(path):
+        return {}
+    return json.load(open(path))
