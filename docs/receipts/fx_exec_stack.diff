+def notarize_main(args, notifier=None):
+    cfg = load_config(args.config)
+    pilot_root = args.pilot_root or cfg.get("pilot_root") or DEFAULT_PILOT
+    repo = args.research_repo or cfg.get("research_repo")
+    subdir = args.notary_subdir or cfg.get("notary_subdir") or "ledger_notary"
+    branch = args.branch if args.branch is not None else cfg.get("branch")
+    push_remote = args.push_remote if args.push_remote is not None else cfg.get("push_remote")
+    days = args.days or [time.strftime("%Y%m%d", time.gmtime(time.time() - 86400))]
+    tag = ",".join(days)
+    if not repo:
+        _alarm(notifier, f"台账公证失败 [{tag}] config: no research repo configured — nothing notarized")
+        return 2
+    notary_dir = os.path.join(repo, subdir)
+    rc, written = 0, []
+    for day in sorted(days):
+        try:
+            man = build_manifest(day, pilot_root, notary_dir, genesis=args.genesis)
