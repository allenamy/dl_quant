+# ── amendments ──────────────────────────────────────────────────────────────────────────────────
+def amendment_record(pilot_root, day, table, before, reason, device):
+    """An append-amendment: the device that appends to a notarized day takes `checkpoint()` BEFORE its append and hands it here
+    afterwards. The record names the segment [before.bytes, after.bytes), why it was appended, and which device (path + sha256)."""
+    p = os.path.join(pilot_root, day, table)
+    data = open(p, "rb").read()
+    v, why = judge_prefix(data, int(before["bytes"]), before["sha256"])
+    if v not in ("EXACT", "APPENDED"):
+        raise NotaryError("amend", f"{day}/{table}: the before-checkpoint does not describe this file ({v}: {why})")
+    after = checkpoint(p)
+    return {"kind": AMENDMENT_KIND, "day": day, "table": table, "created_utc": _utc(),
+            "before": {"bytes": int(before["bytes"]), "sha256": before["sha256"]},
+            "after": {"bytes": after["bytes"], "sha256": after["sha256"]}, "reason": str(reason),
+            "device": {"path": os.path.abspath(device), "sha256": sha(device)}}
+
+
+def write_amendment(notary_dir, rec):
+    stamp = rec["created_utc"].replace("-", "").replace(":", "")
+    return write_json_excl(os.path.join(notary_dir, f"amendment_{rec['day']}_{rec['table'].split('.')[0]}_{stamp}.json"), rec)
+
+
+def _amendment_segments(rec):
+    """[(from_cp, to_cp, reason)] from either record shape. Legacy E1 receipts: notarized → pre_e1 → post_e1."""
+    if rec.get("kind") == AMENDMENT_KIND:
+        return rec["day"], rec["table"], [(rec["before"], rec["after"], rec.get("reason") or "")], None
+    cps = [(k, v) for k, v in rec.items() if isinstance(v, dict) and "bytes" in v and "sha256" in v]
+    cps.sort(key=lambda kv: int(kv[1]["bytes"]))
+    segs = []
+    for (k0, c0), (k1, c1) in zip(cps, cps[1:]):
+        rel = next((v for kk, v in c1.items() if kk.startswith("relation_to")), "")
+        segs.append((c0, c1, f"{k0}→{k1}: {rel}"))
+    return rec.get("day"), rec.get("table"), segs, dict(cps).get("notarized")
+
+
+# ── the verifier ────────────────────────────────────────────────────────────────────────────────
+def verify_tree(notary_dir, pilot_root, amendments=None, days=None):
+    manifests = list_manifests(notary_dir)
+    by_day = {d: json.load(open(os.path.join(notary_dir, n))) for d, n in manifests}
+    # chain, in day order
+    chain, prev_sha, prev_name = [], None, None
+    for d, n in manifests:
+        rec = by_day[d].get("prev_manifest_sha256")
+        if prev_name is None:
+            v, why = ("GENESIS", None) if rec == GENESIS else ("BREAK", f"first manifest but prev is {str(rec)[:12]}…, not GENESIS")
+        elif rec == prev_sha:
+            v, why = "LINKED", None
+        elif rec == GENESIS:
+            v, why = "BREAK", f"prev is GENESIS although {prev_name} exists — this manifest does not commit to its predecessor"
         else:
-            print("nothing to commit" if "nothing to commit" in r.stdout + r.stderr else r.stderr[-200:])
+            v, why = "BREAK", f"prev {str(rec)[:12]}… is not the sha256 of {prev_name} ({prev_sha[:12]}…)"
+        chain.append({"manifest": n, "prev_recorded": rec, "verdict": v, **({"why": why} if why else {})})
+        prev_sha, prev_name = sha(os.path.join(notary_dir, n)), n
+    # checkpoints: manifest appends + amendment records
+    extra = {}                                                  # (day, file) -> [(from_cp, to_cp, attested_by)]
+    for d, n in manifests:
