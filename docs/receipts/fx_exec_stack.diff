+def verify(notary_dir, pilot_root, amendments=(), days=None):
+    if NEW:
+        return NL.verify_tree(notary_dir, pilot_root, amendments=list(amendments), days=days)
+    # the OLD module's only integrity reading: its docstring's whole-file contract, through its own sha()
+    files, rc = [], 0
+    for fn in sorted(os.listdir(notary_dir)):
+        if not (fn.startswith("manifest_") and fn.endswith(".json")):
+            continue
+        man = json.load(open(os.path.join(notary_dir, fn)))
+        if days and man["day"] not in days:
+            continue
+        for name, rec in sorted(man["files"].items()):
+            p = os.path.join(pilot_root, man["day"], name)
+            same = os.path.exists(p) and NL.sha(p) == rec["sha256"] and os.path.getsize(p) == rec["bytes"]
+            files.append({"day": man["day"], "file": name, "verdict": "EXACT" if same else "MISMATCH", "segments": []})
+            rc = rc if same else 1
+    return {"rc": rc, "files": files, "chain": [], "amendments": [],
+            "summary": {"files_ok": rc == 0, "chain_ok": None, "amendments_ok": None}}
+
