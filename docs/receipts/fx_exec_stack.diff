+            files.append(out)
+    counts = {}
+    for f in files:
+        counts[f["verdict"]] = counts.get(f["verdict"], 0) + 1
+    files_ok = all(f["verdict"] in ("EXACT", "APPENDED") for f in files)
+    amendments_ok = all(a["verdict"] == "VERIFIED" for a in amend_out)
+    chain_ok = all(c["verdict"] in ("GENESIS", "LINKED") for c in chain) and sum(c["verdict"] == "GENESIS" for c in chain) <= 1
+    rc = 1 if not (files_ok and amendments_ok) else (3 if not chain_ok else 0)
+    return {"rc": rc, "files": files, "chain": chain, "amendments": amend_out,
+            "summary": {"files_ok": files_ok, "amendments_ok": amendments_ok, "chain_ok": chain_ok, "counts": counts,
+                        "chain_breaks": [c["manifest"] for c in chain if c["verdict"] == "BREAK"], "n_manifests": len(manifests)}}
+
+
+def verify_main(args):
+    cfg = load_config(args.config)
+    notary_dir = args.notary_dir or os.path.join(args.research_repo or cfg.get("research_repo") or "",
+                                                 args.notary_subdir or cfg.get("notary_subdir") or "ledger_notary")
+    try:
+        rep = verify_tree(notary_dir, args.pilot_root or cfg.get("pilot_root") or DEFAULT_PILOT, amendments=args.amendment,
+                          days=args.day or None)
+    except (NotaryError, OSError, ValueError) as e:
+        print(json.dumps({"rc": 2, "error": f"{type(e).__name__}: {e}"}))
+        return 2
+    if args.json:
+        print(json.dumps(rep, indent=1, default=str))
+    else:
+        for f in rep["files"]:
+            if f["verdict"] != "EXACT":
+                print(f"{f['day']} {f['file']} {f['verdict']} {f.get('why') or ''} "
+                      + "; ".join(f"[{s['from']},{s['to']}) {s['n_lines']} rows {s['attested_by'] or 'unattested'}" for s in f["segments"]))
+        for c in rep["chain"]:
+            if c["verdict"] == "BREAK":
