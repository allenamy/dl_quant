+#!/usr/bin/env python3
+"""p9_declared_interval_table.py — FIXPROGRAM 2026-09-13 P9 shared evidence: the declared settlement interval of every funding settlement.
+READ-ONLY inputs (sha-pinned in the receipt): pod2 ledger_full.npz (data.binance.vision zip U fund_aug API rows, zip `funding_interval_hours`,
+2020-01 -> 2026-09-01 02:00Z); every frozen producer ledger (aux ledger_tail) and both bundle seeds; the executor's own settlement records
+~/dl_quant_live/state/live/pilot_log/<day>/funding.jsonl (`funding_interval_h` = /fapi/v1/fundingInfo read at PULL time, applied to every
+settlement of that pull; positive control only).
+One row per (symbol, settlement second) in [LO, HI]:
+  iv_producer   stored iv in the producer ledger (union of frozen producer ledgers; rows only in a seed carry the seed's stored iv, flagged)
+  iv_zip        exchange-declared funding_interval_hours from the monthly zip (rows <= 2026-07-31 only; August/September zips absent)
+  iv_exec       executor fundingInfo label for that settlement (held names only); several differing labels are joined with '|'
+  gap_back_h / gap_fwd_h  raw hours to the previous / next settlement of the same symbol (union of all row sources)
+  iv_gap_back / iv_gap_fwd  the producer's snap rule (shadow_loop_v3.py L341-342) applied to those gaps
+  regime        steady (snap back == snap fwd) | transition (snap back != snap fwd) | edge (no back or no fwd neighbour)
+  iv_best, iv_best_source  zip if present; else only rules that equal the zip on EVERY scored row of the full history (receipt V1):
+                structure_steady (2,521,513/2,521,515), interest_signature (rate == 1.25e-5*iv for exactly one candidate; 1,111/1,111),
+                cap_signature_{4,8}h_to_1h (|rate| == 0.02, back 4h/8h, fwd 1h; 194/194), structure_last_1h_before_gap{2,3} (92/92);
+                otherwise NULL with 'unresolved_<regime>' (the declared interval of a transition row is the schedule in force AT the settlement,
+                which neither the backward gap nor a fundingInfo read after the settlement determines; see p9_rule_eval.py)
+  iv_likely, iv_likely_support  below-100% rules for unresolved rows: gap3_into_longer 40/41, gap2_into_longer 52/62
+  iv_candidates  for transition rows: 'back|fwd' candidate ivs
+  producer_vs_best  match | mismatch | unresolved | not_in_producer_ledger
+Validation written to the receipt: (V1) the structural iv_best rule against the zip column on every zip row in [ZLO, 2026-07-31] of the same
+symbols (rule accuracy where truth exists); (V2) executor labels at switch_up rows (fundingInfo read after the switch must equal iv_best)."""
+import os, sys, json, glob, gzip, time, hashlib, csv, io
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import fx_harness as H
+
+LO = 1782864000   # 2026-07-01 00:00Z
+HI = 1789300800   # 2026-09-13 12:00Z (close of the frozen live state)
+ZLO = 1577836800  # 2020-01-01 00:00Z: V1 scores every resolution rule over the full zip history
+OUT = H.WORK + "/p9"
+ALLOWED = [1.0, 2.0, 4.0, 6.0, 8.0]
+
+
+def snap(g):
+    return float(min(ALLOWED, key=lambda a: abs(a - (g if 0 < g <= 24 else 8.0))))
+
+
+def T(t): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(int(t)))
+
+
+def main():
+    t0 = time.time(); shas = {}
+    p = H.WORK + "/pod2_inputs/ledger_full.npz"; shas["pod2_ledger_full"] = H.gsha(p)
+    assert shas["pod2_ledger_full"] == "bea6f5752772d54e659a4da5571ca41945a27d1b2316ec0ae52f387074f795ad"
+    z = np.load(p); syms = [str(s) for s in z["symbols"]]; off = z["off"]; FT = z["ft"]; RT = z["rate"]; SRC = z["src"]; ZIV = z["zip_iv"]
+    rows = {}   # sym -> {ft: dict}
+    for j, s in enumerate(syms):
+        a, b = int(off[j]), int(off[j + 1])
+        d = rows.setdefault(s, {})
+        for ft, rt, sr, zi in zip(FT[a:b].tolist(), RT[a:b].tolist(), SRC[a:b].tolist(), ZIV[a:b].tolist()):
+            d[int(ft)] = {"rate": rt, "pod2_src": int(sr), "iv_zip": (None if zi != zi else float(zi))}
+    src, s2 = H.frozen_ledger_sources(); shas.update(s2)
+    conflicts = 0
+    for tag, led in src:
+        seed = tag.startswith("seed")
+        for s, rr in led.items():
+            d = rows.setdefault(s, {})
+            for r in rr:
+                ft = int(r[0]); rt = float(r[1]); iv = float(r[2])
+                e = d.setdefault(ft, {"rate": rt, "pod2_src": 0, "iv_zip": None})
+                if e["rate"] != rt: conflicts += 1
+                key = "iv_seed_" + tag.split("_", 1)[1] if seed else "iv_producer"
+                if key in e and e[key] != iv:
+                    e.setdefault("iv_conflicts", []).append((tag, iv))
+                e[key] = iv
+    # executor records
+    ex_files = sorted(glob.glob(H.HOME + "/dl_quant_live/state/live/pilot_log/2026*/funding.jsonl"))
+    shas["executor_funding_jsonl"] = {f.split("pilot_log/")[1]: H.gsha(f) for f in ex_files}
+    n_ex = 0; n_ex_shifted = 0; n_ex_unmatched = 0; n_ex_rate_mismatch = 0
+    for f in ex_files:
+        for l in open(f):
+            r = json.loads(l); n_ex += 1
+            s = r["symbol"]; t = float(r["settlement_ts"]); d = rows.setdefault(s, {})
+            # executor income timestamps are the settlement second or one second later (223 of 36,280): match the ledger row within 60 s
+            cands = [ft for ft in (int(t), int(t) - 1, int(t) + 1) if ft in d] or [ft for ft in d if abs(ft - t) <= 60]
+            if cands:
+                ft = min(cands, key=lambda x: abs(x - t)); n_ex_shifted += int(ft != int(round(t)))
+                if abs(d[ft]["rate"] - float(r["funding_rate"])) > 1e-12: n_ex_rate_mismatch += 1
+            else:
+                ft = int(round(t)); n_ex_unmatched += 1
+                d[ft] = {"rate": float(r["funding_rate"]), "pod2_src": 0, "iv_zip": None, "exec_only": True}
+            d[ft].setdefault("iv_exec", set()).add(r.get("funding_interval_h"))
+    # per symbol pass
+    header = ["symbol", "ft", "utc", "rate", "pod2_src", "in_producer_ledger", "iv_producer", "iv_seed_aug", "iv_seed_v3", "iv_zip", "iv_exec",
+              "gap_back_h", "gap_fwd_h", "iv_gap_back", "iv_gap_fwd", "regime", "iv_candidates", "iv_best", "iv_best_source", "iv_likely", "iv_likely_support", "producer_vs_best"]
+    out_rows = []; v1 = {}; v2 = {"switch_up_rows_with_exec": 0, "exec_equals_best": 0, "disagree": []}
+    cls_counts = {}; mism = []
+    for s in sorted(rows):
+        d = rows[s]; ts = sorted(d)
+        n = len(ts)
+        for k, ft in enumerate(ts):
+            if ft < ZLO or ft > HI: continue
+            e = d[ft]
+            gb = (ft - ts[k - 1]) / 3600.0 if k > 0 else None
+            gf = (ts[k + 1] - ft) / 3600.0 if k + 1 < n else None
+            gf2 = (ts[k + 2] - ts[k + 1]) / 3600.0 if k + 2 < n else None
+            gbb = (ts[k - 1] - ts[k - 2]) / 3600.0 if k > 1 else None
+            ib = snap(gb) if gb is not None else None; ifw = snap(gf) if gf is not None else None
+            if gb is None or gf is None:
+                reg = "edge"
+            elif ib == ifw:
+                reg = "steady"
+            else:
+                reg = "transition"
+            cand = [c for c in (ib, ifw) if c is not None]
+            sig = [c for c in sorted(set(cand)) if abs(e["rate"] - 1.25e-5 * c) < 1e-12]
+            gb_r = None if gb is None else round(gb, 6)
+            gf_r = None if gf is None else round(gf, 6)
+            # resolution rules, in priority order; each is scored against the zip over full history in V1 (only rules at 100% are used)
+            rules = []
+            if reg == "steady":
+                rules.append(("structure_steady", ib))
+            if reg == "transition" and gb_r in (2.0, 3.0) and ifw is not None and ifw > gb_r:
+                rules.append(("structure_gap%g_into_longer" % gb_r, ifw))
+            if reg == "transition" and gb_r == 1.0 and gf_r in (2.0, 3.0):
+                rules.append(("structure_last_1h_before_gap%g" % gf_r, ib))
+            if reg == "transition" and gb_r in (4.0, 8.0) and gf_r == 1.0 and abs(abs(e["rate"]) - 0.02) < 1e-12:
+                rules.append(("cap_signature_%gh_to_1h" % gb_r, ib))
+            if reg in ("transition", "edge") and len(sig) == 1:
+                rules.append(("interest_signature", float(sig[0])))
+            if e.get("iv_zip") is not None:
+                for nm, val in rules:
+                    v = v1.setdefault(nm + ("" if reg != "edge" else "_edge"), [0, 0]); v[0] += 1; v[1] += int(val == e["iv_zip"])
+                if reg == "transition":
+                    v = v1.setdefault("transition_zip_equals_back", [0, 0]); v[0] += 1; v[1] += int(ib == e["iv_zip"])
+                    v = v1.setdefault("transition_zip_equals_fwd", [0, 0]); v[0] += 1; v[1] += int(ifw == e["iv_zip"])
+            # EXACT = rules that equal the zip on every scored row of the full history (V1; steady has 2 exchange anomalies in 2.52M);
+            # LIKELY = rules below 100% (support written into the row)
+            EXACT = {"structure_steady", "structure_last_1h_before_gap2", "structure_last_1h_before_gap3", "cap_signature_4h_to_1h",
+                     "cap_signature_8h_to_1h", "interest_signature"}
+            LIKELY = {"structure_gap3_into_longer": "40/41", "structure_gap2_into_longer": "52/62"}
+            likely = ""; likely_sup = ""
+            if e.get("iv_zip") is not None:
+                best, bsrc = e["iv_zip"], "zip"
+            else:
+                usable = [(nm, val) for nm, val in rules if nm in EXACT]
+                vals = {val for nm, val in usable}
+                if len(vals) == 1:
+                    best, bsrc = usable[0][1], "+".join(nm for nm, _ in usable)
+                elif len(vals) > 1:
+                    best, bsrc = None, "conflicting_rules:" + ",".join(f"{nm}={val:g}" for nm, val in usable)
+                else:
+                    best, bsrc = None, "unresolved_" + reg
+                lk = [(nm, val) for nm, val in rules if nm in LIKELY]
+                if best is None and lk:
+                    likely = lk[0][1]; likely_sup = f"{lk[0][0]} {LIKELY[lk[0][0]]}"
+            if ft < LO: continue
+            inprod = "iv_producer" in e
+            pv = e.get("iv_producer")
+            if not inprod: pvb = "not_in_producer_ledger"
+            elif best is None: pvb = "unresolved"
+            else: pvb = "match" if pv == best else "mismatch"
+            ivx = e.get("iv_exec")
+            if reg == "transition" and ivx:
+                v2["switch_up_rows_with_exec"] += 1
+                if best is not None and ivx == {best}: v2["exec_equals_best"] += 1
+                else: v2["disagree"].append((s, T(ft), sorted(x for x in ivx if x is not None), best, bsrc))
+            cls_counts[(reg, pvb)] = cls_counts.get((reg, pvb), 0) + 1
+            if pvb == "mismatch": mism.append((s, T(ft), pv, best, bsrc, reg, e["rate"]))
+            out_rows.append([s, ft, T(ft), repr(e["rate"]), e.get("pod2_src", 0), int(inprod), pv, e.get("iv_seed_aug"), e.get("iv_seed_v3"), e.get("iv_zip"),
+                             "|".join(str(x) for x in sorted(ivx, key=lambda x: (x is None, x))) if ivx else "", None if gb is None else round(gb, 6),
+                             None if gf is None else round(gf, 6), ib, ifw, reg, ("|".join("%g" % c for c in cand) if reg == "transition" else ""), best, bsrc, likely, likely_sup, pvb])
+    os.makedirs(OUT, exist_ok=True)
+    fn = OUT + f"/P9_declared_interval_table_{T(LO)[:10]}_{T(HI)[:13]}Z.csv.gz"
+    buf = io.StringIO(); w = csv.writer(buf, lineterminator="\n"); w.writerow(header)
+    for r in out_rows: w.writerow(["" if x is None else x for x in r])
+    raw = buf.getvalue().encode()
+    with open(fn, "wb") as f:
+        f.write(gzip.compress(raw, mtime=0))
+    rc = dict(self_sha256=H.gsha(os.path.abspath(__file__)), harness_sha256=H.gsha(os.path.join(os.path.dirname(os.path.abspath(__file__)), "fx_harness.py")),
+              window=[T(LO), T(HI)], output=fn, output_sha256=H.gsha(fn), csv_sha256=hashlib.sha256(raw).hexdigest(), n_rows=len(out_rows),
+              n_symbols=len({r[0] for r in out_rows}), inputs_sha256=shas, rate_conflicts_across_sources=conflicts, n_executor_records=n_ex, executor_matched_with_1s_shift=n_ex_shifted, executor_unmatched_rows=n_ex_unmatched, executor_rate_mismatch=n_ex_rate_mismatch,
+              regime_x_producer_counts={f"{a}|{b}": c for (a, b), c in sorted(cls_counts.items())},
+              V1_rules_vs_zip_2026_01_01_to_07_31={k: dict(rows=v[0], equal=v[1], share=round(v[1] / v[0], 6) if v[0] else None) for k, v in v1.items()},
+              V2_exec_labels_at_transition_rows=dict(rows=v2["switch_up_rows_with_exec"], exec_equals_best=v2["exec_equals_best"], other=v2["disagree"][:60], note="executor labels are fundingInfo read AFTER the settlement (pull time) and are not per-settlement truth"),
+              producer_mismatch_rows=len(mism), producer_mismatches=mism[:400], runtime_s=round(time.time() - t0, 1),
+              built_utc=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
+    json.dump(rc, open(OUT + "/RECEIPT_P9_declared_interval_table.json", "w"), indent=1, default=str)
+    print(json.dumps({k: v for k, v in rc.items() if k not in ("producer_mismatches", "inputs_sha256")}, indent=1, default=str))
+    print("SUMMARY p9_declared_interval_table rows=%d mismatches=%d" % (len(out_rows), len(mism)))
+
+
+if __name__ == "__main__":
+    main()
