+def declared_interval_exact(t_prev, t, t_next, rate):
+    """P6: 只用在 2020-01..2026-07 全部 zip 申报行(funding_interval_hours)上逐行相等的规则判一次结算的申报间隔
+    (fx_prod p9_declared_interval_table.py V1): steady(前后时间差吸附相同, 2,521,513/2,521,515) / cap(|rate|=0.02, 前 4h|8h 后 1h ⇒ 前段,
+    194/194) / 1h 行后接 2-3h 间隔 ⇒ 1h(92/92) / 利息腿签名(rate == 1.25e-5×iv 唯一候选, 1,111/1,111)。
+    返回 (iv, 规则) 或 (None, "unresolved"|"conflict"); 切换边界其余行的申报值由结算时刻的配置决定, 时间与费率判不出, 不猜。"""
+    gb = None if t_prev is None else round((t - t_prev) / 3600.0, 6)
+    gf = None if t_next is None else round((t_next - t) / 3600.0, 6)
+    ib = None if gb is None else _snap_iv(gb)
+    ifw = None if gf is None else _snap_iv(gf)
+    rules = []
+    if ib is not None and ifw is not None and ib == ifw:
+        rules.append((ib, "steady"))
+    else:
+        if gb in (4.0, 8.0) and gf == 1.0 and abs(abs(rate) - 0.02) < 1e-12:
+            rules.append((ib, "cap_signature"))
+        if gb == 1.0 and gf in (2.0, 3.0):
+            rules.append((1.0, "last_1h_before_gap"))
+        sig = [c for c in sorted({x for x in (ib, ifw) if x is not None}) if abs(rate - 1.25e-5 * c) < 1e-12]
+        if len(sig) == 1:
+            rules.append((float(sig[0]), "interest_signature"))
+    vals = {v for v, _ in rules}
+    if len(vals) == 1:
+        return rules[0][0], "+".join(r for _, r in rules)
+    return None, ("conflict" if len(vals) > 1 else "unresolved")
