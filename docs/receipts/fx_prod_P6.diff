+def seed_rederive(seed, ema, ema_v0=None, tol=SEED_IV_EMA_TOL):
+    """P6: bundle 种子引导时逐行重判间隔标签并对齐 EMA 态。
+    (1) 精确规则判出的申报间隔 != 存储值 ⇒ 修复并点名(repaired); 判不出而存储值 != 时间差 ⇒ 保留存储值并点名(kept_unresolved, 如 zip 申报的切换行);
+    (2) 修复对 bundle EMA 态的精确线性影响 sum a_k*drn_k*0.5**((t_end-t_k)/3d)(只计 EMA 已吸收的行)> tol ⇒ 拒启(需重导 bundle);
+    (3) EMA 态 last_ts 必须是种子行, 其后的种子行按第 4 步递推补齐(v1 用修复后标签, v0 用原始费率); 否则拒启。
+    返回 (ledger_tail, ema, ema_v0, report, refuse)。"""
+    HL = 3 * 86400.0
+    rep = {"repaired": [], "kept_unresolved": [], "n_caught_up_v1": 0, "n_caught_up_v0": 0, "max_abs_repair_impact": 0.0}
+    refuse = []; led_out = {}; ema_out = {}; v0_out = None if ema_v0 is None else {}
+    if set(ema) != set(seed):
+        refuse.append(("ema_seed_name_sets_differ", sorted(set(ema) ^ set(seed))[:20]))
+    if ema_v0 is not None and set(ema_v0) != set(seed):
+        refuse.append(("ema_v0_seed_name_sets_differ", sorted(set(ema_v0) ^ set(seed))[:20]))
+    for s, rows0 in seed.items():
+        rows = [[int(r[0]), float(r[1]), float(r[2])] for r in rows0]
+        if not rows:
+            continue
+        ts = [r[0] for r in rows]
+        if any(ts[k] >= ts[k + 1] for k in range(len(ts) - 1)):
+            refuse.append((s, "seed_rows_not_strictly_increasing")); continue
+        fixed = {}
+        for k in range(len(rows)):
+            iv_x, rule = declared_interval_exact(ts[k - 1] if k else None, ts[k], ts[k + 1] if k + 1 < len(ts) else None, rows[k][1])
+            if iv_x is not None and iv_x != rows[k][2]:
+                if k == 0:
+                    refuse.append((s, "first_seed_row_needs_repair", ts[k], rows[k][2], iv_x)); continue
+                fixed[k] = rows[k][2]
+                rep["repaired"].append([s, ts[k], rows[k][2], iv_x, rule]); rows[k][2] = iv_x
+            elif iv_x is None and k and rows[k][2] != _snap_iv((ts[k] - ts[k - 1]) / 3600.0):
+                rep["kept_unresolved"].append([s, ts[k], rows[k][2], _snap_iv((ts[k] - ts[k - 1]) / 3600.0), rule])
+        est = ema.get(s)
+        if not isinstance(est, dict):
+            continue
+        lt = int(est["last_ts"])
+        if lt not in ts:
+            refuse.append((s, "ema_last_ts_not_a_seed_row", lt)); continue
+        i0 = ts.index(lt)
+        impact = sum((1 - 0.5 ** (max(ts[k] - ts[k - 1], 1) / HL)) * rows[k][1] * (8.0 / rows[k][2] - 8.0 / old) * 0.5 ** ((ts[-1] - ts[k]) / HL)
+                     for k, old in fixed.items() if k <= i0)
+        rep["max_abs_repair_impact"] = max(rep["max_abs_repair_impact"], abs(impact))
+        if abs(impact) > tol:
+            refuse.append((s, "repair_impact_on_bundle_ema", impact))
+        acc = float(est["acc"]); last = lt
+        for r in rows[i0 + 1:]:
+            a = 1 - 0.5 ** (max(r[0] - last, 1) / HL)
+            acc = acc + a * (r[1] * (8.0 / r[2]) - acc); last = r[0]
+        rep["n_caught_up_v1"] += int(i0 < len(rows) - 1)
+        ema_out[s] = {"acc": acc, "last_ts": last}
+        if ema_v0 is not None and isinstance(ema_v0.get(s), dict):
+            l0 = int(ema_v0[s]["last_ts"])
+            if l0 not in ts:
+                refuse.append((s, "ema_v0_last_ts_not_a_seed_row", l0))
+            else:
+                j0 = ts.index(l0); acc0 = float(ema_v0[s]["acc"]); last0 = l0
+                for r in rows[j0 + 1:]:
+                    a = 1 - 0.5 ** (max(r[0] - last0, 1) / HL)
+                    acc0 = acc0 + a * (r[1] - acc0); last0 = r[0]
+                rep["n_caught_up_v0"] += int(j0 < len(rows) - 1)
+                v0_out[s] = {"acc": acc0, "last_ts": last0}
+        led_out[s] = rows[-400:]
+    return led_out, ema_out, v0_out, rep, refuse
