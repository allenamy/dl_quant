+def _snap_iv(g):
+    """第 4 步追加规则同式: 时间差(h)吸附 {1,2,4,6,8}, 不在 (0,24] 取 8。"""
+    return float(min([1.0, 2.0, 4.0, 6.0, 8.0], key=lambda a: abs(a - (g if 0 < g <= 24 else 8.0))))
