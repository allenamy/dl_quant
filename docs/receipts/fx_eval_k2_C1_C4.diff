+print("SUMMARY k2_materialize inputs=%d dataless_at_start=%d still_dataless=%d waited=%.0fs %s" % (len(PATHS), len(dl0), len(dl), time.time() - t0, [os.path.relpath(p, REPO) for p in dl][:5]))
+sys.exit(0 if not dl else 1)
