+#!/usr/bin/python3
+"""E-0912-A — RE-JUDGE persisted `ledger_inconsistent` rows against their ORIGINAL evidence, and write a RECEIPT.
+READ-ONLY: never edits a ledger row, never clears a flag, never touches the watchdog's state directory. The only file it writes is
+the receipt at --out (default: a temp path printed at the end).
+
+★ WHY A TOOL AND NOT A FLAG FLIP (review 563e3470 §2/§5, lead 12Z inspection (1)/(2)). The 12Z rows still carry the
+OLD gate's verdict — `inconsistent: "… origQty 1933692.0 differs from ours 1933986.0"` and `ledger_inconsistent` —
+beside confirmed_qty −1933692 and child fills summing to exactly that. Three things must stay separate and each
+needs its own receipt: (i) NEW requests are no longer mis-judged (the broker/venue_fills gates, T1–T7); (ii) the
+HISTORICAL mis-classification is re-judged from evidence — THIS tool, and `reconcile._rederive_ledger` at read time;
+(iii) the resume gate can pass (T9 / `ops/resume_from_trip.sh --check`, the operator's step). Deleting the old string,
+clearing state or flipping a resume flag would collapse the three into one unevidenced act.
+
+★ WHAT IS RE-JUDGED, AND WITH WHAT EVIDENCE. For every `orders` row of the day that carries `ledger_inconsistent`:
+    · the read-time rule (`reconcile._rederive_ledger`: the string's own two numbers say the venue accepted LESS —
+      0 < Qv < Qs; |C| ≤ Qv ≤ |Qs| with Qs == the request's qty; Σ child trade_qty == |C|; same side) — verdict
+      `known` (quantity = C) or `stands`;
+    · the ORIGINAL evidence, independently of the string: the POST response filed by the broker (watchdog
+      `events.jsonl`, action `submit`, matched by `clientOrderId` == the request's client_id): its `origQty` (Qv),
+      `reduceOnly`, `side`; the day's `fills` rows of that (rebalance_id, symbol): their trade_ids vs the request's
+      `trade_qty` keys, Σ fill_notional; the `position_readback` rows before and at the anchor (the position the
+      request set out from, and what was left).
+    · a CROSS-CHECK: the string's Qv equals the POST response's origQty; the children named on the request are the
+      day's fills rows; readback_after == readback_before + C.
+  Nomenclature: Qs = quantity sent; Qv = venue-accepted origQty; L = executed lower bound; F = proven final; C = the
+  request's confirmed quantity (here Σ children = F when the venue's record is terminal).
+★ THEN the watchdog's §4-5b / §4-7 derivation is run on a COPY of the day (no network: `venue_events=[]`,
+  `derive_ops_stats` for §4-7) and its cond5b / drift states are written into the receipt — the reader sees what the
+  guards would say WITHOUT anyone having edited anything. What `ops/resume_from_trip.sh` would still check is listed
+  in the receipt verbatim (mode, seeded-rehearsal marker, the hard gate over the WHOLE pilot_log with the public-path
+  probe, then the quarantine/remove steps) — this tool runs none of them.
+
+Usage:
+    python3 ops/rejudge_ledger_rows.py --check --pilot-log <root> --day 20260912 --events <watchdog/events.jsonl> [--out receipt.json]
+Exit 0 = the receipt was written (whatever the verdicts); 2 = bad arguments / missing inputs.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import sys
+import tempfile
+import time
+from typing import Any, Dict, List, Optional
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+for _d in ("live", "ops", "signal", "scheduler"):
+    sys.path.insert(0, os.path.join(REPO, _d))
+
+
+def _rows(path: str) -> List[dict]:
+    if not path or not os.path.exists(path):
+        return []
+    return [json.loads(l) for l in open(path, encoding="utf-8") if l.strip()]
+
+
+def _fin(x) -> Optional[float]:
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if (v == v and v not in (float("inf"), float("-inf"))) else None
+
+
+def submit_records(events_path: str) -> Dict[str, dict]:
+    """clientOrderId -> {order, resp} from the watchdog's events.jsonl (every `submit` action the broker filed).
+    The LAST record for an id wins (a re-submit under the same id would be its own defect, and is counted)."""
+    out: Dict[str, dict] = {}
+    dup = 0
+    for ev in _rows(events_path):
+        for a in ev.get("actions") or ():
+            if a.get("action") != "submit" or not isinstance(a.get("resp"), dict):
+                continue
+            cid = (a.get("order") or {}).get("client_id") or a["resp"].get("clientOrderId")
+            if cid is None:
+                continue
+            if str(cid) in out:
+                dup += 1
+            out[str(cid)] = {"order": a.get("order") or {}, "resp": a["resp"], "ts": a.get("ts")}
+    out["__duplicates__"] = {"n": dup}          # bookkeeping entry beside the client-id keys (read by the receipt only)
+    return out
+
+
+def rejudge_day(root: str, day: str, events_path: Optional[str]) -> Dict[str, Any]:
+    import pilot_log as PL
+    import reconcile as RC
+
+    data = PL.read_day(root, day)
+    subs = submit_records(events_path) if events_path else {}
+    fills_by = {}
+    for f in data.get("fills", []):
+        fills_by.setdefault((f.get("rebalance_id"), f.get("symbol")), {})[str(f.get("trade_id"))] = f
+    rb_by_anchor: Dict[float, Dict[str, dict]] = {}
+    for r in data.get("position_readback", []):
+        rb_by_anchor.setdefault(float(r["anchor_ts"]), {})[r["symbol"]] = r
+    anchors_sorted = sorted(rb_by_anchor)
+
+    rejudged: List[Dict[str, Any]] = []
+    for o in data.get("orders", []):
+        if not o.get("ledger_inconsistent"):
+            continue
+        rd = RC._rederive_ledger(o)
+        q, why, kind = RC._exec_qty(o)
+        ats = float(o["anchor_ts"])
+        prev_ats = max([a for a in anchors_sorted if a < ats], default=None)
+        rb_prev = (rb_by_anchor.get(prev_ats) or {}).get(o["symbol"]) if prev_ats is not None else None
+        rb_at = (rb_by_anchor.get(ats) or {}).get(o["symbol"])
+        reqs = []
+        for r in (o.get("request_ledger") or ()):
+            if not isinstance(r, dict):
+                continue
+            cid = r.get("client_id")
+            sub = subs.get(str(cid)) if cid is not None else None
+            resp = (sub or {}).get("resp") or {}
+            tq = r.get("trade_qty") or {}
+            fills_here = fills_by.get((o.get("rebalance_id"), o.get("symbol")), {})
+            children_in_fills = sorted(k for k in tq if k in fills_here)
+            children_not_in_fills = sorted(k for k in tq if k not in fills_here)
+            m = RC._ORIGQTY_PAIR.search(str(r.get("inconsistent") or ""))
+            str_qv = _fin(m.group(1)) if m else None
+            str_qs = _fin(m.group(2)) if m else None
+            post_qv = _fin(resp.get("origQty"))
+            entry = {
+                "client_id": cid,
+                "Qs_sent": r.get("qty"),
+                "C_confirmed": r.get("confirmed_qty"),
+                "children_sum": (sum(float(v) for v in tq.values()) if tq else None),
+                "n_children": len(tq),
+                "inconsistent": r.get("inconsistent"),
+                "rule_verdict": ("known" if (rd and cid in rd["known"]) else ("stands" if rd else "no ledger")),
+                "evidence": {
+                    "post_response_found": bool(sub),
+                    "post_origQty_Qv": post_qv,
+                    "post_reduceOnly": resp.get("reduceOnly"),
+                    "post_side": resp.get("side"),
+                    "post_orderId": resp.get("orderId"),
+                    "order_sent_quantity": (sub or {}).get("order", {}).get("quantity"),
+                    "order_sent_reduce_only": (sub or {}).get("order", {}).get("reduce_only"),
+                    "string_Qv": str_qv, "string_Qs": str_qs,
+                    "children_in_day_fills": children_in_fills,
+                    "children_not_in_day_fills": children_not_in_fills,
+                    "fills_notional_sum": (sum(float(fills_here[k]["fill_notional"]) for k in children_in_fills) if children_in_fills else None),
+                    "readback_before": ({"anchor_ts": prev_ats, "qty": rb_prev.get("venue_position_qty"), "notional": rb_prev.get("venue_position_notional")} if rb_prev else None),
+                    "readback_at": ({"anchor_ts": ats, "qty": rb_at.get("venue_position_qty"), "notional": rb_at.get("venue_position_notional")} if rb_at else None),
+                },
+            }
+            c = _fin(r.get("confirmed_qty"))
+            entry["cross_check"] = {
+                "string_Qv_equals_post_origQty": (str_qv is not None and post_qv is not None and abs(str_qv - post_qv) <= 1e-9),
+                "post_says_reduceOnly_and_we_sent_reduce_only": (resp.get("reduceOnly") is True and bool((sub or {}).get("order", {}).get("reduce_only"))),
+                "Qv_below_Qs": (str_qv is not None and str_qs is not None and 0 < str_qv < str_qs),
+                "children_all_in_day_fills": (bool(tq) and not children_not_in_fills),
+                "children_sum_equals_C": (c is not None and tq and abs(sum(float(v) for v in tq.values()) - abs(c)) <= 1e-9),
+                "readback_after_equals_before_plus_C": (rb_prev is not None and rb_at is not None and c is not None
+                                                        and abs(float(rb_prev.get("venue_position_qty") or 0.0) + c - float(rb_at.get("venue_position_qty") or 0.0)) <= 1e-9),
+            }
+            entry["cross_check"]["all"] = all(bool(v) for v in entry["cross_check"].values())
+            reqs.append(entry)
+        rejudged.append({
+            "rebalance_id": o.get("rebalance_id"), "anchor_ts": ats, "symbol": o["symbol"], "order_type": o.get("order_type"),
+            "terminal_reason_as_written": o.get("terminal_reason"),
+            "ledger_inconsistent_as_written": o.get("ledger_inconsistent"),
+            "read_time_verdict": {"kind": kind, "quantity": q, "why": why,
+                                  "standing_contradictions": (rd or {}).get("stands") if rd else None},
+            "requests": reqs,
+        })
+
+    # the guards' derivation on a COPY of the day — nothing here writes into `root`
+    tree = tempfile.mkdtemp(prefix="rejudge_")
+    shutil.rmtree(tree)
+    os.makedirs(tree)
+    shutil.copytree(os.path.join(root, day), os.path.join(tree, day))
+    wd: Dict[str, Any]
+    try:
+        import watchdog as WD
+        import watchdog_inputs as WI
+        ops = WI.derive_ops_stats(tree)
+        ev = WD.evaluate(tree, venue_events=[], ops_stats=ops)
+        c5 = ev["conditions"]["cond5_venue_event"]["5b_liquidation_anomaly"]
+        c7 = ev["conditions"]["cond7_ops"]
+        wd = {"cond5b": {k: c5.get(k) for k in ("state", "n", "triggered", "last_reconciled_anchor_ts", "n_historical_anomalies")},
+              "cond5b_examples": [(a.get("symbol"), a.get("kind")) for a in (c5.get("examples") or [])],
+              "cond7_drift_state": c7.get("drift_state"), "cond7_triggered": c7.get("triggered"),
+              "tripped": ev.get("tripped"), "triggers": ev.get("triggers"), "conditions_blind": ev.get("conditions_blind"),
+              "caliber": "WD.evaluate on a COPY of this day only; venue_events=[] (no public-path probe); §4-7 from derive_ops_stats"}
+    except Exception as e:                                  # noqa: BLE001 — the receipt must still be written
+        wd = {"error": f"{type(e).__name__}: {str(e)[:160]}"}
+    finally:
+        shutil.rmtree(tree, ignore_errors=True)
+
+    return {
+        "tool": "ops/rejudge_ledger_rows.py --check (READ-ONLY; writes only this receipt)",
+        "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "pilot_log_root": root, "day": day, "events_path": events_path,
+        "n_rows_with_ledger_inconsistent": len(rejudged),
+        "n_rows_rejudged_known": sum(1 for r in rejudged if r["read_time_verdict"]["kind"] == "known"),
+        "n_rows_still_unquantifiable": sum(1 for r in rejudged if r["read_time_verdict"]["kind"] != "known"),
+        "n_requests_cross_check_all_true": sum(1 for r in rejudged for q in r["requests"] if q["cross_check"]["all"]),
+        "submit_records_duplicates": subs.get("__duplicates__"),
+        "rows": rejudged,
+        "watchdog_derivation_on_copy": wd,
+        "not_done_here": [
+            "no ledger row edited, no flag cleared, the watchdog's state directory untouched",
+            "ops/resume_from_trip.sh NOT run; what it would check: (0) LIVE_MODE names the tripped mode; (0b) no `_seeded_by_rehearsal` marker; "
+            "(1) HARD GATE = WI.collect (public-path probe, network) + WD.run on a COPY of the WHOLE pilot_log (all days): refuses on any "
+            "`conditions_blind` or `tripped`; --check stops here; (2) quarantine state.json; (3) remove it + harvest_ema.json; (4) verify no halt/reduce-only state remains",
+        ],
+    }
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--check", action="store_true", help="the only mode; present so the invocation says what it does")
+    ap.add_argument("--pilot-log", required=True, help="pilot_log ROOT (the directory holding YYYYMMDD day dirs)")
+    ap.add_argument("--day", required=True)
+    ap.add_argument("--events", default=None, help="watchdog events.jsonl (POST responses); optional")
+    ap.add_argument("--out", default=None, help="receipt path (JSON); default: a temp file, printed")
+    a = ap.parse_args()
+    if not os.path.isdir(os.path.join(a.pilot_log, a.day)):
+        print(f"no such day: {os.path.join(a.pilot_log, a.day)}", file=sys.stderr)
+        return 2
+    rep = rejudge_day(a.pilot_log, a.day, a.events)
+    out = a.out or os.path.join(tempfile.mkdtemp(prefix="rejudge_receipt_"), f"rejudge_{a.day}.json")
+    with open(out, "w", encoding="utf-8") as f:
+        json.dump(rep, f, indent=1, default=str, ensure_ascii=False)
+    print(json.dumps({k: rep[k] for k in ("day", "n_rows_with_ledger_inconsistent", "n_rows_rejudged_known",
+                                          "n_rows_still_unquantifiable", "n_requests_cross_check_all_true")}, ensure_ascii=False))
+    print(json.dumps(rep["watchdog_derivation_on_copy"], default=str, ensure_ascii=False))
+    print(f"receipt: {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
