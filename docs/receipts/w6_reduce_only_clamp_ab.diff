+"""E-0912-A (b) fee population: a PROTECTIVE FLATTEN's executions get fills rows and measured commission via the
+B26b backfill — the flatten's legs are joined by the rows' OWN client ids, as one `protective_flatten` leg.
+
+*** MOCK ONLY: `urllib.request.urlopen` is sealed by the transport suite's FakeNet; temp pilot_log trees; no venue,
+    no credentials, nothing written under state/. ***
+
+THE GAP (review 563e3470 §5.3, lead 12Z inspection (6)): the 2026-09-12 12:47Z ladder wrote 255 `protective_flatten`
+order rows with `fee_paid None`, no `fee_*` keys and ZERO fills rows — the cost of the flatten is therefore an
+estimate (≈5 bps) and M2 has no markout input for it. `ops/backfill_fills.py` (B26b) already detects such a batch as a
+gap, but its leg resolution (`venue_fills.order_legs_from_venue`) joined allOrders rows by the `<rebalance_id>-`
+client-id PREFIX; a flatten mints `F<utc>-SYM-n` ids under a `FLATTEN-<trip>` rebalance id, so zero legs were rebuilt
+and the runner refused (correctly) to write rows it could not attribute.
+
+WHAT CHANGED: `find_gaps` carries each missing symbol's own client ids and the batch kind; for a flatten batch
+`order_legs_from_venue(..., client_ids=…, leg="protective_flatten")` joins by EXACT client id; `attribute_trades` gives
+the leg its own bucket; `fill_rows_from_trades` writes `order_type = protective_flatten`. The order rows are NOT
+rewritten (append-only: a row records what we knew when we wrote it) — the measured commission lives on the fills rows.
+
+ASSERTED HERE:
+  [A] the REAL 2026-09-12 day (fixture, verbatim): `find_gaps` names the FLATTEN batch — 255 executed symbols, 255
+      missing fills, 255 client ids, 255 order rows with fee unmeasured — and nothing else (the anchors have fills).
+  [B] synthetic flatten population (3 names, 4 child fills, one foreign row and one foreign trade): report-only run
+      rebuilds 3 legs, 4 recoverable rows, writes nothing; `--apply` writes exactly the 4 fills rows (order_type
+      protective_flatten, FLATTEN rebalance id, commission per fill, the venue's trade ids); a second apply writes 0
+      (idempotent by trade id); the foreign trade is counted unattributed, never written.
+  [C] a flatten batch whose client ids the venue does not list ⇒ 0 legs, warning, nothing written (fail closed).
+  [D] regression: a normal rebalance gap still resolves by the `<rid>-` prefix (maker leg from GTX).
+  [E] the flatten's leg bucket does not disturb the maker/topup_taker buckets a normal batch produces.
+
+NOT asserted: that the venue's allOrders reaches back to the flatten (limit 500 / startTime — the runner reports
+`symbols_unreached`), nor the live run (`LIVE_MODE=LIVE python3 ops/backfill_fills.py --day 20260912 [--apply]` is the
+operator's step, with credentials). Old code (918559f): [A] has no client_ids / kind, [B] rebuilds 0 legs ⇒ red.
+
+Exit 0 = all pass.
+"""
+import contextlib
+import io
+import json
+import os
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+for _d in ("ops", "scheduler", "signal"):
+    sys.path.insert(0, os.path.join(REPO, _d))
+
+_ns = {"__file__": os.path.join(HERE, "tests_transport_resilience.py"), "__name__": "__fixture__"}
+_buf = io.StringIO()
+with contextlib.redirect_stdout(_buf):
+    try:
+        exec(compile(open(_ns["__file__"], encoding="utf-8").read(), _ns["__file__"], "exec"), _ns)
+    except SystemExit as _e:
+        if _e.code not in (0, None):
+            print(_buf.getvalue()[-2000:])
+            print("FIXTURE SUITE (tests_transport_resilience) IS RED — this suite cannot run on top of it")
+            sys.exit(1)
+NET, broker = _ns["NET"], _ns["broker"]
+import backfill_fills as BF            # noqa: E402
+import pilot_log as PL                 # noqa: E402
+import venue_fills as VF               # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:400]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+FIX = os.path.join(HERE, "tests_fixtures", "e0912a_12z", "pilot_log")
+DAY = "20260912"
+RID_F = "FLATTEN-20260912T124737Z"
+TS = 1789217401.146036
+
+print("[A] the REAL 2026-09-12 day: the flatten batch is the one gap, with its own client ids")
+_g = BF.find_gaps(PL.read_day(FIX, DAY))
+check("★★★ A one gap = the FLATTEN batch, kind flatten, 255 executed / 255 missing / 255 client ids / 255 order rows fee-unmeasured",
+      len(_g) == 1 and _g[0]["rebalance_id"] == RID_F and _g[0].get("kind") == "flatten" and _g[0]["n_executed_symbols"] == 255
+      and _g[0]["n_missing_symbols"] == 255 and len(_g[0].get("client_ids") or {}) == 255 and _g[0].get("n_order_rows_fee_unmeasured") == 255,
+      [(x.get("rebalance_id"), x.get("kind"), x.get("n_missing_symbols"), len(x.get("client_ids") or {})) for x in _g])
+check("★ A every client id has the flatten prefix F20260912124738-<SYM>-",
+      all(all(c.startswith(f"F20260912124738-{s}-") for c in v) for s, v in (_g[0].get("client_ids") or {}).items()) if _g else False)
+
+
+# ── synthetic population ────────────────────────────────────────────────────────────────────────────────────────
+POP = [("AAAUSDT", "sell", 100.0, 2.0, 9001), ("BBBUSDT", "buy", 50.0, 10.0, 9002), ("CCCUSDT", "sell", 7.0, 100.0, 9003)]
+
+
+def _tree(with_rebalance_gap=False):
+    root = tempfile.mkdtemp(prefix="e0912a_bf_")
+    lg = PL.PilotLogger(root, day=DAY)
+    for sym, side, qty, px, _oid in POP:
+        lg.order(anchor_ts=TS, symbol=sym, side=side, target_w=0.0, prev_w=None, intended_notional=qty * px,
+                 order_type="protective_flatten", submit_ts=TS, price_submit=None, mid_at_submit=px, mid_at_anchor=None,
+                 filled_notional=(qty * px if side == "buy" else -qty * px), avg_fill_px=px, first_fill_ts=TS - 100.0,
+                 last_fill_ts=TS - 100.0, cancel_ts=None, fee_paid=None, rebalance_id=RID_F,
+                 client_id=f"F20260912124738-{sym}-1", attempt_idx=1, terminal_reason="filled", notional_currency="USDT",
+                 flatten_error=None)
+    # a normal anchor batch WITH its fill row (not a gap) — and optionally one without (a rebalance gap, for [D])
+    lg.order(anchor_ts=TS - 5000, symbol="DDDUSDT", side="buy", target_w=0.01, prev_w=0.0, intended_notional=5.0, order_type="maker",
+             submit_ts=TS - 4990, price_submit=1.0, mid_at_submit=1.0, mid_at_anchor=1.0, filled_notional=5.0, avg_fill_px=1.0,
+             first_fill_ts=TS - 4900, last_fill_ts=TS - 4900, cancel_ts=None, fee_paid=0.001, rebalance_id="A1789212401",
+             attempt_idx=1, terminal_reason="filled", notional_currency="USDT")
+    lg.fill(anchor_ts=TS - 5000, symbol="DDDUSDT", side="buy", order_type="maker", attempt_idx=1, fill_ts=TS - 4900, fill_px=1.0,
+            fill_notional=5.0, mid_at_fill_plus_60s=None, rebalance_id="A1789212401", trade_id=777001, commission=0.001,
+            commission_asset="USDT", venue_maker_flag=True)
+    if with_rebalance_gap:
+        lg.order(anchor_ts=TS - 5000, symbol="EEEUSDT", side="buy", target_w=0.01, prev_w=0.0, intended_notional=8.0, order_type="maker",
+                 submit_ts=TS - 4990, price_submit=1.0, mid_at_submit=1.0, mid_at_anchor=1.0, filled_notional=8.0, avg_fill_px=1.0,
+                 first_fill_ts=TS - 4900, last_fill_ts=TS - 4900, cancel_ts=None, fee_paid=None, rebalance_id="A1789212401",
+                 attempt_idx=1, terminal_reason="filled", notional_currency="USDT")
+    lg.close()
+    return root
+
+
+def _all_orders_row(sym, cid, oid, side, qty, px, tif="IOC"):
+    return {"clientOrderId": cid, "orderId": oid, "symbol": sym, "timeInForce": tif, "status": "FILLED", "side": side.upper(),
+            "origQty": f"{qty}", "executedQty": f"{qty}", "cumQuote": f"{qty * px}", "avgPrice": f"{px}", "reduceOnly": True,
+            "updateTime": int((TS - 100.0) * 1000)}
+
+
+def _trade(sym, oid, tid, side, qty, px, fee, asset="USDT"):
+    return {"id": tid, "orderId": oid, "symbol": sym, "side": side.upper(), "price": f"{px}", "qty": f"{qty}", "quoteQty": f"{qty * px}",
+            "commission": f"{fee}", "commissionAsset": asset, "time": int((TS - 100.0) * 1000), "maker": False, "buyer": side == "buy"}
+
+
+def _script_venue(foreign_only=False):
+    """allOrders + userTrades per symbol, in the runner's (sorted) symbol order; one foreign order row and one foreign trade."""
+    NET.calls.clear(); NET.script.clear()
+    ao, tr = [], []
+    for i, (sym, side, qty, px, oid) in enumerate(POP):
+        cid = f"F20260912124738-{sym}-1"
+        rows = [_all_orders_row(sym, "SOMEONE-ELSE-1", 5555 + i, side, 1.0, px)]
+        if not foreign_only:
+            rows.append(_all_orders_row(sym, cid, oid, side, qty, px))
+        ao.append(rows)
+        children = ([_trade(sym, oid, 70000 + 2 * i, side, qty * 0.6, px, 0.0006 * qty * px), _trade(sym, oid, 70001 + 2 * i, side, qty * 0.4, px, 0.0004 * qty * px)]
+                    if i == 0 else [_trade(sym, oid, 70000 + 2 * i, side, qty, px, 0.001 * qty * px)])
+        if i == 2:
+            children.append(_trade(sym, 5557, 99999, side, 1.0, px, 0.001))       # a foreign trade (another orderId)
+        tr.append(children)
+    NET.on("GET", "/fapi/v1/allOrders", *ao)
+    NET.on("GET", "/fapi/v1/userTrades", *tr)
+
+
+print("\n[B] synthetic flatten population: report, apply, idempotence")
+root = _tree()
+b = broker(); _script_venue()
+rep = BF.run(root=root, day=DAY, apply=False, broker=b)
+r0 = (rep.get("results") or [{}])[0]
+check("★★★ B report-only: one flatten gap, 3 legs rebuilt from the venue by exact client id, 4 rows recoverable, 1 foreign trade unattributed, nothing written",
+      rep["n_gaps"] == 1 and r0.get("kind") == "flatten" and r0.get("n_legs_rebuilt_from_venue") == 3 and r0.get("n_rows_recoverable") == 4
+      and r0.get("n_trades_unattributed") == 1 and r0.get("n_rows_written") == 0 and r0.get("applied") is False
+      and not PL.read_day(root, DAY)["fills"] or len(PL.read_day(root, DAY)["fills"]) == 1,
+      {k: r0.get(k) for k in ("kind", "n_legs_rebuilt_from_venue", "n_rows_recoverable", "n_trades_unattributed", "n_rows_written", "warning")})
+check("★★ B the report says where the fee lands and how many order rows stay fee-unmeasured (3)",
+      r0.get("n_order_rows_fee_unmeasured") == 3 and "fills rows" in str(r0.get("fee_measurement_lands_on")), r0.get("fee_measurement_lands_on"))
+b = broker(); _script_venue()
+rep = BF.run(root=root, day=DAY, apply=True, broker=b)
+r1 = rep["results"][0]
+fills = [f for f in PL.read_day(root, DAY)["fills"] if f.get("rebalance_id") == RID_F]
+check("★★★ B --apply: exactly 4 fills rows written for the FLATTEN batch — order_type protective_flatten, the venue's trade ids, commission per fill, backfilled_utc stamped",
+      r1.get("n_rows_written") == 4 and len(fills) == 4 and all(f["order_type"] == "protective_flatten" for f in fills)
+      and sorted(f["trade_id"] for f in fills) == [70000, 70001, 70002, 70004] and all(f.get("commission") is not None and f["commission"] > 0 for f in fills)
+      and all(f.get("backfilled_utc") for f in fills) and not any(f["trade_id"] == 99999 for f in fills),
+      [(f["symbol"], f["trade_id"], f["commission"], f["order_type"]) for f in fills])
+check("★★ B the measured commission per name = Σ child commissions (AAAUSDT 0.12 + 0.08 = 0.20, BBBUSDT 0.5, CCCUSDT 0.7 USDT)",
+      abs(sum(f["commission"] for f in fills if f["symbol"] == "AAAUSDT") - 0.20) < 1e-9 and abs(sum(f["commission"] for f in fills if f["symbol"] == "BBBUSDT") - 0.5) < 1e-9
+      and abs(sum(f["commission"] for f in fills if f["symbol"] == "CCCUSDT") - 0.7) < 1e-9, [(f["symbol"], f["commission"]) for f in fills])
+check("★★ B the ORDER rows are untouched (append-only): still fee_paid None, same 4 order rows",
+      [o.get("fee_paid") for o in PL.read_day(root, DAY)["orders"] if o["order_type"] == "protective_flatten"] == [None, None, None]
+      and len(PL.read_day(root, DAY)["orders"]) == 4)
+b = broker(); _script_venue()
+rep = BF.run(root=root, day=DAY, apply=True, broker=b)
+check("★★★ B a second --apply writes 0 rows (idempotent by trade id) and the gap is gone from find_gaps",
+      rep["n_gaps"] == 0 and rep.get("results") == [] and len([f for f in PL.read_day(root, DAY)["fills"] if f.get("rebalance_id") == RID_F]) == 4,
+      (rep["n_gaps"], rep.get("results")))
+
+print("\n[C] a flatten batch the venue does not list under our client ids ⇒ fail closed")
+root = _tree()
+b = broker(); _script_venue(foreign_only=True)
+rep = BF.run(root=root, day=DAY, apply=True, broker=b)
+r2 = rep["results"][0]
+check("★★★ C 0 legs rebuilt, warning present, nothing written even with --apply",
+      r2.get("n_legs_rebuilt_from_venue") == 0 and r2.get("warning") and r2.get("n_rows_written") == 0
+      and not [f for f in PL.read_day(root, DAY)["fills"] if f.get("rebalance_id") == RID_F], {k: r2.get(k) for k in ("n_legs_rebuilt_from_venue", "n_rows_written", "warning")})
+
+print("\n[D]/[E] regression: a normal rebalance gap still resolves by prefix; leg buckets undisturbed")
+root = _tree(with_rebalance_gap=True)
+b = broker(); NET.calls.clear(); NET.script.clear()
+# runner order: gaps sorted by anchor_ts ⇒ the rebalance batch (TS−5000) first, then the flatten
+NET.on("GET", "/fapi/v1/allOrders", [_all_orders_row("EEEUSDT", "A1789212401-EEEUSDT-1", 8001, "buy", 8.0, 1.0, tif="GTX")],
+       *[[_all_orders_row(s, f"F20260912124738-{s}-1", oid, side, q, px)] for s, side, q, px, oid in POP])
