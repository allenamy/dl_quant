+#!/usr/bin/env python3
+"""fx_state.py — producer state from frozen snapshots for FX-PROD tests and devices (READ-ONLY inputs).
+Mirrors parity_replay_2026-09-12/devices/replay_driver.py build_state_from_snapshot (G-P3 forward mode): the float64 state saved at the
+close of anchor S, the cache frozen after anchor A (rows <= A are what the live process held after its own fetch at A), and the ledger
+rows served for (S, A] from the ledger frozen after A."""
+import os, sys, json, importlib.util, time
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import fx_harness as H
+
+
+def import_device(path, modname, home, bundle):
+    os.environ["WIDE_SHADOW_HOME"] = home; os.environ["WIDE_SHADOW_BUNDLE"] = bundle
+    os.makedirs(home + "/state", exist_ok=True)
+    spec = importlib.util.spec_from_file_location(modname, path); mod = importlib.util.module_from_spec(spec)
+    sys.modules[modname] = mod; spec.loader.exec_module(mod)
+    assert mod.STATE_DIR == home + "/state" and mod.BUNDLE == bundle, (mod.STATE_DIR, mod.BUNDLE)
+    mod.ShadowState.save = lambda self: None
+    return mod
+
+
+class RecBooster:
+    """Records the exact matrix the device feeds the booster and the returned scores; delegates unchanged (T4 driver RecBooster)."""
+    def __init__(self, b): self.b = b; self.last = None
+    def predict(self, X):
+        p = self.b.predict(X); self.last = (np.array(X, dtype=np.float32, copy=True), np.array(p, dtype=np.float64, copy=True)); return p
+
+
+def state_from_snapshot(dev, cfg, snap_aux_path, snap_lr_path, rolling_path, bundle):
+    st = dev.ShadowState.__new__(dev.ShadowState)
+    st.syms = cfg["symbols_panel"]; st.live = cfg["symbols_live"]; st.NW = len(st.syms)
+    st.sym_idx = {s: j for j, s in enumerate(st.syms)}
+    st.live_mask = np.zeros(st.NW, bool); st.live_mask[[st.sym_idx[s] for s in st.live if s in st.sym_idx]] = True
+    z = np.load(rolling_path, allow_pickle=True); st.cts = z["ts"].astype(np.int64); st.cd = z["data"].astype(np.float16)
+    aux = json.load(open(snap_aux_path))
+    st.prev_close = {k: float(v) for k, v in aux["prev_close"].items()}
+    st.H = np.zeros(st.NW)
+    for k, v in aux["H"].items(): st.H[int(k)] = float(v)
+    st.last_anchor = int(aux["last_anchor"]); st.ema = aux["ema"]; st.ledger = {s: [list(r) for r in rows] for s, rows in aux["ledger_tail"].items()}
+    st.prev_rec = aux.get("prev_rec"); st.base = list(aux.get("base_syms") or st.live)
+    lr = np.load(bundle + "/leg_returns.npz"); extra = json.load(open(snap_lr_path))
+    st.LR = {leg: list(lr[leg]) + list(extra[leg]) for leg in ("king", "rev24", "fund")}
+    return st, aux
+
+
+def full_rows(include_pod2=True):
+    """{sym: [(ft, rate)]} = pod2 ledger_full (zip ∪ API, <= 09-01 02:00Z) ∪ every frozen Mac ledger source; rates must agree exactly."""
+    src, shas = H.frozen_ledger_sources()
+    if include_pod2:
+        p = H.WORK + "/pod2_inputs/ledger_full.npz"; shas["pod2_ledger_full"] = H.gsha(p)
+        assert shas["pod2_ledger_full"] == "bea6f5752772d54e659a4da5571ca41945a27d1b2316ec0ae52f387074f795ad"
+        z = np.load(p); syms = [str(s) for s in z["symbols"]]; off = z["off"]; ft = z["ft"]; rate = z["rate"]
+        led = {s: [[int(t), float(r), 0.0] for t, r in zip(ft[off[j]:off[j + 1]], rate[off[j]:off[j + 1]])] for j, s in enumerate(syms)}
+        src = [("pod2_ledger_full", led)] + src
+    rows, audit = H.rows_union(src)
+    assert audit["n_conflicts"] == 0, audit["conflicts"][:5]
+    return rows, audit, shas
+
+
+def v0_state_matching(ema, rows):
+    """ema_v0 for every name in ema: training v0 after all rows with ft <= that name's ema last_ts (so last_ts matches by construction)."""
+    out = {}; bad = []
+    for s, est in ema.items():
+        v = H.v0_state_after(rows.get(s, []), int(est["last_ts"]))
+        if v is None or v["last_ts"] != int(est["last_ts"]):
+            bad.append(s); continue
+        out[s] = v
+    return out, bad
