+"""W9 fixture builder for the LIVE 2026-09-13 08:00Z anchor (rid A1789287840) — provenance record; the suite reads the JSON only.
+
+Why this anchor (lead's read-only 08Z deep check): the executor paged 撤名残差 −20,475.81 USDT = −8.69% of the sizing gross
+235,542.59 (target gross after the venue cap 235,111.02), from 11 withdrawn names; state/live/per_name_stop.json held cooldown 10 /
+stopped 0; the book was flat and opening halted, so nothing traded. When trading resumes the reshape neutralises around this hole.
+Reads the LIVE tree READ-ONLY (nothing is written under ~/dl_quant_live or ~/wide_shadow). Every source file is read only if it is not
+APFS-dataless and the bytes read equal st_size (evicted files can silently read as empty).
+Scenario values: IOSTUSDT and LSKUSDT are two of the eleven withdrawn names, and were REAL stopped names on 09-12 12Z (rid A1789215839):
+their held notionals then (prev_w x target_gross of their maker rows) are the stopped-and-held values the suite injects.
+Run: /usr/bin/python3 live/tests_fixtures/w9_stopped_long/build_fixture_0913_08z.py
+"""
+import hashlib, json, os, re, stat
+LIVE, WS = "/Users/haosiyu/dl_quant_live", "/Users/haosiyu/wide_shadow"
+A, RID, RID_PREV = 1789286400, "A1789287840", "A1789215839"
+OUT = os.path.dirname(os.path.abspath(__file__))
+SF_DATALESS = getattr(stat, "SF_DATALESS", 0x40000000)
+SRC = {}
+def read(p):
+    st = os.stat(p)
+    if st.st_flags & SF_DATALESS:
+        raise SystemExit(f"REFUSE {p}: dataless")
+    b = open(p, "rb").read()
+    if len(b) != st.st_size:
+        raise SystemExit(f"REFUSE {p}: read {len(b)} of {st.st_size}")
+    SRC[p] = {"bytes": len(b), "sha256": hashlib.sha256(b).hexdigest()}
+    return b.decode("utf-8", errors="replace")
+pa = None
+for ln in read(LIVE + "/state/anchor_runs.log").splitlines():
+    m = re.match(r"^\S+Z phase_A: (.*)$", ln)
+    if m and RID in ln:
+        try: pa = json.loads(m.group(1))
+        except Exception: pass
+assert pa is not None
+arow = [json.loads(l) for l in read(LIVE + "/state/live/pilot_log/20260913/anchors.jsonl").splitlines() if RID in l][-1]
+rows = [json.loads(l) for l in read(LIVE + "/state/live/pilot_log/20260913/orders.jsonl").splitlines() if RID in l]
+w = json.loads(read(WS + "/state/target_live/1789286400.json"))["weights"]
+assert pa["external_book"]["json_sha"] == SRC[WS + "/state/target_live/1789286400.json"]["sha256"]   # the file the anchor read
