+# ★★★ ENVRED-2: THE TREE-OUTSIDE STATE, RECORDED BESIDE THE INTERPRETER.
+#     A suite count is only comparable with another count taken in the SAME tree state. Measured
+#     2026-09-16: identical code gave 135/135 on the production tree and 137/139 here, and the
+#     whole difference was two suites that depend on things outside the code — `.env` (absent in a
+#     clone, so `tests_env_loading` cannot observe what it asks) and `state/notify_audit.jsonl`
+#     (21 days stale, so `tests_alarm_digest`'s 24h window is empty). Neither is a defect; both
+#     are invisible unless recorded. ⇒ Any cross-tree comparison of counts that does not state
+#     these is void.
+_ENV_PRESENT="$([ -e "$_SELF/.env" ] && echo true || echo false)"
+_NA_PATH="$_SELF/state/notify_audit.jsonl"
+if [ -f "$_NA_PATH" ]; then
+  _NA_LINES="$(wc -l < "$_NA_PATH" | tr -d ' ')"
+  _NA_AGE_H="$("$PY" - "$_NA_PATH" <<'PYEOF' 2>/dev/null || echo null
+import json, sys, time
+ts = []
+for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
+    line = line.strip()
+    if not line:
+        continue
+    try:
+        d = json.loads(line)
+    except ValueError:
+        continue
+    v = d.get("utc") or d.get("ts") or d.get("observed_utc")
+    if isinstance(v, (int, float)):
+        ts.append(float(v))
+print(f"{(time.time() - max(ts)) / 3600.0:.1f}" if ts else "null")
+PYEOF
+)"
+else
