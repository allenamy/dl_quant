+                          "n_skipped": 0, "regime": "calm", "regime_source": "fixture",
+                          "factor_version": '{"a":1}', "panel_hash": "deadbeef"}
+    out = lp.finalize_anchor({"rebalance_id": "A1785000000"}, {})
+    lg.close()
+    return out
