new file mode 100644
index 0000000..bbdee7a
--- /dev/null
+++ b/live/ledger_amendments.py
@@ -0,0 +1,171 @@
+"""ONE reader for the LED-04 daily_nav realised-split amendment records.
+
+★★ WHY A MODULE. The records are FX-EXEC2's (they own the format, the builder and the apply step:
+   quant_research docs/fixprogram_2026-09-13/FX_EXEC2/devices/led04_daily_nav_amendment.py, commit
+   e05c45a). Their branch reads them in `ops/daily_summary.py` — a REPORT. The watchdog's §4-4 reads
+   the same rows to price a TRANSFER DAY, which is a TRIGGER. Two readers of one record format, one
+   of which stops the book, is the "two implementations differing only by which convention they
+   read" family in the worst possible place, so the reading lives here and both callers import it.
+   ⇒ MERGE ACTION (stated here so it cannot be forgotten): when FX-EXEC2's branch is stacked, its
+     `ops/daily_summary.load_realised_amendments` must be replaced by an import of `load` below.
+     `tests_cond4_amended_transfer_day.py` has a cell that goes RED the moment two definitions of
+     that function exist in the tree.
+
+WHAT THE RECORDS ARE (verified against the real 250-record file and the real live rows, 2026-09-16:
+250/250 `row_sha256` values reproduce from the live `daily_nav.jsonl` lines):
+  every `daily_nav` row written before the E-0909-H carrier fix (b681ca5, 2026-09-12 06:05Z) carries
+  a realised split from a carrier that de-duplicated income on `tranId` alone — dropping one of each
+  COMMISSION/REALIZED_PNL twin — and summed BNB commissions into the USDT figure. The ledger is
+  append-only and is never rewritten; a record beside it says what that row's realised P&L was in
+  USDT, recomputed from guard_twin's income ledger.
+
+THE RULING THIS SERVES (FIXPROGRAM_2026-09-13 §9, lead, ruling (a)): §4-4 prices a pre-fix transfer
+day from the amendment record when a VALID one exists; when the record is missing, fails its sha
+check or does not parse, it uses the RECORDED value and names that day `unamended_prefix_day` in
+`last_eval` — never blind, never silent. Nothing here can break the drawdown chain or make a
+condition blind: a bookkeeping correction must not become a new way to stop the book.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from typing import Any, Dict, Optional, Tuple
+
+KIND = "daily_nav_realised_split_amendment"
+REL_PATH = os.path.join("ledger_amendments", "daily_nav_realised_split.jsonl")
+# the literal the ruling names; readers of last_eval grep for it
+UNAMENDED = "unamended_prefix_day"
+
+
+def _finite(x) -> Optional[float]:
+    try:
+        v = float(x)
+    except (TypeError, ValueError):
+        return None
+    return v if v == v and v not in (float("inf"), float("-inf")) else None
+
+
+def path_for(pilot_log_root: str) -> str:
+    """`<mode root>/ledger_amendments/daily_nav_realised_split.jsonl` from the pilot_log root.
+
+    The apply step writes it beside `pilot_log`, under the mode root — the same relative path
+    FX-EXEC2's reader uses (`ops/daily_summary.AMENDMENTS_REL`).
+    """
+    return os.path.join(os.path.dirname(os.path.normpath(pilot_log_root)), REL_PATH)
+
+
+def load(path: str) -> Dict[Tuple[str, Optional[float]], Dict[str, Any]]:
+    """{(day, nav_ts): record} — or {} when the file is absent. Never raises.
+
+    ★ Same contract as FX-EXEC2's `load_realised_amendments`, deliberately, including the conflict
+      rule: a key that appears twice with DIFFERENT content is DROPPED, never resolved by position.
+      The row then reads as unamended, which is the direction that cannot invent a number.
+    """
+    out: Dict[Tuple[str, Optional[float]], Dict[str, Any]] = {}
+    conflict = set()
+    if not path or not os.path.exists(path):
+        return out
+    try:
+        fh = open(path)
+    except OSError:
+        return out
+    with fh:
+        for line in fh:
+            line = line.strip()
+            if not line:
+                continue
+            try:
+                r = json.loads(line)
+            except ValueError:
+                continue                      # an unparsable line is not a record; the row stays unamended
+            if not isinstance(r, dict) or r.get("kind") != KIND:
+                continue
+            k = (r.get("day"), _finite(r.get("nav_ts")))
+            if k in out and out[k] != r:
+                conflict.add(k)
+            out[k] = r
+    for k in conflict:
+        out.pop(k, None)
+    return out
+
+
+def _row_sha_ok(pilot_log_root: str, rec: Dict[str, Any]) -> Tuple[bool, str]:
+    """Does the record still describe the row it was built from?
+
+    The builder hashed the raw line INCLUDING its newline (`splitlines(keepends=True)`) and stored
+    the 1-based line number, so the check is exact and needs the file, not the parsed row.
+    """
+    want = rec.get("row_sha256")
+    line_no = rec.get("line")
+    if not isinstance(want, str) or not isinstance(line_no, int) or line_no < 1:
+        return False, "the record carries no usable row_sha256/line"
+    p = os.path.join(pilot_log_root, str(rec.get("day")), "daily_nav.jsonl")
+    try:
+        with open(p, "rb") as fh:
+            lines = fh.read().splitlines(keepends=True)
+    except OSError as e:
+        return False, f"could not read {p} ({type(e).__name__})"
+    if line_no > len(lines):
+        return False, f"the record names line {line_no} and the file has {len(lines)}"
+    got = hashlib.sha256(lines[line_no - 1]).hexdigest()
+    if got != want:
+        return False, f"row_sha256 mismatch (file {got[:12]}… vs record {want[:12]}…)"
+    return True, ""
+
+
+def realised_usdt(row: Dict[str, Any], amendments, pilot_log_root: str) -> Dict[str, Any]:
+    """The realised P&L this `daily_nav` row should be priced with, and WHERE it came from.
+
+    Returns {"usdt", "source", "status", "why", "day", "nav_ts"} and NEVER raises. `usdt` is None
+    only when the row's own `realised_pnl` is not a finite number — the caller already treats that
+    as unpriceable and this does not change it.
+
+    source/status vocabulary (both appear in `last_eval`, so they are the reader's contract):
+      amended               a valid record: sha verified, finite USDT total   ⇒ the record's value
+      post_fix_row          the row carries its own per-asset split           ⇒ the recorded value
+      unamended_prefix_day  a pre-fix row with no usable record               ⇒ the recorded value
+    """
+    row = row or {}
+    day = str(row.get("day")) if row.get("day") is not None else None
+    nav_ts = _finite(row.get("nav_ts"))
+    rec_usdt = _finite(row.get("realised_pnl"))
+    base = {"day": day, "nav_ts": nav_ts, "recorded_usdt": rec_usdt}
+
+    # ★ A ROW WRITTEN AFTER THE CARRIER FIX NEEDS NO RECORD, and is left exactly as it is priced
+    #   today. Its own `realised_by_type_asset` holds a USDT slice that the carrier sum can differ
+    #   from when a commission was paid in BNB; using that slice instead is a SECOND change to what
+    #   a stop-loss reads and is not part of the ruling — so the difference is REPORTED here and
+    #   priced nowhere, rather than taken silently.
+    bta = row.get("realised_by_type_asset")
+    if isinstance(bta, dict):
+        slice_usdt = None
+        try:
+            slice_usdt = sum(float((bta.get(t) or {}).get("USDT", 0.0)) for t in bta)
+        except (TypeError, ValueError):
+            slice_usdt = None
+        return dict(base, usdt=rec_usdt, source="recorded", status="post_fix_row",
+                    row_usdt_slice=_finite(slice_usdt),
+                    why=("the row carries its own per-asset split; §4-4 prices it from the carrier "
+                         "sum as it always has. `row_usdt_slice` is the USDT-only total beside it "
+                         "— reported, NOT priced: switching to it is a second change to a trigger "
+                         "and is outside the ruling"))
+
+    rec = None
+    if isinstance(amendments, dict):
+        rec = amendments.get((day, nav_ts))
+    if not isinstance(rec, dict):
+        return dict(base, usdt=rec_usdt, source="recorded", status=UNAMENDED,
+                    why="no amendment record for this row (day, nav_ts)")
+    ok, why = _row_sha_ok(pilot_log_root, rec)
+    if not ok:
+        return dict(base, usdt=rec_usdt, source="recorded", status=UNAMENDED, why=why)
+    am_usdt = _finite(((rec.get("amended") or {}).get("realised_pnl_usdt")))
+    if am_usdt is None:
+        return dict(base, usdt=rec_usdt, source="recorded", status=UNAMENDED,
+                    why="the record's amended USDT total is not a finite number")
+    return dict(base, usdt=am_usdt, source="amended", status="amended", why=None,
+                income_sha256=(rec.get("source") or {}).get("income_sha256"),
+                row_sha256=rec.get("row_sha256"),
+                delta_recorded_minus_amended_usdt=(
+                    None if rec_usdt is None else round(rec_usdt - am_usdt, 8)))
