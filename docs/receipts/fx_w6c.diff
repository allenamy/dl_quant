+"""M2-33 (aud-kb, P1): §4-2 must never judge a STALE day because the latest equity day could not be priced.
+
+*** MOCK ONLY: pilot_log trees in tmp, `watchdog.evaluate`. No venue, no network. ***
+
+THE DEFECT (ef60f85 live/watchdog.py L1103–1112, L1252): a day whose daily_nav rows carry external_flow_usdt ≠ 0 (a transfer)
+or whose income ledger was truncated is UNKNOWN — by the B32 caliber, kept — and cond2 then judged "the most recent PRICED
+day" with no staleness bound. On a resume day after a day-loss trip, a wallet transfer made cond2 fall back to the losing day
+and trip again: an instrument gap (today cannot be priced) deciding a book-level flatten. The research commit 74b2acb5 fixed
+only a research tool's text; the executor kept the rule, so "no transfers on a resume day" stayed an operating rule.
+AUDIT_EXEC STA-01 ("a transfer today would not re-trip") is the SAME mechanism measured on a window whose fallback day
+(09-12, +0.22%) was positive — no contradiction.
+
+THE RULE HERE: cond2 judges the LATEST day that carries equity rows. If that day is unpriced (transfer / truncated / terms
+missing), cond2 is BLIND — named, paged as blind, and the resume gate refuses — and the older priced day is reported as
+history, never judged. A day with no equity rows at all (e.g. a new UTC day before its first anchor) says nothing about
+equity and is skipped, exactly as before. The transfer-day caliber itself (UNKNOWN, B32) is NOT changed.
+
+Cells: [1] headline — D2 −4.2% (the trip day), D3 resume day with a +5,000 transfer: not tripped, blind, D2 reported not
+judged (ef60f85: trips on D2). [2] neighbour — D3 truncated instead of a transfer: same. [3] neighbour (STA-01's window) —
+D2 +0.22%, D3 transfer: not tripped either way, now blind. [4] control — D3 ordinary −0.5%: judged on D3, quiet (both trees).
+[5] control — D3 ordinary −4.5%: trips on D3 (both trees). [6] control — a day with NO equity rows after D2: D2 is still
+the latest equity day and is judged (both trees).
+
+Exit 0 = all pass.
+"""
+import os
+import shutil
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import pilot_log as PL                 # noqa: E402
+import watchdog as WD                  # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:400]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+def tree(days):
+    """days: [(nav or None for no equity rows, flow_usdt, truncated)] — one flat, consistent anchor per day."""
+    root = tempfile.mkdtemp(prefix="m233_")
+    for i, (nav, flow, trunc) in enumerate(days):
+        day = f"202609{11 + i:02d}"
+        ats = 1789100000.0 + i * 86400
+        lg = PL.PilotLogger(root, day)
+        lg.anchor(anchor_ts=ats, target_vector_hash="h", realized_gross=0.0, target_gross=20000.0, n_names_skipped=0,
+                  regime_at_anchor="calm", mid_at_anchor_vector={"AAAUSDT": 1.0}, factor_version="f", panel_hash="p")
+        lg.order(anchor_ts=ats, symbol="AAAUSDT", side="buy", target_w=0.0, prev_w=0.0, intended_notional=0.0,
+                 order_type="maker", submit_ts=None, price_submit=None, mid_at_submit=1.0, mid_at_anchor=1.0,
+                 filled_notional=None, avg_fill_px=None, first_fill_ts=None, last_fill_ts=None, cancel_ts=None,
+                 fee_paid=None, rebalance_id=f"A{int(ats)}", attempt_idx=1, terminal_reason="skipped_min_notional",
+                 notional_currency="USDT")
+        lg.position_readback(anchor_ts=ats, symbol="AAAUSDT", venue_position_notional=0.0, venue_position_qty=0.0,
+                             source="mock", read_ts=ats + 10)
+        if nav is not None:
+            lg.daily_nav(day=int(day), target_gross=2.0 * nav, nav=nav, sizing_policy="constant_leverage_2.00",
+                         realised_pnl=0.0, unrealised_pnl=0.0, external_flow_usdt=flow, realised_truncated=trunc)
+        lg.close()
+    return root
+
+
+def c2(days):
+    r = tree(days)
+    try:
+        ev = WD.evaluate(r, venue_events=[], ops_stats=[])
+    finally:
+        shutil.rmtree(r, ignore_errors=True)
+    return ev, ev["conditions"]["cond2_day_loss"]
+
+
+D1 = (10000.0, 0.0, False)
+D2_LOSS = (9580.0, 0.0, False)          # −4.20%: the trip day
+
+print("[1] ★ headline: the resume day after a −4.20% trip carries a +5,000 transfer")
+ev, c = c2([D1, D2_LOSS, (14580.0, 5000.0, False)])
+check("★★★ 1 NOT tripped; cond2 BLIND on the transfer day 2026-09-13; the −4.20% of 2026-09-12 is reported as the last "
+      "priced day and NOT judged (ef60f85: tripped again on 2026-09-12's −4.20%)",
+      ev["tripped"] is False and c["triggered"] is False and c["blind"] is True and c["recent_day"] is None
+      and c.get("latest_equity_day") == "20260913" and c.get("last_priced_day") == "20260912"
+      and abs((c.get("last_priced_day_pct") or 0.0) - (-4.2)) < 1e-9 and "cond2_day_loss" in ev["conditions_blind"],
+      {k: c.get(k) for k in ("triggered", "blind", "recent_day", "recent_day_pct", "latest_equity_day",
+                             "last_priced_day", "last_priced_day_pct", "judged_on")} | {"triggers": ev["triggers"]})
+check("★★ 1 the record says WHY it is blind and names both days", "transfer" in str(c.get("judged_on")) and
+      "2026-09-13" in str(c.get("judged_on")) and "2026-09-12" in str(c.get("judged_on")), c.get("judged_on"))
+
+print("\n[2] neighbour: the resume day's income ledger is truncated instead")
+ev, c = c2([D1, D2_LOSS, (9600.0, 0.0, True)])
+check("★★★ 2 truncated latest day ⇒ not tripped, blind, the older −4.20% not judged (ef60f85: tripped on it)",
+      ev["tripped"] is False and c["blind"] is True and c.get("last_priced_day") == "20260912"
+      and "truncated" in str(c.get("judged_on")), {k: c.get(k) for k in ("triggered", "blind", "judged_on")})
+
+print("\n[3] neighbour — STA-01's window: the fallback day was positive (+0.22%), today a transfer")
+ev, c = c2([D1, (10022.0, 0.0, False), (15022.0, 5000.0, False)])
+check("★★ 3 not tripped on either tree; on this one cond2 is blind on the transfer day instead of quietly judging yesterday",
+      ev["tripped"] is False and c["blind"] is True and c.get("last_priced_day") == "20260912",
+      {k: c.get(k) for k in ("triggered", "blind", "last_priced_day", "last_priced_day_pct")})
+
+print("\n[4] control: an ordinary −0.5% day after the trip day is judged and quiet")
+ev, c = c2([D1, D2_LOSS, (9532.1, 0.0, False)])
+check("★ 4 judged on 2026-09-13 (−0.50%), not tripped, not blind",
+      c["recent_day"] == "20260913" and c["triggered"] is False and c["blind"] is False and abs(c["recent_day_pct"] - (-0.5)) < 1e-6,
+      {k: c.get(k) for k in ("recent_day", "recent_day_pct", "triggered", "blind")})
+
+print("\n[5] control: an ordinary −4.5% latest day still trips")
+ev, c = c2([D1, (10000.0, 0.0, False), (9550.0, 0.0, False)])
+check("★★ 5 judged on 2026-09-13 (−4.50%), tripped, the trigger names that day",
+      c["triggered"] is True and c["recent_day"] == "20260913" and any(t.startswith("§4-2") for t in ev["triggers"]),
+      ev["triggers"])
+
+print("\n[6] control: a newer day with NO equity rows (a UTC day before its first anchor) is skipped")
+ev, c = c2([D1, D2_LOSS, (None, 0.0, False)])
+check("★ 6 the latest EQUITY day is still 2026-09-12 and it is judged (−4.20%, tripped) — no equity rows is not an "
+      "unpriced equity day",
+      c["recent_day"] == "20260912" and c["triggered"] is True and c["blind"] is False,
+      {k: c.get(k) for k in ("recent_day", "recent_day_pct", "triggered", "blind")})
+
+print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed")
+if FAILS:
