+class _Acct(WD.MockBroker):
+    def __init__(self, pos=None, fail=False, none=False, reject_after=None):
+        super().__init__(positions=dict(pos or {}))
+        self._pos, self._fail, self._none, self._reject_after = dict(pos or {}), fail, none, reject_after
