+"""ALM-02: §4-2's record must name the day it JUDGED, and its trigger must print the number that TRIPPED.
+
+*** MOCK ONLY: pilot_log trees in tmp, `watchdog.evaluate`. No venue, no network. ***
+
+THE DEFECT (AUDIT_EXEC ALM-02, ef60f85): `cond2_day_loss.judged_on` is the literal "most recent priced day (2026-09-06);
+…" whatever day was judged — the live last_eval.json at 2026-09-13T12:46:53Z carried it beside recent_day 20260913. Its
+twin one screen below: the §4-2 trigger string prints `worst` (the window's historical minimum) while the trip is decided
+on `recent` (the most recent priced day, since 2026-09-06). On that same live record worst_day_pct was −4.2755 (09-06), so
+a new day tripping at −4.05% would have written "single-day loss -4.28%" into the trigger, the trip page, ALARM.log, the
+state reason and every protective_flatten row's note — the number of a day that did not trip. The same family as the
+research-side flow-day text fixed in 74b2acb5: a written fact that goes stale.
+
+Cells: [1] headline — an older −5.00% day stays in the window, the latest day trips at −4.11%: the trigger prints −4.11 and
+names its day, judged_on names that day (ef60f85: prints −5.00, judged_on 2026-09-06). [2] neighbour — one losing day, worst
+== recent: the same number either way. [3] neighbour — nothing trips: judged_on still names the judged day. [4] neighbour —
+no priced day: judged_on says so instead of naming a date. [5] source pin: no hard-coded date in the record's wording.
+
+Exit 0 = all pass.
+"""
+import json
+import os
+import shutil
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import pilot_log as PL                 # noqa: E402
+import watchdog as WD                  # noqa: E402
+
+FAILS, N = [], [0]
+
+
+def check(name, cond, detail=""):
+    N[0] += 1
+    print(f"  {'OK  ' if cond else 'FAIL'}  {name}{('  — ' + str(detail)[:400]) if detail != '' else ''}", flush=True)
+    if not cond:
+        FAILS.append(name)
+
+
+def tree(navs, nav_rows=True):
+    """One day per entry of `navs` (last nav of the day), a flat consistent book so nothing but §4-2 can speak."""
+    root = tempfile.mkdtemp(prefix="alm02_")
+    for i, nav in enumerate(navs):
+        day = f"202609{11 + i:02d}"
+        ats = 1789100000.0 + i * 86400
+        lg = PL.PilotLogger(root, day)
+        lg.anchor(anchor_ts=ats, target_vector_hash="h", realized_gross=0.0, target_gross=2.0 * nav, n_names_skipped=0,
+                  regime_at_anchor="calm", mid_at_anchor_vector={"AAAUSDT": 1.0}, factor_version="f", panel_hash="p")
+        lg.order(anchor_ts=ats, symbol="AAAUSDT", side="buy", target_w=0.0, prev_w=0.0, intended_notional=0.0,
+                 order_type="maker", submit_ts=None, price_submit=None, mid_at_submit=1.0, mid_at_anchor=1.0,
+                 filled_notional=None, avg_fill_px=None, first_fill_ts=None, last_fill_ts=None, cancel_ts=None,
+                 fee_paid=None, rebalance_id=f"A{int(ats)}", attempt_idx=1, terminal_reason="skipped_min_notional",
+                 notional_currency="USDT")
+        lg.position_readback(anchor_ts=ats, symbol="AAAUSDT", venue_position_notional=0.0, venue_position_qty=0.0,
+                             source="mock", read_ts=ats + 10)
+        if nav_rows:
+            lg.daily_nav(day=int(day), target_gross=2.0 * nav, nav=nav, sizing_policy="constant_leverage_2.00",
+                         realised_pnl=0.0, unrealised_pnl=0.0)
+        lg.close()
+    return root
+
+
+def c2(navs, nav_rows=True):
+    r = tree(navs, nav_rows)
+    try:
+        ev = WD.evaluate(r, venue_events=[], ops_stats=[])
+    finally:
+        shutil.rmtree(r, ignore_errors=True)
+    return ev, ev["conditions"]["cond2_day_loss"]
+
+
+print("[1] headline: an older −5.00% day in the window, the latest day trips at −4.11%")
+ev, c = c2([10000.0, 9500.0, 9500.0, 9110.0])
+_t = [t for t in ev["triggers"] if t.startswith("§4-2")]
+check("★★★ 1 the trip is decided on the latest day (−4.105%) and the trigger PRINTS that number and names 2026-09-14, "
+      "not the window's worst day (−5.00% on 2026-09-12) — ef60f85 prints -5.00",
+      c["triggered"] is True and c["recent_day"] == "20260914" and abs(c["recent_day_pct"] - (-4.105263157894737)) < 1e-9
+      and abs(c["worst_day_pct"] - (-5.0)) < 1e-9 and len(_t) == 1 and "-4.11%" in _t[0] and "2026-09-14" in _t[0]
+      and "-5.00%" not in _t[0], (_t, c["recent_day_pct"], c["worst_day_pct"]))
+check("★★★ 1 judged_on names the judged day 2026-09-14 (ef60f85: the literal 2026-09-06)",
+      "2026-09-14" in c["judged_on"] and "2026-09-06" not in c["judged_on"], c["judged_on"])
+
+print("\n[2] neighbour: one losing day — worst == recent, the same number either way")
+ev, c = c2([10000.0, 10000.0, 9580.0])
+_t = [t for t in ev["triggers"] if t.startswith("§4-2")]
+check("★★ 2 −4.20% on the only losing day: the trigger prints -4.20% and names 2026-09-13",
+      c["triggered"] is True and len(_t) == 1 and "-4.20%" in _t[0] and "2026-09-13" in _t[0], _t)
+
+print("\n[3] neighbour: nothing trips — the record still names the day it judged")
+ev, c = c2([10000.0, 9500.0, 9550.0])
+check("★★ 3 latest day +0.53% (an older −5.00% in the window): not triggered, judged_on names 2026-09-13",
+      c["triggered"] is False and not [t for t in ev["triggers"] if t.startswith("§4-2")]
+      and "2026-09-13" in c["judged_on"] and "2026-09-06" not in c["judged_on"], c["judged_on"])
+
+print("\n[4] neighbour: no priced day — the record says so instead of naming a date")
+ev, c = c2([10000.0], nav_rows=False)
+check("★★ 4 no daily_nav at all: blind, recent_day None, judged_on names no date",
+      c["blind"] is True and c["recent_day"] is None and "2026-" not in c["judged_on"] and "no priced day" in c["judged_on"],
+      c["judged_on"])
+
+print("\n[5] source pin")
+_src = open(os.path.join(HERE, "watchdog.py")).read()
+check("★ 5 the §4-2 record's wording carries no hard-coded date and the trigger reads `recent`",
+      '"judged_on": "most recent priced day (2026-09-06)' not in _src and 'single-day loss {worst:.2f}%' not in _src)
+
+print(f"\n{N[0] - len(FAILS)}/{N[0]} checks passed")
+if FAILS:
+    print("FAILED:", *FAILS, sep="\n  ")
+    sys.exit(1)
+print("ALL PASS")
