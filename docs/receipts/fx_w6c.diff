+               page=bool(obs.get("halt_opening")),
+               why=(f"newest evaluation ({data.get('evaluated_utc')}) reports "
+                    f"{obs.get('state')} via {obs.get('reference')}; newest scheduled anchor "
+                    f"{obs.get('newest_scheduled_anchor_ts')}"))
+    return out
