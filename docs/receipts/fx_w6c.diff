+    def account_snapshot(self):
+        self.n_reads += 1
+        if self._fail:
+            raise RuntimeError("venue said no")
+        if self._none:
+            return None
+        return {"total_wallet_balance": 10_000.0, "total_unrealized_profit": 0.0,
