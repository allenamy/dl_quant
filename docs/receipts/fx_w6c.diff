+class _RejectingLogger(PL.PilotLogger):
+    def __init__(self, root, day, reject_after):
+        super().__init__(root, day)
+        self._n, self._reject_after = 0, reject_after
+
+    def position_readback(self, **row):
+        self._n += 1
+        if self._n > self._reject_after:
+            raise ValueError("schema says no")
+        return super().position_readback(**row)
